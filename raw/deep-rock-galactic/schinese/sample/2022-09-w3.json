owned": 146, "num_reviews": 5, "playtime_forever": 14594, "playtime_last_two_weeks": 0, "playtime_at_review": 11956, "last_played": 1717317352, "avatar": "bd3c0d7741bda279511a2d534238242936d8b2f5"}, "language": "schinese", "review": "这不是个什么人都喜欢的游戏。除非你有一群喜欢一起探险的朋友，并且不畏惧昏暗的地底空间。那么你首先会获得一款地图全可破坏，酣畅淋漓的杀虫挖矿游戏。这仅仅是开始。如果你能全部体验完游戏内容，并开始真正开始感兴趣，想要了解不同武器模组带来的优质体验。那么你的深岩银河游戏体验将真正开始。\n——来自小黑盒用户DeevenLAI的评价", "timestamp_created": 1663898354, "timestamp_updated": 1663898354, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}