mid": "76561198333329496", "personaname": "弱小的勇者~", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/WX233/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 2820, "playtime_last_two_weeks": 0, "playtime_at_review": 1080, "last_played": 1680743579, "avatar": "39148b81df3b6013cac3d09b303b6f2dcbc7c5d9"}, "language": "schinese", "review": "为什么不更新了", "timestamp_created": 1527745511, "timestamp_updated": 1527745511, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "42370278", "author": {"steamid": "76561198268731850", "personaname": "阳总裁", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/ayangzongcai/", "num_games_owned": 50, "num_reviews": 3, "playtime_forever": 13631, "playtime_last_two_weeks": 0, "playtime_at_review": 1648, "last_played": 1781505196, "avatar": "169cf217cf9dfe16a6b7993a664d6d5549178062"}, "language": "schinese", "review": "游戏体验很好，有了地图我还是一样懵逼，中二无所畏惧。很基佬的游戏。开黑必备的良品。\n这辈子不可能不玩，不玩是不可能的。只能偶尔被水蛭吊着，炸一炸，被喷口水之外，没啥好的操作了。趴趴地是真的舒服。", "timestamp_created": 1527629186, "timestamp_updated": 1527629186, "voted_up": true, "votes_up": 1, "votes_funny": 2, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "42313741", "author": {"steamid": "76561198403828963", "personaname": "叶子poi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/1726973919/", "num_games_owned": 72, "num_reviews": 6, "playtime_forever": 188, "playtime_last_two_weeks": 0, "playtime_at_review": 187, "last_played": 1533920984, "avatar": "c471512e65fdb89ef00845f0a72d61a054507b78"}, "language": "schinese", "review": "呆逼游戏。一开始，我们觉得是款不错的游戏。我们的团队在上一局的游戏里，也是最后一局游戏里感觉到了对路痴的不尊重。找不到该走的路。我好不容易为团队找到两次该走的路。然而在一段时间的搜寻之后，又迷失了路。没有明确的指示方向的东西。以至于我们没办法有效的前进，最后烦躁的都自杀了。很无奈。", "timestamp_created": 1527435191, "timestamp_updated": 1527435191, "voted_up": false, "votes_up": 0, "votes_funny": 4, "weighted_vote_score": "0.359326571226119995", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}