e_forever": 165, "playtime_last_two_weeks": 0, "playtime_at_review": 64, "last_played": 1655348392, "avatar": "e2dfbc249f2bb95febe43c64177c96e7138ee68c"}, "language": "schinese", "review": "gan jue you dian wu liao", "timestamp_created": 1655308772, "timestamp_updated": 1655308772, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "117028250", "author": {"steamid": "76561198310999730", "personaname": "loong xxxxxx", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198310999730/", "num_games_owned": 238, "num_reviews": 49, "playtime_forever": 9050, "playtime_last_two_weeks": 0, "playtime_at_review": 2078, "last_played": 1772641582, "avatar": "18b9c3b6ddb83a115a23e47dfedad697d61f591c"}, "language": "schinese", "review": "优点\n连着玩了30多小时，真的爽。一局游戏，开始是探索，后期是逃命。最后登船的时候，真的是争分夺秒，非常刺激，不仅仅是时间限制，你只要落后，孤身一人，敌人会无限在你身边刷新，是必死的。所以，给人一种火烧屁股的感觉，肾上腺素狂飙。\n然而，优点也就到此了。缺点也来的也快，刚开始不熟悉，所以新鲜感很足，干劲十足。等到所有角色玩一遍，等级堆上去，熟练度上去之后，重复感顿时就上来了。无非是8个模式，10张地图（没记错的话），地图看上去生成的不一样，但所有地图的生物是一模一样的，没有任何变化，只是不同地图，环境略有不同。打你的永远只有蜘蛛，换个名字和皮肤，也没有任何区别。游戏出来好久了，指望后期更新出新鲜感是没可能的了。\n然而问我推不推荐，那是肯定的，游戏肯定值回票价，只是后期略乏力。", "timestamp_created": 1655308293, "timestamp_updated": 1655308293, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}