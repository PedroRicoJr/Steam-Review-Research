refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "64568230", "author": {"steamid": "76561198088197241", "personaname": "El Cata", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/elcata/", "num_games_owned": 0, "num_reviews": 29, "playtime_forever": 274, "playtime_last_two_weeks": 0, "playtime_at_review": 82, "last_played": 1668725722, "avatar": "7933b528c1b202578aaba7e2d98a95ac12f1b114"}, "language": "latam", "review": "Dignidad. Los 1.5 GBs mejor aprovechados de los últimos 10 años. Una razón más para no formar una familia.", "timestamp_created": 1583445767, "timestamp_updated": 1583445767, "voted_up": true, "votes_up": 4, "votes_funny": 7, "weighted_vote_score": "0.586206912994384766", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "64436199", "author": {"steamid": "76561198358254981", "personaname": "joaco55436", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198358254981/", "num_games_owned": 90, "num_reviews": 5, "playtime_forever": 14562, "playtime_last_two_weeks": 0, "playtime_at_review": 647, "last_played": 1722364392, "avatar": "b8abd274ab68b6589536960fb7cbf7a1f4863966"}, "language": "latam", "review": "Es claramente un juego increible. Marco mi relacion con mis amigos, tanto por los insultos al morir o al ellos matarte, como por las risas por la muerte de otros o las divertidas skins.\nContiene unos graficos maravillosos, con vividos colores y hermosos efectos, pudiendo dejar boquiabierto a cualquiera. La banda sonora no se queda atras dando una maravillosa mezcla de tranquilidad de exploracion, y electronica frenetica en los momentos de horda, en los cuales solo puedes pensar en sobrevivir. Simplemente un juego que claramente vale su precio, dejando memorables experiencias. Muy contento de haberlo adquirido y haberle dedicado casi 200 horas.", "timestamp_created": 1583207053, "timestamp_updated": 1606366572, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "64433573", "author": {"steamid": "76561198111948696", "personaname": "Titi calderon", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/avontuursteam/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4313, "playtime_last_two_weeks": 0, "playtime_at_review": 362, "last_played": 1648595318, "avatar": "ddc168ec67fdc3017ffe776d70327a007748a7d8"}, "language": "latam", "review": "Lo bajé gratis para ver si me gustaba: Jugué 5 horas seguidas.", "timestamp_created": 1583202037, "timestamp_updated": 1583202037, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "64431394", "author": {"steamid": "76561198336219838", "personaname": "frutimix.mp3", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198336219838/", "num_games_owned": 106, "num_reviews": 5, "playtime_forever": 3928, "playtime_last_two_weeks": 0, "playtime_at_review": 1357, "last_played": 1681448058, "avatar": "35c3fb62c8d8f00386f891552e8670dbc64d0a5e"}, "language": "latam", "review": "esta bueno lo probe gratis pero soy super pobre como para comprarlo gg", "timestamp_created": 1583197768, "timestamp_updated": 1583197768, "voted_up": true, "votes_up": 0, 