view": "Epic, A great game to play with friends", "timestamp_created": 1612458312, "timestamp_updated": 1612458312, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "85781016", "author": {"steamid": "76561198248830380", "personaname": "Clancey", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/clancey366/", "num_games_owned": 724, "num_reviews": 82, "playtime_forever": 5967, "playtime_last_two_weeks": 0, "playtime_at_review": 2015, "last_played": 1773283333, "avatar": "5cb37b2266cf1575f6c1f74e87b800b9c52edea5"}, "language": "latam", "review": "De los mejores coop online que he jugado, te puede ser confuso en las primeras horas, pero solo en lo que aprendes qué hacer con cada rol y en cada misión, en todo caso la comunidad es muy wholesome así que siempre van a ayudar si no le sabes, algunos hasta te desean dulces sueños antes de desconectarse", "timestamp_created": 1612213147, "timestamp_updated": 1612213147, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": [{"reaction_type": 21, "count": 1}]}]}