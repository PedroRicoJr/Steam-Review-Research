lse, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "224195579", "author": {"steamid": "76561198930070561", "personaname": "Lauty21", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198930070561/", "num_games_owned": 538, "num_reviews": 45, "playtime_forever": 2477, "playtime_last_two_weeks": 0, "playtime_at_review": 1081, "last_played": 1779297155, "avatar": "3caa238e51bf5f3b40ccad35f183a27ce40e4eb4"}, "language": "spanish", "review": "k juegazo", "timestamp_created": 1777266348, "timestamp_updated": 1777266348, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "224191709", "author": {"steamid": "76561198092365369", "personaname": "Khilnmer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Khilnmer/", "num_games_owned": 212, "num_reviews": 4, "playtime_forever": 6041, "playtime_last_two_weeks": 0, "playtime_at_review": 3405, "last_played": 1779500435, "avatar": "7fbab9bb9e64fea4d608a8cddab000c1f87ea55a"}, "language": "spanish", "review": "Como casi siempre en mi caso tuve ciertas dudas con este juego, pero la verdad es que terminó dándome una sorpresa completamente positiva.\n\n¿Te gusta ir en solitario? Puedes hacerlo llevando contigo a Bosco para que te asista en algunas cosas, no tienes limitaciones ni tampoco el juego te obliga a que juegues en cooperativo, puedes iniciar tu partida para ti nada más y aventurarte en los peligros de cada misión.\n\n¿Tienes amigos? Entonces arma una buena presentación en powerpoint, insisteles y oblígalos (en caso de que las maneras de persuasión no funcionen) a comprar el juego, la experiencia jugando con amigos siempre es risas aseguradas a menos que todos sean unos enanos gruñones y netamente tácticos dejando claro que solo están allí para cumplir un trabajo y que la compañía siga siendo la mejor.\n\nTambién tiene alguna que otra curiosidad en la nave de la compañía, merece la pena explorarla e interactuar con lo que te vayas consiguiendo, recuerda estar pendiente de cualquier detalle.", "timestamp_created": 1777260305, "timestamp_updated": 1777260305, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.560000002384185791", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "hardware": {"system_ram": "32125", "os": "Windows 11", "cpu_name": "AMD Ryzen 7 5700G with Radeon Graphics         ", "adapter_description": "Radeon RX 580 Series", "vram_size": 8170}, "reactions": []}, {"recommendationid": "224180692", "author": {"steamid": "76561199146805543", "personaname": "Huriuz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199146805543/", "num_games_owned": 32, "num_reviews": 3, "playtime_forever": 6685, "playtime_last_two_weeks": 0, "playtime_at_review": 1883, "last_played": 1786248597, "avatar": "10b1a1091aa8eebbfc17774f64e7b74b5bc50b4f"}, "language": "spanish", "review": "ta weno el juego, rocomendao", "timestamp_created": 1777244814, "timestamp_updated": 1777244814, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}