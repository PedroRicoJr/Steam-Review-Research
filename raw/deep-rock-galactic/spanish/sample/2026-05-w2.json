s": 5, "playtime_forever": 10423, "playtime_last_two_weeks": 118, "playtime_at_review": 9104, "last_played": 1787108540, "avatar": "8b49097da099a78633a4c2491b6cd234e0213d90"}, "language": "spanish", "review": "Viniendo de Helldivers 2 y siendo profundamente decepcionado, solo puedo decir que este juego es increíble. Obviamente no tiene una gran narrativa, así que es importante jugar este juego por lo que ofrece: gameplay, progreso, y pasarlo bien con los amigos. \r\n\r\nSí que me gustaría que hubiera cosas narrativas más interesantes, pero la variedad de gameplay que ofrece el juego es suficiente para que esté siempre encantado, así que en general disfruto el juego. Además, incluso si no lo juegas muy seguido siempre se refrescan las misiones semanales y los Deep Dives, así que no sientas que has \"perdido\" la oportunidad de más recursos, y en cambio juega el juego como quieras.", "timestamp_created": 1778690662, "timestamp_updated": 1778690662, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}