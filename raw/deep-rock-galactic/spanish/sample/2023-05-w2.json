oz del gordo del Deep Rock que me decía que tenia una mena de red sugar en frente mio. Así que tal cual agarre mi bonito pico lleno de gadgets extraños y procedí a reventar el cráneo del niño. Mucho rojo salio pero sirvió porque regenere salud en lo que gritaba a los cuatro vientos \"red sugaah!!!!\"\nEn fin este juego es muy bueno, compralo ya. PERO YA, STOP READING MOFO!!! VE A COMPRARLO YA!!!!!!!! 100% RECOMENDADO!!!!!!!!", "timestamp_created": 1684140287, "timestamp_updated": 1684140287, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "138324351", "author": {"steamid": "76561198180845593", "personaname": "Thepliego12", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/1246935023803841898/", "num_games_owned": 143, "num_reviews": 22, "playtime_forever": 8095, "playtime_last_two_weeks": 0, "playtime_at_review": 902, "last_played": 1772166184, "avatar": "c8a540a8ea6fd310a335bc76490204c20e9380a9"}, "language": "spanish", "review": "Ta weno juegalo", "timestamp_created": 1684125707, "timestamp_updated": 1684125707, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "138319450", "author": {"steamid": "76561199094171308", "personaname": "Carlos Heinz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199094171308/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 1245, "playtime_last_two_weeks": 0, "playtime_at_review": 1245, "last_played": 1683432377, "avatar": "f5ac3850cbdef710f87