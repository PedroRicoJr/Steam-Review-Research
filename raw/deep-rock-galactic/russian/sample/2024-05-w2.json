mendationid": "165433740", "author": {"steamid": "76561198131408414", "personaname": "popo_sko", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198131408414/", "num_games_owned": 0, "num_reviews": 111, "playtime_forever": 630, "playtime_last_two_weeks": 0, "playtime_at_review": 556, "deck_playtime_at_review": 32, "last_played": 1771967863, "avatar": "3604ac34b47c87e187d151f22aa17e107253ce34"}, "language": "russian", "review": "ROCK AND STONE!", "timestamp_created": 1715810102, "timestamp_updated": 1715810102, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "165433145", "author": {"steamid": "76561198168456441", "personaname": "Fertyn", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/5086362/", "num_games_owned": 206, "num_reviews": 17, "playtime_forever": 18107, "playtime_last_two_weeks": 0, "playtime_at_review": 11063, "last_played": 1778365435, "avatar": "8442685651231b08503c282a75c5f324df2ae085"}, "language": "russian", "review": "Слежу за игрой практически с её появления в стиме. На глазах она развивалась, обрастала контентом, обретала, так скажем, лоск. И сейчас, когда этот процесс почти закончен, а игра смотрится завершенной, можно уверенно сказать, а получился ли у Coffee Stain кооперативный шутер? ДА, получился. Игра прекрасно подходит для кооперативных поигрулек по вечерам, она не очень скиллозависима, у неё низкий порог входа, так как это все таки PVE шутер, и контента в ней более чем достаточно. Но у неё есть и серьезный недостаток, она быстро наскучивает, я пробовал играть в неё соло, пробовал в компании, все равно, через какое-то время она надоедает, не знаю с чем это связано, но этот фактор не мог быть неупомянутым. Рекомендую для игры с друзьями, в соло на ваш страх и риск.", "timestamp_created": 1715809345, "timestamp_updated": 1715809345, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "165428123", "author": {"steamid": "76561199468579714", "personaname": "karuniko", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199468579714/", "num_games_owned": 96, "num_reviews": 4, "playtime_forever": 10912, "playtime_last_two_weeks": 0, "playtime_at_review": 1037, "last_played": 1762215065, "avatar": "61c6cb24afd876e64f6843371ee513a69cdfb874"}, "language": "russian", "review": "ломай камень, кушай пиво. пиво.. пиво... пиво... пиво...", "timestamp_created": 1715803215, "timestamp_updated": 1715803215, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}