teamid": "76561198393624050", "personaname": "Alexander1748", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198393624050/", "num_games_owned": 0, "num_reviews": 43, "playtime_forever": 13424, "playtime_last_two_weeks": 0, "playtime_at_review": 4859, "last_played": 1739721699, "avatar": "c1b429f84f743a3d6d4f56514ce7b0e112ab2623"}, "language": "russian", "review": "Интересная игра.", "timestamp_created": 1624478172, "timestamp_updated": 1624478172, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.54356849193572998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "94233757", "author": {"steamid": "76561198443867923", "personaname": "Léra Estrogen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ngonasah/", "num_games_owned": 262, "num_reviews": 26, "playtime_forever": 6311, "playtime_last_two_weeks": 115, "playtime_at_review": 524, "last_played": 1787537151, "avatar": "86d664c151199e79f8a5e48648a6766fe57dcaf0"}, "language": "russian", "review": "Копать в шахтах, а по приходу в общагу с другими работягами, есть суп из опилок и пить пивко...\nШедевр, а не игра", "timestamp_created": 1624476505, "timestamp_updated": 1624476505, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "94233061", "author": {"steamid": "76561198014533090", "personaname": "Pew", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/pewmarine/", "num_games_owned": 228, "num_reviews": 83, "playtime_forever": 1542, "playtime_last_two_weeks": 0, "playtime_at_review": 524, "last_played": 1733961837, "avatar": "33a8c585be17a6c799cdc47ea87cd33a2cf83f39"}, "language": "russian", "review": "Я приобрёл эту игру за 399 рублей по скидке с другом. Давно ещё хотели ее купить . Первые 8 часов в игре были интересными , а дальше всё становится однотипным, кастомизации маловато , задания однотипные (хоть они и генерируются каждый раз по новому, задачи остаются такими же) . Я ожидал от игры Left 4 Dead который затянет на сотни часов , но получил скучные задания и слабо влияющая прокачка , одним словом скучная гриндилка . Я не говорю что я играл без удовольствия ,  а напротив , в начале интересно исследовать новые биомы, пещеры и обороняться от толп жуков как из Alien Swarm, но это веселье быстро заканчивается когда ничего нового по сути в игре не происходит после 7-8 часов в игре. Было бы по больше игровых режимов , по типу выживания.\n\nОценка : 3+\\5 . Мало контента как-то, и нету цели в игре , прокачка есть , но она не очень влияет.", "timestamp_created": 1624475497, "timestamp_updated": 1624538206, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.488301277160644531", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}