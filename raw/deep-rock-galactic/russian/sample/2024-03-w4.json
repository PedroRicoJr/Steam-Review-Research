другой изобрел новый способ использования взрывчатки, чтобы ускорить процесс добычи минералов (и чуть не отправил всю команду на тот свет).\r\n\r\nВ общем, если ты готов погрузиться в мир, где мемы о гномах встречаются с тотальным безумием и где твоя борода — это не только украшение, но и показатель твоего стажа в игре, то \"Deep Rock Galactic\" — это точно то, что тебе нужно. Rock and Stone!", "timestamp_created": 1711911821, "timestamp_updated": 1711911821, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "161901294", "author": {"steamid": "76561199051210092", "personaname": "Slyxrt ♡", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Slyxrt/", "num_games_owned": 140, "num_reviews": 18, "playtime_forever": 4952, "playtime_last_two_weeks": 0, "playtime_at_review": 3887, "last_played": 1778700742, "avatar": "6042643e43b7975f69fa9fb078b32daf4b1fdcb2"}, "language": "russian", "review": "помню сидел пил пиво и подходит знакомый дворф говорит пошли проходить глубокое погружение...\nпосле этого у меня не было знакомых дворфов", "timestamp_created": 1711910668, "timestamp_updated": 1711910668, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}