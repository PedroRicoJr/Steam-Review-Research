er": 7719, "playtime_last_two_weeks": 0, "playtime_at_review": 3073, "last_played": 1771586319, "avatar": "397fdc373af287c1f263c3f51aaeb9b97db0e529"}, "language": "russian", "review": "Купили с друзьями по скидке , думали что эта игра какой то малоинтересный шутер . По итогу наиграли по пятьдесят часов каждый , пьем пиво и убиваем любых насекомых под крики : ROCK AND STONE. \r\nЕсли не знаете стоит ли ее покупать или лучше с экономить , то такой вам совет . У игры прекрасное комьюнити и в подключаясь к многим лобби вы можете познакомиться с прекрасными людьми . Но одному в этой игре делать нечего , как по мне одному играть будет многим не интересно . Ну а если прямо то игра классная . Вкусного вам пиво и Good luck team\r\n", "timestamp_created": 1730404843, "timestamp_updated": 1730404843, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}