community.com/profiles/76561199026211184/", "num_games_owned": 118, "num_reviews": 17, "playtime_forever": 3462, "playtime_last_two_weeks": 0, "playtime_at_review": 501, "last_played": 1774726079, "avatar": "cefeedab70daa3c60afe8accaae9b26b7f8d837b"}, "language": "russian", "review": "ochen normalno", "timestamp_created": 1719783207, "timestamp_updated": 1719783207, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "168638849", "author": {"steamid": "76561199384962998", "personaname": "76561199384962998", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199384962998/", "num_games_owned": 34, "num_reviews": 8, "playtime_forever": 1688, "playtime_last_two_weeks": 0, "playtime_at_review": 1629, "last_played": 1722396733, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "russian", "review": "любишь напиваться то долбаного отказа, танцевать как балерина (или тверкать) и добывать золото? Тебе сюда. Только в этой игре ты можешь уменьшится, пердеть взрывом и сразу вырубится от 1 кружки пива! Надоело бухать? Идите танцевать под хорошую музыку! Это тоже надоело? Тогда хватит заниматься фигнёй и идите на задания. Добывать мокрит, нитру, золото, яйца, кристалы - вот твоя главная задача!!! Естественно это не казуальная игра, поэтому ты должен обороняться от толп всяких тварей. Большинство просто ползают и кусают, но есть и стреляющие, непробиваемые, огромные и тд. Самое главное - выполнить миссию и М.О.Л.И. сама доберётся до капсулы. На тебя всем начхать: выживешь - молодец, умерёшь - ну ок. \r\nДля любителей дума самое то. Тут даже у одного класса дробовик как у думгая есть!\r\n\r\nВывод: учите английский.", "timestamp_created": 1719782127, "timestamp_updated": 1719782127, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "168638676", "author": {"steamid": "76561198107523413", "personaname": "Lightbringer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198107523413/", "num_games_owned": 336, "num_reviews": 16, "playtime_forever": 14598, "playtime_last_two_weeks": 36, "playtime_at_review": 7908, "last_played": 1787495886, "avatar": "6796cf53d1b12f7e70b34f2d02f69a41e1de3d81"}, "language": "russian", "review": "[h1] If you don't ROCK AND STONE you ain't comin' home [/h1]\n\nПокупайте, не ошибётесь. Можно играть одному или с друзьями или даже с рандомами.\nОсобый пещерный вайб, мощный шутан, немного хоррора, симулятор свиданий (с пивом и пацанами) и огромная куча юмора с отсылками. Разрабы в эту игру вложили просто нереальное количество любви.\n\n[spoiler] Советую ебашить жуков и роботов под трек We Fell Apart (Hardstyle) [/spoiler]", "timestamp_created": 1719781988, "timestamp_updated": 1719782499, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "168638232", "author": {"steamid": "76561198987718311", "personaname": "Striker", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198987718311/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 27635, "playtime_last_two_weeks": 0, "playtime_at_review": 14622, "last_played": 1784809410, "avatar": "c4b279244e728d2d1cd2d7a6ffbd08bad9e81c65"}, "language": "russian", "review": "Жуки, Пиво, Мужики. что ещё нежно желать?", "timestamp_created": 1719781603, "timestamp_updated": 1719781603, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}