, "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199015053812/", "num_games_owned": 0, "num_reviews": 30, "playtime_forever": 376, "playtime_last_two_weeks": 0, "playtime_at_review": 376, "last_played": 1749989874, "avatar": "3017f64da039e05834f718537fc1fba48efe92e6"}, "language": "russian", "review": "пить пиво и добывать руды это же лучшая игра 10 из 10", "timestamp_created": 1784125905, "timestamp_updated": 1784125905, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "230534615", "author": {"steamid": "76561198350775639", "personaname": "✞Uri Gavriel✞", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198350775639/", "num_games_owned": 443, "num_reviews": 92, "playtime_forever": 125, "playtime_last_two_weeks": 0, "playtime_at_review": 125, "last_played": 1744014152, "avatar": "c56029ab67fd6ef9cce435804c47642f960dd599"}, "language": "russian", "review": "I recommend\nRock and Stone, brothers! This is literally the best four-player co-op shooter I've ever played. Everything is perfect: the procedurally generated caves that never repeat, the complete destructibility of the environment, and the four completely unique classes of dwarves that complement each other perfectly. The shooting is juicy, the guns feel massive, and the atmosphere of the dark depths of Hoxxes is 10 out of 10. But the true gem of this game is the community. There's no toxicity here. You join random players, press the \"V\" button, your dwarf shouts \"Rock and Stone!\", and the entire team instantly becomes your best friends. The developers are saintly people, all updates are free, and the battle pass doesn't require a single penny of real money. If you're looking for a game to have fun with friends or decent workers, don't hesitate to grab it. Management will be pleased!", "timestamp_created": 1784124517, "timestamp_updated": 1784124517, "voted_up": true, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.583333313465118408", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "230520376", "author": {"steamid": "76561198026130822", "personaname": "Darrel [UA]", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198026130822/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 11333, "playtime_last_two_weeks": 2736, "playtime_at_review": 2121, "last_played": 1787955262, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "russian", "review": "чудова гра для компанії", "timestamp_created": 1784109270, "timestamp_updated": 1784109270, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "hardware": {"system_ram": "32617", "os": "Windows 11", "cpu_name": "Intel(R) Core(TM) i7-8750H CPU @ 2.20GHz", "adapter_description": "NVIDIA GeForce RTX 2070", "vram_size": 8006}, "reactions": []}]}