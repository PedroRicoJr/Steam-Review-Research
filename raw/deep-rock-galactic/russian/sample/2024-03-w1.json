eactions": []}, {"recommendationid": "160139549", "author": {"steamid": "76561198318450130", "personaname": "Atamanchuuuuuuuuuk", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Atamanchuk27/", "num_games_owned": 362, "num_reviews": 17, "playtime_forever": 53696, "playtime_last_two_weeks": 0, "playtime_at_review": 30982, "last_played": 1785442806, "avatar": "1df3535a6f4c9bcf76d310fff46700d18b98412c"}, "language": "russian", "review": "\r\n⠀⠀⠀░█▀▀█⠀░█▀▀▀█⠀░█▀▀█⠀░█─▄▀⠀　⠀⠀\r\n⠀⠀⠀░█▄▄▀⠀░█──░█⠀░█───⠀░█▀▄─⠀　⠀⠀\r\n⠀⠀⠀░█─░█⠀░█▄▄▄█⠀░█▄▄█⠀░█─░█⠀　⠀⠀\r\n⠀⠀⠀⠀⠀⠀─█▀▀█⠀░█▄─░█⠀░█▀▀▄⠀　\r\n⠀⠀⠀⠀⠀⠀░█▄▄█⠀░█░█░█⠀░█─░█⠀　\r\n⠀⠀⠀⠀⠀⠀░█─░█⠀░█──▀█⠀░█▄▄▀⠀　\r\n░█▀▀▀█⠀▀▀█▀▀⠀░█▀▀▀█⠀░█▄─░█⠀░█▀▀▀⠀\r\n─▀▀▀▄▄⠀─░█──⠀░█──░█⠀░█░█░█⠀░█▀▀▀⠀\r\n░█▄▄▄█⠀─░█──⠀░█▄▄▄█⠀░█──▀█⠀░█▄▄▄", "timestamp_created": 1709938731, "timestamp_updated": 1709938731, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.47826087474822998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "160137969", "author": {"steamid": "76561199246533656", "personaname": "mak1nt0sh", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199246533656/", "num_games_owned": 41, "num_reviews": 10, "playtime_forever": 19986, "playtime_last_two_weeks": 0, "playtime_at_review": 15062, "last_played": 1786133763, "avatar": "0e18f823306b3b7f6367f9bea91b7c16564f19cd"}, "language": "russian", "review": "что я понял за 250 часов..эта игра вероятно , имеет лучшее комьюнити , я нигде не видел такой сплачености и отзывчивости! в этой игре аж 96 билдов на один класс (в купе со всеми оверклоками ), индивидуальность каждого класса и их подгон под каждый из других поражает, стоит так же отметить и сам геймплей , где очень обширная фауна начиная от летающих заканчивая стреляющими в тебя растениями. НО! спустя всего часов 10 , ты перестанешь путаться и начнешь строить тактику против абсолютно каждого моба вплоть до последнего. еще стоит выделить разработчиков которые всегда прислушиваются к своим игрокам , добавляют разные интересности вплоть до реакции ведущего вас по пещере оператора на разного рода раздражатели по типу:\"we're rich!\". но больше всего что мне принесло удовольствие , это на минуточку БЕСПЛАТНЫЙ БАТТЛ ПАС МАТЬ ЕГО , в котором вещи остаются навсегда а не на один сезон. а если кто то недоволен насчет доната то я скажу что он исключительно косметический и никак не влияет на геймплей , Да и это скорее поддержка разработчиков которые для пака supporter 2 сделали благодарность в виде хлопушки и конфетти у стойки бара когда заказываешь особое пиво из пака! по итогу могу сказать что эту игру можно брать даже не на скидке ,чисто что бы поддержать разаботчиков , тк они, по всей видимости одни из не многих кто действительно любит свою аудиторию и игроков. очень люблю эту игру и буду играть в нее до потери пульса. 100/10\r\n\r\nFOR ROCK AND STONE!", "timestamp_created": 1709937224, "timestamp_updated": 1736200184, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "160137939", "author": {"steamid": "76561199088071949", "personaname": "mengentel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199088071949/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 438, "playtime_last_two_weeks": 0, "playtime_at_review": 92, "last_played": 1723229823, "avatar": "9aaef5f98782025764f37921b2b92b10415253a4"}, "language": "russian", "review": "deep ♥♥♥♥ galactic", "timestamp_created": 1709937199, "timestamp_updated": 1709937199, "voted_up": true, "votes_up": 0, "votes_f