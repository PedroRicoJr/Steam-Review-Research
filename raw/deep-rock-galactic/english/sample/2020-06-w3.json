commendationid": "71247572", "author": {"steamid": "76561198042209603", "personaname": "Protogazer", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/protogazer/", "num_games_owned": 436, "num_reviews": 29, "playtime_forever": 3304, "playtime_last_two_weeks": 0, "playtime_at_review": 1919, "last_played": 1689738860, "avatar": "5d6f0e9f0e30df20c4daf8fdf474cc29f970c0ca"}, "language": "english", "review": "There is so much passion from this community and the developers that it instantly made this game a classic for me and my friends. With time, this statement has only become more true, aging like the finest wine. These devs have not only updated and added to the core gameplay missions, they've kept to their promise of cosmetic-only DLC with every substantial release being completely free. These guys are absolutely cracked!\n\nBefore even playing one level, I already knew it'd be a hit in my friend group. I ended up buying two copies to entice others to play. They've since purchased copies for more of our friends, it's just that cool. If you're looking for a fun co-op game to play with some good friends, there's no going wrong with Deep Rock Galactic.", "timestamp_created": 1592954813, "timestamp_updated": 1669155075, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "71246695", "author": {"steamid": "76561198799340476", "personaname": "CGFrog", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198799340476/", "num_games_owned": 306, "num_reviews": 17, "playtime_forever": 4216, "playtime_last_two_weeks": 0, "playtime_at_review": 2362, "last_played": 1707619596, "avatar": "c3015b2f7e3579179889e89d63ba67985c6a70a0"}, "language": "english", "review": "Fan