}, {"recommendationid": "124299848", "author": {"steamid": "76561197971660664", "personaname": "TeamAquaHQ", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197971660664/", "num_games_owned": 58, "num_reviews": 8, "playtime_forever": 2574, "playtime_last_two_weeks": 0, "playtime_at_review": 945, "last_played": 1723398954, "avatar": "388df25897e219134e45b3dd38b48b2ffac4540b"}, "language": "english", "review": "COOL GAME :DDDDDDDDDDDDDDDDDDDD", "timestamp_created": 1666567019, "timestamp_updated": 1666567019, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "124299116", "author": {"steamid": "76561198267448973", "personaname": "Unknown_Scientist", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Blagalaga/", "num_games_owned": 184, "num_reviews": 31, "playtime_forever": 15058, "playtime_last_two_weeks": 0, "playtime_at_review": 6954, "last_played": 1775464540, "avatar": "9eecf2ca1f41603af2f5b184b0eb539c259cfba3"}, "language": "english", "review": "DRG is an extremely fun game with an amazing team and community backing it up.\n\nDRG is a game that is just oozing with charm, you can tell the developers care deeply for the wellbeing of this game. The game has this ongoing joke of management just outright hating you and deeming you expendable while you and your fellow coworkers do things out of spite for the company. You can just tell the amount of love poured into this game by these wonderful devs. They even support full on mod support.\n\nThe game is constantly changing, and in such an amazing way. You never know what you're going to find down in the caves of Hoxxes. There are an onslaught of events and bosses down there that you may encounter, which helps break up the game and helps it feel interesting and unpredictable. Things can and will go wrong down there. Things are also constantly being added, with new weapons, events, bosses, and cosmetics all being released for free at no additional cost to the player to constantly give you the incentive to play and constantly be working towards something.\n\nOverall DRG is a game that promotes fun above all, and is definitely worth a try if you enjoy hoard shooters. The game never gets stale since the regular gameplay loop is so satisfying, with a level of randomness that keeps the game from being stale.", "timestamp_created": 1666565628, "timestamp_updated": 1666565628, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "124298459", "author": {"steamid": "76561198069458341", "personaname": "Icarus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/JustIcarus/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4401, "playtime_last_two_weeks": 0, "playtime_at_review": 3831, "last_played": 1722209458, "avatar": "4c0b07a2382f23ded03bb0cc43576d52fd29333e"}, "language": "english", "review": "Rock and Stone Forever!", "timestamp_created": 1666564372, "timestamp_updated": 1666564372, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}