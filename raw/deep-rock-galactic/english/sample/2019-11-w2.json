": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "57244101", "author": {"steamid": "76561198089270228", "personaname": "Deserter17", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198089270228/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 18931, "playtime_last_two_weeks": 0, "playtime_at_review": 8510, "last_played": 1744445801, "avatar": "b8174a0d8fb1c1c2b1043aceb3af733e0b56f717"}, "language": "english", "review": "This game is a great space mining game wherein you fight hordes of enemies. Comparable to the likes of the Vermintide franchise as well as the Left 4 Dead series, this game stacks up to be another great cooperative based game. Gameplay ranges from calm mining to intense combat fighting hordes. It even allows for problem solving as you try to figure out the best approach to grabbing a hard to reach material or the best way to traverse the caverns. Give it a try sometime and you will see how great this game is, although it is always better to play with friends!", "timestamp_created": 1573856914, "timestamp_updated": 1574805542, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.547325074672698975", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": [{"reaction_type": 18, "count": 1}]}]}