r_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "92493189", "author": {"steamid": "76561198009957633", "personaname": "Aaosoth", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198009957633/", "num_games_owned": 245, "num_reviews": 12, "playtime_forever": 5850, "playtime_last_two_weeks": 0, "playtime_at_review": 815, "last_played": 1761208693, "avatar": "957317f496b0da22f9a3f89546a8695b6e704b2d"}, "language": "english", "review": "This game is so much fun. It's badass space dwarves, mining planets and asteroids and slaying waves of alien bugs. The objectives are varied enough that it doesn't feel like you're doing the same thing every mission. \n\nWhile it is possible to play solo, coop feels much better. But if you don't have friends that play, there is a good public match making system so you won't be stuck trying to solo a mission you need. \n", "timestamp_created": 1621809751, "timestamp_updated": 1621809751, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}