ate": "1519804887", "reactions": []}, {"recommendationid": "140130160", "author": {"steamid": "76561198009833858", "personaname": "Arvay6", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Arvay6/", "num_games_owned": 0, "num_reviews": 51, "playtime_forever": 26330, "playtime_last_two_weeks": 0, "playtime_at_review": 25656, "last_played": 1765250994, "avatar": "c736c6e12e3c3a7fc79b8160afaba0121fdaeced"}, "language": "english", "review": "A great co-op shooter to play with friends and amazing mod support. I'd highly recommend if you have buddies to play with, if not though it's going to be a bit more dull like playing vermintide solo.", "timestamp_created": 1686872745, "timestamp_updated": 1686872745, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "140129966", "author": {"steamid": "76561197968549739", "personaname": "Catastrophe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197968549739/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 31842, "playtime_last_two_weeks": 0, "playtime_at_review": 6103, "last_played": 1771786715, "avatar": "3a99a3c6d8258bd6cd82216c2c9c63785197d2ce"}, "language": "english", "review": "Smash minerals with a pick to grab them, explore strange straw-like caves and massive caverns, find items and find or fight to achieve objectives, bring your best dwarf friends or a trusty robot to join you, fight a range of bosses, upgrade your gear and obtain cosmetics, what's not to like?\n\nRock and stone!", "timestamp_created": 1686872378, "timestamp_updated": 1686872378, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.541984736919403076", "comment_count": 0, "steam_purchase": false,