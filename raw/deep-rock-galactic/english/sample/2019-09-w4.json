 []}, {"recommendationid": "55359457", "author": {"steamid": "76561198048301552", "personaname": "Wylbhr", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/wylbhr/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 7373, "playtime_last_two_weeks": 0, "playtime_at_review": 3630, "last_played": 1614476460, "avatar": "478b4dfeadab63e82ba77019b9c15677fde28012"}, "language": "english", "review": "This video game is fun.\n- Characters are entertaining, and there are a boatload of humorous references to other games and media.\n- Gathering resources is enjoyable, and there are quite a few rare/unique spawns that encourage you to search thoroughly in each mission.\n- There is a reasonable amount of enemy diversity, and the game spawns different compositions based on zones and seeds.\n- Different biomes feel unique and help distinguish from one run to another.\n- Difficulty can be scaled to suit your preferred experience.  You can go on a fairly relaxing resource hunt or get punched in the nards by angry bugs as soon as you land.\n- Game offers a lot of upgrades and cosmetics to grind towards.\n- You can play a truly single-player mode with no need for a network connection and can pause the game.\n- The Devs are still adding more content!", "timestamp_created": 1569879633, "timestamp_updated": 1569879684, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "55359231", "author": {"steamid": "76561198112439292", "personaname": "the fella", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/yourpalbeep/", "num_games_owned": 280, "num_reviews": 8, "playtime_forever": 47141, "playtime_last_two_weeks": 0, "playtime_at_review": 11668, "last_played": 1770771696, "avatar": "5a042c20036e79960c2079e7480facf4ec535c3b"}, "language": "english", "review": "Absolutely one of the greatest co-op games on Steam. Criminally underrated. If you like dwarves and horde gameplay similar to L4D, this is the game for you. The music is also great. All around, you can tell that devs really put their hearts and souls into this game.", "timestamp_created": 1569878637, "timestamp_updated": 1569878730, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "55358755", "author": {"steamid": "76561198045315003", "personaname": "Mrmeeseeks", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/MrMeeseeks54/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 29349, "playtime_last_two_weeks": 0, "playtime_at_review": 11416, "last_played": 1766727613, "avatar": "3169549fdb3be572e9b4e2c2d0defa87ec92fdee"}, "language": "english", "review": "This is how 4-Player Co-op should be. Well done Ghost Ship and Coffee Stain.", "timestamp_created": 1569876786, "timestamp_updated": 1569876786, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}