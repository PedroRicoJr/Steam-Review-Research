hor": {"steamid": "76561198275862510", "personaname": "Tuyo", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/986754312/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 2466, "playtime_last_two_weeks": 0, "playtime_at_review": 2466, "last_played": 1595827887, "avatar": "81dddc4124d128ea233d59c7d22464abe3fc4ec7"}, "language": "english", "review": "Reason why I don't recommend this game: It is extremely grindy as the missions are really repetitive. There isn't really much left after you finished the tutorial missions except for the deep dive feature but the grind to get there really puts people off. I spend 30+ hours into this game and it didn't really feel rewarding at all. I even hopped on to public lobbies with really high leveled and promoted people to let them carry my behind but that just felt even more boring.\n\nTLDR: I had more fun kicking barrels and playing hide and seek in the main lobby with my buddy than the missions.", "timestamp_created": 1599596274, "timestamp_updated": 1599598765, "voted_up": false, "votes_up": 5, "votes_funny": 2, "weighted_vote_score": "0.494584172964096069", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}