{"game": "deep-rock-galactic", "language": "english", "appid": 548430, "month": "2020-11", "window": 1, "start_date": 1604188800, "end_date": 1604879999, "month_true_total": 6802, "quota": 8, "returned": 8, "pulled_at": "2026-08-29 21:21:53 Pacific Daylight Time", "reviews": [{"recommendationid": "78970221", "author": {"steamid": "76561198407561813", "personaname": "LordShrekM8", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/lordshrekm8/", "num_games_owned": 83, "num_reviews": 12, "playtime_forever": 90030, "playtime_last_two_weeks": 0, "playtime_at_review": 8469, "last_played": 1765161345, "avatar": "c8a476fd1f2d4c04b5a9e5c3d3721985304ca110"}, "language": "english", "review": "Very fun, very engaging. Non stop action with tons of thrill and suprises! Totally recommend if you like blowing ♥♥♥♥ up.", "timestamp_created": 1604878149, "timestamp_updated": 1604878149, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "78968547", "author": {"steamid": "76561197979315871", "personaname": "Schnappi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197979315871/", "num_games_owned": 0, "num_reviews": 49, "playtime_forever": 5897, "playtime_last_two_weeks": 0, "playtime_at_review": 2482, "last_played": 1705437863, "avatar": "add8564167eeb6b51bc62f645a1f6c96f20ed808"}, "language": "english", "review": "a great combination of mining, resource management, and teamwork shooting. This is honestly one of my favorite games to be (officially) released in 2020. Beware that there are sometimes bugs in the random map generation that can force a restart, like no ammo (resource) spawning.", "timestamp_created": 1604875326, "timestamp_updated": 1604875326, "voted_up