pp_release_date": "1519804887", "reactions": [{"reaction_type": 17, "count": 1}]}, {"recommendationid": "78965652", "author": {"steamid": "76561198132514736", "personaname": "VinierSpark", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Flippy_Wiggler/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 27802, "playtime_last_two_weeks": 45, "playtime_at_review": 1872, "last_played": 1787712087, "avatar": "c29d62a3f6b3be6bb9d19998a2f1ca1f939293b8"}, "language": "english", "review": "real good", "timestamp_created": 1604870940, "timestamp_updated": 1604870940, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "78964881", "author": {"steamid": "76561198043338815", "personaname": "Keeper of Rocks", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198043338815/", "num_games_owned": 45, "num_reviews": 3, "playtime_forever": 9543, "playtime_last_two_weeks": 0, "playtime_at_review": 2782, "last_played": 1767835695, "avatar": "814477ad55649cae7c45d0437114280d865587fe"}, "language": "english", "review": "Having worked as a Mine Geologist across diverse mines in North and South America, I deeply appreciate the meticulous attention to detail that the developers Ghost Ship have poured into Deep Rock Galactic. From the intricately crafted cave systems to the myriad of minerals with their distinct crystal habits and properties, every aspect of Hoxxes IV feels authentically immersive.\n\nMoreover, the range of biomes and the diverse array of enemies encountered throughout the game add layers of excitement and challenge to the exploration experience.\n\nThe inclusion of four distinct player classes further enhances the gameplay, catering to various playstyles and mechanics. Whether you're a casual player enjoying a brief session each week or a hardcore enthusiast diving in for hours every day, Deep Rock Galactic offers something for everyone.\n\nWith its dynamic objectives, regular updates, and ever-changing cave systems, Deep Rock Galactic guarantees a fantastic experience that will keep players captivated as they delve deeper into the mysteries of Hoxxes IV, whether solo or with friends.", "timestamp_created": 1604869886, "timestamp_updated": 1714746298, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "78964778", "author": {"steamid": "76561198073864264", "personaname": "SirYumYumms", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198073864264/", "num_games_owned": 0, "num_reviews": 18, "playtime_forever": 43635, "playtime_last_two_weeks": 0, "playtime_at_review": 10813, "last_played": 1785551047, "avatar": "7d1d81711e9ca25e931ff56351ad26faaca7acf3"}, "language": "english", "review": "Great game with friends. Plenty of custom weapons, skins, and missions to keep you busy and addicted for hours.", "timestamp_created": 1604869728, "timestamp_updated": 1604869728, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "78964650", "author": {"steamid": "76561198409905854", "personaname": "TwoInchKotat", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198409905854/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 460