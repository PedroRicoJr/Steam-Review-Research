61198309717186", "personaname": "КИЦЮСЯ", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198309717186/", "num_games_owned": 7, "num_reviews": 4, "playtime_forever": 3005, "playtime_last_two_weeks": 0, "playtime_at_review": 245, "last_played": 1765140026, "avatar": "209f0827dca8065e971c1ec5c030165c8b3f2538"}, "language": "english", "review": "sticks and stones may break my bones, but beer will never hurt me", "timestamp_created": 1723160462, "timestamp_updated": 1723160462, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "171714076", "author": {"steamid": "76561198253611176", "personaname": "robert", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198253611176/", "num_games_owned": 93, "num_reviews": 1, "playtime_forever": 10808, "playtime_last_two_weeks": 0, "playtime_at_review": 8006, "last_played": 1782029745, "avatar": "65afd9fb019514079f84a18de2ccddf398be9309"}, "language": "english", "review": "Did I hear a Rock and Stone?", "timestamp_created": 1723159340, "timestamp_updated": 1723159340, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "171713019", "author": {"steamid": "76561199554028793", "personaname": "Siegfried", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199554028793/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 10780, "playtime_last_two_weeks": 128, "playtime_at_review": 4576, "last_played": 1787960287, "avatar": "46b5b63f5fede65f8cb24bc1f2a127ceaac7c244"}, "language": "english", "review": "I'm a dwarf since 2018 have around 600 hours on the Xbox/Windows Version of the game. I still love the game, even after six years. The game is pure fun, even without friends. The community is super friendly and supportive. I can count on one hand how many bad people I met in all this time. Two, two people in over 600 hours, that's incredible. The devs really love what they are doing and you can feel that. They talk with the community, ask for their feedback and take that into consideration. The gameplay, the mission design and customisation is fun and satisfying. The DLC's are fair priced and look really good. The updates are all free and change the gameplay in many fun ways. At least most of the time (looking at you OG Stingtail). The season passes are also completely free and you can even unlock older Cosmetics via gameplay, if you missed a season. The game is imo a shimmering beakon in todays gaming landscape and I hope we can play this masterpiece for many more years.\n\nLet's make Karl proud ! Rock and Stone !", "timestamp_created": 1723157822, "timestamp_updated": 1723158896, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}