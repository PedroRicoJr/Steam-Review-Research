author": {"steamid": "76561197982379784", "personaname": "Izzles", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/tokillthelight/", "num_games_owned": 293, "num_reviews": 14, "playtime_forever": 32420, "playtime_last_two_weeks": 0, "playtime_at_review": 4524, "last_played": 1659357270, "avatar": "67c97ce317fdd2e95b025600d6d8019742be5674"}, "language": "english", "review": "Gotta love all the free updates, way more than any AAA game would give you for free.. perhaps even more than you'd get with paid DLC. Super fun 4 player co-op game, highly recommended.", "timestamp_created": 1560591857, "timestamp_updated": 1560591857, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "51232513", "author": {"steamid": "76561198096842611", "personaname": "THANOSCAR5", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198096842611/", "num_games_owned": 0, "num_reviews": 35, "playtime_forever": 9706, "playtime_last_two_weeks": 0, "playtime_at_review": 1362, "last_played": 1721451496, "avatar": "f065aa8972ae4d7c54a1d551571567983e3d4937"}, "language": "english", "review": "Lovely style, decent community, good difficulty, fun gameplay.\n\nConsider this game if you are into PvE FPS, this one makes you feel like a badass sometimes. Lower difficulties will get stagnant after a while as gameplay mostly consists of remembering to mash all of the buttons you have available to you, but thankfully the highest difficulties are pretty intense, and you don't always expect to succeed in a mission. Even on lower difficulties every now and then some RNG events will combine to create some \"wth is happening\" moments (just today I had sandstorm, +exploder swarm modifier, +swarm, +called drop pod on hazard 4, it was pretty crazy).\n\nGood stuff.\n\nFor a early access game too it has a lot of content, much more than is typical which is great.", "timestamp_created": 1560575491, "timestamp_updated": 1560575491, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.514422774314880371", "comment_count": 4, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "51232072", "author": {"steamid": "76561197972377165", "personaname": "Lockdonnen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Lockdonnen/", "num_games_owned": 1678, "num_reviews": 123, "playtime_forever": 23032, "playtime_last_two_weeks": 0, "playtime_at_review": 2031, "last_played": 1779512964, "avatar": "584d168a4d6601118a32458913281cdec36fe791"}, "language": "english", "review": "This is the perfect game!\nI'm currently able to play this with my sister and her other half; Sister wants to play FPS games but her aim is, and I quote \"total crap\" so she isn't big into every-day shooters. This being a game about mining/gathering however gives her a great angle to be super good at one aspect of this game The other half enjoys the typical Calling Of Battlefields 7: Gotta Shoot a Man. So he is a happy boi when the music ramps up and a waves of huge bugs come munching for our faces.\nThen there is me who goes Engi and enjoys being able to support my sister's mining with platforms and able to help make choke points with the turret and shotgun.\n\nRuns fantastic on Linux through Steams Proton.", "timestamp_created": 1560572838, "timestamp_updated": 1560572838, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.530201315879821777", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}