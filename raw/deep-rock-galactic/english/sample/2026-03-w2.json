 "220786239", "author": {"steamid": "76561198152203737", "personaname": "Scooby-Louby", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198152203737/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 12107, "playtime_last_two_weeks": 0, "playtime_at_review": 8111, "last_played": 1783969448, "avatar": "8b84adbdb97b0f57819150d36cc300715d8ba5c5"}, "language": "english", "review": "Great game to play with friends.", "timestamp_created": 1773617629, "timestamp_updated": 1773617629, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "220784170", "author": {"steamid": "76561198261487610", "personaname": "harley", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/thisismypawnshop_/", "num_games_owned": 172, "num_reviews": 32, "playtime_forever": 6860, "playtime_last_two_weeks": 0, "playtime_at_review": 2524, "last_played": 1786157470, "avatar": "3300631191083db1433718c106cde2edd5dccc36"}, "language": "english", "review": "I've played my fair share of the game, most of my hours are on Xbox. To put it simply, it's a fun game. It's one of those types of games where it'll suck me in until I get burned out on it, and then I drop it for another few months before deciding \"Oh hey, haven't played that in a while\" thus having my cycle continue. It's got a relatively nice community, I personally haven't had any toxic experiences. Some of the missions feel a little repetitive and just not a whole lot of fun (I'm not a fan of salvage missions, sorry) and sometimes missions can feel like they go on for a little too long. There's a bit of jank, mostly in trying to climb up ledges, but it works well enough. The random map generation isn't too bad. Sometimes it can really screw you over, although it's rare and most cave generation is fine.\n\nOver time I've eventually come to enjoy playing solo more than online. It's a lot more relaxed and suits my playstyle better than playing with others. Regardless, it's still one of the best co-op games on Steam. It's not for everyone, but it's fun.", "timestamp_created": 1773615330, "timestamp_updated": 1774227547, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "220783940", "author": {"steamid": "76561199108111785", "personaname": "nothin.", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199108111785/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 5486, "playtime_last_two_weeks": 0, "playtime_at_review": 3562, "last_played": 1784770145, "avatar": "c2cdc95869dc17f0aed63f7e91020c5a3cf74eec"}, "language": "english", "review": "GOATED", "timestamp_created": 1773615073, "timestamp_updated": 1773615073, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}