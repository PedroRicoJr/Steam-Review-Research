commendationid": "50140165", "author": {"steamid": "76561198143340117", "personaname": "Kyosw", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Kyosw/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 12587, "playtime_last_two_weeks": 0, "playtime_at_review": 4035, "last_played": 1760917967, "avatar": "4618d2e3ddf4b1316f78fb87f71622f3fa890f1f"}, "language": "english", "review": "The game is fantastic. The only problem is the bug called \"Detonator\". It is a massive Exploder bug that creates explosions that cover half the map and kills no less than three people with every explosion. Something needs to be done about that one. The rest of the bug varieties make it a challenge. This one is so powerful that there is no counter to it, especially in an icy biome where you can only walk because of the thick snow since outrunning it is your only hope.", "timestamp_created": 1555302274, "timestamp_updated": 1555302274, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}