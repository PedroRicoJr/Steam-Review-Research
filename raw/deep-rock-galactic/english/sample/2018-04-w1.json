nid": "41357911", "author": {"steamid": "76561198156118014", "personaname": "chocolate thug", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/fabfje/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 5843, "playtime_last_two_weeks": 0, "playtime_at_review": 1030, "last_played": 1673643431, "avatar": "53977823eede2ee926bb25a26b3eb136b6a03a50"}, "language": "english", "review": "Pretty cool. me and the boys had alot of fun with it!", "timestamp_created": 1523178104, "timestamp_updated": 1523178104, "voted_up": true, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.583333313465118408", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "41356261", "author": {"steamid": "76561198338852912", "personaname": "Liayda", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/liayda/", "num_games_owned": 234, "num_reviews": 2, "playtime_forever": 1364, "playtime_last_two_weeks": 0, "playtime_at_review": 464, "last_played": 1642368223, "avatar": "73e89f24523f0d20e5191049bdc7971b22e2807b"}, "language": "english", "review": "Streamed on: https://www.twitch.tv/liayda \n\n\nDeep Rock Galactic is by far one of the most fun and unique Indie games I have ever played! \n\n\nI received 4 codes and gave 3 to friends of mine to play with. In game voice chat was offered but we preferred to use Discord. I did like that there was that option however. The graphics are stupendous and the game itself is seemingly very stable for early access. I did have an issue at the beginning but restarting the game fixed it. The wall climbing is a little funny but I feel like it adds some extra charm. There are a bunch of easter eggs (hi Rob!) as well, so definitely spend time exploring and hitting things with your pick axe. \n\nAll in all, I would definitely recommend, it is worth a $25 purchase.", "timestamp_created": 1523170201, "timestamp_updated": 1523170201, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "41353911", "author": {"steamid": "76561198383948432", "personaname": "SangheiliB01", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198383948432/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 96899, "playtime_last_two_weeks": 0, "playtime_at_review": 3425, "last_played": 1778717801, "avatar": "13308bb0a57e48e782c18e8aeefd634f16f6a6be"}, "language": "english", "review": "After playing the game for 2 years, I can honestly say I am proud to support & play this game.  Deep Rock Galactic is as big & loved as it should be.  With lots of replay-ability, great action & humor & an environment that rewards those who enjoy to explore.  Deep Rock has something for everyone & its an absolute must-play.  Its still getting bigger & more awesome with every update & it deserves its equally awesome community & developers.  Not much left to say, ROCK & STONE FOREVER!!!", "timestamp_created": 1523157734, "timestamp_updated": 1588181568, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}]}