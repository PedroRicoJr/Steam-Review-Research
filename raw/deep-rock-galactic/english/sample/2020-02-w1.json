te": "1519804887", "reactions": []}, {"recommendationid": "63185737", "author": {"steamid": "76561198324058229", "personaname": "Stellar Flare", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198324058229/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 20684, "playtime_last_two_weeks": 0, "playtime_at_review": 527, "last_played": 1675314026, "avatar": "c8af4bdfd88cd5b3fe3330ddb9d2de4c50c3bb68"}, "language": "english", "review": "This game rules and is an absolute blast, but the entire framework of the game can change from patch to patch.\n\nSkins and perks might be added in one patch then removed in the next. Even if they are very helpful like a double jump, it might get taken out because it 'doesn't fit with the developer's vision.' \n\nA game should be fun first and foremost. Adding more mobility never made a game worse. Giving players way to flavour their experience never made a game worse. \n\nIf you're interested in this, I would say that you should wait until the full release, at which point it will hopefully be more consistent and you can make a more informed decision about what the game is.", "timestamp_created": 1581202131, "timestamp_updated": 1581202131, "voted_up": false, "votes_up": 19, "votes_funny": 1, "weighted_vote_score": "0.483993858098983765", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1519804887", "reactions": []}, {"recommendationid": "63184240", "author": {"steamid": "76561198300958245", "personaname": ".Neurogenesis", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198300958245/", "num_games_owned": 121, "num_reviews": 19, "playtime_forever": 19809, "playtime_last_two_weeks": 0, "playtime_at_review": 2516, "last_played": 1785324970, "avatar": "929163d9b4e6da6b5ceeb3792a13b03fb13a4332"}, "language": "english", "review