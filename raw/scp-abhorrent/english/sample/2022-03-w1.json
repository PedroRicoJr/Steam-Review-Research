rue, "votes_up": 8, "votes_funny": 1, "weighted_vote_score": "0.503225803375244141", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1647142140", "reactions": [{"reaction_type": 3, "count": 1}]}, {"recommendationid": "112105387", "author": {"steamid": "76561198145038967", "personaname": "Old - Not using anymore", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198145038967/", "num_games_owned": 0, "num_reviews": 83, "playtime_forever": 45, "playtime_last_two_weeks": 0, "playtime_at_review": 5, "last_played": 1647255114, "avatar": "dadef3c2eb7ce206bcf0c39ac9395c7a5bd1b620"}, "language": "english", "review": "Review for patch 1.3.\n\nOriginally I didn't recommend this game, primarily because I couldn't see anything.\nApparently, some monitors are darker, which made the game unplayable on my computer.\n\nAs you can see from the comments to my review, the developers quickly released a patch fixing this issue using a brightness slider (can be switched once in a game) that made the game much better.\n\n\nI didn't finish it yet, but so far I enjoyed it.:D", "timestamp_created": 1647172582, "timestamp_updated": 1647256026, "voted_up": true, "votes_up": 17, "votes_funny": 1, "weighted_vote_score": "0.661056041717529297", "comment_count": 3, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1647142140", "reactions": []}, {"recommendationid": "112091003", "author": {"steamid": "76561198277601104", "personaname": "Mitochondria", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198277601104/", "num_games_owned": 43, "num_reviews": 3, "playtime_forever": 9, "playtime_last_two_weeks": 0, "playtime_at_review": 9, "last_played": 1647152792, "avatar": "f7ba59eb5b819f7645