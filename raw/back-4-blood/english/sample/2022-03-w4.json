tes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.527976453304290771", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": [{"reaction_type": 6, "count": 1}]}, {"recommendationid": "113136385", "author": {"steamid": "76561198298575182", "personaname": "wangmeng.vang", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/wmengv/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 5737, "playtime_last_two_weeks": 0, "playtime_at_review": 2875, "last_played": 1674890535, "avatar": "3f9ce7c86d315d326385ea05f1378a1525107e3d"}, "language": "english", "review": "Fun, great with a full team of reliable players", "timestamp_created": 1648762331, "timestamp_updated": 1648762331, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "113136131", "author": {"steamid": "76561198340073331", "personaname": "Step Bro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TacosAndNutella/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 12992, "playtime_last_two_weeks": 0, "playtime_at_review": 12210, "last_played": 1708130874, "avatar": "c9932e7affebead4e3105672f0605bba8edd30e1"}, "language": "english", "review": "After playing for 200 hrs I can finally make this review. This game is NOT for anyone looking for L4D3, it's not supposed to be related to L4D in any way shape or form, I'm unsure why SO many people b*tch and moan \"its not L4D3 it sucks\". Majority of people complaining have less than 20 hrs in-game. If you want a mindless zombie shooter that's fun to play while high with friends than this is a great game to pick up, but NOT at it's current price. I love this game for what it is but if I could I would have never paid $140 for the ultimate edition. This game is worth $30 maybe.. With all that said the game is fun but buy it when it goes on sale so you don't waste money like I did.", "timestamp_created": 1648761916, "timestamp_updated": 1648761916, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.487671226263046265", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "113134202", "author": {"steamid": "76561198075795751", "personaname": "datadmin", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/datadmin/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 2520, "playtime_last_two_weeks": 0, "playtime_at_review": 2512, "last_played": 1649276468, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "Much too expensive for what it offers.\nYou can play it through in 5-6 hours or even faster.\nBadly balanced, partially unplayable depending on your \"corruption cards\".\nCard system is nonsense.\nGerman translation horrible.\nUsability and Menu flow really bad.\nBots incredible stupid.", "timestamp_created": 1648758857, "timestamp_updated": 1648758857, "voted_up": false, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.552845537662506104", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}