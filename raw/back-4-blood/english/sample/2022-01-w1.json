_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "107624040", "author": {"steamid": "76561199071868613", "personaname": "Liam Swag Balls", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/liamswagballs/", "num_games_owned": 170, "num_reviews": 29, "playtime_forever": 521, "playtime_last_two_weeks": 0, "playtime_at_review": 521, "last_played": 1641679785, "avatar": "18cf9e93edbe79213f24fd277a0c8fc05e9ec68f"}, "language": "english", "review": "the card system sucks, literally just a downgrade from left for dead 2. I'm not even sure how this is possible considering it was made by the same people almost 10 years. complete ass", "timestamp_created": 1641679840, "timestamp_updated": 1641679840, "voted_up": false, "votes_up": 7, "votes_funny": 0, "weighted_vote_score": "0.528945803642272949", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "107623686", "author": {"steamid": "76561198834563930", "personaname": "GnarWhal5-0", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198834563930/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 6862, "playtime_last_two_weeks": 0, "playtime_at_review": 1001, "last_played": 1666649285, "avatar": "b2599250136ff92c045c5cff1897ea321666f6e2"}, "language": "english", "review": "GAEM GUUD", "timestamp_created": 1641679438, "timestamp_updated": 1641679438, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.482195734977722168", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "107622691", "author": {"steamid": "