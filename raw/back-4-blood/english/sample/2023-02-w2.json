lease_date": "1634050800", "reactions": []}, {"recommendationid": "132932534", "author": {"steamid": "76561199017880208", "personaname": "Wund3rBr3d - Study Flat Earth", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199017880208/", "num_games_owned": 322, "num_reviews": 3, "playtime_forever": 19, "playtime_last_two_weeks": 0, "playtime_at_review": 19, "last_played": 1660766076, "avatar": "cc89dd9458f32aa204d3c82fe69352546406086d"}, "language": "english", "review": "First time I opened the game I got a big message saying that all voice comms were recorded. Honestly, was so turned off by that, that I have had no interest in returning to this game. Happy I got this in a bundle and didn't pay full price.", "timestamp_created": 1676498347, "timestamp_updated": 1676498347, "voted_up": false, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.492528706789016724", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "132919951", "author": {"steamid": "76561198381931425", "personaname": "FriendlyUmbra", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198381931425/", "num_games_owned": 0, "num_reviews": 147, "playtime_forever": 3338, "playtime_last_two_weeks": 0, "playtime_at_review": 3338, "last_played": 1660954273, "avatar": "31318039e629316caf7decb49adfc32c4be2c553"}, "language": "english", "review": "I really wish I could have enjoyed this game, the gunplay feels amazing, and the idea of a modern left4dead like was such a nice thought.\n\nBut alongside the horrible community support (No workshop, and anti consumer practices) the balancing for this game got worse as they updated it from the beta, I wish I did not spend 100 dollars on this game with my friends, cause its horrible balance pushed us all away from it, and now this game sits in my library as a reminder of what could have been if the devs actually cared like they claimed.\n\nOh and as of February 2ed 2023 they have stopped supporting the game, so this is the final product that Turtle Rock Studios has to offer, and it is a sad shell of what they were able to do with valve with left4dead, it has so many short comings that the only way to properly understand them all is by watching one of the many videos documenting this gas fire of a disappointment.\n\nIf this game ever goes on sell for like 5 bucks for the ultimate edition, I would say its worth it if you can get your friends to pick it up too, but as it is, go get a indie game by someone who actually cared about their work.", "timestamp_created": 1676495055, "timestamp_updated": 1676495055, "voted_up": false, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.568353414535522461", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "132919540", "author": {"steamid": "76561199111696939", "personaname": "Artainius", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/notoriouslyshadythug/", "num_games_owned": 205, "num_reviews": 56, "playtime_forever": 1745, "playtime_last_two_weeks": 0, "playtime_at_review": 545, "last_played": 1698714913, "avatar": "b8abd274ab68b6589536960fb7cbf7a1f4863966"}, "language": "english", "review": "The mom is very hot", "timestamp_created": 1676494541, "timestamp_updated": 1676494541, "voted_up": true, "votes_up": 2, "votes_funny": 1, "weighted_vote_score": "0.493934661149978638", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "132916137", "auth