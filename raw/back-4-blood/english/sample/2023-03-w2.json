": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "134721275", "author": {"steamid": "76561198025483598", "personaname": "TruBluZero", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TruBlu0/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 4599, "playtime_last_two_weeks": 0, "playtime_at_review": 1038, "last_played": 1682883174, "avatar": "393af569d8813d0cd6821e093df8d20be5a10bbc"}, "language": "english", "review": "Back 4 Blood is a great game undermined by its learning curve with the deck system and its presence on both console's' subscription services. I love that it is available to so many people, but playing the main campaign online with cross play attracts many idiots and ignorant newbies who are simply cancer to this game's online play. I am proud of the many individuals living without brains that play online. If you are ever shot in the head, having a stroke, or suffering from a massive tumor in your grey matter, jump online in this game immediately and you will still be running circles around about 80 percent of the cross play crowd.\n\n If you ever enjoyed Left 4 Dead, try it out as a variation of the series, not a successor. It is truly a shame that Turtle Rock joined the bandwagon of abandoning games with unfulfilled promises in 2023. PvP is sorely lacking and Swarm mode was DOA.", "timestamp_created": 1678915330, "timestamp_updated": 1689220843, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}