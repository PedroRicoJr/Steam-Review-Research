rily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "104879406", "author": {"steamid": "76561197966068762", "personaname": "JimBradley", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197966068762/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 1497, "playtime_last_two_weeks": 0, "playtime_at_review": 1432, "last_played": 1641137708, "avatar": "5d2541364dbdc0bc1b2d8311b2d2c02780b5252b"}, "language": "english", "review": "Basically L4D2 so if you like that you will probably like this. Gunplay feels a bit lighter though. Has more RPG customizations with their card system which is a good addition. More usable items and guns and attachments for variety. The campaign has a good length. Hopefully they will update with more content for versus as people will probably get bored of the current mode fast or not interested at all. The price is steep for the current state, get it on a sale if you're not in a hurry.", "timestamp_created": 1638298895, "timestamp_updated": 1638298895, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.500392138957977295", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "104878219", "author": {"steamid": "76561199190051180", "personaname": "Tiekvbalod", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/basescumessi69/", "num_games_owned": 24, "num_reviews": 1, "playtime_forever": 869, "playtime_last_two_weeks": 0, "playtime_at_review": 608, "last_played": 1646419918, "avatar": "49e4318ab9e3fd545faa77725b9ce11a14afd2ea"}, "language": "english", "review": "Best game!!!", "timestamp_created": 1638298306, "timestamp_updated": 1638298306, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment