{"game": "back-4-blood", "language": "english", "appid": 924970, "month": "2022-10", "window": 4, "start_date": 1666569600, "end_date": 1667260799, "month_true_total": 520, "quota": 5, "returned": 5, "pulled_at": "2026-08-29 20:49:38 Pacific Daylight Time", "reviews": [{"recommendationid": "124745010", "author": {"steamid": "76561198038126750", "personaname": "asasinedude", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198038126750/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 8882, "playtime_last_two_weeks": 0, "playtime_at_review": 6021, "last_played": 1723925131, "avatar": "d86f58087d4a6bcd46f78055a496c7881debf0ad"}, "language": "english", "review": "A game where you get to blast hordes of undead! It scratches that \"left-4-dead\" itch I've had for a while. It has a strangely unique card system which allows you to buff up your characters to make them stronger! Want to be a heavy damage dealer who can one-shot bosses? There are cards for that! Want to be a heavy frontline tank who can never die? There are cards for that!! Want to be the flash and move so fast that you get to the safehouse before your team even leaves the first area? There are cards for that!!!\n\nAll in all, I think once you get used to the decks and how they apply to your character in game, you can have some serious amounts of fun!", "timestamp_created": 1667258174, "timestamp_updated": 1667258174, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "124740922", "author": {"steamid": "76561198295758260", "personaname": "Johnny Silverhand", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198295758260/", "num_games_owned": 83, "num_reviews": 35, "pl