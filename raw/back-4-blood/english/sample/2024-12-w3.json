otes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "183519640", "author": {"steamid": "76561197986381506", "personaname": "τemplar", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/cannaclaus/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 207, "playtime_last_two_weeks": 0, "playtime_at_review": 155, "last_played": 1736825812, "avatar": "4c555ad0eef2cb39c499d44245dc5e8a836f15ef"}, "language": "english", "review": "Very good game. Don't listen to the bad comments that's its just a copy.\nBuy the game at a good deal and try it out for yourself.", "timestamp_created": 1734994545, "timestamp_updated": 1734994545, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "183519518", "author": {"steamid": "76561198022397549", "personaname": "scas", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198022397549/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 376, "playtime_last_two_weeks": 0, "playtime_at_review": 376, "last_played": 1722551133, "avatar": "4570abe9a4d5a4099c084a61c150fb0f8b467013"}, "language": "english", "review": "Bring Back Evolve!!!\n\nBack 4 Blood is alright, get it for a discount but not the full price.", "timestamp_created": 1734994422, "timestamp_updated": 1734994422, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "183518623", "author": {"steamid": "76561198000085240", "personaname": "Sleve_McDichael", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/bistrian/", "num_games_owned": 186, "num_reviews": 11, "playtime_forever": 29, "playtime_last_two_weeks": 0, "playtime_at_review": 29, "last_played": 1734748563, "avatar": "a627d3c0e9fe310d6ce9538c3594376522acbb00"}, "language": "english", "review": "Bad game play Left 4 dead", "timestamp_created": 1734993617, "timestamp_updated": 1734993617, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.516891896724700928", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": [{"reaction_type": 19, "count": 1}]}, {"recommendationid": "183515010", "author": {"steamid": "76561198014790143", "personaname": "Caradog", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/rivenart/", "num_games_owned": 582, "num_reviews": 213, "playtime_forever": 466, "playtime_last_two_weeks": 0, "playtime_at_review": 333, "deck_playtime_at_review": 333, "last_played": 1735040866, "avatar": "7077dc8ca75bf3309e3bbeea03046ec8b02ee6c7"}, "language": "english", "review": "Left 4 Dead but they decided to reinvent the wheel. Then add a cup holder. Then RGB lights. Then a pasty warmer. Then a barometer. Then an aztec calender.\n\nJust fluff, that I don't see the point in, just mades booting up the game and playing a level far more complex then it ever was or has any need to be. Runs fine, seemingly better then L4D2 on steam deck though levels do feel emptier with just more fluff and nothing between hordes.\n\nI personally don't see why you'd pick this one even if you did like horde zombie survival games, its just needlessly complicating a rather simply and already perfected formula, probably because it was meant to have micro transations of the cards or something, thats what it feels like to me. Maybe it does, I just haven't stuck around long enough for it to ask for my Credit card details.\n\nAlso why'd it take over 5 hours to claim the free trading cards on this product, really trying to force that player retention, I have no played any of the additional hours after the first just let it run to get the last 2 cards but for some reason they just never came til late.", "timestamp_created": 1734990408, "timestamp_updated": 1735008115, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": true, "app_release_date": "1634050800", "reactions": []}]}