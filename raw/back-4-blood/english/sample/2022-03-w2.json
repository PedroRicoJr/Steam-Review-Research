ing_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "112254171", "author": {"steamid": "76561197973436559", "personaname": "dingus khan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hauck_/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 6505, "playtime_last_two_weeks": 0, "playtime_at_review": 5993, "last_played": 1680404499, "avatar": "e61e7ccd86445ccf1e69937d93c44238a38cec86"}, "language": "english", "review": "I rate this game 420/69.", "timestamp_created": 1647375188, "timestamp_updated": 1647375188, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.477515578269958496", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "112249919", "author": {"steamid": "76561199092746324", "personaname": "stonerdoq", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/stonerdoq/", "num_games_owned": 69, "num_reviews": 6, "playtime_forever": 4270, "playtime_last_two_weeks": 0, "playtime_at_review": 1295, "last_played": 1782170751, "avatar": "3e5dbd01c1f8ef1714f0f940e038bdee19d33de9"}, "language": "english", "review": "What can I say? It's another zombie shooter with little story line. I'd recommend waiting for a 50% sale deal instead of paying the full price of $90, I will admit if you are looking for a chill semi-fast to fast pacing zombie game to pass some time than this game is up your ally! I wouldn't recommend the multi-player but the solo experience is pretty good. I know a lot of people originally punched this thinking 'HEY! It's going to be an updated and better version of Left 4 Dead.' YEAAAHHH... Don't get your hopes up! I mean it, It's good for what it is, but no way near the Left 4 Dead experience. Left 4 Dead had WAY more maps and different game modes, along side a decent story line to say the least. Not only that, it also had a lot more zombies with different personalities. Back 4 Blood just has your regular zombies with a few basic mutation ones, If we compare Left 4 Dead and Back 4 Blood when it comes to zombies, Left 4 Dead had some pretty cool zombies like The Witch, You can usually find her sitting around maps crying and if startled she comes after you taking half your health. Back 4 Blood doesn't even have anything like that. Okay, I will admit some mutations are cool but It's all things we've seen before. Acid being puked at the player, boulders being thrown... It's nothing original. But back to what I said at the beginning, this is up your ally if you want a chill semi-fast to fast pacing zombie game to pass time just don't expect a whole lot.", "timestamp_created": 1647369484, "timestamp_updated": 1647369484, "voted_up": true, "votes_up": 38, "votes_funny": 7, "weighted_vote_score": "0.650188028812408447", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": [{"reaction_type": 15, "count": 1}, {"reaction_type": 20, "count": 1}, {"reaction_type": 6, "count": 1}]}, {"recommendationid": "112249401", "author": {"steamid": "76561198336144816", "personaname": "dimos", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198336144816/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 14764, "playtime_last_two_weeks": 0, "playtime_at_review": 310, "last_played": 1664053487, "avatar": "b2a046908176f4dfbbf06a35f3df7c86bf98e848"}, "language": "english", "review": "game crushes for no reason", "timestamp_created": 1647368799, "timestamp_updated": 1647368799, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.502729594707489014", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "112224759", "author": {"steamid": "76561198061973963", "personaname": "Tiir Rumibul", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Iino_doue/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 10672, "playtime_last_two_weeks": 0, "playtime_at_review": 1216, "last_played": 1743310115, "avatar": "51fd2e0d663bc8db4554a9caedfc4e452326fe5a"}, "language": "english", "review": "It's a fun game, a good sequel to L4D2, but be warned, I experience freezing, no idea how to fix it", "timestamp_created": 1647329776, "timestamp_updated": 1647329776, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.496987968683242798", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}