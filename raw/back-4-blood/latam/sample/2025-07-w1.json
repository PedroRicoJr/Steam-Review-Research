_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "199032350", "author": {"steamid": "76561198846363438", "personaname": "boyfree39reload", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198846363438/", "num_games_owned": 65, "num_reviews": 24, "playtime_forever": 536, "playtime_last_two_weeks": 0, "playtime_at_review": 388, "last_played": 1772001320, "avatar": "83d2ab083eb76aebed718fd01921fbe2af2b7e35"}, "language": "latam", "review": "Es repetitivo pero esta entretenido yo lo acabo de comprar por 120 pesos 200 ya con los dlc creo por ese precio almenos para mi si vale la pena", "timestamp_created": 1751733995, "timestamp_updated": 1751733995, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}