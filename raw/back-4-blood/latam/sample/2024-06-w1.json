nt_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "167785794", "author": {"steamid": "76561198074880037", "personaname": "Teach109", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/dhellionpy/", "num_games_owned": 636, "num_reviews": 94, "playtime_forever": 2212, "playtime_last_two_weeks": 0, "playtime_at_review": 372, "last_played": 1778087572, "avatar": "ef8f2c4656ed595acd75a0ead1dfa512be610439"}, "language": "latam", "review": "Tengo que decir que conociendo cómo se las gasta Warner, fue el responsable directo de forzar unas políticas DEI. Y eso deja un videojuego con enorme potencial, pero con personajes jugables sin carisma y olvidables.\n\nLa chulearía insoportable de la parte \"empoderada\" del mundo, me genera un rechazo muy fuerte. Y la historia sufre todo el golpe, al tener que adaptar esto, a un ambiente que le queda grande. Esta es mi opinión personal.\n\nPor eso, comparado con Left 4 Dead, este juego pierde demasiado.\n\nAún así la recomiendo, a 5 dólares. O en Game Pass.", "timestamp_created": 1718914529, "timestamp_updated": 1718914622, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.454545468091964722", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "167779872", "author": {"steamid": "76561198381122267", "personaname": "leorocca123", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/LeoRH/", "num_games_owned": 454, "num_reviews": 26, "playtime_forever": 1352, "playtime_last_two_weeks": 0, "playtime_at_review": 1352, "last_played": 1749356502, "avatar": "dd1b10e7149c18fe4e9bd269fb4750892f257196"}, "language": "latam", "review": "Back 4 Blood es un juego de zombies bastante bueno, nos ofrece algo diferente a lo que estamos acostumbrados en L4D2, pero NO es lo mismo, por lo que compararlo con left4dead no es adecuado, NO es L4D3, NO es un \"sucesor espiritual\" como muchos Youtubers dijeron en su momento, nos cuenta otra historia completamente distinta, dado que ya solo recibe parches de vez en cuando, recomiendo aprovechar en rebajas 90% descuento, ya sea la version normal y luego el pase anual (trae los DLC) o la deluxe, o si te interesan unas cuantas skins extra y banners con sprays la ultimate, pero francamente lo único que agrega algo significativamente extra al juego son los DLC.", "timestamp_created": 1718909109, "timestamp_updated": 1773275123, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.526924490928649902", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "hardware": {"system_ram": "15771", "os": "Windows 11", "cpu_name": "AMD Ryzen 9 5900HX with Radeon Graphics        ", "adapter_description": "NVIDIA GeForce RTX 3060 Laptop GPU", "vram_size": 5994}, "reactions": []}, {"recommendationid": "167743123", "author": {"steamid": "76561198194621617", "personaname": "SanRocks12", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198194621617/", "num_games_owned": 242, "num_reviews": 30, "playtime_forever": 521, "playtime_last_two_weeks": 0, "playtime_at_review": 270, "last_played": 1719292574, "avatar": "db1382126b55a2709386f99d0727732927d42cd2"}, "language": "latam", "review": "Buen juego, mejor con amigos.", "timestamp_created": 1718866421, "timestamp_updated": 1718866421, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_acc