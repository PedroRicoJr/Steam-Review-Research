playtime_last_two_weeks": 0, "playtime_at_review": 1075, "last_played": 1642279138, "avatar": "399bdc03ff10b56ccced1ec77f1ef974bddd1ec4"}, "language": "russian", "review": "Она еще сырая.", "timestamp_created": 1638901195, "timestamp_updated": 1638901195, "voted_up": false, "votes_up": 5, "votes_funny": 1, "weighted_vote_score": "0.520697176456451416", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "105371020", "author": {"steamid": "76561198291822813", "personaname": "Пивозавр", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198291822813/", "num_games_owned": 166, "num_reviews": 11, "playtime_forever": 6376, "playtime_last_two_weeks": 0, "playtime_at_review": 1325, "last_played": 1719698587, "avatar": "b663baf368812dc7ebdb3ae41ea3fe56b319f62b"}, "language": "russian", "review": "ахуеенннаа оуоуоу\n", "timestamp_created": 1638820449, "timestamp_updated": 1638820449, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.500770390033721924", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "105366634", "author": {"steamid": "76561199012806808", "personaname": "Alehandro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Alexander_boom/", "num_games_owned": 0, "num_reviews": 27, "playtime_forever": 3098, "playtime_last_two_weeks": 0, "playtime_at_review": 877, "last_played": 1712794458, "avatar": "f61a1c2e9ee05236d6cbc89add14976eb05b6cd9"}, "language": "russian", "review": "играть строго с друзьями! Одному отстой! Игра топ", "timestamp_created": 1638814546, "timestamp_updated": 1638814546, "voted_up": true, "votes_up": 2, "votes_funny": 1, "weighted_vote_score": "0.519999980926513672", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "105357388", "author": {"steamid": "76561198118918750", "personaname": "AlisaRed", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198118918750/", "num_games_owned": 0, "num_reviews": 100, "playtime_forever": 4754, "playtime_last_two_weeks": 0, "playtime_at_review": 302, "last_played": 1759893017, "avatar": "4ebf057fcd792a8107cbb5bd770f16eeb212e8e8"}, "language": "russian", "review": "[h1] Баланс? Не, не слышали [/h1]\n\nПосле дофига часов наигранных в Myth of Empires, решили пойти дружной компанией для разнообразия пострелять в Back 4 Blood заодно посмотреть, что там изменили с приходом релиза и патча за ноябрь.\n\nДобавили немного кастомизации всего и вся (профиль, персонажи, оружие и т.д.), два новых персонажа, новые контент для сюжетной компании, пофиксили какие - то баги и с оптимизацией стало по лучше.\nНа этом всё.  Если поиграв в бетку и вы для себя уже всё решили ещё тогда, то ничего из нововведений не сможет перевесить так называемую чащу весов в одну из сторон.\n\nГлавная проблема игры не тупые боты, не вороны которые поднимают тревогу даже если ты стрелял через стену от них в зомби и не малое количество игроков из - за которого вы скорее всего не найдёте себе случайную компанию для прохождения игры, а баланс сложности.\nЕсть три сложности рекрут, ветеран и кошмар. Между этими сложностями настолько большая разница, что она отражается на геймплее и на интересе к игре в целом.\nНа рекруте ты можешь просто зевать, а на ветеране и до половины не дойти локации, потому что на вас выбегут по каждому виду заражённых и к ней вагон ещё обычные зараженные, которые просто вас снесут и всё начинай с начало.\n\nК подобным играм я вообще отношусь нейтрально для меня они все на одно лицо.\nЕсли и брать игру, то желательно со скидкой, просто пострелять и пройти игру на рекруте для разгрузки, то что надо.\nЕсли хочется бессмысленной боли, достаточно перейти на сложность повыше, может и понравиться.\nhttps://steamcommunity.com/sharedfiles/filedetails/?id=2675042966\nP. S.\nСпасибо Feranot за предоставленную возможность поиграть всем вместе в эту игру )", "timestamp_created": 1638802699, "timestamp_updated": 1640200986, "voted_up": true, "votes_up": 14, "votes_funny": 0, "weighted_vote_score": "0.630328059196472168", "comment_count": 10, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "105309327", "author": {"steamid": "76561198069413368", "personaname": "♕MERSER♕", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198069413368/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 120, "playtime_last_two_weeks": 0, "playtime_at_review": 120, "last_played": 1634158199, "avatar": "7ea1e5b9d97ba11b03e234981f4f1877747839dd"}, "language": "russian", "review": "Карточная игра с элементами шутера.", "timestamp_created": 1638728717, "timestamp_updated": 1638728717, "voted_up": false, "votes_up": 8, "votes_funny": 5, "weighted_vote_score": "0.5122336745262146", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}