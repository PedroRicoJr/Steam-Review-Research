{"game": "back-4-blood", "language": "russian", "appid": 924970, "month": "2025-04", "window": 1, "start_date": 1743465600, "end_date": 1746057599, "month_true_total": 20, "quota": 20, "returned": 20, "pulled_at": "2026-08-29 21:01:32 Pacific Daylight Time", "reviews": [{"recommendationid": "193898637", "author": {"steamid": "76561198882330655", "personaname": "Hank", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198882330655/", "num_games_owned": 240, "num_reviews": 62, "playtime_forever": 286, "playtime_last_two_weeks": 0, "playtime_at_review": 286, "last_played": 1735658722, "avatar": "67df5407674abbff68d44b7ddf9ef7c705fdc052"}, "language": "russian", "review": "not bad", "timestamp_created": 1746011569, "timestamp_updated": 1746011569, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "193779322", "author": {"steamid": "76561198085758822", "personaname": "Michelle", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198085758822/", "num_games_owned": 81, "num_reviews": 5, "playtime_forever": 27345, "playtime_last_two_weeks": 0, "playtime_at_review": 11754, "last_played": 1774383264, "avatar": "7336b2aa4686d5aa9d52ae471c4950ae5c1d11b8"}, "language": "russian", "review": "найзз", "timestamp_created": 1745851254, "timestamp_updated": 1745851254, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.47826087474822998", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "193685968", "author": {"steamid": "76561199277372503", "personan