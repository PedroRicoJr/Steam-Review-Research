: true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "133317033", "author": {"steamid": "76561198986547229", "personaname": "Tokbay", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/uglyTokbay/", "num_games_owned": 304, "num_reviews": 106, "playtime_forever": 1455, "playtime_last_two_weeks": 0, "playtime_at_review": 466, "last_played": 1718658826, "avatar": "b01e6e6dfd4a3762f84ea80fea6a31e5b5e6abf4"}, "language": "russian", "review": "[h1] Порадовало [/h1]\n[i] · кастомизация персонажей [/i]\n[i] · ощущения от стрельбы. [/i]\n\n[h1] Огорчило [/h1]\n[i] · без PvP-элемента кампания слишком однообразна [/i]\n[i] · скучнейшие, чересчур живучие противники [/i]\n[i] · баланс сложности зависит от воли случая [/i]\n[i] · мультиплеер без возможности выгнать игрока [/i]\n[i] · ограничение в две попытки на кампанию. [/i]\n\n[h1] Вердикт [/h1]\n[b] Back 4 Blood могла стать достойной продолжательницей идей Left 4 Dead, но слабый геймдизайн поставил на этой мечте крест. А всё хорошее, что в ней есть, губят крайне неудачные решения в плане баланса и сетевого функционала. [/b]", "timestamp_created": 1677016781, "timestamp_updated": 1677460186, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.511278212070465088", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}