ing_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "228445438", "author": {"steamid": "76561199247743767", "personaname": "Yalen_LS", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199247743767/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 1076, "playtime_last_two_weeks": 0, "playtime_at_review": 1076, "last_played": 1708206754, "avatar": "22f0930c5ca034720612bd757eab6fa8b753843f"}, "language": "spanish", "review": "No estava mal pero lo deje de jugar porque era muy repetitivo", "timestamp_created": 1781993699, "timestamp_updated": 1781993699, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "228324939", "author": {"steamid": "76561198193221987", "personaname": "TUPAC AMARU III", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198193221987/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 10881, "playtime_last_two_weeks": 139, "playtime_at_review": 7618, "last_played": 1788058429, "avatar": "b2edbc430cffa963966ebafc9e7844414a9c51c1"}, "language": "spanish", "review": "Este juego debes tomarlo como un juego aparte, no es un left 4 dead 3, sin embargo tiene lados muy positivos, tiene tematica con las cartas y los personajes, lo unico malo entre comillas seria el tema de los accesorios ya que debes llegar hasta el refugio para poderlos quitar, sin embargo es un buen juego entretenido y si tienes amigos es juego se vuelve mucho mejor.\r\nNo es pay to win, no tiene micro transacciones que molestan, es un juego completo y con muchas horas de diversion.\r\n\r\nThis game should be considered a separate title; it's not Left 4 Dead 3. However, it has many positive aspects, including the card system and the characters. The only downside, if you can call it that, is the item system, since you have to reach the safe house to remove items. Nevertheless, it's a good, entertaining game, and it becomes even better with friends.\r\nIt's not pay-to-win, and it doesn't have annoying microtransactions. It's a complete game with many hours of fun.", "timestamp_created": 1781869935, "timestamp_updated": 1781869935, "voted_up": true, "votes_up": 10, "votes_funny": 1, "weighted_vote_score": "0.666666686534881592", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": [{"reaction_type": 26, "count": 1}]}, {"recommendationid": "228076659", "author": {"steamid": "76561198037786734", "personaname": "KillerChicken", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/jahibol117/", "num_games_owned": 187, "num_reviews": 8, "playtime_forever": 3944, "playtime_last_two_weeks": 0, "playtime_at_review": 3008, "last_played": 1783290155, "avatar": "b09fc9441966aec326522d16cf1805b50ed83582"}, "language": "spanish", "review": "Positivamente genial y con una dificultad super enganchadora", "timestamp_created": 1781584321, "timestamp_updated": 1781584321, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.565217375755310059", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "227767206", "author": {"steamid": "76561199252438498", "personaname": "jdthdpxd", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199252438498/", "num_games_owned": 51, "num_reviews": 8, "playtime_forever": 4671, "playtime_last_two_weeks"