laytime_last_two_weeks": 0, "playtime_at_review": 3778, "last_played": 1761463571, "avatar": "edca0c3bba249ffd8a08b29483b61ace24b91cba"}, "language": "schinese", "review": "一个FPS游戏最猛的是冷兵器，高难度下基本靠近战大爹活到最后拉人。枪位尤其狙位实在太脆弱，一碰就嗷嗷叫，不过射击手感和击杀反馈做得相当好，卡组配完之后爽爆，推荐机枪和霰弹。\n\n联机游戏最缺的是朋友，无忧无虑时间充裕的日子和一叫就到随时上号的朋友再也没有之后，我终于开始了解这句话。\n约人一起玩的过程多少有点坎坷，但愿我们能相逢一笑泯恩仇。", "timestamp_created": 1767149774, "timestamp_updated": 1767149774, "voted_up": true, "votes_up": 15, "votes_funny": 1, "weighted_vote_score": "0.654011905193328857", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}