ion_type": 9, "count": 1}]}, {"recommendationid": "138791563", "author": {"steamid": "76561198321068822", "personaname": "ClavaPeter", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198321068822/", "num_games_owned": 277, "num_reviews": 13, "playtime_forever": 42944, "playtime_last_two_weeks": 0, "playtime_at_review": 34811, "last_played": 1786551824, "avatar": "865e0eea7f4593e8f65845d12ce60e23b150773b"}, "language": "schinese", "review": "作为一个从头打到尾的玩家，说这款游戏不好玩，肯定有失偏颇。说这款游戏良心，肯定也抬举他了。说他是精神续作，他又L4D一直更新的精神么？放屁。打折可以入，和朋友一起玩，还是很开心的。综合评价：5/10。", "timestamp_created": 1684789009, "timestamp_updated": 1684789009, "voted_up": true, "votes_up": 10, "votes_funny": 0, "weighted_vote_score": "0.647749364376068115", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "138614797", "author": {"steamid": "76561198095019996", "personaname": "小恶鬼", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198095019996/", "num_games_owned": 21, "num_reviews": 2, "playtime_forever": 23718, "playtime_last_two_weeks": 0, "playtime_at_review": 13118, "last_played": 1769683165, "avatar": "1eb8d095cf5340aacb647cb5869f4a57cf41e8be"}, "language": "schinese", "review": "听说不更新了\n", "timestamp_created": 1684592528, "timestamp_updated": 1684592528, "voted_up": false, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.588161885738372803", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "138608764", "author": {"steamid": "76561198213721745", "personaname": "黑桃", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198213721745/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 59937, "playtime_last_two_weeks": 0, "playtime_at_review": 29049, "last_played": 1769085712, "avatar": "f53d9fdc84a86bb26dd8953cd65a3488e0b04751"}, "language": "schinese", "review": "官方已经割够韭菜放弃更新了，就目前的内容来说也远远不值这个价，想入的伙伴们等打折吧，原价入真的不值。原版的地图也没几张，就是相同的地图改一改岔路口或者改一改剧情，怪物方面既然说是求生之路的精神续作的话，怪物方面真的看不出来，无论从特感的进攻方式还是外貌都平平无奇，一个怪物稍稍的改一改外貌就是一个新怪物了。看不到类似求生之路的设计感，所以导致新手根本不能有效的分辨出各种特感有什么不同。DLC的评价比原版可玩性好一点，但也不太多，第一个DLC虫穴有好几张地图，挺有新鲜感的，可以当成一个支线去打，骷髅币的位置基本都固定了，多跑几次就知道会刷在哪里了。剩下的两个DLC增了两个地图，难度有所增加，但是流程不长有点为了增加玩家游玩时间故意把路程延长的感觉。当做类似刷宝游戏可以玩一玩，但是当成求生之路续作的话还是算了，姑且给个好评吧，也算是帮我打发了很多无聊时间", "timestamp_created": 1684585922, "timestamp_updated": 1684585922, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}