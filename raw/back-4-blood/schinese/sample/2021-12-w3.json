file_url": "https://steamcommunity.com/profiles/76561199088188459/", "num_games_owned": 24, "num_reviews": 2, "playtime_forever": 47605, "playtime_last_two_weeks": 0, "playtime_at_review": 58, "last_played": 1775650157, "avatar": "265d043506f0654d97a5049f03c3bb5e9018f513"}, "language": "schinese", "review": "打折刚买下玩了58分钟，果断选择退款，个人认为打击手感不是很好，甚至带点晕，都是带着情怀来的，结果差强人意，看别人主播玩和自己玩完全是两种感觉，可能是以前常玩求生系列中mod，服务器等原因，4人房已经满足不了我了，而且并不是所有人都带着脑子和麦来打游戏的，之所以退款还有一点就是价格还是太贵虽然打6折后低了不少，但价格和游戏体验明显不对等，若是100左右或许可以考虑留着以后慢慢磨合，但200往上明显不行，只希望制作组再改进改进，说不定还会入手。", "timestamp_created": 1640255896, "timestamp_updated": 1640255896, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.468008875846862793", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}