playtime_forever": 7804, "playtime_last_two_weeks": 0, "playtime_at_review": 4446, "last_played": 1758187282, "avatar": "9bc0fc848f87c7316dc9505e610ec51751956793"}, "language": "schinese", "review": "难度调低了是不容易体会到这游戏好玩在哪的\n首发那会一套牌还得慢慢抽，难度有点太高了；后来貌似改了好几次，总之等到它停止更新后再回坑，感觉真的和首发不是一个游戏，体验好很多了\n其实L4D2反而玩的不是很进去，去年才下定决心通一次，每天玩两个小时就玩不动了\nB4B游戏机制花里胡哨很多，有经济有卡组有配件等级，更对我胃口一点（但是地图设计确实一坨，不知道为什么远不如求生之路系列）没必要也不能把它当求生之路复刻版玩\n当然路人也是真的恶心，我是玩懂了配了套近战卡组才敢去带路人（哪的人都有，国人印度人还有东南亚人，甚至貌似澳洲）过老兵难度的，看不明白他们都带的什么卡，干啥啥不行暴毙第一名，不知道怎么配卡之前就玩玩新兵得了吧，现在改了补给点倍率，通关六章哪怕四章应该就能收集几乎全部卡了，后面补给点只能买买喷漆图标燃烧卡啥的挺遗憾\n最奇怪的是不明白为什么停止更新，组不大有新项目没啥，首发又贵又不合理内容也不够能怪谁，现在更新的挺好了突然又放弃了，莫名其妙，那我这个缺的衣服上哪买啊", "timestamp_created": 1689418644, "timestamp_updated": 1689418644, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "142094264", "author": {"steamid": "76561198208168051", "personaname": "iiiik", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/1037803156/", "num_games_owned": 98, "num_reviews": 5, "playtime_forever": 26110, "playtime_last_two_weeks": 0, "playtime_at_review": 926, "last_played": 1700216444, "avatar": "2618789099c4b89c92a81d6c5b21c524a70ed869"}, "language": "schinese", "review": "队友加我！", "timestamp_created": 1689377697, "timestamp_updated": 1689377697, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}