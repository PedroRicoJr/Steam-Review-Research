me_forever": 1614, "playtime_last_two_weeks": 0, "playtime_at_review": 270, "last_played": 1754472909, "avatar": "113f22bd537370ca7613983da4c8e29e3075d7ee"}, "language": "schinese", "review": "666", "timestamp_created": 1722427133, "timestamp_updated": 1722427133, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "171152555", "author": {"steamid": "76561198950715227", "personaname": "Money不多", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198950715227/", "num_games_owned": 28, "num_reviews": 3, "playtime_forever": 9045, "playtime_last_two_weeks": 0, "playtime_at_review": 8624, "last_played": 1749937804, "avatar": "92ba98c8031e1bd41e5c04282538662cce7eeb17"}, "language": "schinese", "review": "摸一下猫猫会张嘴，一个赞摸一次！！！\n⣿⣿⣿⠟⠛⠛⠻⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡟⢋⣩⣉⢻\n⣿⣿⣿⠀⣿⣶⣕⣈⠹⠿⠿⠿⠿⠟⠛⣛⢋⣰⠣⣿⣿⠀⣿\n⣿⣿⣿⡀⣿⣿⣿⣧⢻⣿⣶⣷⣿⣿⣿⣿⣿⣿⠿⠶⡝⠀⣿\n⣿⣿⣿⣷⠘⣿⣿⣿⢏⣿⣿⣋⣀⣈⣻⣿⣿⣷⣤⣤⣿⡐⢿\n⣿⣿⣿⣿⣆⢩⣝⣫⣾⣿⣿⣿⣿⡟⠿⠿⠦⠀⠸⠿⣻⣿⡄⢻\n⣿⣿⣿⣿⣿⡄⢻⣿⣿⣿⣿⣿⣿⣿⣿⣶⣶⣾⣿⣿⣿⣿⠇⣼\n⣿⣿⣿⣿⣿⣿⡄⢿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡟⣰\n⣿⣿⣿⣿⣿⣿⠇⣼⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⢀⣿\n⣿⣿⣿⣿⣿⠏⢰⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⢸⣿\n⣿⣿⣿⣿⠟⣰⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⠀⣿\n⣿⣿⣿⠋⣴⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡄⣿\n⣿⣿⠋⣼⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡇⢸", "timestamp_created": 1722418783, "timestamp_updated": 1722418783, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.502074718475341797", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "171134617", "author": {"steamid": "76561198185676045", "personaname": "Senjio3", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Senjio3/", "num_games_owned": 0, "num_reviews": 48, "playtime_forever": 1267, "playtime_last_two_weeks": 0, "playtime_at_review": 120, "last_played": 1723685526, "avatar": "bc40db1fb7104a888cca223a326da2660bc1c46c"}, "language": "schinese", "review": "即使是几十块打折买的，依旧体验很差，画面很脏很乱，僵尸血肉横飞遮挡视野，没必要的环境布景让视野更乱，黑暗的地方开枪闪得眼睛都要瞎了，音效很杂，怪的声音从头到尾不停的，没有什么辨识度，尸潮的时候也没有什么标志性音乐，我甚至不知道是在尸潮，一打起来又乱又杂，根本听不清特感从哪里来的，而是需要他标出来特感，让爽感大幅降低。僵尸数量比求生多多了，但是弹匣依旧那么点，就变成了按一梭子就得频繁换弹，非常不爽。\n\n小怪跑得又快刷得又多，动不动脸上刷一堆，没升级的一个弹匣还不够清一波怪的，，评价是游戏体验一坨。\n\n武器全靠捡，脸黑就很难受。求生带着3个BOT能写专，站在平地三个电脑神挡杀神可以直接挂机。B4B带着三个弱智BOT，别说帮我清尸潮了，帮我看个屁股都做不到，一不小心屁股就被挠烂了。\n\n玩法方面想做加法，但是实际体验是新手学习和入门成本大大提高，但是游玩体验并没有提升太多，明明是一款打僵尸的爽游，何必要这么折腾呢。\n\n总而言之，想打僵尸的为什么不等隔壁L4D2打折4块的时候买求生呢？画面舒服音效准确配置要求低，玩法成熟简单爽快还有创意工坊。", "timestamp_created": 1722391463, "timestamp_updated": 1722471172, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.47826087474822998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "171032203", "author": {"steamid": "76561199433862034", "personaname": "李若依", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199433862034/", "num_games_owned": 38, "num_reviews": 1, "playtime_forever": 159, "playtime_last_two_weeks": 0, "playtime_at_review": 159, "last_played": 1720970038, "avatar": "14fa45d90d1774068441651602af9b2de61890b4"}, "language": "schinese", "review": "很牛，很爽，很爱玩", "timestamp_created": 1722263846, "timestamp_updated": 1722263846, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "171027958", "author": {"steamid": "76561198364807738", "personaname": "LuoTao", "persona_status": "offline", "profile_url": "https://steamcommunity.com/prof