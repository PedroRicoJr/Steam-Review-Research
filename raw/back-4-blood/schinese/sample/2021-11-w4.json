primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "104833176", "author": {"steamid": "76561199066482773", "personaname": "沐沐", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199066482773/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 1320, "playtime_last_two_weeks": 0, "playtime_at_review": 346, "last_played": 1722265492, "avatar": "49b8fc0f64109308009c25636336670ba7d6066e"}, "language": "schinese", "review": "♥♥，真的很傻逼，没有可玩性，玩了4-5个小时之后就不想玩了，操作还没有wwz好，而且dlc还是预售，还不能退款，真绝了。这哪是情怀税，这是智商税", "timestamp_created": 1638277489, "timestamp_updated": 1638277489, "voted_up": false, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "104832967", "author": {"steamid": "76561198121487539", "personaname": "奔波儿灞", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198121487539/", "num_games_owned": 93, "num_reviews": 24, "playtime_forever": 9872, "playtime_last_two_weeks": 0, "playtime_at_review": 3134, "last_played": 1696763009, "avatar": "df11b6c75a8bfb6f51655d0436a46be1945db36e"}, "language": "schinese", "review": "我需要创意工坊", "timestamp_created": 1638277374, "timestamp_updated": 1638277374, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "104832801", "author": {"steamid": "76561198430873354", "personaname": "厚礼屑", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198430873354/", "num_games_owned": 138, "num_re