amid": "76561198282010871", "personaname": "Elder James", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198282010871/", "num_games_owned": 484, "num_reviews": 8, "playtime_forever": 13, "playtime_last_two_weeks": 0, "playtime_at_review": 13, "last_played": 1639563190, "avatar": "3dd9229b07ea24b45b19ab4b918d76e03efc7528"}, "language": "schinese", "review": "制作组有没有考虑过，在一个边跑边打僵尸的游戏里加入一个会严重减慢移动速度的机瞄是个很蠢的事情。然后推开僵尸这个动作个人认为，还是用枪托去推会有力量感一点，角色手上拿着枪然后按一下V就突然空出手去推僵尸是否过于违和。虽然没有指望这部作品能达到L4D系列两部作品的高度，但是抛开剧情没有关注这部作品对比L4D2也就画面能赢了而且说实话这个画面在现在看来也不算优秀。老实说比较失望，失望到马上跑回去玩L4D2的程度。", "timestamp_created": 1639566179, "timestamp_updated": 1639566179, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.506628751754760742", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "105862898", "author": {"steamid": "76561199099762479", "personaname": "p768106191", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199099762479/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 10830, "playtime_last_two_weeks": 0, "playtime_at_review": 622, "last_played": 1722831840, "avatar": "037153affe7325a155871371216bf2a42827b517"}, "language": "schinese", "review": "好玩", "timestamp_created": 1639565118, "timestamp_updated": 1639565118, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.498452037572860718", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "105862051", "author": {"steamid": "76561198101548374", "personaname": "Nep哒", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561