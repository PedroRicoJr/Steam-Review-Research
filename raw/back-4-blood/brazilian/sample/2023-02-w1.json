pdated": 1675562160, "voted_up": false, "votes_up": 136, "votes_funny": 5, "weighted_vote_score": "0.910151481628417969", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": [{"reaction_type": 6, "count": 1}]}, {"recommendationid": "132219235", "author": {"steamid": "76561198164897918", "personaname": "moonshy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/moonshyl/", "num_games_owned": 111, "num_reviews": 18, "playtime_forever": 1786, "playtime_last_two_weeks": 0, "playtime_at_review": 1141, "last_played": 1781985808, "avatar": "5a6c0d3eb511c43e9305e598c517df5386ef6a7f"}, "language": "brazilian", "review": "Esse foi um dos melhores jogos de zumbi cooperativo que joguei nesses tempos. Lembra muito Left 4 Dead mas com jogabilidades diferentes, mais opções de armas, movimentos, ataques e uma história nova.\nO Jogo é muito bem feito, tem falas incríveis e raramente tem bugs.  \nÚnico pontos que preciso citar é que ia ser legal ter mais diversidade de cartas para montar os baralhos.\nE é, realmente é um inferno na dificuldade máxima...\nBom, finalizo falando que é bem triste o jogo não ter mais suporte, e acho o preço bem salgadinho pra esse jogo, mesmo sendo muito bom, peguei ele por causa do promoção, e agora to me coçando pra comprar as DLC's, que ao meu ver são bem salgadinhas também, fora isso, adorei.", "timestamp_created": 1675549202, "timestamp_updated": 1675549202, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "132208296", "author": {"steamid": "76561198042505717", "personaname": "Cabeça de Gelo", "