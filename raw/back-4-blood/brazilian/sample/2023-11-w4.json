ck 4 Blood não veio para ser substituir Left 4 Dead e sim para ser mais uma opção de jogo de zumbi no seu Left!", "timestamp_created": 1701140990, "timestamp_updated": 1701140990, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.5", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "152331705", "author": {"steamid": "76561198399310390", "personaname": "HIPNOS", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198399310390/", "num_games_owned": 64, "num_reviews": 1, "playtime_forever": 958, "playtime_last_two_weeks": 0, "playtime_at_review": 666, "last_played": 1724622046, "avatar": "307bbf9b09169e24ffd77c36a537e8ea26225c45"}, "language": "brazilian", "review": "muito bom", "timestamp_created": 1701139412, "timestamp_updated": 1701139412, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}