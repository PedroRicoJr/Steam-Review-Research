: false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "129627106", "author": {"steamid": "76561198287371597", "personaname": "ESMGAMER", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/lorsitheverton/", "num_games_owned": 19, "num_reviews": 2, "playtime_forever": 1158, "playtime_last_two_weeks": 0, "playtime_at_review": 533, "last_played": 1713726435, "avatar": "0f735f135c516f8657c3beec4300cb583c7d6f9f"}, "language": "brazilian", "review": "O jogo tem mutias opções de armas para você ficar se desafiando a passar as fases com alguns tipo de armamentos e com tipo diferente de personagens e de função no grupo.", "timestamp_created": 1672341149, "timestamp_updated": 1672341149, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "129606151", "author": {"steamid": "76561198360350905", "personaname": "Duck de Caxias", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198360350905/", "num_games_owned": 200, "num_reviews": 13, "playtime_forever": 7293, "playtime_last_two_weeks": 0, "playtime_at_review": 950, "last_played": 1783041863, "avatar": "6d3587b4f526fee04db3393e604e659f7773fee9"}, "language": "brazilian", "review": "Jogo fantástico, valeu cada centavo gasto!", "timestamp_created": 1672323106, "timestamp_updated": 1672323106, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "129519005", "author": {"steamid": "76561198226384380", "pers