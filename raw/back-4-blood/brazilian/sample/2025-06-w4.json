p": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "198488840", "author": {"steamid": "76561199041484071", "personaname": "CyberHavoc", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199041484071/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 931, "playtime_last_two_weeks": 0, "playtime_at_review": 931, "last_played": 1743898259, "avatar": "3d1eda389bc4c7286ff64db8b050c7ca9441a630"}, "language": "brazilian", "review": "O jogo é uma evolução espiritual de Left 4 Dead, trazendo ideias novas, como o sistema de cartas, no qual você monta um baralho de habilidades que afetam atributos como vida, resistência e recarga. Também há as 'cartas de corrupção', que aumentam a dificuldade e podem não agradar a todos os fãs do clássico, especialmente por não capturar totalmente a simplicidade direta e frenética do original. Ainda assim, é um excelente jogo cooperativo, especialmente quando jogado com amigos. No entanto, por ser um jogo relativamente curto, recomendo esperar por uma promoção para adquiri-lo por um preço melhor.", "timestamp_created": 1751225297, "timestamp_updated": 1751225832, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}]}