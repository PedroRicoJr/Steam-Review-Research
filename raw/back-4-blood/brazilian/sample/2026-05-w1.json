ode parecer mais complexo do que o necessário para quem quer algo mais casual.", "timestamp_created": 1777935480, "timestamp_updated": 1777935480, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "224736534", "author": {"steamid": "76561199046979455", "personaname": "bilipegajosa", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/bilipegajosa/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 2298, "playtime_last_two_weeks": 0, "playtime_at_review": 2298, "last_played": 1777763380, "avatar": "be6fa890332d8fc9b901249b0b5107b66006a009"}, "language": "brazilian", "review": "é um l4d2 da contemporaneidade, tem como não gostar?", "timestamp_created": 1777873232, "timestamp_updated": 1777873232, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1634050800", "reactions": []}, {"recommendationid": "224645094", "author": {"steamid": "76561198918813580", "personaname": "ZeroTwobrskins", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198918813580/", "num_games_owned": 32, "num_reviews": 1, "playtime_forever": 743, "playtime_last_two_weeks": 0, "playtime_at_review": 455, "last_played": 1778290874, "avatar": "4c0f50cc3e0594a16179a2d9b2e98528490dc565"}, "language": "brazilian", "review": "sim, muito bom o modo online", "timestamp_created": 1777777704, "timestamp_updated": 1777777704, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_f