{"game": "alien-swarm", "language": "english", "appid": 630, "month": "2011-09", "window": 4, "start_date": 1316736000, "end_date": 1317427199, "month_true_total": 55, "quota": 5, "returned": 5, "pulled_at": "2026-10-06 00:53:06 UTC", "reviews": [{"recommendationid": "2916219", "author": {"steamid": "76561198014536120", "personaname": "Karlos", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Karlos_Wolf/", "num_games_owned": 1499, "num_reviews": 12, "playtime_forever": 1544, "playtime_last_two_weeks": 0, "playtime_at_review": 1540, "last_played": 1509484486, "avatar": "3f54f75b326470044f54c51f6d250a216ff76076"}, "language": "english", "review": "This is one hell of a fun co-op game. It has great replayability and it feels like a solid modern game. The only downside to this neat little game is that it lacks updates so although it has a high re-play value, I can drag on after a few rounds on one campaign.\n\nSuit up, choose your class and take down the alien swarm!\n\nBest thing? It's free!", "timestamp_created": 1317388214, "timestamp_updated": 1317388214, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "83734", "author": {"steamid": "76561197961358449", "personaname": "Atomic Element Zero", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/atomicelementzero/", "num_games_owned": 180, "num_reviews": 44, "playtime_forever": 6298, "playtime_last_two_weeks": 0, "playtime_at_review": 6018, "last_played": 1730943628, "avatar": "6661484b5fc9db8df9cb027ca67812ff405001fc"}, "language": "english", "review": "This game is awesome!  And it's free! It's better than most games I've paid for!!!", "timestamp_created": 1317255907, "timestamp_updated": 1317255907, "voted_up"