early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "105970874", "author": {"steamid": "76561199071138331", "personaname": "The Insurgent", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199071138331/", "num_games_owned": 34, "num_reviews": 5, "playtime_forever": 99, "playtime_last_two_weeks": 0, "playtime_at_review": 27, "last_played": 1639778607, "avatar": "58fcb6534737f6baef393d745d1f6eafe82d64d0"}, "language": "english", "review": "NOBODY PLAYS HARD TO FIND MACH", "timestamp_created": 1639743248, "timestamp_updated": 1639743248, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "105934732", "author": {"steamid": "76561198888994414", "personaname": "schizokämpfer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/schizokampfer/", "num_games_owned": 26, "num_reviews": 18, "playtime_forever": 5275, "playtime_last_two_weeks": 0, "playtime_at_review": 4144, "last_played": 1787506039, "avatar": "ab0f5dbad4dcbbcd656d1bc67924919469820f72"}, "language": "english", "review": "Honestly, I have never expected this game to be this good. Back in 2021, I installed it only out of desire to obtain a hat for Team Fortress 2. But the game is actually worth way more attention than it currently gets. In my opinion, it is a great cooperative shooter, with loads of various weapons, 8 unique characters, with each one having a unique personality and various dialogues. The plot that many people miss is also well written for such a short game; a lot of details, such as PDA`s are being missed simply because people treat this project as a way to get free stuff... Give this game a try; you will NOT regret it.", "timestamp_created": 1639681370, "timestamp_updated": 1785168504, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "hardware": {"system_ram": "16088", "os": "Windows 11", "cpu_name": "12th Gen Intel(R) Core(TM) i5-12500H", "adapter_description": "NVIDIA GeForce RTX 3050 Ti Laptop GPU", "vram_size": 3962}, "reactions": []}, {"recommendationid": "105911215", "author": {"steamid": "76561198073859769", "personaname": "Noctiss", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Romunder/", "num_games_owned": 0, "num_reviews": 20, "playtime_forever": 7646, "playtime_last_two_weeks": 0, "playtime_at_review": 7276, "last_played": 1741911654, "avatar": "b06791f409ecd853e379cb9f2d745df1b24f4afe"}, "language": "english", "review": "An absolute masterpiece, but how?\n\nThis game is a tiny small game made EONS ago by Valve in a diffirent era. It is small, has 1 single short campaign, and a small to medium sized sortiment of items which you can unlock as you get higher levels, and thats pretty much it. Its a top down alien shooter... SO HOW ON EARTH IS THIS GAME SO GOOD? i spend over 200 hours on this on my old steam acc and i have 121 hours on it on this account. What is it with this game, why is this game so fun? When you see this game, you think you would get bored with it fast, play it through once, maybe twice, but no... 2021, and this thing is 10x more enjoyable than the buggy abysmal games that the companies push out these days. And i didnt even mention the MODABILITY of this thing. The workshop maps are phenomenal, and the ammount of content we get out of them, and the custom servers, just everything... my god is this game a marvel...", "timestamp_created": 1639645371, "timestamp_updated": 1639645371, "voted_up": true, "votes_up": 8, "votes_funny": 0, "weighted_vote_score": "0.618357956409454346", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "105842713", "author": {"steamid": "76561197996898435", "personaname": "TW Dumbass", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197996898435/", "num_games_owned": 0, "num_reviews": 18, "playtime_forever": 1366, "playtime_last_two_weeks": 0, "playtime_at_review": 1366, "last_played": 86400, "avatar": "fdb70b4bddcb0b7297eb415246ceeb4b16a407e1"}, "language": "english", "review": "GG", "timestamp_created": 1639525484, "timestamp_updated": 1639525484, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "105838118", "author": {"steamid": "76561198834871118", "personaname": "Greamoh", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Greamoh/", "num_games_owned": 150, "num_reviews": 20, "playtime_forever": 53, "playtime_last_two_weeks": 0, "playtime_at_review": 53, "last_played": 1628439472, "avatar": "5b8825b34c5d77b00c3a18897f2f1175fa0e0e57"}, "language": "english", "review": "Good game I played it a lot with my friend and We loved it", "timestamp_created": 1639517806, "timestamp_updated": 1639517806, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "10565092