e, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "37862017", "author": {"steamid": "76561197994930598", "personaname": "Subnok", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/subnok/", "num_games_owned": 0, "num_reviews": 201, "playtime_forever": 865, "playtime_last_two_weeks": 0, "playtime_at_review": 864, "last_played": 1623484328, "avatar": "45ecfdde7df4affdf7a30fdc5ef75e366ce6ee59"}, "language": "english", "review": "Don't like it!", "timestamp_created": 1511857810, "timestamp_updated": 1511857810, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.382881879806518555", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "37786138", "author": {"steamid": "76561198135051759", "personaname": "Maby51", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Maby51/", "num_games_owned": 227, "num_reviews": 23, "playtime_forever": 2174, "playtime_last_two_weeks": 0, "playtime_at_review": 1856, "last_played": 1560808177, "avatar": "dc10afa9a91ee05f0c148e3ffdf708fd6a8a3ad7"}, "language": "english", "review": "Best game I ever found for a LAN party. Lets me practice my leadership and micromanagement skills.\n\nKind of like Planetside 2 except this time you AREN'T the aliens, this time it's top-down, and this time the FULL GAME takes around 3 hours rather than just learning how things work.\n\nAlso this one you need to find your own friends since literally the game is ♥♥♥♥♥♥♥ DEAD", "timestamp_created": 1511792911, "timestamp_updated": 1560544137, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.481481492519378662", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "37676530", "author": {"steamid": "76561198226515696", "personaname": "Yami Senpai", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198226515696/", "num_games_owned": 80, "num_reviews": 31, "playtime_forever": 236, "playtime_last_two_weeks": 0, "playtime_at_review": 132, "last_played": 1691638415, "avatar": "c5da13940a3d4a9e6b84a5d7dc8527e57dcfe942"}, "language": "english", "review": "I am not a fan of top Down Shooters, At all. \nAlas, this one is different . the abilirty to use a controller /and/or a Keyboard and mouse is exellent!!\nI think the controller better suites this game in the long run, however, customizable key bindings is an awesome feature\n, you can also customize your Controller layout as well.  Love the fact you can play it solo as well as with others, too many games these days leave out the solo campaigne and forget there are people who still like to solo once in awhile.\n \nI also think the storyline could be a bit more detailed , but it is good just as is. switching loadouts before mission could use a little more variety, but again is good as it is as well. I like the idea of being able to pick up a fallen commerades main weapon is good, but wish we could loot them for what was needed more. \n\nGraphics are great for this type of game in my experiance. the game is very responsive to the controls and flow very even,  to the dev my gratitude , and hopefully we will see more in the future.", "timestamp_created": 1511707073, "timestamp_updated": 1511707073, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}