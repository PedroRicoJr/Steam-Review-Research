{"game": "alien-swarm", "language": "english", "appid": 630, "month": "2011-03", "window": 1, "start_date": 1298937600, "end_date": 1299542399, "month_true_total": 81, "quota": 5, "returned": 5, "pulled_at": "2026-10-06 00:52:13 UTC", "reviews": [{"recommendationid": "1267284", "author": {"steamid": "76561197990361649", "personaname": "Loading", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/sonkunoverdadeiro/", "num_games_owned": 57, "num_reviews": 4, "playtime_forever": 418, "playtime_last_two_weeks": 0, "playtime_at_review": 418, "last_played": 1326787200, "avatar": "3dffa4b1cd53f3ed1e6274d4f206187a010cd9eb"}, "language": "english", "review": "Opa esse e dahora recomendo =D", "timestamp_created": 1299482075, "timestamp_updated": 1299482075, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "1751168", "author": {"steamid": "76561197997431519", "personaname": "sl0wpeek", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/slowpeeking/", "num_games_owned": 0, "num_reviews": 47, "playtime_forever": 50, "playtime_last_two_weeks": 0, "playtime_at_review": 50, "last_played": 86400, "avatar": "d30b39c89069757914e245aa2bba7585ccc3d763"}, "language": "english", "review": "free.", "timestamp_created": 1299476024, "timestamp_updated": 1299476024, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "2066733", "author": {"steamid": "76561198001739704", "personaname": "Stevoisiak", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/stevoisiak/", "num_games_owned": 1728, "num_reviews": 103, "playtime_forever": 52, "playtime_last_two_weeks": 0, "playtime_at_review": 52, "last_played": 86400, "avatar": "0e11f8a128a4d2cf0d9df50f3afb4516eff22be9"}, "language": "english", "review": "Alien Swarm is a top-down shooter developed by Valve. Alien swarm is a blast to play with friends in 4 player co-op. If you don't have 4 people to play with, you can jump into a random game in a match making system similar to Left 4 Dead.\n\nThere are multiple classes to choose from, each with dozens of unlockable weapons. From flamethrowers to Tesla coils, theres a bit to pick from. These weapons are unlocked with experience Ala Call of Duty.\n\nWhile the game is a bit on the short side with only one 4 level campaign, it will still take you a few hours to get through. And with the varying difficulty levels, there is some replay value to be found. All in all, its a fun game worth picking up.\n\nOh, and did I mention it's free?", "timestamp_created": 1299469842, "timestamp_updated": 1385412598, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "916154", "author": {"steamid": "76561197981935407", "personaname": "8ushvvacker", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/8ushvvacker/", "num_games_owned": 456, "num_reviews": 30, "playtime_forever": 230, "playtime_last_two_weeks": 0, "playtime_at_review": 230, "last_played": 86400, "avatar": "623b6a04b9d15f5d28b9cb6e0062288309dc6437"}, "language": "english", "review": "Top down gameplay and tight co-op provide a solid gaming experience. The only downside to this \"diamond in the rough\" is it comprises of a single campaign, that is it. Unfortunatley the good folks at Valve have not got Alien Swarm on their to-do list.", "timestamp_created": 1299387329, "timestamp_updated": 1299387329, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "322145", "author": {"steamid": "76561197968573161", "personaname": "Raylen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/mistrblank/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 172, "playtime_last_two_weeks": 0, "playtime_at_review": 172, "last_played": 86400, "avatar": "9c796bbffea9c56a82b0943beea1a7873e6124f1"}, "language": "english", "review": "Download this, it's fun!", "timestamp_created": 1299387026, "timestamp_updated": 1299387026, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}