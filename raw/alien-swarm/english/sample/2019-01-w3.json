6561198061026720", "personaname": "Empress Roth", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/TheWolfsSky/", "num_games_owned": 2498, "num_reviews": 98, "playtime_forever": 189, "playtime_last_two_weeks": 0, "playtime_at_review": 164, "last_played": 1548048670, "avatar": "22c9c26334421966c7f57c1943396d8bd2374aed"}, "language": "english", "review": "The game's pretty fun, until the infestation mechanic starts showing up. At default brightness(which you'll use if you want the game to look nice) you can't see these facehuggers, which latch onto you and start leeching your health and only get knocked off with healing. Putting the game to max brigtness lets you see them, but makes the game look pretty bad. If the infestation mechanic was purged from orbit I'd recomend this game, but honestly it gets in the way of an otherwise enjoyable game", "timestamp_created": 1548081350, "timestamp_updated": 1548081350, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "48398933", "author": {"steamid": "76561198028673669", "personaname": "XJ9", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/nekomimibadik/", "num_games_owned": 7026, "num_reviews": 401, "playtime_forever": 4127, "playtime_last_two_weeks": 0, "playtime_at_review": 4127, "last_played": 1370439824, "avatar": "f4271059618e3d4683063153dc984266b27f7f49"}, "language": "english", "review": "One of the best F2P co-op games you could get on steam for the last 10 years, good times.\n\n+Source engine\n+Tons of monsters\n+Various ways to beat the game\n+Incredible difficulties\n+FREE\n-Online is pretty much dead now, its close to impossible to get a team to beat levels on Brutal difficulties\n\nCool game, even so it's a multiplayer oriented game, you can beat pretty much all levels alone", "timestamp_created": 1547809153, "timestamp_updated": 1547809153, "voted_up": true, "votes_up": 24, "votes_funny": 0, "weighted_vote_score": "0.716192662715911865", "comment_count": 4, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "48381689", "author": {"steamid": "76561198069515021", "personaname": "Therkelsen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/therkelsen/", "num_games_owned": 513, "num_reviews": 35, "playtime_forever": 75, "playtime_last_two_weeks": 0, "playtime_at_review": 75, "last_played": 1546191910, "avatar": "80746749b3cddc960cf4028e9aee07aac1b695f5"}, "language": "english", "review": "This is a really fun game to play with friends, but tbh it's kinda shiz ;)\nGood it for fun times with friends, though.", "timestamp_created": 1547726661, "timestamp_updated": 1547726728, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}