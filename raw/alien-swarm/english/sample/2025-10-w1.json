id": "206396213", "author": {"steamid": "76561199812090042", "personaname": "Broslow9000", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199812090042/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 232, "playtime_last_two_weeks": 0, "playtime_at_review": 112, "last_played": 1772078945, "avatar": "d4a021a62f3bf90479d6d4b6f8df69d942667fec"}, "language": "english", "review": "its hard but really fun ngl", "timestamp_created": 1760146832, "timestamp_updated": 1760146832, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "206169848", "author": {"steamid": "76561198307013223", "personaname": "Paladin0023", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198307013223/", "num_games_owned": 171, "num_reviews": 7, "playtime_forever": 9563, "playtime_last_two_weeks": 0, "playtime_at_review": 9563, "last_played": 1759901559, "avatar": "deb0a274b31b394c4acc63d93dddaf4b0b2f77b8"}, "language": "english", "review": "Old game that stands the test of time.\nGood to play with friends.\n\nA quick tip for anyone that wants to play solo:\nGo into your settings, and click the check mark for Console Usage. Probably has a different name than that, but whatever.\nThen, press ~ to open the command prompter.\nType in\n\n\"asw_ignore_need_two_player_requirement 1\"\n\nThis will make it so you can play alone, and believe me, the player base maxes out at 20 players on a good day.\nThis command resets whenever you close the game as an FYI.\n\nGood hunting out there marines.", "timestamp_created": 1759902617, "timestamp_updated": 1759902617, "voted_up": true, "votes_up": 19, "votes_funny": 0, "weighted_vote_score": "0.7203826904296875", "comment_count