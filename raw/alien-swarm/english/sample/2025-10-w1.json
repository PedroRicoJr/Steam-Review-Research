7, "count": 2}]}, {"recommendationid": "207711689", "author": {"steamid": "76561199685960578", "personaname": "twopixell", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199685960578/", "num_games_owned": 80, "num_reviews": 37, "playtime_forever": 15, "playtime_last_two_weeks": 0, "playtime_at_review": 15, "last_played": 1750673600, "avatar": "079133ef154dce5e7590e16833516e38cdaec309"}, "language": "english", "review": "I must praise the valve games.", "timestamp_created": 1761567327, "timestamp_updated": 1761567327, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "207559628", "author": {"steamid": "76561199815072984", "personaname": "Squids", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/evgassassin/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 1285, "playtime_last_two_weeks": 0, "playtime_at_review": 605, "last_played": 1770200767, "avatar": "1845ead92ea5d90fb7beb676ee6b2fccb82a8aac"}, "language": "english", "review": "Superb", "timestamp_created": 1761407989, "timestamp_updated": 1761407989, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "207505611", "author": {"steamid": "76561199107273601", "personaname": "✺NiKoTiN_EnD✺", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/NiKoTiN_EnD/", "num_games_owned": 240, "num_reviews": 15012, "playtime_forever": 63, "playtime_last_two_weeks": 0, "playtime_at_review": 63, "last_played": 1763744614, "avatar": "4c1b65c68502774818548e70fd226100cefcd036"}, "language": "english", "review": "Игра 'Alien Swarm' – это динамичный и напряженный кооперативный шутер с видом сверху, где команде морпехов предстоит отбиваться от полчищ инопланетных захватчиков. Игра дарит ощущение настоящего командного взаимодействия, ведь правильный выбор классов, грамотное распределение ролей и слаженные действия – залог выживания.\n\nЧто мне особенно понравилось: разнообразие классов с уникальными навыками и снаряжением, глубокая система прокачки персонажей, позволяющая тонко настроить их под свой стиль игры, а также мрачная и давящая атмосфера, идеально передающая чувство безысходности перед лицом инопланетной угрозы.\n\nНесмотря на свой возраст, игра выглядит достойно, а благодаря активному сообществу, всегда можно найти компанию для совместного прохождения. 'Alien Swarm' – отличный выбор для тех, кто ищет хардкорный и увлекательный кооперативный экшен, требующий от игроков тактического мышления и умения работать в команде. Однозначный рекомендую!", "timestamp_created": 1761352349, "timestamp_updated": 1761352349, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "207468727", "author": {"steamid": "76561199267646607", "personaname": "Rene Batergago", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199267646607/", "num_games_owned": 56, "num_reviews": 4, "playtime_forever": 70, "playtime_last_two_weeks": 0, "playtime_at_review": 10, "last_played": 1763993483, "avatar": "2a6decb8a75e6a56aaa4317608e7c4d2b4effef9"}, "language": "english", "review": "I got alien swarmed", "timestamp_created": 1761318398, "timestamp_updated": 1761318398, "voted_up": true, "votes_up": 0, "votes_