language": "english", "review": "Alien Swarm is a cooperative top-down shooter that offers a thrilling sci-fi action experience. The game, which is free to play on Steam, puts players in the role of a squad of elite space marines tasked with battling waves of deadly alien creatures.\n\nOne of the best things about Alien Swarm is its cooperative gameplay. The game is designed to be played with a team of up to four players, each taking on a specific role such as medic, tech specialist, or heavy weapons expert. Working together is essential to survive the game's intense battles, and the variety of roles and playstyles ensures that each player has a unique contribution to the team.", "timestamp_created": 1681493526, "timestamp_updated": 1681493526, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "136674606", "author": {"steamid": "76561198427365449", "personaname": "Zarathustra", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/cubeofskillofficial/", "num_games_owned": 763, "num_reviews": 425, "playtime_forever": 138, "playtime_last_two_weeks": 0, "playtime_at_review": 138, "last_played": 1661394108, "avatar": "a5172ddaf8a3f99baf1636a8e4cbc4d6003b3839"}, "language": "english", "review": "Alien Swarm: Reactive Drop is basically the same game with more content\nhttps://store.steampowered.com/app/563560/Alien_Swarm_Reactive_Drop/", "timestamp_created": 1681470246, "timestamp_updated": 1681470246, "voted_up": false, "votes_up": 3, "votes_funny": 2, "weighted_vote_score": "0.451363712549209595", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reac