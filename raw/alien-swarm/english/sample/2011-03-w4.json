76561197966610595", "personaname": "Kayman", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197966610595/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1345, "playtime_last_two_weeks": 0, "playtime_at_review": 1100, "last_played": 1616279981, "avatar": "6330c0531c83e7262767b52a29728f6801bcc289"}, "language": "english", "review": "Super cool co-op game. perfect for a game night with the friends", "timestamp_created": 1301501729, "timestamp_updated": 1301501729, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "1519053", "author": {"steamid": "76561197994104149", "personaname": ".", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197994104149/", "num_games_owned": 0, "num_reviews": 56, "playtime_forever": 767, "playtime_last_two_weeks": 0, "playtime_at_review": 690, "last_played": 1490377498, "avatar": "20bac5d5c2a5745260c63b694dfd71f266ae9a6c"}, "language": "english", "review": "Teamplay orientated game on Halflife2s mother of engines.\nSplatter your way through alien hordes in isometric view.\n\nFeatures a Technician who has to solve puzzles and hacks while others need to guard him.\nYou can Weld and Unweld doors for tactical situations.\n\nHas some Epic Maps like the Elevator (which looks like the One from the movie \"Akira\" btw when they go down to the Freezing thing).\n\nall in all i find all the usual Scifi ideas about aliens together in here, inspirations taken from a lot of movies and other games makes this one solid.\n\nPlay with your friends on LAN or Online, you wont regret it once youre into it. 2 players is hard but doable on EASY mode. \nFree 2 Play and just recently got a nice addon!", "timestamp_created": 1301489050, "timestamp_updated": 1502339431, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.484317362308502197", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "647819", "author": {"steamid": "76561197974176010", "personaname": "Dave", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197974176010/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 9226, "playtime_last_two_weeks": 0, "playtime_at_review": 8070, "last_played": 1478478191, "avatar": "274f03b19bafa55fe53596303f7170d198c81bed"}, "language": "english", "review": "A very nice game, its free too", "timestamp_created": 1301451047, "timestamp_updated": 1301451047, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}