cription": "NVIDIA GeForce GTX 1060 3GB", "vram_size": 2965}, "reactions": []}, {"recommendationid": "226773428", "author": {"steamid": "76561198011993087", "personaname": "PiGuVaya", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/piguvaya/", "num_games_owned": 2007, "num_reviews": 199, "playtime_forever": 3439, "playtime_last_two_weeks": 0, "playtime_at_review": 3439, "last_played": 1617454709, "avatar": "0646c2d74a943748483cbd49181eaac49ce0a605"}, "language": "english", "review": "Alien Swarm is one of those rare free games that still holds up because it knows exactly what it wants to be: a tight, fast, co‑op top‑down shooter with real tension and a great sense of teamwork. The missions are short but intense, the classes actually matter, and when everyone plays their role the game feels incredibly satisfying. It’s not huge in content and the campaign is over pretty quickly, but the replay value comes from trying different loadouts and pushing through on harder difficulties. Even after all these years, it’s still fun to jump in with friends and blast through hordes of aliens. For a free title, it delivers more quality and polish than many paid games.", "timestamp_created": 1780142991, "timestamp_updated": 1780142991, "voted_up": true, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.593488752841949463", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "226578502", "author": {"steamid": "76561198108538166", "personaname": "Lo Hye Pal Tamer", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/LoHye/", "num_games_owned": 313, "num_reviews": 79, "playtime_forever": 8, "playtime_last_two_weeks": 0, "playtime_at_review": 8, "last_played": 1779915437, "avatar": "bdb8c1c80ddc5fb68499a0ea7603b3108f6b4ab0"}, "language": "english", "r