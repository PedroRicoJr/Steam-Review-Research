squad doesn't need one of each, you can play with whoever you want, but some levels require a tech marine.\nOne thing I don't like in this game is that every class has a superior member who is better in pretty much every relevant way than the other one.\nI think this is one of the best game made by Valve, even though it's not that popular.", "timestamp_created": 1722839962, "timestamp_updated": 1722839962, "voted_up": true, "votes_up": 13, "votes_funny": 0, "weighted_vote_score": "0.671241164207458496", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": [{"reaction_type": 9, "count": 1}]}, {"recommendationid": "171203815", "author": {"steamid": "76561199085484278", "personaname": "Mincusdelux", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199085484278/", "num_games_owned": 10, "num_reviews": 4, "playtime_forever": 311, "playtime_last_two_weeks": 0, "playtime_at_review": 243, "last_played": 1722489004, "avatar": "28c5d9783ed598a5e309ed2ed49bc88f5f91bbc8"}, "language": "english", "review": "good game", "timestamp_created": 1722484839, "timestamp_updated": 1722484839, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}