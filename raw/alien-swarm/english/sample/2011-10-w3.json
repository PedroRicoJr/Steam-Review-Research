at_review": 964, "last_played": 1424550481, "avatar": "3b8a8ebda634a67a2a18ef75ffc8f8cb6842ed84"}, "language": "english", "review": "Whenever I think about AS all that comes to mind is \"God I wish there were more games like this\"  \n\nAS started out as a mod and then the devs started working on an independent game.  In the process they got picked up and hired by Valve and all of their work was generously put up for free on Steam.  \n\nWhat's crazy or maybe a little sad is that AS is free and it's 10 times better than most AAA titles.  \n\nAS is not for the casual gamer, it requires very coordinated group effort to complete a mission, which is the best feature of the game.", "timestamp_created": 1318979061, "timestamp_updated": 1424035847, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}