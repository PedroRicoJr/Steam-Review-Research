{"game": "alien-swarm", "language": "english", "appid": 630, "month": "2023-07", "window": 4, "start_date": 1690156800, "end_date": 1690847999, "month_true_total": 28, "quota": 5, "returned": 5, "pulled_at": "2026-10-06 01:09:35 UTC", "reviews": [{"recommendationid": "143153532", "author": {"steamid": "76561198862172679", "personaname": "Sn3akyWheel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198862172679/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 254, "playtime_last_two_weeks": 0, "playtime_at_review": 182, "last_played": 1690925623, "avatar": "91850c48e61f7b9fbc48ea4d5720f231966199fb"}, "language": "english", "review": "Created by Valve, Alien Swarm is a multiplayer shooter game where you and other players follow a campaign through a dark future where aliens have decimated a colony and it's up to you and your team to stop them before they spread. There are four classes you can play as, a Cadet, a Special Weapons, a Medic, and a Tech. Each with their own tools and gadgets that they can use. Players must work together to reach the end of the map while the alien swarms try to kill them off. There are many types of aliens that you fight, each with their own mechanics. To find out the rest, try the game for yourself! The game has a very tense atmosphere so do be advised. And last but not least, there is a free hat for Team Fortress 2 that can be unlocked from one of the achievements here, so give it a try!", "timestamp_created": 1690820892, "timestamp_updated": 1690820892, "voted_up": true, "votes_up": 8, "votes_funny": 2, "weighted_vote_score": "0.582498669624328613", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "143103204", "author": {"steamid": "76561199156097898", "personaname": "the.rigby.clan", "persona_status": "of