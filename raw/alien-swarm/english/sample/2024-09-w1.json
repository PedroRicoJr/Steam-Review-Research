{"game": "alien-swarm", "language": "english", "appid": 630, "month": "2024-09", "window": 1, "start_date": 1725148800, "end_date": 1725753599, "month_true_total": 24, "quota": 5, "returned": 4, "pulled_at": "2026-10-06 01:11:04 UTC", "reviews": [{"recommendationid": "174458883", "author": {"steamid": "76561198764654740", "personaname": "Nickinator811", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198764654740/", "num_games_owned": 619, "num_reviews": 54, "playtime_forever": 166, "playtime_last_two_weeks": 0, "playtime_at_review": 166, "last_played": 1725409696, "avatar": "160b05e4415d7b04975f916c408eaebe935e6496"}, "language": "english", "review": "This is a great Free to play Overhead Alien shooter, It runs well, it looks great for a source engine game, The gameplay is solid Its basically a top down arcade style shooter, the controls are simple, the game is fun to play with friends, if you have a full squad it can be really fun to take down aliens and complete objectives, you have access to health and ammo crates to equip to your character, each character gets 1 gadget, and you can equip a sentry to a class should you need it later on. Overall the game is solid but some of the puzzles can be confusing to complete especially while the horde is coming after you.\r\n\r\nI would say Try this game out, stick around to play 2 co op missions with someone and you get a tf2 hat out of it", "timestamp_created": 1725730310, "timestamp_updated": 1725730310, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "174354233", "author": {"steamid": "76561198103761090", "personaname": "《H☆lløwZ》", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/7656119810