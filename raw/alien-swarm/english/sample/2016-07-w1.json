{"game": "alien-swarm", "language": "english", "appid": 630, "month": "2016-07", "window": 1, "start_date": 1467331200, "end_date": 1467935999, "month_true_total": 144, "quota": 5, "returned": 5, "pulled_at": "2026-10-06 01:00:33 UTC", "reviews": [{"recommendationid": "24163648", "author": {"steamid": "76561197978652697", "personaname": "MuD", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197978652697/", "num_games_owned": 449, "num_reviews": 64, "playtime_forever": 2711, "playtime_last_two_weeks": 0, "playtime_at_review": 2711, "last_played": 1331967600, "avatar": "db8cbd76af0ca5fda12283a05fb5697a350b4c64"}, "language": "english", "review": "This is one of those rare gems that lasted a few weeks and was almost completely dead.  I remember waiting for this game to release.  A few buddies of mine really enjoyed playing it and we all topped out in rank and unlocks and there was just no reason to play it anymore... It's a shame, really.  The original idea was to give the Steam members at the time a gift for all the support.  I mean, yeah it was free so I didn't expect them to support it for long.  However, I would pay full price for this if they decided to give it a comeback and start adding new maps and fixing it up.  Like others have said already, it was definitely a blast while it lasted!", "timestamp_created": 1467916970, "timestamp_updated": 1467916970, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "24163407", "author": {"steamid": "76561198131890573", "personaname": "Brad Mays", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198131890573/", "num_games_owned": 0, "num_reviews": 49, "playtime_forever": 91, "playtime_last_two_we