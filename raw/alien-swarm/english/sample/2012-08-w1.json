 "1874205", "author": {"steamid": "76561197999151586", "personaname": "Pappa Beertjie", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/beertjie-poen/", "num_games_owned": 0, "num_reviews": 71, "playtime_forever": 6325, "playtime_last_two_weeks": 0, "playtime_at_review": 6237, "last_played": 1368687600, "avatar": "db1382126b55a2709386f99d0727732927d42cd2"}, "language": "english", "review": "The first free to play game on Steam, and still the best one. Alien Swarm is a game my cousin and I keep going back to for more alien-shooting fun.\n\nThere are plenty of difficulty levels and a diverse arsenal of weapons and characters to choose from. This helps keep the game interesting in spite of its relatively short campaign and considerable lack of high quality community maps. I wish Valve would take this idea and make it into a larger, more complete game – I'd certainly be willing to put down a hefty sum for it.", "timestamp_created": 1343942841, "timestamp_updated": 1343942841, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}