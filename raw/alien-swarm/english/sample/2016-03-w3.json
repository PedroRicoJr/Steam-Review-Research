the Technician. You're the Technician and you're alone ? Don't kid yourself, you're doomed.\n\nSo what is this game ? An excellent tactical team-building experience. Go in with two or three friends that you trust and are ready to commit, and you will have a blast.\n\nGo in with a half-hearted, twitch-trigger, careless teammate and you will be counting the failures.\n\nOh, and never stray from the group. Alone means death, pure and simple.", "timestamp_created": 1458680844, "timestamp_updated": 1458680908, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "21973589", "author": {"steamid": "76561198122446688", "personaname": "Kolbolt", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Kolbolt12/", "num_games_owned": 450, "num_reviews": 100, "playtime_forever": 132, "playtime_last_two_weeks": 0, "playtime_at_review": 58, "last_played": 1504660101, "avatar": "89796a2b46221fa50091134e6999a0dd4e4da91f"}, "language": "english", "review": "Just buy man Just buy", "timestamp_created": 1458604965, "timestamp_updated": 1458604965, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}