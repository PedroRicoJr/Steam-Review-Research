"profile_url": "https://steamcommunity.com/id/Red578/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 2092, "playtime_last_two_weeks": 0, "playtime_at_review": 2092, "last_played": 1366441200, "avatar": "f54b98c71b59464463757c8a55d7d63645524122"}, "language": "english", "review": "I have had a great time playing this. Meet some cool people as you play this game, never getting old. Only con is that you have to rely on the public to continue the story by making maps as tthe main campaign is short and you need to download your own maps.", "timestamp_created": 1412635135, "timestamp_updated": 1412635135, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "12393270", "author": {"steamid": "76561198003570750", "personaname": "Deadlock", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198003570750/", "num_games_owned": 0, "num_reviews": 234, "playtime_forever": 787, "playtime_last_two_weeks": 0, "playtime_at_review": 787, "last_played": 1406407705, "avatar": "374de5dbe78960490a471455e8d925faef7494be"}, "language": "english", "review": "I'm Dutch. Dutch people like free stuff. Especially if it's an awesome game like this one.\n\nIt's a little short, but hey, it's free.\n\nYou should really play this game on a LAN party, with 3 other friends (they can also download it, because it's free).\n\nIt's a lot of fun to move through the maps as a squad, covering each others backs or shooting the crap out of your team mates with a grenade launcher, I guess that can be fun too.\n\nThe missions are varied (and free) and the pace of the game is pretty high, which is nice.\n\nOh and did I mention this game is free?\n", "timestamp_created": 1412632227, "timestamp_updated": 1412632227, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "12386867", "author": {"steamid": "76561198009778124", "personaname": "Sai", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/loneknightd/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 761, "playtime_last_two_weeks": 0, "playtime_at_review": 478, "last_played": 1611227040, "avatar": "abdbf1dc089495872444c11fa3f10f85b72c7e1d"}, "language": "english", "review": "Fantastic world building surrounds a fast paced top down shooter that's heavily inspired by the Alien movies. It's one of the best Co-op games I've ever had the pleasure of playing. \n\nIt's free, but I'd gladly hand over cash for it and would be first in line to buy and futher missions.", "timestamp_created": 1412592720, "timestamp_updated": 1412592720, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}]}