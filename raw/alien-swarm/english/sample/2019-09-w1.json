ords from myself: This game is the best free game for coop ever. It is just so much fun to play with your friends, or even with randoms. It is challenging, but not impossible, has big amount of possible tactics, large variety of weapons and active use items. Every member of the team will have his own role, so no one would feel useless. Very recommended for people searching for what to play with friends.\n", "timestamp_created": 1567931671, "timestamp_updated": 1567931671, "voted_up": true, "votes_up": 0, "votes_funny": 2, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "55011513", "author": {"steamid": "76561198195257851", "personaname": "Mike Hondum", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198195257851/", "num_games_owned": 107, "num_reviews": 4, "playtime_forever": 1389, "playtime_last_two_weeks": 0, "playtime_at_review": 1153, "last_played": 1587319484, "avatar": "9e3591459bd90fe5314ef556c02fe26b338324c2"}, "language": "english", "review": "hands down one of my favorite games on steam have played many times. it is really plus ITS FRREEEEEEE!", "timestamp_created": 1567909837, "timestamp_updated": 1567909837, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.494252860546112061", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1279569600", "reactions": []}, {"recommendationid": "55007349", "author": {"steamid": "76561197975784062", "personaname": "iAwp", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/iAwpX/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 6306, "playtime_last_two_weeks": 0, "playtime_at_review": 