mmendationid": "110225371", "author": {"steamid": "76561198254136898", "personaname": "croak", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198254136898/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 4531, "playtime_last_two_weeks": 0, "playtime_at_review": 1888, "last_played": 1741080879, "avatar": "d9a2379c5ebe08fa373799e0d54b2f60a0ba5e55"}, "language": "english", "review": "If you like ROR2 or Issac you'll like this. Instead of 'items' the main chase loot drops are weapons, theres a good variety of base weapons but they drop with random rolls known as 'affixes' There are green, blue and active affixes that can roll on any weapon, the active is a right click alt fire but the other 2 are the important ones that significantly alter a weapons strength. more rolls = more extravagant beams on the item, its pog when you see one drop. Theres also a currency you collect across runs to unlock permanent upgrades and a machine at the start of each stage to reroll your weapons affixes. Some reviews suggest waiting for content, as of this review (feb 2022) theres plenty of content, at time of writing i've bought all the upgrades but havent yet finished all the possible paths you can take to the end of the game, theres plenty more content to come but the game has more than enough content to justify the early access price, also has a feedback button in game so you can report bugs etc and they're quickly addressed.", "timestamp_created": 1644848217, "timestamp_updated": 1645196892, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "110191222", "author": {"steamid": "76561198007930488", "personaname": "RippleNipple", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198007930488/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 1418, "playtime_last_two_weeks": 0, "playtime_at_review": 1138, "last_played": 1732669781, "avatar": "62b40357c3cf2b9db0dcf975e75eb4718ba4127e"}, "language": "english", "review": "I've thoroughly enjoyed my time with this game.  I've experienced most or all of what there is to do in the game but keep it installed and updated.  Sometimes I just want to do a run but most of the time I just want to experience the absolute banger OST!  \n\nGreat job devs you made a big fan with me! (Keep whoever made the music at all costs)", "timestamp_created": 1644798214, "timestamp_updated": 1644798214, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "110184991", "author": {"steamid": "76561198013698005", "personaname": "RedGuy Johnson", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/2239/", "num_games_owned": 0, "num_reviews": 55, "playtime_forever": 8676, "playtime_last_two_weeks": 0, "playtime_at_review": 159, "last_played": 1713246598, "avatar": "1893d7c151ac71f1182e4097df5072dbfd996d6c"}, "language": "english", "review": "95% of the time the only question you'll have is, \"what actually hit me\"\n\nEdit: 95% of the time the only question the enemies have for me is, \"what actually hit me\"", "timestamp_created": 1644790742, "timestamp_updated": 1658951769, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.477941185235977173", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}