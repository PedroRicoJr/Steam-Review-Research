561199541890866/", "num_games_owned": 27, "num_reviews": 2, "playtime_forever": 7901, "playtime_last_two_weeks": 0, "playtime_at_review": 2912, "last_played": 1788851155, "avatar": "30ff1edddb21bac635bbd9b59036d23827a9dd22"}, "language": "english", "review": "There are a lot of things I love about this game, the game play loop is fun, the gun play is satisfying and well made and there are a good verity of upgrades and combos. \r\nThe addition of multiplayer is fantastic, even if you play through the game yourself, playing the game with a friend after is just as fun. Trying to make collaborating builds just adds another element to the game. \r\n\r\nThe only thing I really think it needs is a way to ping things other then guns in multiplayer and maybe some more gun options but all in all its fun, fast paced and charming to boot. 8/10", "timestamp_created": 1760452242, "timestamp_updated": 1760452242, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}