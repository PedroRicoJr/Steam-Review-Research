uage": "english", "review": "Really good", "timestamp_created": 1706019048, "timestamp_updated": 1706038847, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "156617926", "author": {"steamid": "76561198072862006", "personaname": "skunkmeister1", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198072862006/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 2152, "playtime_last_two_weeks": 0, "playtime_at_review": 1977, "last_played": 1706400596, "avatar": "469a7edbbd4db2d21799320bdca7ef73a9dc15d8"}, "language": "english", "review": "This sort of game is usually not my favourite, but Roboquest won me over. Lots of fun and meaningful builds with the roguelike elements and the core shooting and gameplay is addictive and fun. Music is also great, didn't find any major bugs as I played it.\n\nThe permanent progression in the forms of unlocking the crystals and finding the items isn't my favourite element, so I looked up how to do a lot of and it didn't stop me having fun. Most people will probably like the exploring and finding new paths organically but my attention is terrible so I'm fine looking it up.", "timestamp_created": 1706007691, "timestamp_updated": 1706007691, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}