]}, {"recommendationid": "101884410", "author": {"steamid": "76561198048458363", "personaname": "Mildly Irritating Mann", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198048458363/", "num_games_owned": 0, "num_reviews": 45, "playtime_forever": 5226, "playtime_last_two_weeks": 0, "playtime_at_review": 177, "last_played": 1700696011, "avatar": "b56fb65ee43c606c2f254bda4025c1b007cb5c9e"}, "language": "english", "review": "haha robot goes stomp", "timestamp_created": 1635599115, "timestamp_updated": 1635599115, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "101874010", "author": {"steamid": "76561198124528378", "personaname": "Squired", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198124528378/", "num_games_owned": 349, "num_reviews": 173, "playtime_forever": 475, "playtime_last_two_weeks": 0, "playtime_at_review": 113, "last_played": 1719306841, "avatar": "d73805e5ffecea31d76b342a7254b543a63dd7dd"}, "language": "english", "review": "I usually don't review games this early, but I think this game is the exception. Ever since Borderlands I've been looking for a game that gets the shooter feeling right - with the plus being the cel shaded artsyle. Somehow I stumbled upon this game, and it just fits. The gun play is right. The movement is up there. Has cute art as well! \n\nIt does however need time to actually be polished, and have the means to be even better. Looking at the road map it seems we have a long update to get there, but it should reach it by its' release. Don't disappoint devs and you'll definitely have a contender for a great shooter movement game.", "timestamp_created": 1635587636, "timestamp_updated": 1635587636, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.552522182464599609", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "101870386", "author": {"steamid": "76561198185065583", "personaname": "Hat Mouse", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hatmouse40/", "num_games_owned": 0, "num_reviews": 25, "playtime_forever": 2902, "playtime_last_two_weeks": 0, "playtime_at_review": 288, "last_played": 1721838593, "avatar": "819a1ef343b773ade81103af89840553a84ebb99"}, "language": "english", "review": "For an early access game, this looks very promising. The variety of weapons that is already in the game surprised me, especially because the gun-game feels very polished and good. There is a solid road map to look forward to and i felt obligated to leave at least a comment, to support the developers. Great work - keep it up!", "timestamp_created": 1635583250, "timestamp_updated": 1635583250, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.536679506301879883", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}