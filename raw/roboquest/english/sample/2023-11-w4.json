s": 0, "playtime_at_review": 1654, "last_played": 1732869940, "avatar": "fa684a7986e5604d5d09b76ff1949bb722d56b06"}, "language": "english", "review": "One of the best co-op games I've played in the last few years. If the devs ever read this Great Job!!! on making a game that is some how intense and relaxing the play at the same time.", "timestamp_created": 1701334287, "timestamp_updated": 1701334287, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152567106", "author": {"steamid": "76561197970464457", "personaname": "Diesel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/DjDoktorDiesel/", "num_games_owned": 0, "num_reviews": 119, "playtime_forever": 2808, "playtime_last_two_weeks": 0, "playtime_at_review": 2218, "last_played": 1702940572, "avatar": "de2ec27182263877f517a0dfdcc45c8931344de9"}, "language": "english", "review": "The game has a rather steep learning curve as it tells you almost nothing about it's mechanics but once you play a few rounds on the easiest setting to get the feel for it, it becomes very much like GunFire Reborn or Pain Killer.  Better than GunFire but not as good as Pain Killer (PK had better weapons IMO).", "timestamp_created": 1701331920, "timestamp_updated": 1702152152, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152566514", "author": {"steamid": "76561197969509060", "personaname": "ChipWolf", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/chipwolf/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 1152, "playtime_last_two_weeks": 0, "playtime_at_review": 183, "deck_playtime_at_review": 7, "last_played": 1702181825, "avatar": "61651eed6935b994297802c692490d64810e57e6"}, "language": "english", "review": "If you like Gunfire Reborn, Borderlands, or really any highly polished FPS, you'll like this. Just play it. Definitely got that \"just one more run\" vibe.", "timestamp_created": 1701330805, "timestamp_updated": 1701330928, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152562384", "author": {"steamid": "76561199082571967", "personaname": "spectral", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/meisnotcool/", "num_games_owned": 0, "num_reviews": 39, "playtime_forever": 1722, "playtime_last_two_weeks": 0, "playtime_at_review": 309, "last_played": 1735592454, "avatar": "4e3536bcb6a42f77252c36fb3ae61743b728060e"}, "language": "english", "review": "ultrakill for straight people", "timestamp_created": 1701323300, "timestamp_updated": 1705129867, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152561757", "author": {"steamid": "76561198000730178", "personaname": "happy-trail cam", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/kaimtime/", "num_games_owned": 396, "num_reviews": 9, "playtime_forever": 937, "playtime_last_two_weeks": 0, "playtime_at_review": 937, "last_played": 1701322140, "avatar": "79108c5393de96087a031653998026ab80a97781"}, "language": "english", "review": "ya it good", "timestamp_created": 1701322195, "timestamp_updated": 1701322195, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152561640", "author": {"steamid": "76561199177542830", "personaname": "Getting Killed by Geese", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/egg_addict/", "num_games_owned": 265, "num_reviews": 21, "playtime_forever": 417, "playtime_last_two_weeks": 0, "playtime_at_review": 238, "last_played": 1756617920, "avatar": "cddc3d076fe317972067da83bf5951e6ac7f7fbe"}, "language": "english", "review": "extremely fun game. clean and fluid movement, very fun weapons, amazing art style, and plenty of attention to detail. the game focuses very much on being fun, which is a good thing. i also love that it doesn't punish you or reduce rewards for selecting a lower difficulty, so if you want to just relax and have fun, you absolutely can. hard mode does give you a little extra, but that's it. the difficulty settings feel really good with the way it scales. i also really love when rogue likes let you build absolutely insane builds. gunplay feels very good. the game also runs really well, max settings 4k resolution was running over 210 fps constantly on my 3080ti. overall, absolutely worth the buy.", "timestamp_created": 1701322030, "timestamp_updated": 1701322030, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152559620", "author": {"steamid": "76561198033744428", "personaname": "Hyper", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198033744428/", "num_games_owned": 554, "num_reviews": 84, "playtime_forever": 1493, "playtime_last_two_weeks": 0, "playtime_at_review": 980, "last_played": 1701902010, "avatar": "4efe1e4699f427f3dac9a9bf9d66c9968d91db66"}, "language": "english", "review": "this game has what i think the new Doom games are lacking. smoother gameplay and more variety when it comes to weapons and abilities even though 70% of the weapons are kinda useless sadly because they have no good synergy with anything. all this game needs is a few more updates with new maps enemies etc. and most of all some weapon balancing with the addition of some more perks that give the bad ones better synergy with your builds cause i see myself gravitating to the same weapons and perks every run since it makes me basically oneshot everything. the music is great and the graphics are more than passable for a game like this. definitely the best rougelite shooter on the market right now it just needs a bit more of everything", "timestamp_created": 1701318989, "timestamp_updated": 1701318989, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152559139", "author": {"steamid": "76561197986121377", "personaname": "-Pro-", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561197986121377/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 16792, "playtime_last_two_weeks": 0, "playtime_at_review": 14883, "last_played": 1735849062, "avatar": "9d79d29fe5800761e532cbf25c7b69a5e3b12cde"}, "language": "english", "review": "I spent hundreds of hours playing this in early access, which means I like it. I was pleased to find that the 1.0 is much more fleshed out than I expected with many more side areas, skill paths, and progression features. Other games combine classes, guns, skill, meta progression, and run choices, but most are compromised in some way such as focusing overly on mechanics without atmosphere, level design, or proper \"feel\". I'm tired of \"pixel\" graphics and other compromises that aren't pleasing to look at. Roboquest has pleasing graphics, level design, progression, and mechanics, bla bla. I love this game and you should buy it.", "timestamp_created": 1701318230, "timestamp_updated": 1701318230, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.519999980926513672", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152556839", "author": {"steamid": "76561199021976913", "personaname": "dutch clutch", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199021976913/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 18426, "playtime_last_two_weeks": 0, "playtime_at_review": 3387, "last_played": 1785617623, "avatar": "235e6e10cd66af9a6c42020f8053cf3a32508522"}, "language": "english", "review": "just buy it", "timestamp_created": 1701314795, "timestamp_updated": 1701314795, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152554512", "author": {"steamid": "76561198043248515", "personaname": "Tsubear", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/tsubani/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 3429, "playtime_last_two_weeks": 0, "playtime_at_review": 1915, "last_played": 1703558964, "avatar": "a5172ddaf8a3f99baf1636a8e4cbc4d6003b3839"}, "language": "english", "review": "Crazy fun, fast paced fps Rougelike. I wish more games had this smoothness and flow this game has, not to mention this awesome soundtrack. More DOOM like level designs and whatnot would be super welcome as I love being able to zip around the environment and blast through bots.", "timestamp_created": 1701311351, "timestamp_updated": 1701311351, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.516129076480865479", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "152554473", "author": {"steamid": "76561199148278268", "personaname": "Gecko Jesus", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199148278268/", "num_games_owned": 177, "num_reviews": 54, "playtime_forever": 1124, "playtime_last_two_weeks": 0, "playtime_at_review": 212, "last_played": 1736971828, "avatar": "c718f08730255dee93624134ec76cd1ee07694ba"}, "language": "english", "review": "fun shoot stabby game go brr for my tism\n", "timestamp_created": 1701311288, "timestamp_updated": 1701311288, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": [{"reaction_type": 19, "count": 1}]}, {"recommendationid": "152554199", "author": {"steamid": "76561198058831591", "personaname": "Coach Twig", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/gormobro/", "num_games_owned": 486, "num_reviews": 126, "playtime_fore