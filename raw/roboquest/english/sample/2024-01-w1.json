forever": 7088, "playtime_last_two_weeks": 0, "playtime_at_review": 6599, "last_played": 1782816600, "avatar": "dae2f35d814e852dadcef0a2141fcc8dfcd69034"}, "language": "english", "review": "10/10 game lots of fun\n\nAlso devs, please let people add mods to the game, I am really curious to see what the community can add to this game", "timestamp_created": 1704635347, "timestamp_updated": 1723659814, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155476605", "author": {"steamid": "76561198074014940", "personaname": "JJ Old", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/brednotderb/", "num_games_owned": 353, "num_reviews": 8, "playtime_forever": 1745, "playtime_last_two_weeks": 0, "playtime_at_review": 755, "last_played": 1728256718, "avatar": "0bed502f970cb85e5d646b31534904cf92b7b52e"}, "language": "english", "review": "This game is so good that after completing every character on game pass, i bought it here just to give the devs the money and started all over again.\n\nWithout comparison it's the most fun i have had with any FPS before, a GIGANTIC thumbs up. Play this game if it's the last thing you do <3", "timestamp_created": 1704634325, "timestamp_updated": 1704634325, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155475148", "author": {"steamid": "76561197995073900", "personaname": "Angelore", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/angelore/", "num_games_owned": 616, "num_reviews": 55, "playtime_forever": 3482, "playtime_last_two_weeks": 0, "playtime_at_review": 2093, "last_played": 1733088037, "avatar": "3ba073c6d794a772927c0fd73691b68682f20bbd"}, "language": "english", "review": "Very fun in co-op. Haven't really tried it solo so far.\nWish it had more music and/or longer tracks. While current score is good, it gets repetitive after a while.", "timestamp_created": 1704633000, "timestamp_updated": 1704633000, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155474687", "author": {"steamid": "76561198015834083", "personaname": "painkiller994", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/gryphon994/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 3147, "playtime_last_two_weeks": 0, "playtime_at_review": 3054, "last_played": 1763655085, "avatar": "b698f81978cd408b5e210f5b5c09d308ae75165b"}, "language": "english", "review": "you lose track of time a really good game", "timestamp_created": 1704632571, "timestamp_updated": 1733030587, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155468795", "author": {"steamid": "76561198119993103", "personaname": "Claudiuyoro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/claudiuyoro/", "num_games_owned": 101, "num_reviews": 34, "playtime_forever": 1838, "playtime_last_two_weeks": 0, "playtime_at_review": 308, "last_played": 1717862265, "avatar": "d1d9fbb4b4e9cd0a88dd3d2dd99465da222313e0"}, "language": "english", "review": "TAKA TAKA TAKA TAKA TAKA TAKA.\n\nExcellent game: My first experience with it.\nhttps://www.youtube.com/watch?v=CsHcrMJ52qo&ab_channel=Claudiuyoro", "timestamp_created": 1704626572, "timestamp_updated": 1704626572, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155466934", "author": {"steamid": "76561198006868551", "personaname": "Lughs_Revenge", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198006868551/", "num_games_owned": 1037, "num_reviews": 56, "playtime_forever": 1299, "playtime_last_two_weeks": 0, "playtime_at_review": 1299, "last_played": 1704623966, "avatar": "d9c8090d40f08977d4e697650e08c4ac5fc10deb"}, "language": "english", "review": "One of the few roguelites that deserve the full price, even after 20 hours I still find some interesting synergies (i.e. having one gun that has long reload time pairing with a gun that refills the ammo of your other gun when taking down a foe) both gun-wise as well as class-wise as you unlock up to 5 robots with each unique playstyles. \n\nYou also keep unlocking levels by taking different paths, unlocking perks by spending a resource that you get from clearing a complete run. Highly repeatable.\n\nP.S.: Do not hesitate to start at easy mode, even if you're experienced FPS before. You gotta get some muscle memory and perks to make it happen without you tryharding. Also when you find codes for doors, write them down - they are specific to your game and can't be looked up on guides/internet.", "timestamp_created": 1704624459, "timestamp_updated": 1704624459, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155465755", "author": {"steamid": "76561198128395054", "personaname": "prohasky", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198128395054/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 2624, "playtime_last_two_weeks": 0, "playtime_at_review": 886, "last_played": 1726397020, "avatar": "01e27d4512980345c368da2627e865c5f416f57c"}, "language": "english", "review": "good stuff", "timestamp_created": 1704623109, "timestamp_updated": 1704623109, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155464687", "author": {"steamid": "76561198057902088", "personaname": "shapaco", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198057902088/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 29804, "playtime_last_two_weeks": 5, "playtime_at_review": 10915, "last_played": 1790493213, "avatar": "1dfc4d3f84eb1831fb491f2e926ca760599cced7"}, "language": "english", "review": "This is an excellent game. I like how the color-pallet in this game is very uplifting and you aren't actually killing anybody in this game (only destroying robots). It is so fun and I cannot stop playing it. If you don't like competitive multiplayer fps games but still want to experience a lot of action, then you gotta play this game.", "timestamp_created": 1704621832, "timestamp_updated": 1704621832, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "writte