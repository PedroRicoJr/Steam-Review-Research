se, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155512718", "author": {"steamid": "76561198080971814", "personaname": "SLNEE", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198080971814/", "num_games_owned": 132, "num_reviews": 9, "playtime_forever": 2447, "playtime_last_two_weeks": 0, "playtime_at_review": 1787, "last_played": 1738352598, "avatar": "20278972f12e1954a5b60bdd7a38010807daefbb"}, "language": "english", "review": "Epic game! Epic Soundtrack!", "timestamp_created": 1704665187, "timestamp_updated": 1704665187, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155511037", "author": {"steamid": "76561198973254865", "personaname": "Doggo", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/howarealltheidstaken/", "num_games_owned": 226, "num_reviews": 13, "playtime_forever": 2410, "playtime_last_two_weeks": 0, "playtime_at_review": 475, "last_played": 1789171863, "avatar": "5f466d460ebc494ee2459e0bb0f250f3bffa3a80"}, "language": "english", "review": "my brobot has autism", "timestamp_created": 1704663554, "timestamp_updated": 1704663554, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155508839", "author": {"steamid": "76561198198680293", "personaname": "Ligg minut", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/BradberryBrothers/", "num_games_owned": 99, "num_reviews": 18, "playtime_forever": 7488, "playtime_last_two_weeks": 0, "playtime_at_review": 345, "last_played": 1774315035, "avatar": "8d883932d3b169f46340fa0246d83051cf6feda3"}, "language": "english", "review": "The designers of Roboquest know where to put their money. Tons of work has gone into enemy variety, weapon variety, level variety, and the satisfaction given to the player during gameplay. I have yet to beat the moon level but this game is a masterpiece indie rougelike, combining easy to understand concepts with a complex and interesting gameplay loop. \n\nIf you like fps games, play Roboquest. If you like rougelikes, play Roboquest. I hope with time that this game gets additional support and content from RyseUp!", "timestamp_created": 1704661482, "timestamp_updated": 1704661482, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "155507958", "author": {"steamid": "76561198001371305", "personaname": "CEMBLE", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/cemble777/", "num_games_owned": 439, "num_reviews": 37, "playtime_forever": 1717, "playtime_last_two_weeks": 0, "playtime_at_review": 1717, "last_played": 1704651222, "avatar": "cd9dc4d7c22609d659a327e382b43c725af82811"}, "language": "english", "review": "Roboquest is a game where you shoot robots, loot robots, and upgrade your robot. It is a generic arcade shooter with robots.\n\nIt can be slow at first but more you play more you enjoy.\n\nI wish we could customise the robots in some extend.\n\nthe worst part is that the maps not fully but somewhat repeats themselfs. Nontheless, it is really fun to play.", "timestamp_created": 1704660696, "timestamp_updated": 1704660696, "voted_up": true, "vot