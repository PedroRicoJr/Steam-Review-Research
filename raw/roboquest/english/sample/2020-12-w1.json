t": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "81635230", "author": {"steamid": "76561198058440981", "personaname": "XoggWizard", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/XoggWizard/", "num_games_owned": 644, "num_reviews": 9, "playtime_forever": 2682, "playtime_last_two_weeks": 0, "playtime_at_review": 436, "last_played": 1779323585, "avatar": "f37e8d7c131502c8a84de6e58af41a7e0372ff77"}, "language": "english", "review": "This game is good now. The combat flow is silky smooth.", "timestamp_created": 1607143339, "timestamp_updated": 1674449143, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "81570877", "author": {"steamid": "76561197997406757", "personaname": "JRodslegend", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/JRodslegend/", "num_games_owned": 959, "num_reviews": 25, "playtime_forever": 582, "playtime_last_two_weeks": 0, "playtime_at_review": 298, "last_played": 1779759300, "avatar": "668451ea40c724ac074b0ef171efde3ca9fbe283"}, "language": "english", "review": "Here's the thing. The gameplay in this game is absolutely incredible. For ANY FPS out there, its really impressive how fluid and crisp this feels. It just does NOT get old to play. HOWEVER, being early access, the problem lies with content. There just isnt much out there. If you start on standard and have any experience at all at boomer shooters or arena shooters, youll beat it your first go around. Move onto the next difficulty and youll probably beat it in a couple tries and unlock a next difficulty. but then thats it. There isnt much to the base system, I think I unlocked everything in about 3 hours of playtime, which accounted to maybe 5 playthroughs. There is no online mode yet which i feel would add so much replayability, but as it stands now... There is just not much to do. And thats OK! I give it a pass since it is Early Access and more content is coming, and again, it is honestly one of the most crisp and impressive feeling fps games i have played, running and sliding around fragging enemies just does not get old. There just needs to be more to do.", "timestamp_created": 1607062508, "timestamp_updated": 1607062508, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "81551778", "author": {"steamid": "76561198138324236", "personaname": "", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198138324236/", "num_games_owned": 365, "num_reviews": 55, "playtime_forever": 581, "playtime_last_two_weeks": 0, "playtime_at_review": 273, "last_played": 1760415846, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "Society destroyed by buff robo", "timestamp_created": 1607033152, "timestamp_updated": 1607033152, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}