{"game": "roboquest", "language": "english", "appid": 692890, "month": "2025-03", "window": 3, "start_date": 1742083200, "end_date": 1742774399, "month_true_total": 222, "quota": 5, "returned": 5, "pulled_at": "2026-10-03 01:54:57 UTC", "reviews": [{"recommendationid": "191033640", "author": {"steamid": "76561198025198873", "personaname": "magicalfishduck", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/magicalfishduck/", "num_games_owned": 227, "num_reviews": 12, "playtime_forever": 2661, "playtime_last_two_weeks": 0, "playtime_at_review": 704, "last_played": 1765399862, "avatar": "3604ac34b47c87e187d151f22aa17e107253ce34"}, "language": "english", "review": "Crispy gunplay, smooth movement, banger soundtrack, and vibrant artstyle makes this game hard to put down. \r\n\r\nThe game has plenty of secrets and branching paths that allow for each play through to be different. There's also multiple different classes and a good variety of weapons to fill different playstyles.", "timestamp_created": 1742771278, "timestamp_updated": 1742771278, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "191016935", "author": {"steamid": "76561198097670533", "personaname": "Pluszowy iloczyn kartezjański", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198097670533/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 3652, "playtime_last_two_weeks": 0, "playtime_at_review": 2462, "last_played": 1782108833, "avatar": "cbb5effefae90a7b340d4a37c6b0c84e959c3e62"}, "language": "english", "review": "Amazing game, perfect for playing with your mate or better half :)", "timestamp_created": 1742757190, "timestamp_updated": 1742757190, "voted_up": true, "votes_u