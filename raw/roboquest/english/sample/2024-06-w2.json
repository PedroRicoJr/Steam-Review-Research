": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "167442567", "author": {"steamid": "76561198054915862", "personaname": "Eseman", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/eseman/", "num_games_owned": 1075, "num_reviews": 180, "playtime_forever": 3025, "playtime_last_two_weeks": 0, "playtime_at_review": 3024, "last_played": 1786779490, "avatar": "048011eaf2990a70b240393f805237d2565c9260"}, "language": "english", "review": "Fun game! At first its kinda slow but once you get the ball rolling it's pretty fast paced. \nThe weapons are fair and with enough use they all feel OP. \nThe game is harder the more you progress throughout the levels. Sometimes it feel like a big spike in difficulty.\nSome of the classes do feel weak compared to the default class. \nThe replayability is really there, there's nothing in the gameplay that makes it feel sluggish or not worth it.\n\nThey added endless mode, THIS GAME IS NOW BETTER", "timestamp_created": 1718481461, "timestamp_updated": 1732734885, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}