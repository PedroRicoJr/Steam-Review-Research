alse, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "222076053", "author": {"steamid": "76561197997754506", "personaname": "crazyaj01", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/crazyaj01/", "num_games_owned": 254, "num_reviews": 50, "playtime_forever": 3756, "playtime_last_two_weeks": 0, "playtime_at_review": 3756, "last_played": 1739338904, "avatar": "5db9d433b53622e7cf3295aca6bff0830ecfc577"}, "language": "english", "review": "It was awesome.  ~60 hours to 100% enjoying every minute of it.", "timestamp_created": 1774843123, "timestamp_updated": 1774843123, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "222070219", "author": {"steamid": "76561198052719323", "personaname": "emptymind", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198052719323/", "num_games_owned": 256, "num_reviews": 13, "playtime_forever": 2927, "playtime_last_two_weeks": 0, "playtime_at_review": 2171, "last_played": 1783564779, "avatar": "1e1698ed3b050f177086e3810fad92dcba69009d"}, "language": "english", "review": "Great game but....\r\n\r\nI wish there was more.\r\n\r\nI want a multiplayer: team deathmatch, free for all, capture the flag, etc.\r\n\r\nI want a moba version: competitive base collecting etc.\r\n\r\nI want a better multiplayer matchmaking for the current game.\r\n\r\nI want a sequel with even more.\r\n\r\n\r\nI absolutely love this game... but it feels like there could be so much more.", "timestamp_created": 1774835473, "timestamp_updated": 1774835473, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "222060858", "author": {"steamid": "76561198354023317", "personaname": "Chad Emperor Crimson", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198354023317/", "num_games_owned": 323, "num_reviews": 18, "playtime_forever": 6683, "playtime_last_two_weeks": 63, "playtime_at_review": 6447, "last_played": 1789795455, "avatar": "7963e3448a3a7eb0bd55ba25e9fd212ed87be6f1"}, "language": "english", "review": "Roboquest is without a shadow of a doubt the BEST action roguelike FPS on steam. Not a single other one on the entire store comes even close to Roboquest. This game really feels as good as a big budget AAA game in terms of gunplay and movement. And as far as action roguelikes in general, it perfectly stands alongside Risk of Rain 2 and Hades as a titan of the genre. I played this game like it owed me money. The meta progression is just enough to expand your run options and potential, but unlike Hades, the game does not feel impossible without a gigantic grind of meta resources to upgrade your character. The real upgrade is your skill as a player and your ability to pick and manage weapons and upgrades. This game does NOT waste your time. It has a great endless mode as well as very high scaling difficulty if you want to absolutely crank it. I looked for a while for a game that combined roguelike build options and high speed FPS and this is the only game that really does it well. 25$ is a bit steep as far as indies go but it is worth that price. The only sour spots are the lack of a great story and some of the weapons just not being that fun to use? Very little to complain about. 9/10.", "timestamp_created": 1774824584, "timestamp_updated": 1774824584, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}