y fine product of true passion, passion you didnt just show to your project but to us fans, listening to feedback, making updates and squashing bugs, letting us be heard. I hope nothing but the best in your futures as well as the future games you release. I will be there to support you along the way! \n\nRyseUp and continue being great!", "timestamp_created": 1713217114, "timestamp_updated": 1746838689, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.494736194610595703", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "162952525", "author": {"steamid": "76561198152599958", "personaname": "MRchimps77", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198152599958/", "num_games_owned": 140, "num_reviews": 16, "playtime_forever": 3273, "playtime_last_two_weeks": 0, "playtime_at_review": 1912, "last_played": 1779767673, "avatar": "628bece84fc7dd2f1ea250d34a7d5d9e408e1526"}, "language": "english", "review": "Fun", "timestamp_created": 1713216788, "timestamp_updated": 1713216788, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.479324400424957275", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "162949853", "author": {"steamid": "76561199189606834", "personaname": "bilipivac", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199189606834/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 7532, "playtime_last_two_weeks": 0, "playtime_at_review": 4446, "last_played": 1777666196, "avatar": "3874978b9391219e66fd487532c843ec89a8ceab"}, "language": "english", "review": "tan