itten_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "149722424", "author": {"steamid": "76561197991227587", "personaname": "dimi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/dimi/", "num_games_owned": 0, "num_reviews": 99, "playtime_forever": 4805, "playtime_last_two_weeks": 0, "playtime_at_review": 1561, "last_played": 1781294740, "avatar": "f1c696309ad8b15a1e3caaedbd832a85bff0b279"}, "language": "english", "review": "A very fun game, that's accessible to beginners too. There's several routes/maps, bosses, tons of weapons and classes you can use and added to that, level up perks that changes how you play. The player character is quite mobile, there's double jump, sliding plus additional movement upgrades later on, there's emphasis on platforming too.\nThe game gives you plenty of reason to play in the form of base upgrades, unlockables and so on. It has a charming art style and characters.\nRuns can take an hour if you want to check every part of the map and sadly there's no saves between levels, so you have to finish or cancel a run.\nMultiplayer works pretty good too, although there's no way to chat or communicate at all.", "timestamp_created": 1699386723, "timestamp_updated": 1699387187, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "149722193", "author": {"steamid": "76561199194444815", "personaname": "depression man", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ndsvfrw/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 2310, "playtime_last_two_weeks": 0, "playtime_at_review": 1023, "last_played": 1745360599, "avatar": "bde3e789cc0542e8e23c