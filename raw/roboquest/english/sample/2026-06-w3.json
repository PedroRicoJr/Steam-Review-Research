ference but I find it cute, shooting robots in oasis is something you don't see every day\n\n- if you looking for a good fps with solid combat and rougelike aspects you are in right place\n\noverall awesome game 10/10!", "timestamp_created": 1781984493, "timestamp_updated": 1781989279, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "228378543", "author": {"steamid": "76561199122340077", "personaname": "The_Pro_at_A's", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199122340077/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 1705, "playtime_last_two_weeks": 0, "playtime_at_review": 1159, "last_played": 1783991624, "avatar": "b2edbc430cffa963966ebafc9e7844414a9c51c1"}, "language": "english", "review": "GOOD", "timestamp_created": 1781925309, "timestamp_updated": 1781925309, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}