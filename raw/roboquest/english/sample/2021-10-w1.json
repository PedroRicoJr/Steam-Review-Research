 1 and 1.5 months and we started to publish at that rate again (like before our holidays).\n\nWe're sorry if you felt like we weren't there, we indeed were away for a while, but we're back now.\n\nAlso, when it comes to the game not being finished, that's why we opted for Early Access as we knew we had a long road ahead to make the best game we can. We're sorry if you're disappointed and we hope that our future updates will bring the game to the state you're looking for.", "app_release_date": "1597939791", "reactions": [{"reaction_type": 19, "count": 2}]}, {"recommendationid": "100381270", "author": {"steamid": "76561197996767457", "personaname": "randal2k", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/randal2k/", "num_games_owned": 450, "num_reviews": 18, "playtime_forever": 2153, "playtime_last_two_weeks": 0, "playtime_at_review": 499, "last_played": 1774191163, "avatar": "a8c5d92192f114f5ed05a03a86e53facc7d22a27"}, "language": "english", "review": "this is actually fun!!", "timestamp_created": 1633193903, "timestamp_updated": 1745199863, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.28823968768119812", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}