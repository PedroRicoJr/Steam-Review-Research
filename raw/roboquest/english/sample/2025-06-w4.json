{"game": "roboquest", "language": "english", "appid": 692890, "month": "2025-06", "window": 4, "start_date": 1750636800, "end_date": 1751327999, "month_true_total": 183, "quota": 5, "returned": 5, "pulled_at": "2026-10-03 01:55:23 UTC", "reviews": [{"recommendationid": "198597697", "author": {"steamid": "76561198102289925", "personaname": "mrpala62", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198102289925/", "num_games_owned": 881, "num_reviews": 140, "playtime_forever": 2655, "playtime_last_two_weeks": 0, "playtime_at_review": 2644, "last_played": 1751575901, "avatar": "f4c42051bc3d62906805e9436a0820d0963a3dfd"}, "language": "english", "review": "Roboquest is not only a hidden gem when it comes to roguelites, but it also is a fantastic 2-player coop game. Progression has been tweaked greatly. You always have something new to look for and the replay value here is appreciated. The characters, the enemies and the weapons are some of the many aspects that will hook you from the beginning, and the high skill-ceiling allows players to sink hours and become masters at the game.\r\n\r\nIf you like roguelites, find a friend to play this game and you will not be disappointed!", "timestamp_created": 1751327190, "timestamp_updated": 1751327190, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "198597016", "author": {"steamid": "76561198006024320", "personaname": "Dick Justice", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198006024320/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 4740, "playtime_last_two_weeks": 0, "playtime_at_review": 2349, "last_played": 1754776881, "avatar": "b7d5d6993decb65ebb45