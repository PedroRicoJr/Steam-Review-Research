0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "169945169", "author": {"steamid": "76561197987203323", "personaname": "OhKay", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ohkaylee/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4397, "playtime_last_two_weeks": 0, "playtime_at_review": 2426, "last_played": 1755898618, "avatar": "c0c551e2d84f96c8d3d103a329cfc129dc9d38c7"}, "language": "english", "review": "Robots, drum and bass, honestly I have 0 complaints about this game, except there needs to be more of it.", "timestamp_created": 1721068679, "timestamp_updated": 1721068679, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "169939186", "author": {"steamid": "76561198047368538", "personaname": "Rockwhisperer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/rockwhisperer/", "num_games_owned": 585, "num_reviews": 72, "playtime_forever": 1760, "playtime_last_two_weeks": 0, "playtime_at_review": 1760, "last_played": 1705551453, "avatar": "3dcd023da1f3d608fd7831391877aa323339614e"}, "language": "english", "review": "What an excellent game! Similar to Gunfire Reborn in that it's a FPS adventure roguelike with a lot more focus on making movement feel good. There are so many builds, weapons, and classes that make every run enjoyable.", "timestamp_created": 1721062656, "timestamp_updated": 1721062656, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "169933103", "author": {"steamid": "76561197984560435", "personaname": "Xi JinPooh", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197984560435/", "num_games_owned": 701, "num_reviews": 18, "playtime_forever": 2148, "playtime_last_two_weeks": 0, "playtime_at_review": 2020, "last_played": 1727826794, "avatar": "a253f2f8500a6282f26581d185a8840170525aa5"}, "language": "english", "review": "Awesome game with pros and cons. \nLots of replayability with braindead classes and pretty complex classes, though all of them are fun. \nLots of hidden stuff and secrets you should open during gameplay. \nLOTS of guns, with some pretty unique and some iconic (like bolter from 40k or cricket from MiB). \nFun bosses, nice monsters and design. This game is pretty good in everything but at the same time lacks of everything and after ~40 hours ive seen pretty much of the stuff. \nI would say - take this game, add some Gunfire reborn and some Risk of rain and you'll get the perfect one. \nIn the meantime its easely 7.5 - 8 of 10. Try it!", "timestamp_created": 1721056736, "timestamp_updated": 1721056736, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "169904290", "author": {"steamid": "76561198167078738", "personaname": "Knavishwater", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198167078738/", "num_games_owned": 205, "num_reviews": 21, "playtime_forever": 1082, "playtime_last_two_weeks": 0, "playtime_at_review": 333, "last_played": 1756968796, "avatar": "7a9f291a7bc3225c9864900a09db04a0b5f6acf1"}, "language": "english", "review": "If you like rougelites and boomer shooters then Roboquest is perfect for you. It's fast paced, unique, replayable, and has a good amount of depth. Very fun very swag", "timestamp_created": 1721020302, "timestamp_updated": 1721020895, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}