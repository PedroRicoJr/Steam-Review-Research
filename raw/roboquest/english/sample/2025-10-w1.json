{"game": "roboquest", "language": "english", "appid": 692890, "month": "2025-10", "window": 1, "start_date": 1759276800, "end_date": 1759881599, "month_true_total": 140, "quota": 5, "returned": 5, "pulled_at": "2026-10-03 01:55:49 UTC", "reviews": [{"recommendationid": "206147803", "author": {"steamid": "76561199866280781", "personaname": "MiNameJeff", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199866280781/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 653, "playtime_last_two_weeks": 0, "playtime_at_review": 409, "last_played": 1760994258, "avatar": "ba93e2a3c91889333bc32b4dfe2f28d914353f57"}, "language": "english", "review": "it's good", "timestamp_created": 1759873064, "timestamp_updated": 1759873064, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "206108122", "author": {"steamid": "76561199108569800", "personaname": "N00DL3S", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199108569800/", "num_games_owned": 0, "num_reviews": 44, "playtime_forever": 1863, "playtime_last_two_weeks": 0, "playtime_at_review": 1739, "last_played": 1760422442, "avatar": "049116dc3827584518d1124b90aa06b7fab8d023"}, "language": "english", "review": "This game is FAR too slept on! Please pick this game up and give it a few runs! I keep finding myself waiting to jump back in!", "timestamp_created": 1759835550, "timestamp_updated": 1759835550, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "206089818", "author": {"steamid": "76561198001367310", "personaname": "qwertycannon", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198001367310/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 7450, "playtime_last_two_weeks": 64, "playtime_at_review": 3157, "last_played": 1789948211, "avatar": "885c4029fff92a6978617e0b730bcf245df812bb"}, "language": "english", "review": "A lot of reviews compare this to Borderlands, but this is pretty misleading if you're looking for an RPG looter shooter. This is more of a modern singeplayer arena shooter akin to DOOM/DOOM Eternal. Very fast paced combat decided by your ability to navigate confined spaces in a frenetic manner using twitch reflexes. I played on Hard, so maybe my experience is a little different than some, but it is significantly more challenging than any Borderlands game (in my opinion).", "timestamp_created": 1759808184, "timestamp_updated": 1759808184, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "206082303", "author": {"steamid": "76561197983701723", "personaname": "Superfranky", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197983701723/", "num_games_owned": 0, "num_reviews": 19, "playtime_forever": 1667, "playtime_last_two_weeks": 0, "playtime_at_review": 336, "last_played": 1760763072, "avatar": "c0c868e026aa56e31fa1ba9df69fbb3525ab9813"}, "language": "english", "review": "Seriously fun!", "timestamp_created": 1759799663, "timestamp_updated": 1759799663, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}, {"recommendationid": "206079322", "author": {"steamid": "76561198044756927", "personaname": "CHLL", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/char_name/", "num_games_owned": 0, "num_reviews": 17, "playtime_forever": 8260, "playtime_last_two_weeks": 0, "playtime_at_review": 4010, "last_played": 1786035725, "avatar": "882c36d9f00ca3e2d683d2d97ea956a6550df9f0"}, "language": "english", "review": "The gun play is fantastic and the movement is fast, precise and very fun. You can freely customize the gameplay and difficulty to your liking. Go as slow or stupid fast as you prefer. After unlocking some stuff you will quickly feel like a robotic god of war dodging and weaving, jumping and flying, shooting, punching and stomping through armies of bots.\n10/10 - The most fun I had singleplayer in an fps in a long time.", "timestamp_created": 1759796214, "timestamp_updated": 1759857488, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.54356849193572998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}