_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198353118289/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 2002, "playtime_last_two_weeks": 0, "playtime_at_review": 193, "last_played": 1715493209, "avatar": "9c9d2e117a3bb10d4a3711336818574dc7555608"}, "language": "english", "review": "My brother and I were searching for a Rogue-lite co-op game with Doom-like movement (I told him this criteria basically didn't exist). Somehow he stumbled upon what quickly became my new favorite simple, fun co-op game. While the offset of all of the Pro's is a relatively small amount of content, the game-play easily makes up for it. Movement feels very smooth and polished, it has the same simple but satisfying flow of Doom. Weapons system and upgrades are similar to Gunfire Reborn and Risk Of Rain 2, with the added benefit that there aren't any game changing perks or weapons. Plenty of options for plenty of playstyles, you always feel a challenge, and always feel rewarded for running a build. Become a walking tank with the Defender, stalk the battlefield with the high crit Recon, Unleash your swarm of drones and boost your elemental damage with the Engineer, or wreak Mayhem with the explosive Commando. No matter who you choose, there are always viable paths for different playstyles. This game is worth so much more than the pricetag, cannot recommend this highly enough.", "timestamp_created": 1655445627, "timestamp_updated": 1655445627, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.479105621576309204", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}