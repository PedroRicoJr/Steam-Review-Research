_forever": 1093, "playtime_last_two_weeks": 0, "playtime_at_review": 700, "last_played": 1705535305, "avatar": "c3c400830556d879bb358595c48f0547c5ec8d1d"}, "language": "english", "review": "This games feel gives off a strong Borderlands vibe with all the pros. \n\nThe randomized Borderlands-style loot system that allows for great variation, and forces you to adapt on the go with better weapons the farther you go. You never get to stick to one playstyle which makes the game feel very fluid and constantly pacing you forward. \n\nThe more you kill and the faster you can do it, you are rewarded at the end of each stage with stat bonuses which after playing through 3-4 stages, really stack up. \n\nBefore you start your run, collecting a certain material from special rooms allows you to upgrade your basecamp giving you bonuses when starting your run, improve the loot you get, or outright giving you special abilities like a triple jump, a shortened cooldown on you skills, even increased damage when Mario stomping enemies. \n\nI am incredibly eager to see what this game develops into, In it's current form, it's an incredibly fun game to pass the time and feels rewarding to keep going back.", "timestamp_created": 1625638979, "timestamp_updated": 1625638979, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1597939791", "reactions": []}]}