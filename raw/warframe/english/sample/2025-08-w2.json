ime_last_two_weeks": 0, "playtime_at_review": 18, "last_played": 1767970359, "avatar": "27eac966b7eebf00202197a4fc07293b5510c294"}, "language": "english", "review": "Warframe is basically space ninja parkour simulator, but someone sprinkled in 10,000 guns, a tragic backstory, and the ability to casually commit acrobatics that would make Spider-Man sweat. You start as a mysterious, sword-swinging, gun-blasting warrior in a bio-metal suit, then very quickly become a fashion designer obsessed with making your armor match your energy color. The story is epic, the combat is faster than a coffee-fueled squirrel, and the number of customization options is so overwhelming you’ll spend more time in the appearance menu than actually saving the Origin System. Whether you’re slicing enemies in half, flying through space in your own battleship, or trying to remember which button makes you stop bullet-jumping into walls, Warframe delivers one thing above all: pure, glorious chaos — in the most stylish way possible.", "timestamp_created": 1755298046, "timestamp_updated": 1755298046, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}