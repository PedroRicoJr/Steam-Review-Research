{"game": "warframe", "language": "english", "appid": 230410, "month": "2014-03", "window": 1, "start_date": 1393632000, "end_date": 1394236799, "month_true_total": 937, "quota": 5, "returned": 5, "pulled_at": "2026-09-14 18:51:10 Pacific Daylight Time", "reviews": [{"recommendationid": "9378146", "author": {"steamid": "76561198063979007", "personaname": "Theodoric ᛖᚢᚱᛟᛈᚨ", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Theodoriceuropa/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 159, "playtime_last_two_weeks": 0, "playtime_at_review": 83, "last_played": 1394504552, "avatar": "546338a80080fb9dd4ef33b0924ab9c883169ced"}, "language": "english", "review": "Very unique mmo. Like playing a bad ass coop verion of mass effect where each player controls an acrobatic terminator with guns and blades. \n\nThere's not much I can say that hasn't been said about this game already but it's atleast worth a try. I really like the game and like the idea of instance based mmos and this one is one of the coolest in style and gameplay. It's also very fast paced and fun with friends or by yourself. You could even speedrun instances which is something most open world mmos don't have available.", "timestamp_created": 1394236429, "timestamp_updated": 1394236429, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "9378013", "author": {"steamid": "76561198047904881", "personaname": "0ddfx", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198047904881/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 454376, "playtime_last_two_weeks": 0, "playtime_at_review": 434170, "last_played": 1777792480, "avatar": "e3f0903db8a07855b2b147ffaaddb27c8eaf86