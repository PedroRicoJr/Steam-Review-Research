 of people with autism", "timestamp_created": 1743460578, "timestamp_updated": 1743460765, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "191681406", "author": {"steamid": "76561198088842481", "personaname": "Zector", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/zectorv1/", "num_games_owned": 0, "num_reviews": 31, "playtime_forever": 149555, "playtime_last_two_weeks": 0, "playtime_at_review": 149327, "last_played": 1766612357, "avatar": "0df0414a34aa863f09e4e23ef772ea0cca2c4086"}, "language": "english", "review": "game is poo cuz im old and bad", "timestamp_created": 1743459785, "timestamp_updated": 1743459785, "voted_up": false, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}