ing_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "15763", "author": {"steamid": "76561197960369935", "personaname": "The Chimpy Man", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TheChimpyMan/", "num_games_owned": 1853, "num_reviews": 40, "playtime_forever": 131827, "playtime_last_two_weeks": 314, "playtime_at_review": 64836, "last_played": 1789215240, "avatar": "1fd6a66e9771f53532559b837e416914861a7876"}, "language": "english", "review": "Bloody hell has this game come a long way. Starting off long ago as a simple shooter with one spaceship tileset shared between three enemy races, the developers have kept hammering away at it until it grew into the space opera that they always wanted, with likeable characters, a varied and vibrant bunch of planets and asteroids to jump around on and a surprisingly great central story arc that throws some real game-changing twists at you. \n\nThe core shooting and grinding has seen a whole lot of improvements, too, with a fun movement system that allows for some proper ninja acrobatics, and dozens of beefy guns and metal suits with which to rob hordes of enemies of their torsos.", "timestamp_created": 1377951928, "timestamp_updated": 1529157057, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}