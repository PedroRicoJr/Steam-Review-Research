{"game": "warframe", "language": "english", "appid": 230410, "month": "2021-11", "window": 4, "start_date": 1637625600, "end_date": 1638316799, "month_true_total": 1729, "quota": 5, "returned": 5, "pulled_at": "2026-09-14 19:02:42 Pacific Daylight Time", "reviews": [{"recommendationid": "104909650", "author": {"steamid": "76561198018848344", "personaname": "PixAimGaming", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198018848344/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 130328, "playtime_last_two_weeks": 0, "playtime_at_review": 103221, "last_played": 1774102654, "avatar": "0b96ef8a1b03e7cb01d4a5fb4ccfd9be831b10f2"}, "language": "english", "review": "Great for killing time", "timestamp_created": 1638315794, "timestamp_updated": 1638315794, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "104905357", "author": {"steamid": "76561197993276349", "personaname": "Gatorade", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561197993276349/", "num_games_owned": 0, "num_reviews": 69, "playtime_forever": 23715, "playtime_last_two_weeks": 0, "playtime_at_review": 23715, "last_played": 1624508778, "avatar": "e5f7295bbb06328b4348287d74f2efecf0ff9b34"}, "language": "english", "review": "There's nothing like this game and no way to compare it so the best I can do is offer some highlights:\n- Space alien ninja robots (yeah I have no idea else how to describe them) that have more weapons then you can imagine, each have their own abilities, and have customizable appearances & builds.\n- Tons and Tons of planets filled with loot that allows any player the ability to collect anything in the game regardless of how much theyve spent (Best F2P game out there).\n- Endless progression where every level up adds to your total account exp and the end game consists of endless wave grinds that have increasingly better rewards.\n- Game is super fast paced with dynamic jumping, quick response from your character, and is seamless whether you use a controller or keyboard. \n\nI haven't played the open world stuff theyve added so I imagine there's way more then what ive described above ... but the best part is every bit of it can be played with three of your friends making this one of the BEST free to play games out there.", "timestamp_created": 1638312913, "timestamp_updated": 1638312913, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "104903784", "author": {"steamid": "76561198835227350", "personaname": "76561198835227350", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198835227350/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 943, "playtime_last_two_weeks": 0, "playtime_at_review": 153, "last_played": 1639723869, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "Good game", "timestamp_created": 1638311857, "timestamp_updated": 1638311857, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "104901086", "author": {"steamid": "76561198009722600", "personaname": "neskanu", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/neskanu/", "num_games_owned": 0, "num_reviews": 1, "pla