ease_date": "1364234640", "reactions": []}, {"recommendationid": "14696851", "author": {"steamid": "76561198161633707", "personaname": "Journetta", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Journetta/", "num_games_owned": 922, "num_reviews": 17, "playtime_forever": 99792, "playtime_last_two_weeks": 47, "playtime_at_review": 81425, "last_played": 1789221856, "avatar": "9a6eef78b2de96de4f536bab12dce5b634879f6d"}, "language": "english", "review": "Warframe is a fantastic game, Be ready to spend ALOT of time Farming and grinding\n\nIt does take... quite of willpower to get into the game I'd recommend that you push through the game until you complete the quest \"The Second Dream\" That's where the game REALLY starts, and if you still aren't interested after that then this game isn't for you\n\nYou don't have to spend ANY money on this game if you don't want to, everything purchasable is either farmable or its just for fashion.\n\nIt's hours of fun with friends, In late game you spend most your time in the same level farming materials or prime parts\n\nThe community is great, There's always someone to help you if you need it\n\nOverall i really like this game, Although it can be a bit hard to get into for new players.", "timestamp_created": 1425151686, "timestamp_updated": 1598799619, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "14693994", "author": {"steamid": "76561198057972331", "personaname": "Doughboy", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/jekek123/", "num_games_owned": 0, "num_reviews": 22, "playtime_forever": 743, "playtime_last_two_weeks": 0, "playtime_at_review": 489, "last_played": 1526087253, "avatar": "dd007bb4c5d8258b2c161711c4