639962232, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.509132444858551025", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "9296171", "author": {"steamid": "76561198020780459", "personaname": "trilobite", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198020780459/", "num_games_owned": 271, "num_reviews": 22, "playtime_forever": 679737, "playtime_last_two_weeks": 0, "playtime_at_review": 1496, "last_played": 1783805299, "avatar": "a4ba07e66a90dca23e798eaf9ec6283bdb36bc84"}, "language": "english", "review": "The concept art design is top notch. This is the main reason I recommend this game. I believe it is done by the same artist that did the design for Pacific Rim, Don't be Afraid of the Dark, and Borderlands 1's alien weapons -- Keith Thompson. The weapons and warframe feel very unique, blending organic and mechanical feels together. Almost like Giger's works. \n\nGameplay is grinding heavy but kinda fun. The system has a lot of depth, like the damage 2.0 system, which allows some theory crafting. Gunplay is OK, animation is OK. Overall 5/10. Mediocre but there is nothing else like it on the market (other than Mass Effect 3 multiplayer which I refuse to pay for to Bioware). \n", "timestamp_created": 1393624313, "timestamp_updated": 1393624313, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}