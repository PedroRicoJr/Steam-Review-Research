{"game": "warframe", "language": "english", "appid": 230410, "month": "2014-01", "window": 1, "start_date": 1388534400, "end_date": 1389139199, "month_true_total": 1345, "quota": 5, "returned": 5, "pulled_at": "2026-09-14 18:50:55 Pacific Daylight Time", "reviews": [{"recommendationid": "8612659", "author": {"steamid": "76561197976952340", "personaname": "DEEP FIST", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/DEEPFIST/", "num_games_owned": 1678, "num_reviews": 27, "playtime_forever": 93701, "playtime_last_two_weeks": 0, "playtime_at_review": 12073, "last_played": 1738148168, "avatar": "ea67725fe8c001ec58c5e0c1cfbb4397540b2a4d"}, "language": "english", "review": "Super cyborg space ninja assassin mercenaries!\n\nIf that doesn't convince you, it's also free!\n\nGet it. Play it. Grow a beard!", "timestamp_created": 1389136451, "timestamp_updated": 1389136451, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8612290", "author": {"steamid": "76561198078594267", "personaname": "felang", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/metrodonttrustu/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 2023, "playtime_last_two_weeks": 0, "playtime_at_review": 32, "last_played": 1496465000, "avatar": "8cbfc2bc11656e247a0af610b5457aee046f97d0"}, "language": "english", "review": "ha gaaayy", "timestamp_created": 1389134618, "timestamp_updated": 1389134618, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8611993", "author": {"steamid": "76561198078984996", "personaname": "Tepoji", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Tepoji/", "num_games_owned": 421, "num_reviews": 11, "playtime_forever": 152716, "playtime_last_two_weeks": 97, "playtime_at_review": 63440, "last_played": 1789418542, "avatar": "7bb98ce4a4e9f6c0b6566dd61d339abbf916a1f4"}, "language": "english", "review": "This game is an addiction machine in the best way possible. There have been some hiccups in development lately, but I still overall recommend this game. It's very fast paced and rewards intelligent minmaxing of your weapons and warframes. By the time you get to the 20s in mastery rank, you should be so ridiculously overpowered that nothing will be hard for you. The new player experience definitely needs some work, as the game starts very slow, and it will take quite some time to get deep into this games content. If you were to play this game and try to experience everything in the fastest way possible, it would still take you a year or two to get to the highest levels. Partially due to many things having real life timers ranging from 1 minute to 72 hours. But for a free game, this game is fantastic, there is no pay to win, no paywalls, no subscription, etc. The only thing you pay for is cosmetics, and you can even earn the platinum used to buy things in the market through trading in game items with players. It's possible to get everything you want in this game without spending a dime.", "timestamp_created": 1389133169, "timestamp_updated": 1588796850, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8611647", "author": {"steamid": "76561198041240948", "personaname": "Obito", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198041240948/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 3861, "playtime_last_two_weeks": 0, "playtime_at_review": 3367, "last_played": 1658631479, "avatar": "e8ef2b11eee5e2b7b13c3a82cbbbb5e4efdb454a"}, "language": "english", "review": "very good", "timestamp_created": 1389131556, "timestamp_updated": 1389131556, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8611392", "author": {"steamid": "76561197989123482", "personaname": "Jayyy!", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197989123482/", "num_games_owned": 332, "num_reviews": 21, "playtime_forever": 17, "playtime_last_two_weeks": 0, "playtime_at_review": 17, "last_played": 1366354800, "avatar": "f8a3cc167c66e680d1520f5d4652c45579bf544f"}, "language": "english", "review": "lol wut", "timestamp_created": 1389130466, "timestamp_updated": 1389130466, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}