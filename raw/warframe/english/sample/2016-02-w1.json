d": "76561197977913023", "personaname": "Knee", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/KneeKneeKnee/", "num_games_owned": 267, "num_reviews": 33, "playtime_forever": 451, "playtime_last_two_weeks": 0, "playtime_at_review": 389, "last_played": 1454904381, "avatar": "ea194b3786030e3bf970d2964f4e4999c67139d7"}, "language": "english", "review": "Once there was a barnacle.\nEveryone was so ugly that the barnacle died.\nThe end.", "timestamp_created": 1454883851, "timestamp_updated": 1454883851, "voted_up": true, "votes_up": 1, "votes_funny": 4, "weighted_vote_score": "0.452658891677856445", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "21037887", "author": {"steamid": "76561198131670710", "personaname": "TREXTOM", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TREXTOM/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 1369, "playtime_last_two_weeks": 0, "playtime_at_review": 1229, "last_played": 1462387962, "avatar": "fc13bb1f59388dc6070a14f9224b6f697e08a4d3"}, "language": "english", "review": "For a free game this is epic! Run up walls, Slide across the room, Slow down time when you jump and shoot enemies, Hack into the secruity, Snap an enemies neck in stealth mode, Upgrade your weapon with mods, Collect mods and other items on your journey, Play with other people, Join a clan. Give this game ago i think you wont regret it :)", "timestamp_created": 1454882186, "timestamp_updated": 1454882186, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "21037333", "author": {"steamid": "76561198119323260", "personaname": "Arcanoa", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198119323260/", "num_games_owned": 36, "num_reviews": 2, "playtime_forever": 77296, "playtime_last_two_weeks": 0, "playtime_at_review": 64739, "last_played": 1703406231, "avatar": "5839e9fa8bf87571e70ef13920e78240e6b61e19"}, "language": "english", "review": "The games been fun. It's not necessary to put any money into it but those who do are supporting it in their own way. I prefer the hard work required to acquire most of the items I want. You can choose to solo or do things with a team which makes things interesting in it's own way. The PvP is fairly balanced and enjoyable also it's not forced so you don't have to participate in it. The game modes to try are pretty diverse but my favorite one by far is Survival. The graphics of the game can be lowered if necessary as in the case of older computers. The story behind this is amazing and well thought out. I originally grew an interest in this game due to it's link with an older game I enjoyed called Dark Sector. I have to admit when a friend of mine told me the glaive was added I instantly wanted to play. Overall I've enjoyed my time in this game and hope you will as well.", "timestamp_created": 1454880666, "timestamp_updated": 1454880666, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}