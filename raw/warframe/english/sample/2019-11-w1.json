persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Abaddoni/", "num_games_owned": 0, "num_reviews": 33, "playtime_forever": 75032, "playtime_last_two_weeks": 0, "playtime_at_review": 72391, "last_played": 1786564378, "avatar": "bf04bc0a4f3f21cbccc81f103dc898b1960c57cd"}, "language": "english", "review": "Ever since I started playing in 2019, I've adored this game, and never once have I disliked what they've done to the game.\n\nThe soundtracks are amazing, updates are incredible. The lore is confusing at first but makes sense if you pay close attention to what is happening, but you don't need to understand the lore to enjoy the story. \n\nI just don't really have enough words I can use to describe this game to the extent it deserves, especially with the recent 1999 update(s). All I can say is; try it. This game is incredible and the community has always been lovely to interact with. I tend to take breaks for weeks or months at a time, but I always come back when an update drops, and it's amazing every time.\n\nI love this game.", "timestamp_created": 1573170607, "timestamp_updated": 1750219979, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "56726033", "author": {"steamid": "76561198216803927", "personaname": "XynDrago", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/XynDrago/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 109515, "playtime_last_two_weeks": 91, "playtime_at_review": 859, "last_played": 1788768381, "avatar": "59348981d5de98c04899923c51e8848442e1a76b"}, "language": "english", "review": "So now that i've had more time on this game i'd say this game is awesome. everytime i think i've tried everything i seem to find something new. with the free price tag can't resiste using it to play with friends who have limitted  money for games. definitely an interesting game. give it a try you have nothing to lose.", "timestamp_created": 1573170501, "timestamp_updated": 1615570941, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "56725506", "author": {"steamid": "76561197979932362", "personaname": "Dark Angel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197979932362/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 643838, "playtime_last_two_weeks": 1711, "playtime_at_review": 297819, "last_played": 1789424060, "avatar": "58abb5b672ea7121a1dec4f8b22789d03d64717f"}, "language": "english", "review": " Decent free game to play.  Graphics are pretty good and price  and build times are pretty good compared to most.", "timestamp_created": 1573169729, "timestamp_updated": 1573169729, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}