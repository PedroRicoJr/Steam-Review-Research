ike no other.\n\nAfter all these years, one thing is clear – Warframe is more than just a game; it’s a journey.\n\nWould I recommend it? Without a doubt!", "timestamp_created": 1738971511, "timestamp_updated": 1738971511, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "187418317", "author": {"steamid": "76561198338892539", "personaname": "del_Toro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/zerobantai/", "num_games_owned": 21, "num_reviews": 4, "playtime_forever": 17536, "playtime_last_two_weeks": 0, "playtime_at_review": 12019, "last_played": 1748019254, "avatar": "97caee00eb9e2fd9f78eaf034b7f9f4d2fd9210d"}, "language": "english", "review": "yes", "timestamp_created": 1738969387, "timestamp_updated": 1738969387, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "187417616", "author": {"steamid": "76561199175985746", "personaname": "Cheesus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199175985746/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 703, "playtime_last_two_weeks": 0, "playtime_at_review": 703, "last_played": 1738423889, "avatar": "9ee137bf3d3f0526c267ec8777877816f59c7487"}, "language": "english", "review": "good", "timestamp_created": 1738968675, "timestamp_updated": 1738968675, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "w