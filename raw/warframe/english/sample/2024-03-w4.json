ss": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "161917541", "author": {"steamid": "76561199635827140", "personaname": "GGG", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199635827140/", "num_games_owned": 2, "num_reviews": 2, "playtime_forever": 22826, "playtime_last_two_weeks": 0, "playtime_at_review": 18325, "last_played": 1712683211, "avatar": "374f2205fcc34c03ec8813079ce2773770f3762e"}, "language": "english", "review": "bored asf too much to do", "timestamp_created": 1711928237, "timestamp_updated": 1711928237, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "161917414", "author": {"steamid": "76561198416943420", "personaname": "Aljhaqu", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198416943420/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 263165, "playtime_last_two_weeks": 0, "playtime_at_review": 236584, "last_played": 1781700723, "avatar": "3108c9d50738c8032045d850ba554bc64e06ac5d"}, "language": "english", "review": "The system is well developed. In the sense that it gives absolute freedom in both movement and attack. Sadly, there are some issues with the game consistency, but I hope the developer can correct them soon.", "timestamp_created": 1711928097, "timestamp_updated": 1711928097, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "161916660", "author": {"steamid": "76561198075853370", "personaname": "wjm777", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198075853370/", "num_games_owned": 23, "num_reviews": 13, "playtime_forever": 12891, "playtime_last_two_weeks": 0, "playtime_at_review": 12353, "last_played": 1777855471, "avatar": "b850e12f5d35cb8377d49bb38252e8c0a75f71e1"}, "language": "english", "review": "A lot of people compare this to Destiny 2 but it's really not like D2. \r\n\r\nIt's a fun game that has surprising depth but it's not very beginner friendly IMO. You'll need to Google, wiki and YouTube a lot of stuff to figure out what to do. But once you put the time in and it starts to click it's a very fun game. Very face paced if you want it to be.\r\n\r\nIt's sci fi lore (most call it sci fi ninja in most reviews I've read). \r\n\r\nGreat shooter game with melee as well. You can pretty much adapt your character and weapons to fit any style of game play you enjoy. You can solo or group play just about anything except open world missions. \r\n\r\nYou can roam around on \"skate\" boards or fly around with arch wings. Just takes a bit to get all of it.\r\n\r\nIf you're willing to put in the time to learn it's very fun. Put if you want something to just pick up and play you might get confused or frustrated at the beginning.", "timestamp_created": 1711927154, "timestamp_updated": 1711927154, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}