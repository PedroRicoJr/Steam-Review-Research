ck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "33569966", "author": {"steamid": "76561197994699046", "personaname": "Top Hat Zealot", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197994699046/", "num_games_owned": 280, "num_reviews": 1, "playtime_forever": 75030, "playtime_last_two_weeks": 0, "playtime_at_review": 71436, "last_played": 1785790025, "avatar": "618c5785faa159b51720347ead5552a62ee888d3"}, "language": "english", "review": "I played the game on and off since 2013 and as far as the game goes, it's \"ok.\" I personally think the game is rather disconnected  from its original \"ninjas in space\" idea by now. There is little stealth going on and most missions involve 4 murder-suits running around with grenade launchers, black hole guns and other AoE weapons - because those are some of the most effective weapons out there. I like the flame thrower myself. \n\nHowever,  I have lost all respect for the devs of this game when they decided to go after VoiD_Glitch and threaten him with legal action because of his \"datamining.\" The devs are under the impression that looking at files inside your game's installation folder (and being knowledgable enough to know how to interpret and disseminate those files) and then sharing the information you gained that way with the public is legally punishable. \n\nThat kind of behavior does not sit well with me. Not at all.", "timestamp_created": 1500155115, "timestamp_updated": 1500155115, "voted_up": false, "votes_up": 27, "votes_funny": 2, "weighted_vote_score": "0.516579568386077881", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "33568816", "author": {"steamid": "76561198334671058", "personaname": "-kelpy", "persona_status": "offline", "profile_url": "https://ste