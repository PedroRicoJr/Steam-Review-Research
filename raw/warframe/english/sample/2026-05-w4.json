": 1780270224, "timestamp_updated": 1780270224, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.508928596973419189", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "226906531", "author": {"steamid": "76561199151127139", "personaname": "Stoned_Mystery", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199151127139/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 38868, "playtime_last_two_weeks": 0, "playtime_at_review": 32885, "last_played": 1785005436, "avatar": "76dce2682675b8e0b1ee69696591301ae971aca5"}, "language": "english", "review": "the perfect power fantasy game doesnt hide anything but cosmetics behind paywalls and there are tons for free anyway\r\nvery well put together game made FOR the gamers and it shows in the best ways\r\n", "timestamp_created": 1780270114, "timestamp_updated": 1780270114, "voted_up": true, "votes_up": 11, "votes_funny": 1, "weighted_vote_score": "0.598598599433898926", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "226906505", "author": {"steamid": "76561198131948388", "personaname": "SkyeDeepDeer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/SkyeDeer69/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 29584, "playtime_last_two_weeks": 1588, "playtime_at_review": 12681, "last_played": 1789350302, "avatar": "735728badb1a8351dcfc41404fdc28a2ac698a4f"}, "language": "english", "review": "Great game, best free2play ive seen, twitch drops alot of the time, fomo is minimun, a vast array of weapons warframes builds interactions and more, would recommend, starting out is confusing but it gets better, theres a Q&A area in the chat menu to ask any questions too.\n\nalso make sure you check the market when holidays come around for free stuff\ne.g pride month, st patricks, christmas, easter etc\n\nGood luck Tenno.\n", "timestamp_created": 1780270091, "timestamp_updated": 1780270091, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "226906290", "author": {"steamid": "76561199082112163", "personaname": "KopiFalls", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Kopifalls/", "num_games_owned": 22, "num_reviews": 7, "playtime_forever": 5521, "playtime_last_two_weeks": 0, "playtime_at_review": 5337, "last_played": 1785988771, "avatar": "37f06f71d27e1a734728acf972dce0ce63dbbaeb"}, "language": "english", "review": "I really enjoy this game, my bf got me into it before we started dating and I play with him a lot. Highly recommend playing with people. Either friends or public both are an option", "timestamp_created": 1780269825, "timestamp_updated": 1780269825, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}