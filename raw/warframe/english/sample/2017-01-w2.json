"received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "29284564", "author": {"steamid": "76561198011519007", "personaname": "Reygund", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Reygund/", "num_games_owned": 87, "num_reviews": 8, "playtime_forever": 119769, "playtime_last_two_weeks": 0, "playtime_at_review": 57731, "last_played": 1783508038, "avatar": "5b00a9378793cf69147eda48328ec07d2ff135ce"}, "language": "english", "review": "You first start off and get addicted, but eventually you realise the grind is a nightmare. In an attempt to git gud, you willingly get screwed over by RNG repeatedly to get 1/4 armour pieces or 1/4 weapon pieces. You can also use in-game currency to buy gear but the community is super greedy and get over-hyped easily.\nAfter getting sick of the stupid RNG and stupid greedy community, you quit the game but eventually forget how fun Warframe was and come back with a refreshed addiction.\nThe game needs a lot of hours sure, but you won't ever quit this game for good so that's alright.", "timestamp_created": 1484518650, "timestamp_updated": 1484518650, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}]}