{"game": "warframe", "language": "english", "appid": 230410, "month": "2025-06", "window": 3, "start_date": 1750032000, "end_date": 1750636799, "month_true_total": 2010, "quota": 5, "returned": 5, "pulled_at": "2026-09-14 19:07:58 Pacific Daylight Time", "reviews": [{"recommendationid": "197921672", "author": {"steamid": "76561198426329111", "personaname": "ZatanaZatara", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198426329111/", "num_games_owned": 48, "num_reviews": 13, "playtime_forever": 42426, "playtime_last_two_weeks": 1255, "playtime_at_review": 1483, "last_played": 1789388169, "avatar": "1ca53751e9ca1f7fad55b0a401ec92842747007d"}, "language": "english", "review": "I came back to Warframe not knowing what to expect, and honestly, I was surprised by how easy it is to get into. Even with all the new content, the game does a great job guiding you through things at your own pace without drowning you in systems.\n\nThe progression feels rewarding. Grinding isn’t a chore here—it’s something you want to do because every mission pushes you closer to a goal you've set yourself. Whether it’s building a new weapon, unlocking a Warframe, or just styling your gear, the effort always pays off.\nIf you're the kind of player who enjoys setting your own goals and working toward them bit by bit, Warframe makes that process feel genuinely satisfying.", "timestamp_created": 1750635876, "timestamp_updated": 1750635876, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "197920245", "author": {"steamid": "76561199242591790", "personaname": "AnimeSenpai5657", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199242591790/", "num_games_owned": 55, "n