{"game": "warframe", "language": "english", "appid": 230410, "month": "2014-01", "window": 2, "start_date": 1389139200, "end_date": 1389830399, "month_true_total": 1345, "quota": 5, "returned": 5, "pulled_at": "2026-09-14 18:50:57 Pacific Daylight Time", "reviews": [{"recommendationid": "8722356", "author": {"steamid": "76561198058562915", "personaname": "CHIKM", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198058562915/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 2869, "playtime_last_two_weeks": 0, "playtime_at_review": 1600, "last_played": 1778879060, "avatar": "90864ecd8cfc031d4600c0f603ba4faf6943021d"}, "language": "english", "review": "YOU ARE INSANE!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n", "timestamp_created": 1389829715, "timestamp_updated": 1389829715, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8722266", "author": {"steamid": "76561198038602250", "personaname": "Lost in Oz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/LostinOz/", "num_games_owned": 158, "num_reviews": 4, "playtime_forever": 52733, "playtime_last_two_weeks": 0, "playtime_at_review": 2570, "last_played": 1682296169, "avatar": "201428f8efa159499a466e5b464facb6ca53baa6"}, "language": "english", "review": "Take the Sci-Fi Action aspect of Mass Effect 3's multiplayer mode, cook it over a flame built from Collectible Card Games and Tradional RPG Advancement, apply a thick Pseudo-Samurai glaze, and dribble \"Guyver\" aesthetics over the whole thing. Serve on a Free-to-Play platter, with a side dish of Item Crafting with a light Trade sauce. Add a Guild Base/Bank for dessert, and you have a 5 star shooter experience.\n\nIn all seriousness, good gunplay, sweet abilities, awesome melee weapons, a solid craft system, and a well-paced effort/reward setup allows and encourages grinding for specific item materials without making it a horrific chore, and allowing the purchase of key mats if you just can't wait. The ability to build your guild's dojo room-by-room, and individually decorating each room to your liking is freaking awesome. \n\n9/10, Most enjoyable F2P on my game list right now.", "timestamp_created": 1389829134, "timestamp_updated": 1389829134, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8721991", "author": {"steamid": "76561198045804857", "personaname": "Stunner", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Stunner36/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 16673, "playtime_last_two_weeks": 0, "playtime_at_review": 11682, "last_played": 1498774526, "avatar": "42d64da3a2ad549035fbce6de781eb91e4992d29"}, "language": "english", "review": "Great free to play game!", "timestamp_created": 1389827365, "timestamp_updated": 1389827365, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.502487540245056152", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1364234640", "reactions": []}, {"recommendationid": "8721323", "author": {"steamid": "76561197995664165", "personaname": "Demonbear", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/demonbear/", "num_games_owned": 627, "num_reviews": 12, "playtime_forever": 5304, "playtime_last_two_weeks": 0, "playtime_at_review": 899, "last_played": 1719849880, "avatar": "6bf39adfc51df647