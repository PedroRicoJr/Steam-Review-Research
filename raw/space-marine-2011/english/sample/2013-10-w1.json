nguage": "english", "review": "Crackin multiplayer battles, a faithful translation of the 40K franchise - more expansions would be cool...", "timestamp_created": 1382327607, "timestamp_updated": 1382327607, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7430236", "author": {"steamid": "76561198060099586", "personaname": "Dom Gamazzi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/SrMasterKaiser/", "num_games_owned": 0, "num_reviews": 34, "playtime_forever": 1179, "playtime_last_two_weeks": 0, "playtime_at_review": 321, "last_played": 1611034422, "avatar": "9fa1f08b6a5ee91d3c813720ea8c47f5c32c969b"}, "language": "english", "review": "O universo de warhammer é uma coisa fabulusa, de longe um dos melhores cenários de fantasia(sci-fi) já criados, apesar de não ser o forte da área jogos to tipo, é um shotter terceira pessoa de classe A+", "timestamp_created": 1382238919, "timestamp_updated": 1382238919, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7425192", "author": {"steamid": "76561198019621629", "personaname": "Malkavian 🌣", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Malkavian61/", "num_games_owned": 4152, "num_reviews": 72, "playtime_forever": 843, "playtime_last_two_weeks": 0, "playtime_at_review": 707, "last_played": 1443073654, "avatar": "5c3488a576230564d1f9295b319cc46e37bcfd81"}, "language": "english", "review": "A pretty cool third person action game following the story of an ultra marine captain in a campaign against orks and to an extend chaos marines (surprise, surprise...). Good looking with satisfying, if not repetitive gameplay and a horrible QTE boss fight!\n\nP.S.: Lapdogs of the False Emperor!\n\n6/8", "timestamp_created": 1382196210, "timestamp_updated": 1600615484, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.474299639463424683", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7415118", "author": {"steamid": "76561198013778917", "personaname": "Aaron", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/KingKamina/", "num_games_owned": 1485, "num_reviews": 19, "playtime_forever": 1232, "playtime_last_two_weeks": 0, "playtime_at_review": 1127, "last_played": 1438611066, "avatar": "7a98d429d9fb61bb6065773f2005fce7257463a8"}, "language": "english", "review": "Probably one of the best Warhammer 40k games out at the moment. The difficulty level is steep though. Slicing through thousands of Orcs then mowing down heretic Chaos is fun enough for many playthroughs of the main game but you get multiplayer and co-op when you get bored of the campaign. 8.5/10", "timestamp_created": 1382105252, "timestamp_updated": 1395342450, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.54259335994720459", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7391145", "author": {"steamid": "76561198094177238", "personaname": "DigitalBeef", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/DigitalBeef/", "num_games_owned": 731, "num_reviews": 9, "playtime_forever": 5859, "playtime_last_two_weeks": 0, "playtime_at_review": 2382, "last_played": 1720880351, "avatar": "f1b63089e376d8a7bed94e82b11182fc26f5b138"}, "language": "english", "review": "This game does a fantastic job of making you *feel* like a space marine captain. The hits are juicy, the sound design is phenomenal. The graphics are pretty standard for a AAA at launch date. Not too shiny by today's standards, but they're well past good enough to get the job done.\n\nThe multiplayer community for this game is basically dead. But if you round up some friends, you can play the co-op invasion mode, which is a lot of fun. Just make sure to go into the bonus round knowing that you'll probably not survive.\n\nOverall, the game mechanics are solid, the combat's fun if repetitive at times. But as I said, this game will make you feel like a space marine. I count that as a total success.", "timestamp_created": 1381815306, "timestamp_updated": 1593329291, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7383701", "author": {"steamid": "76561198101526511", "personaname": "Skuttle", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198101526511/", "num_games_owned": 228, "num_reviews": 5, "playtime_forever": 1217, "playtime_last_two_weeks": 0, "playtime_at_review": 267, "last_played": 1719521369, "avatar": "6dae2652c12a6d5ea21805ebaab9c0cdaf0cc0dd"}, "language": "english", "review": "This is Gears of War before there was a Gears of War. It s basically the same game but with Space Marines and Orks which is pretty badass if you ask me. I enjoy the weapons like the swordsaw and the awesome battleaxe. Its fun to go charging into a ton of Orks and just hack away using finishing moves and keep hacking. From what I've gathered religion IS technology in this world where they worship computers and what not. Anyways great game for people who love Gears.", "timestamp_created": 1381725412, "timestamp_updated": 1381725412, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7362027", "author": {"steamid": "76561198073083527", "personaname": "Phobion", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198073083527/", "num_games_owned": 0, "num_reviews": 25, "playtime_forever": 5382, "playtime_last_two_weeks": 0, "playtime_at_review": 5349, "last_played": 1725545998, "avatar": "92620c2e5f15b278cb3cdd90670b9f4c94634783"}, "language": "english", "review": "For the Emperor!", "timestamp_created": 1381519570, "timestamp_updated": 1725544006, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "7359463", "author": {"steamid": "76561197998990572", "personaname": "Devil4", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Diavol4/", "num_games_owned": 566, "num_reviews": 14, "playtime_forever": 1091, "playtime_last_two_weeks": 0, "playtime_at_review": 754, "last_played": 1773695805, "avatar": "b5d74b80389f8a7a5fe04541e536c02c1ae10a64"}, "language": "english", "review": "Cattivissimo, da avere", "timestamp_created": 1381495729, "timestamp_updated": 1381495729, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": 