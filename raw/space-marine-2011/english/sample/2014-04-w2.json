{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2014-04", "window": 2, "start_date": 1396915200, "end_date": 1397606399, "month_true_total": 30, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 17:48:48 UTC", "reviews": [{"recommendationid": "9823537", "author": {"steamid": "76561197998035151", "personaname": "Thorren", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197998035151/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 753, "playtime_last_two_weeks": 0, "playtime_at_review": 753, "last_played": 1397638299, "avatar": "19c57f3f6de3cca662fce5180f42d7e20ec0c864"}, "language": "english", "review": "Do enjoy smashing Orks", "timestamp_created": 1397560956, "timestamp_updated": 1397560956, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "9821515", "author": {"steamid": "76561198129462414", "personaname": "Simonbarsinistr", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198129462414/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1792, "playtime_last_two_weeks": 0, "playtime_at_review": 1314, "last_played": 1427062093, "avatar": "3954395a2d2ba63ae7886c3dc9ffd04c9eac089d"}, "language": "english", "review": "A cult classic that still gets multiplayer support. This game hasn't been matched yet in it's fluid transition from ranged weapons to melee combos. And not just a predefined melee combo, but an actual set of combos that you can utilize by hitting the right buttons and not just button mashing. Halo, Titanfall, BF, CoD....All these games have weak ass melee compared to Space Marine. The fact that you can use a jump pack to attack from a third dimension is just icing on the cake!", "timestamp_created": 1397532063, "timestamp_updated": 1397532063, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "9806614", "author": {"steamid": "76561198012778769", "personaname": "[K9]-Aardwolf", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198012778769/", "num_games_owned": 638, "num_reviews": 18, "playtime_forever": 1527, "playtime_last_two_weeks": 0, "playtime_at_review": 764, "last_played": 1747466816, "avatar": "ebf07ea39fd20858f1f233f9d6af4f62907c1a57"}, "language": "english", "review": "Perfectly captures the dark, war-torn theme of Warhammer 40K's gothic universe...", "timestamp_created": 1397394353, "timestamp_updated": 1397394353, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "9792886", "author": {"steamid": "76561198064257982", "personaname": "Red", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/RedTransistor/", "num_games_owned": 762, "num_reviews": 109, "playtime_forever": 1860, "playtime_last_two_weeks": 0, "playtime_at_review": 1554, "last_played": 1430193545, "avatar": "1df3535a6f4c9bcf76d310fff46700d18b98412c"}, "language": "english", "review": "A new take in gaming in the W40K universe as you play Captain Titus of the Ultramarines in a unique third person shooter as you defend a forgeworld from the WAAARRGGHH. Equip yourself with the iconic weapons and gear of the unstoppable Space Marines and cleave and blast your way through the unrelenting hordes of Orks and the invading Chaos. It also has some enjoyable co-op horde mode play that pits you and your friends against waves of enemies in a fashion similar to last stand in DOW II Retribution. 10/10.", "timestamp_created": 1397276056, "timestamp_updated": 1397276056, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "9785007", "author": {"steamid": "76561197981070391", "personaname": "Vigo The Butch", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/zabbadahun/", "num_games_owned": 0, "num_reviews": 19, "playtime_forever": 1145, "playtime_last_two_weeks": 0, "playtime_at_review": 710, "last_played": 1436632136, "avatar": "43653f0e2f9aaec0854713908a96baeeb5c21ce6"}, "language": "english", "review": "If you are a fan of the warhammer games you have a good time with this one. Take control of a spacemarine in a third person action packed shooter. Fight your way onto and through a now ork infested planet in single player, hold off against waves of orks and chaos in Exterminatus or go head to head with other players in Vs.", "timestamp_created": 1397204197, "timestamp_updated": 1397204197, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}