{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2012-10", "window": 1, "start_date": 1349049600, "end_date": 1349654399, "month_true_total": 47, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 17:46:44 UTC", "reviews": [{"recommendationid": "2943399", "author": {"steamid": "76561198014908621", "personaname": "Conducting Kraken", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198014908621/", "num_games_owned": 1035, "num_reviews": 37, "playtime_forever": 5249, "playtime_last_two_weeks": 0, "playtime_at_review": 4228, "last_played": 1732030368, "avatar": "14f1a9927382fa8dea134a0f3ca6f17e6938e131"}, "language": "english", "review": "full of bloody visceral violence and engrossing storyline recomended to 40k fans and others equally", "timestamp_created": 1349652197, "timestamp_updated": 1349652197, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "6606975", "author": {"steamid": "76561198070317253", "personaname": "FramesPerSecond", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/FramesPreSecond/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 3807, "playtime_last_two_weeks": 0, "playtime_at_review": 2596, "last_played": 1510711906, "avatar": "4c17c42e8a17e8e0b034f2d96141e3ee834ddd53"}, "language": "english", "review": "SPEHSS MAHEENS!!!!!!", "timestamp_created": 1349640944, "timestamp_updated": 1349640944, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "3018384", "author": {"steamid": "76561198016001038", "personaname": "영혼", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198016001038/", "num_games_owned": 0, "num_reviews": 39, "playtime_forever": 1545, "playtime_last_two_weeks": 0, "playtime_at_review": 1208, "last_played": 1377137736, "avatar": "b36b78fb4e058bced004a1f076f89e5dbb7bc419"}, "language": "english", "review": "This is a phenominal addition to the Warhammer 40k series. It's a 3rd person shooter with several options to choose from: first being the campaign.\n\n Second being online multiplayer which has several modes to choose from such as deathmatch, capture the point, and dreadnaught which is a mode where a team fights for control of a point to summon their dreadnaught and aiding it to capture points for victory. \n\nThe Dreadnaught mode is the most enjoyable yet a little broken. It's difficult to kill due to powerful weapons and a full team of enemy opponets fighting you off aswell. The third mode is extermination which holds to maps, a third with dlc all with 20 waves of throughout 4 different arenas which you will fight off hordes of orks to survive.\n\nThis game is great except the fact that multiplayer is player hosted which for those of you with poor internet connection such as myself may find theirself lagging to an unplayble state at some point throughout the game making it very unejoyable.", "timestamp_created": 1349636981, "timestamp_updated": 1349636981, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "2004640", "author": {"steamid": "76561198000834627", "personaname": "NoSleepTilB", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/nosleeptilbrooklyn/", "num_games_owned": 379, "num_reviews": 21, "playtime_forever": 1348, "playtime_last_two_weeks": 0, "playtime_at_review": 1321, "last_played": 1388707328, "avatar": "a4a17a0437cf454c74a49234dec810b2f0ff8bd0"}, "language": "english", "review": "This game has alot to it. This is one of those gems that went unappreciated. A new feeling combat style that switches seemlessly between ranged and melee combat (with a chainsword), and you can get into those hard to reach places with your jetpack. The single player campaign has a story that anyone can get into and feels like an invasion from open to close. Lots of DLC is available and more people should buy", "timestamp_created": 1349606410, "timestamp_updated": 1349606410, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "2564448", "author": {"steamid": "76561198009352601", "personaname": "Erick", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ErickPC/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 462, "playtime_last_two_weeks": 0, "playtime_at_review": 31, "last_played": 1520807618, "avatar": "c293332a940e21e67e6ef511dc7becee163af38f"}, "language": "english", "review": "Great game get it if you like 40k", "timestamp_created": 1349561056, "timestamp_updated": 1349561056, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}