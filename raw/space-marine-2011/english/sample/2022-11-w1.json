_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "125075640", "author": {"steamid": "76561198091193752", "personaname": "Gabs", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/HumphreyTW/", "num_games_owned": 0, "num_reviews": 37, "playtime_forever": 661, "playtime_last_two_weeks": 0, "playtime_at_review": 604, "last_played": 1667954909, "avatar": "c04e5bdab9a9c7284d1624277cf6cf2f20dee31f"}, "language": "english", "review": "Sinceramente eu não esperava que esse jogo fosse tão bom assim quando resolvi baixar ele, porém o jogo é fantástico. A historia, gráficos, jogabilidade, trilha sonora, é difícil encontrar pontos negativos nesse jogo. Desconsiderando o modo multiplayer que não cheguei a jogar, recomendo fortemente esse jogo para quem estiver afim de uma experiencia hack 'n slash do xbox 360.", "timestamp_created": 1667776292, "timestamp_updated": 1667776292, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "125074509", "author": {"steamid": "76561199085371291", "personaname": "Soobuncle", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199085371291/", "num_games_owned": 290, "num_reviews": 140, "playtime_forever": 1753, "playtime_last_two_weeks": 0, "playtime_at_review": 688, "last_played": 1725493293, "avatar": "ebcfab8e867faca98507915da1e1169a9e4b0ac8"}, "language": "english", "review": "Soob", "timestamp_created": 1667774488, "timestamp_updated": 1667774488, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "r