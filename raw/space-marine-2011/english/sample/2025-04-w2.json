": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "192784964", "author": {"steamid": "76561199836629306", "personaname": "Blitz_", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199836629306/", "num_games_owned": 34, "num_reviews": 21, "playtime_forever": 446, "playtime_last_two_weeks": 0, "playtime_at_review": 238, "last_played": 1757140563, "avatar": "b7fbf78e6d2abb73de19ff818cf221d1264cca7f"}, "language": "english", "review": "Very fun game. Good story characters, level design is immersive and fits the genre, theme and overall franchise very well. The Orks are fun to fight, as well as Boss Grimskull (Who is just Shrek in his final form). My only complaint is that the Chaos Daemons are not fun to fight against. They remind me of the Promethean Knights in Halo 4. Not too hard, but not that easy either, and they teleport a lot. Other than that, a very good game.", "timestamp_created": 1744706092, "timestamp_updated": 1744706092, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}