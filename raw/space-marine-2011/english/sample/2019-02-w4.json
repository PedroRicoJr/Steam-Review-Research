ccess": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "49254640", "author": {"steamid": "76561197969276266", "personaname": "PAW", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197969276266/", "num_games_owned": 277, "num_reviews": 256, "playtime_forever": 975, "playtime_last_two_weeks": 0, "playtime_at_review": 541, "last_played": 1756250462, "avatar": "2f70132449680163db9c851bdc73a9dffaec17b7"}, "language": "english", "review": "An ok action game. I've finished game on hard even tough I don't have achievement - I got screwed in chapter 13 and needed to restart from earlier checkpoint - quick tip: don't take hammer in chapter 13... that screwed my hard achievement run but w/e cba to finish this game again.\nIf you can get this on high discount/sale and you like action games and you're fan of warhammer 40k universe - go for it. Otherwise it's just a meh game.\n\nI've set it on recommended but consider getting it cause it's not that great.\n\n[b]5.5/10[/b]", "timestamp_created": 1551228479, "timestamp_updated": 1551228479, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "49221697", "author": {"steamid": "76561197974471003", "personaname": "drone110266", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/drone110266/", "num_games_owned": 0, "num_reviews": 353, "playtime_forever": 487, "playtime_last_two_weeks": 0, "playtime_at_review": 487, "last_played": 1551055391, "avatar": "11adea46d00c73ac120436b1600a18fd07f2e7df"}, "language": "english", "review": "Awesome game and well worth getting if you have not played it before. Feels like the movie marines you find the in the books.", "timestamp_created": 1551055523, "timestamp_updated": 1551055523, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "49210346", "author": {"steamid": "76561197993092122", "personaname": "Tomekk", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/TomekkHUN/", "num_games_owned": 611, "num_reviews": 4, "playtime_forever": 593, "playtime_last_two_weeks": 0, "playtime_at_review": 593, "last_played": 1551013671, "avatar": "ff7ee5af4c2dd486d04d6e183e62ae3e10bbd0fd"}, "language": "english", "review": "The dictionary definition of a last-gen 7/10 game. Third-person perspective, repetitive, simplistic but functional gameplay, checkpoints that make you rewatch the same cutscenes time and time again, a QTE sequence as the climactic final battle, tacked on multiplayer that forces you to grind for unlocks, inability to rebind controls or change options in game...\n\nIf you are a massive fan of third person shooters or have even a passing interest in the Warhammer 40,000 setting, then it's definitely worth a shot. Otherwise, it might be worth a weekend of your time if you just like violent shooter/brawler games.", "timestamp_created": 1551013865, "timestamp_updated": 1551013865, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476439774036407471", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}