se, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "147346080", "author": {"steamid": "76561198293744503", "personaname": "marjun1n", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/marjunin/", "num_games_owned": 445, "num_reviews": 9, "playtime_forever": 908, "playtime_last_two_weeks": 0, "playtime_at_review": 878, "deck_playtime_at_review": 509, "last_played": 1696070185, "avatar": "2ea7e98c15b874bda8b831f5bfa6d6223d1520bc"}, "language": "english", "review": "Good game!! first game i beat on steam deck. runs perfectly too!", "timestamp_created": 1696070130, "timestamp_updated": 1696070448, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": true, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "147334031", "author": {"steamid": "76561199081400707", "personaname": "Eldin_Eldritch", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/SirSponge32/", "num_games_owned": 0, "num_reviews": 26, "playtime_forever": 1769, "playtime_last_two_weeks": 0, "playtime_at_review": 506, "last_played": 1722021505, "avatar": "20a222030eb0c9a8a97dcaa2457e8a67a3f2e561"}, "language": "english", "review": "FOR ULTRAMAR!!! FOR THE EMPEROR!!!", "timestamp_created": 1696055699, "timestamp_updated": 1696055699, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "147331793", "author": {"steamid": "76561198140074151", "personaname": "Toxilicious", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198140074151/", "num_games_owned": 374, "num_reviews": 71, "playtime_forever": 448, "playtime_last_two_weeks": 0, "playtime_at_review": 448, "last_played": 1695949286, "avatar": "804e60d554283dad0bd3d1c8d83e897b49a0fa9b"}, "language": "english", "review": "A fantastic third person shooter which still holds up. It has a surprisingly well implemented combination fantastic gunplay and satisfying hack n slash combat. You'd think one would feel better over the other but both feel equally good. There's a variety of both melee and ranged weapons which are fantastic to use, executions which are basically Doom (2016) gory kills before they were at thing which feel powerful and oh so satisfying. Speaking of which the whole game is a power fantasy where you mow down a bunch of orks with one swing and take down big bads with ease and I think that's the best part of this game.\n\nI'm not well versed in Warhammer40k lore but the story was decent and simple enough to follow, the level design was a bit meh but I didn't mind it that much since the game wasn't that long. Unfortunately the multiplayer seems to be dead so can't say much about that. Overall a short but pretty fun game to play especially in preparation of Space Marines 2 but DO NOT GET THIS AT $60. Just not worth it. Definitely recommend getting this on sale.", "timestamp_created": 1696052565, "timestamp_updated": 1696052565, "voted_up": true, "votes_up": 8, "votes_funny": 0, "weighted_vote_score": "0.635761559009552002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}