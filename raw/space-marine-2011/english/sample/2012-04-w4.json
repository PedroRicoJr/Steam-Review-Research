": "deefdelic", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/deefdelic/", "num_games_owned": 3095, "num_reviews": 274, "playtime_forever": 383, "playtime_last_two_weeks": 0, "playtime_at_review": 8, "last_played": 1696767468, "avatar": "5b083929b5cb56e1d48819f590f1d720bb946214"}, "language": "english", "review": "This game is a straight up Gears of war clone set in the Warhammer universe.\nThe story is very basic  but functional. The graphics look very nice and the sound is reasonably good. The game is also very easy to get into.\nThere is a downside and that's the gameplay itself. Space Marine is to one sided.\nIn the end you'll only fight, fight and fight. It just gets to damn repetive after a while.\nIn the end t think everyone playing this will get bored a little bit and that doesn't do a Warhammer game any justice. Still if you like this franchise you might be amused with this one. Overall rating is about a 7 out 10...", "timestamp_created": 1335526037, "timestamp_updated": 1335526037, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}