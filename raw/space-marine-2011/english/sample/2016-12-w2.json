"1315281600", "reactions": []}, {"recommendationid": "28365266", "author": {"steamid": "76561198021308169", "personaname": "The Bad Man", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198021308169/", "num_games_owned": 0, "num_reviews": 85, "playtime_forever": 497, "playtime_last_two_weeks": 0, "playtime_at_review": 410, "last_played": 1603058075, "avatar": "d78ce094f05cb1c89817559dfc36e2ea5cdb0769"}, "language": "english", "review": "Fight Green Chavs as Toughguy McNobody, the stoutest and most stoic Space Grunt of all! \n\n10/8 do it for the Empetor on his Golden Home.", "timestamp_created": 1481744534, "timestamp_updated": 1481744534, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "28357204", "author": {"steamid": "76561197998445123", "personaname": "Klarum", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Klarum/", "num_games_owned": 0, "num_reviews": 177, "playtime_forever": 975, "playtime_last_two_weeks": 0, "playtime_at_review": 975, "last_played": 1436789551, "avatar": "0a79bc53c92b6ebee2a54206dfc31141e58e0a9a"}, "language": "english", "review": "The best 40k action game ever created!\nPossibly one of the best 3rd action games ever! (haven't played so many of these :D)", "timestamp_created": 1481707496, "timestamp_updated": 1481707496, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476845920085906982", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "28338427", "author": {"steamid": "76561198021048506", "personaname": "The Hancock", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TD4/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 803, "playtime_last_two_weeks": 0, "playtime_at_review": 803, "last_played": 1481666249, "avatar": "ece4fcedd891b45dbb27578a08b673572db206b3"}, "language": "english", "review": "Came for a senseless stress reliever, stayed for a great story and actually still functional multiplayer!\nWarhammer 40,000: Space Marine turned out to be a fantastic game! I wasn't expecting much but it turns out I love it!\nI'm a fan of the Warhammer universe, and maybe that gives me a bias as to why I enjoy the game, but compared to other modern third person shooters Space Marine stands strong. \nI was even able to jump into a packed multiplayer lobby on the weekend!\n\nI did however foretell the \"plot twist\" in the game, but that is probably just because of my lore knowledge.\n\nOverall, and for what it's worth, I'd give Warhammer 40,000: Space Marine a 10/10, waiting on a follow up!\nFor the Emperor!!\n", "timestamp_created": 1481606893, "timestamp_updated": 1481606893, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.509027302265167236", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}