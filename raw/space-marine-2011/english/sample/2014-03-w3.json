"voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.463407903909683228", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "9554068", "author": {"steamid": "76561197991248564", "personaname": "Jon Gill", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/JonGill/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 744, "playtime_last_two_weeks": 0, "playtime_at_review": 741, "last_played": 1417217173, "avatar": "30216d17390e9cf2c700eab793a734491f7f76fa"}, "language": "english", "review": "If you are a fan of the real time strategy or board game by the Warhammer franchise then you likely will enjoy this. Set in the same universe, you take on the role of a space marine as you battle through hoards of enemies and relieve comrades. This game is not afraid of showing a gush of explosive blood upon impact with two handed hammers or grenades. The gritty atmosphere and first person shooter gameplay combine to provide a good feel for your bullet laden adventures through wartorn fantasy religion infused warfare. A great game all in all if you like the other sin the franchise even with it being on a different genre entirely than its counterparts.", "timestamp_created": 1395170845, "timestamp_updated": 1395170845, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}