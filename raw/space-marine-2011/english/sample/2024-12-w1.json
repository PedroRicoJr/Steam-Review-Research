{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2024-12", "window": 1, "start_date": 1733011200, "end_date": 1733615999, "month_true_total": 251, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 18:06:04 UTC", "reviews": [{"recommendationid": "182198542", "author": {"steamid": "76561199217717971", "personaname": "Hugh Mann", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/playfnv/", "num_games_owned": 70, "num_reviews": 9, "playtime_forever": 434, "playtime_last_two_weeks": 0, "playtime_at_review": 432, "last_played": 1740172901, "avatar": "af1cf9cf15be50bc6eda5a5c35bb1698bbf77ecd"}, "language": "english", "review": "♥♥♥♥ leandros", "timestamp_created": 1733615074, "timestamp_updated": 1733615074, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "182195125", "author": {"steamid": "76561197990641231", "personaname": "Clashway", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197990641231/", "num_games_owned": 721, "num_reviews": 10, "playtime_forever": 600, "playtime_last_two_weeks": 0, "playtime_at_review": 5, "last_played": 1779575350, "avatar": "b16f75554d2368b248df0cd0ce394111b2132930"}, "language": "english", "review": "Seems like a cool game, but it will not run. Every attempt to start the game gives me a prompt that says \"updating application\" then it just closes. Sometimes after I fiddle with some settings I get an bug splat error screen. If you check the forums, there are other people having the same problem scattered all throughout. Some of them offer solutions that seem to have worked for them, but not others. As for me, I tried all of them with no success. I disabled my firewalls, I got a .dll fix, reduced the number of processors used down to 8, I tried all the compatibility modes and running it as administrator, but nothing  has worked for me. I'm glad that some of these options have worked for a few others who had this problem, but this absolutely should not be an issue present at all.\n\nMore disappointed than anything. If you plan on buying this, be aware that it may be a gamble if it works for you at all.", "timestamp_created": 1733612225, "timestamp_updated": 1733612225, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.509090900421142578", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "182171274", "author": {"steamid": "76561199798311462", "personaname": "noahmote12345", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199798311462/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1011, "playtime_last_two_weeks": 0, "playtime_at_review": 819, "last_played": 1740183600, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "for the emperor", "timestamp_created": 1733595191, "timestamp_updated": 1733595191, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "182143459", "author": {"steamid": "76561198086887501", "personaname": "rafaa14", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198086887501/", "num_games_owned": 0, "num_reviews": 158, "playtime_forever": 90, "playtime_last_two_weeks": 0, "playtime_at_review": 90, "last_played": 1733577808, "avatar": "fa01002e7