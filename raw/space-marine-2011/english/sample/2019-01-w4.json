{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2019-01", "window": 4, "start_date": 1548288000, "end_date": 1548979199, "month_true_total": 76, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 17:56:29 UTC", "reviews": [{"recommendationid": "48639106", "author": {"steamid": "76561198000305114", "personaname": "Andras Zodon", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Andras_Zodon/", "num_games_owned": 842, "num_reviews": 193, "playtime_forever": 942, "playtime_last_two_weeks": 0, "playtime_at_review": 942, "last_played": 1548915794, "avatar": "2d554b4e0af8acc3d3065ce4622a842e311c7044"}, "language": "english", "review": "This game is a perfectly average 7/10. It's an enjoyable experience where you should get about your money's worth if you play through the whole thing. However, if you're a Warhammer fan, that easily pushes this to an 8 or even 9 out of 10. You are the instrument of the Emperor's will, and you shall rain his fury upon the green-skins with .75 caliber explosive judication. Faith is your shield, and hatred your weapon!\n\nThe vs multiplayer is basically completely dead, but at the time of this review you can still find games in the co-op mode (and there's DLC that adds more co-op maps!) It's fun, and at the later stages, quite challenging.", "timestamp_created": 1548821384, "timestamp_updated": 1548821384, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "48632208", "author": {"steamid": "76561197962623490", "personaname": "Liquidspy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Liquidspy_58/", "num_games_owned": 327, "num_reviews": 47, "playtime_forever": 5801, "playtime_last_tw