s": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198018628834/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 5213, "playtime_last_two_weeks": 0, "playtime_at_review": 4753, "last_played": 1515444590, "avatar": "2ae19a4243961cf78ce27b72904d24a8625b4bf5"}, "language": "english", "review": "Good story, epic action and immersive environments. Once you start the singleplayer campaign you will want to see it through to the end.\nThe multiplayer is a blast. Unlockable perks increase your tactical options and offer some fun combinations to take to the field. On the downside pretty much the only format being played online is \"Point Capture\". Invite some friends if you want to check out other things like the coop \"Exterminatus\" survival mode.\n\nEdit for customer survey a.k.a. Steam Awards:\nIt would be nice if this game got a sequel. But that seems very unlikely right now.", "timestamp_created": 1480380266, "timestamp_updated": 1511822404, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}