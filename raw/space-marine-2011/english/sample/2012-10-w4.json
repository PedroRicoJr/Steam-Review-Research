{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2012-10", "window": 4, "start_date": 1351036800, "end_date": 1351727999, "month_true_total": 47, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 17:46:50 UTC", "reviews": [{"recommendationid": "3381379", "author": {"steamid": "76561198021763750", "personaname": "Occultist", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Interrer/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 983, "playtime_last_two_weeks": 0, "playtime_at_review": 913, "last_played": 1495806865, "avatar": "b08439c1c98ec289773f637555154325cf9c28d1"}, "language": "english", "review": "This game follows through the warhammer 40k franchise, offering a fast paced, brutal 3rd person shooter experience. There is plenty of action to be had, murdering hordes of orks and chaos followers but unfortunately you'll often find this game lacking. The battle mechanics are repetitive and somewhat clunky, while the difficulty rises up unreasonably high at times. The graphics are acceptable. The multiplayer part is peer-to-peer only so it's a failure from the get go. \n\nVerdict : Nothing special. 6/10", "timestamp_created": 1351580414, "timestamp_updated": 1442167931, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.499989062547683716", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "1362075", "author": {"steamid": "76561197992113445", "personaname": "nunezilla", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197992113445/", "num_games_owned": 0, "num_reviews": 17, "playtime_forever": 1166, "playtime_last_two_weeks": 0, "playtime_at_review": 1166, "last_played": 1350802800, "avatar": "ec33f5963813882d50bcd875bc426c8257640732"}, "language": "en