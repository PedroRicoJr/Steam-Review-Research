e": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "54471109", "author": {"steamid": "76561198253753210", "personaname": "RandomODST", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Rome1527/", "num_games_owned": 0, "num_reviews": 18, "playtime_forever": 1566, "playtime_last_two_weeks": 0, "playtime_at_review": 1108, "last_played": 1674017571, "avatar": "3ce87da4c58e4c9d9ce898fab7bc069cde36b0ad"}, "language": "english", "review": "The omnissah approves", "timestamp_created": 1565015998, "timestamp_updated": 1565015998, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "54464437", "author": {"steamid": "76561198005642549", "personaname": "Angrakhan", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198005642549/", "num_games_owned": 0, "num_reviews": 30, "playtime_forever": 699, "playtime_last_two_weeks": 0, "playtime_at_review": 699, "last_played": 1564976910, "avatar": "95d8f1c00bbdc43e289e494f3dad027a6f930ac4"}, "language": "english", "review": "I got this game on sale and was pleasantly surprised with the quality of it in spite of its age.  The gameplay is challenging and even on normal difficulty you will be hard pressed to make it through the campaign without a single death.  I'm a WH40K fan and enjoyed the fact the story kept quite true to the lore.  The story was compelling to me and was certainly the driving force behind me finishing the campaign.\n\nThe only down side of the game in my opinion is the on-rails nature of it.  There are no side missions, exploration, or moral choices to make (or any choices to make other than who dies next).  It's just straight down the rails from start to finish.  \n\nAnyway, if you're a fan of WH40K or just like a good, old-fashioned shooter that lacks any of the frills of more modern games, this is a solid purchase.", "timestamp_created": 1564977404, "timestamp_updated": 1564977404, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "54457069", "author": {"steamid": "76561198044214839", "personaname": "tenser", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/romanowtenser/", "num_games_owned": 3005, "num_reviews": 19, "playtime_forever": 466, "playtime_last_two_weeks": 0, "playtime_at_review": 466, "last_played": 1559170026, "avatar": "32e906cbbf8bfecc2bdcea55b85a38136f6fba92"}, "language": "english", "review": "-Game is shorter then its installation time\n-Progress/upgrades are almost non existent\n-Repetetive, boring, dumbed down, simplistic\n-Very overhyped\n-Very linear", "timestamp_created": 1564936563, "timestamp_updated": 1564936563, "voted_up": false, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.374556452035903931", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}