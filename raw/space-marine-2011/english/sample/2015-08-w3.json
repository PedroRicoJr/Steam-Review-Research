{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2015-08", "window": 3, "start_date": 1439683200, "end_date": 1440374399, "month_true_total": 53, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 17:51:03 UTC", "reviews": [{"recommendationid": "17675735", "author": {"steamid": "76561197994134338", "personaname": "mrw", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/8underr/", "num_games_owned": 0, "num_reviews": 317, "playtime_forever": 849, "playtime_last_two_weeks": 0, "playtime_at_review": 528, "last_played": 1536449124, "avatar": "c3266fb417530a5266540d025c323e7595a4edad"}, "language": "english", "review": "The game itself is fine, but something about the Steam version of this product just causes massive issues in online play. I got it on steam just to save myself having to break out a CD every time I wanted to install it but I had to go back to my CD copy. The steam version is almost unplayable online. I see a 100-200ms difference in online play no matter what game I join, between playing through Steam and playing a regular retail copy. It boggles my mind how that's even possible, but I've investigated every possible cause and that's all I can see. That's the only difference. The games are installed in the same place in the same way.", "timestamp_created": 1440329155, "timestamp_updated": 1440329155, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "17669589", "author": {"steamid": "76561198021757575", "personaname": "Incipit Satan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198021757575/", "num_games_owned": 0, "num_reviews": 664, "playtime_forever": 766, "playtime_last_two_weeks": 0, "playtime_at_r