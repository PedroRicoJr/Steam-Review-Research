profile_url": "https://steamcommunity.com/profiles/76561199552506101/", "num_games_owned": 105, "num_reviews": 76, "playtime_forever": 319, "playtime_last_two_weeks": 0, "playtime_at_review": 319, "last_played": 1751769107, "avatar": "1b0a867c0531dddd3675a2ecc8017345069142a4"}, "language": "english", "review": "While a decent time, this game has most of the trappings you'd expect of a Gears clone, plus a few other issues. Still worth it if it's on sale.\n\nPros:\n- 40K as a setting is fantastic, with all its built in lore.\n- Combat is mostly satisfying.\n\nCons:\n- Extremely predictable story.\n- Occasionally, feedback from hits (given and received) is weak.\n- Some enemy types are absurdly annoying.", "timestamp_created": 1751769263, "timestamp_updated": 1751903361, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.492537319660186768", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}