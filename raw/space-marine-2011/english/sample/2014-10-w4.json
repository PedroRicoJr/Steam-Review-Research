ayer aside, the only game that scratches the role-playing shooter the way space marine does is firewarrior and that's ♥♥♥♥♥♥♥ garbage\nBuy this game", "timestamp_created": 1414689783, "timestamp_updated": 1535803513, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.482264906167984009", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "12689993", "author": {"steamid": "76561198024689328", "personaname": "wel ard", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/BANGNAWWWH/", "num_games_owned": 343, "num_reviews": 67, "playtime_forever": 799, "playtime_last_two_weeks": 0, "playtime_at_review": 443, "last_played": 1507122672, "avatar": "d3eb39d70f297a4191bea908797cd7972a77ad86"}, "language": "english", "review": "HERETICS MUST DIE", "timestamp_created": 1414637628, "timestamp_updated": 1414637628, "voted_up": true, "votes_up": 28, "votes_funny": 14, "weighted_vote_score": "0.53023141622543335", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}