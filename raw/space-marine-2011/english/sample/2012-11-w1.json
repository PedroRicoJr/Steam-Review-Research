steamcommunity.com/profiles/76561198008933565/", "num_games_owned": 0, "num_reviews": 37, "playtime_forever": 993, "playtime_last_two_weeks": 0, "playtime_at_review": 944, "last_played": 1375064851, "avatar": "8e16d1988c039b08a26fbfad3e0e9c94f67f1200"}, "language": "english", "review": "This game is all action, all the time! It creates an atmosphere that is true to the Warhammer series and will not disappoint the fans. You slash your way through enemies and must perform \"executions\" in order to gain  health. This game is aggressive from the begining and does not stop. Strategy is not needed except when it comes to which weapons you choose. The campaign is strong enough to keep you engaged but does get kind of boring since there really is no other mission other than to kill your enemies. The multiplayer is nothing fantastic but does provide you with the option to choose Chaos to play. It is a fun game for fans of the series and also comes with the usual customization that people come to expect. The game is simple and easily delivers the intense action that comes with being a Space Marine.", "timestamp_created": 1351823441, "timestamp_updated": 1351823441, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}