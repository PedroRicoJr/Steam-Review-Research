eam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "1671057", "author": {"steamid": "76561197996202886", "personaname": "Jay Lowe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/meowmix25/", "num_games_owned": 0, "num_reviews": 40, "playtime_forever": 5036, "playtime_last_two_weeks": 0, "playtime_at_review": 4835, "last_played": 1392160155, "avatar": "7c8f19011481233c9fb2c1cbb1791b559e5bc0e5"}, "language": "english", "review": "For blowing off frustration, very few titles come close to Space Marine. The carnage you can unleash as a living, chainsword and bolter wielding machine of war against endless waves of Orks and all sorts of demonic Chaos ♥♥♥♥ is pure satisfaction every time. The campaign ain't deep but it's a lot of fun, multiplayer could be decent if it had dedicated servers or didn't lag all the ♥♥♥♥♥♥♥ time (also a couple of the maps are real stinkers) but Exterminatus mode is a great challenge to get into with a couple friends. For a shallow, good time, and an absolute must for 40k fans, as the look and feel of everything but the Ork voices (a very odd miss considering it's Relic, but the Freebootaz in Retribution were good enough to make me forgive this offense) is spot on.", "timestamp_created": 1362183231, "timestamp_updated": 1362183231, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.492307692766189575", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}