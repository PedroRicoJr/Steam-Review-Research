{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2021-08", "window": 3, "start_date": 1629072000, "end_date": 1629763199, "month_true_total": 99, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 18:00:38 UTC", "reviews": [{"recommendationid": "98118405", "author": {"steamid": "76561198135721233", "personaname": "Dick \"McLarge\" Huge", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198135721233/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 638, "playtime_last_two_weeks": 0, "playtime_at_review": 638, "last_played": 1629758989, "avatar": "8193b1a1964cf90db1410747cf3bba05ffdc14e5"}, "language": "english", "review": "This game really makes you feel like a powerful space marine captain! As a collector of the tabletop game I could not imagine a better third person shooter than this. The combat is brutal and intense although quite simple but the variety of weapons at your disposal make up for it. The environments are awe inspiring and really capture the scale of the setting. The sound design is stellar (the bolter in particular sounds phenomenal). Overall, a great game and something I would definitely recommend to any Warhammer fan or anybody looking for a great action game!", "timestamp_created": 1629759678, "timestamp_updated": 1629759678, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "98110247", "author": {"steamid": "76561198119016681", "personaname": "PancakeEater69", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/nomadedge/", "num_games_owned": 571, "num_reviews": 229, "playtime_forever": 433, "playtime_last_two_weeks": 0, "playtime_at_review": 433, "last_played": 1604779729, "avatar": "738