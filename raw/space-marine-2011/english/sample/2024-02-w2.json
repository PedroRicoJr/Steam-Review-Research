purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "158256204", "author": {"steamid": "76561197976624909", "personaname": "Heretik", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/woep/", "num_games_owned": 631, "num_reviews": 12, "playtime_forever": 2625, "playtime_last_two_weeks": 0, "playtime_at_review": 2625, "last_played": 1707856930, "avatar": "07f7ab4983f0fe40221dac5f1afe8fd7fcc174d4"}, "language": "english", "review": "This game makes you feel like a badass. An Ultramarine Badass. Wishlist this, wait for a sale, buy it, play it, you're welcome", "timestamp_created": 1707857099, "timestamp_updated": 1707857099, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}