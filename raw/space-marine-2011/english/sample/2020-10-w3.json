": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "77987318", "author": {"steamid": "76561198170865993", "personaname": "HorrorCube", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/HorrorCube/", "num_games_owned": 269, "num_reviews": 79, "playtime_forever": 2063, "playtime_last_two_weeks": 0, "playtime_at_review": 667, "last_played": 1719899460, "avatar": "13d8a0bf74b896b015d68b163d4ee96a17fc1ff9"}, "language": "english", "review": "It is impossible to write a long review about this game because it is so simple and doesn't have much content in it. Dont even think for a second that this games simplicity and lack of content is bad though, there was not 1 second I did not enjoy in this game, what it does, it does GOOD. Killing hordes of orks with guns that shoot tank shells and axes infused with lightning is so damn good and fun that you could replay the campaign 5 times and still enjoy every kill. I would highly recommend this game to people who aren't even warhammer fans, its just a really f*cking fun game!", "timestamp_created": 1603400773, "timestamp_updated": 1603400773, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}