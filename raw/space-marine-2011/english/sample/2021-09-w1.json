]}, {"recommendationid": "98917544", "author": {"steamid": "76561198052505886", "personaname": "Evohunter7", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198052505886/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 16692, "playtime_last_two_weeks": 0, "playtime_at_review": 12060, "last_played": 1725367746, "avatar": "ab192c0fe6bc5a0a0109f80c230deeb721589560"}, "language": "english", "review": "My go to catharsis.", "timestamp_created": 1630985543, "timestamp_updated": 1630985543, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "98916835", "author": {"steamid": "76561198288305163", "personaname": "MrOctober", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/mroctober98/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 1579, "playtime_last_two_weeks": 0, "playtime_at_review": 459, "last_played": 1682569154, "avatar": "7a741b8d9d4b80e71571ba1bdb1d4fd8814f740d"}, "language": "english", "review": "Pretty solid run 'n gun\nThe fight dynamic is pretty good. Doesn't stand out with any amazing unique features but is still absolutely fun to slowly get really good at dispatching the green menace, but not too good, as constantly adding in new enemy types and weapons to match keeps it interesting and challenging. And the occasional break in regular game play for some different, temporary mechanics keep it all the fresher (only one of which is a qte)\nHowever, the controls can be clunky, some game play things don't work at all like you would expect them to (though you can learn to work with/around them) and a couple deaths confused me so much that I have no choice but to believe that they were some kind of glitch\nThe story is not one to talk about in length, but it is better than they had to make it. And that's always welcome\nIt really does feel like like love was but into the game over all\nA good 6-10 hours of good fun (and maybe even a gateway into the 40k universe for some people)\nBut as always, everything 40k comes at a 24k price, so maybe wait for a sale despite all my praises", "timestamp_created": 1630984107, "timestamp_updated": 1630984107, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.549144327640533447", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "98899065", "author": {"steamid": "76561198355827230", "personaname": "skinnar", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198355827230/", "num_games_owned": 353, "num_reviews": 22, "playtime_forever": 1233, "playtime_last_two_weeks": 0, "playtime_at_review": 1031, "last_played": 1672428775, "avatar": "010e3ac5e870f826f2d1108c1914cb37b0e3620b"}, "language": "english", "review": "joe mama\n", "timestamp_created": 1630954767, "timestamp_updated": 1630954767, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}