": 1629019884, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.499071985483169556", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "97533285", "author": {"steamid": "76561198062605121", "personaname": "dvoicer678", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198062605121/", "num_games_owned": 608, "num_reviews": 17, "playtime_forever": 394, "playtime_last_two_weeks": 0, "playtime_at_review": 394, "last_played": 1628918968, "avatar": "76de0e7ed0e2fba804f5d293f793f1c6607cbc4f"}, "language": "english", "review": "Honestly, 10 years after this game's release, there's just not that much reason to buy it. I don't think it's a particularly worthwhile game. It's basically gears of war but with worse controls, shooting, a lot more bugs, and literally no cover system. It's not a terrible experience, but I wouldn't really recommend that you buy this, it's just not really worth playing it through when there's much better stuff out there. If you really want a late 2000's era 3rd-person cover shooter game with oversized dudes, just (re)play Gears of War, it'll probably be a lot better.", "timestamp_created": 1628926690, "timestamp_updated": 1628926690, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.49368584156036377", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "97520308", "author": {"steamid": "76561198283559914", "personaname": "sneedmeiser", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198283559914/", "num_games_owned": 95, "num_reviews": 6, "playtime_forever": 798, "