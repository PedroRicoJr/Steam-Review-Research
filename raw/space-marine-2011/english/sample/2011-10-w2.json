mendationid": "2085133", "author": {"steamid": "76561198002025072", "personaname": "The_Spartan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/EGO_TheSpartan/", "num_games_owned": 0, "num_reviews": 39, "playtime_forever": 9367, "playtime_last_two_weeks": 0, "playtime_at_review": 8127, "last_played": 1726357739, "avatar": "f61a1c2e9ee05236d6cbc89add14976eb05b6cd9"}, "language": "english", "review": "A very good third person shooter. It has an awesome single player game but sadly, the multiplayer is just too laggy since it lacks dedicated servers. The leveling system also makes it hard for newcomers to have a chance against people with countless more hours of gaming because those that played more are rewarded with superior weapons and weapon perks. If you got the money and the time for multiple games, buy it, otherwise better invest your time on some other game.", "timestamp_created": 1318560152, "timestamp_updated": 1318560152, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.47329181432723999", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}