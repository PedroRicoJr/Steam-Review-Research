tes_funny": 0, "weighted_vote_score": "0.507462680339813232", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "39041749", "author": {"steamid": "76561198080560866", "personaname": "W Corp C.A. Kinsley", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198080560866/", "num_games_owned": 435, "num_reviews": 3, "playtime_forever": 5571, "playtime_last_two_weeks": 0, "playtime_at_review": 335, "last_played": 1769684379, "avatar": "92929f4eb76fa0c40dbcb65c587a1c8fd3dd0ea7"}, "language": "english", "review": "Absolutely love this game. The Adeptus Astartes are powerful, we know this, but playing as one with all the level of devastation one would expect? Really makes you feel awesome, while showing you that space marines are not someone to be messed with. This game takes Warhammer, and puts it into third person with glorious results. I only wish the multiplayer was more active. But, while other games water down the power of the space marines for PVP balance, this game lets you go crazy with the true power of a space marine, and it is ludicrously awesome.", "timestamp_created": 1515057305, "timestamp_updated": 1515057807, "voted_up": true, "votes_up": 2, "votes_funny": 1, "weighted_vote_score": "0.530583202838897705", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "39000673", "author": {"steamid": "76561197991718710", "personaname": "horrorsh0w", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/graphic/", "num_games_owned": 681, "num_reviews": 29, "playtime_forever": 1886, "playtime_last_two_weeks": 0, "playtime_at_review": 1872, "last_played": 1528732139, "avatar": "a414458044edab4a8f370e6aed556fd3d865b5c1"}, "language": "english", "review": "The core gameplay is completely unremarkable but the atmosphere, story, and the 40K license is enough to carry it. Buy it on sale for $10 or less.", "timestamp_created": 1514959483, "timestamp_updated": 1514959483, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523121416568756104", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "38996979", "author": {"steamid": "76561198053341948", "personaname": "kaoshosh", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198053341948/", "num_games_owned": 0, "num_reviews": 112, "playtime_forever": 218, "playtime_last_two_weeks": 0, "playtime_at_review": 218, "last_played": 1512688312, "avatar": "14f1a9927382fa8dea134a0f3ca6f17e6938e131"}, "language": "english", "review": "Best 40K game in the market. Nothing even comes close.", "timestamp_created": 1514948277, "timestamp_updated": 1514948277, "voted_up": true, "votes_up": 9, "votes_funny": 0, "weighted_vote_score": "0.608424007892608643", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}