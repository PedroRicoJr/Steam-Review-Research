ssSpecFella", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198163148477/", "num_games_owned": 0, "num_reviews": 325, "playtime_forever": 312, "playtime_last_two_weeks": 0, "playtime_at_review": 312, "last_played": 1567888087, "avatar": "85374e762c8593de4755c25478207c8f81a863b7"}, "language": "english", "review": "This game is a lot of fun, especially if you rebind the controls to more comfortable ones. It does get a bit boring though. There's section of the game where very little happens. Not sure how it made the cut. Overall the game is pretty good.", "timestamp_created": 1567888192, "timestamp_updated": 1567888192, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "54992986", "author": {"steamid": "76561197993791411", "personaname": "357 Magnum Ace", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/shadowwolfx1/", "num_games_owned": 528, "num_reviews": 63, "playtime_forever": 4212, "playtime_last_two_weeks": 0, "playtime_at_review": 4022, "last_played": 1579397160, "avatar": "3a8c99c6e9f5b6728f6c42091b5e87980c985222"}, "language": "english", "review": "The best shooter experience you're going to get in the Warhammer 40,000 universe. This game is not ground breaking in its mechanics, but it is fun, satisfying, and fast paced. There is no cover, your armor and faith in the Emperor is your cover, and your rage is all the nourishment you need. Slam through orks, traitors, and worse as you progress through the story of Titus an Ultramarine Captain who has a refreshing view of the Codex Astartes.\n\nNow for 40K fans, this game is BEAUTIFUL and it is very immersive. It nails the look and feel of WH40K down to a T. The only qualm I have is that these ultramarines should of been Ordos Xenos Death Watch. The scope of their tasks, capabilities, and accomplishments seems more fitting for them than rank-and-file Space Marines.\n\n10/10. Even though the game is long dead, I still go back and beat it from time to time and PvE multiplayer still has a few souls on. It's not impossible to find games.", "timestamp_created": 1567804019, "timestamp_updated": 1567804019, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "54974181", "author": {"steamid": "76561198145370837", "personaname": "G A S T E N C E", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Gastence/", "num_games_owned": 454, "num_reviews": 665, "playtime_forever": 1096, "playtime_last_two_weeks": 0, "playtime_at_review": 1096, "last_played": 1557162496, "avatar": "09176071ef035f68d776577f72af82a6c0c7279f"}, "language": "english", "review": "no likey likey", "timestamp_created": 1567689904, "timestamp_updated": 1567689904, "voted_up": false, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": "0.316925942897796631", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}