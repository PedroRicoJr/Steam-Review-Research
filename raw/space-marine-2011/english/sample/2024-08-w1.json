5281600", "reactions": []}, {"recommendationid": "171646641", "author": {"steamid": "76561197982090798", "personaname": "wackydude101", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197982090798/", "num_games_owned": 0, "num_reviews": 27, "playtime_forever": 864, "playtime_last_two_weeks": 0, "playtime_at_review": 864, "last_played": 1723071295, "avatar": "39df481bfe6260ee142eb4f42057e5ee99fa6e2c"}, "language": "english", "review": "We don't get many good warhammer games and this is one of them. That said the game is a product of  it's time. It still holds up graphically but it has a one thing in it that I am glad has become a lot less common in gaming. Quick time events. The biggest complaint I have with this game is making some fights not about player skill but about how quickly you can mash  buttons. Other than that this is a good game that I'd recommend if you love the 40k setting", "timestamp_created": 1723071250, "timestamp_updated": 1723071250, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "171645768", "author": {"steamid": "76561199468850380", "personaname": "Condorcobi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199468850380/", "num_games_owned": 21, "num_reviews": 3, "playtime_forever": 813, "playtime_last_two_weeks": 0, "playtime_at_review": 706, "last_played": 1770361466, "avatar": "e954d9a2ed7de4d64cd612dda2ccbc68dd6b56d4"}, "language": "english", "review": "Got this game to get prepared for Space Marine 2. Can't believe i never played this game when i had an Xbox 360. 10/10", "timestamp_created": 1723070015, "timestamp_updated": 1723070015, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_sc