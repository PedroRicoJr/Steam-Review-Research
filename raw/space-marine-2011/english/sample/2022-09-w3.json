{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2022-09", "window": 3, "start_date": 1663286400, "end_date": 1663891199, "month_true_total": 84, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 18:02:14 UTC", "reviews": [{"recommendationid": "122652063", "author": {"steamid": "76561198934161691", "personaname": "TheBlackBobRoss", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198934161691/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 395, "playtime_last_two_weeks": 0, "playtime_at_review": 395, "last_played": 1663882587, "avatar": "24e996d7fb8026c3560cc6d72a2182e53e5c1d57"}, "language": "english", "review": "Shootin, Blastin, Chaos Hackin fun", "timestamp_created": 1663882763, "timestamp_updated": 1663882763, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "122637044", "author": {"steamid": "76561197993661752", "personaname": "Cibron", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197993661752/", "num_games_owned": 439, "num_reviews": 71, "playtime_forever": 4016, "playtime_last_two_weeks": 0, "playtime_at_review": 2940, "last_played": 1726599872, "avatar": "7b0f65d77d2780e4dd916a22d8d966f1593525be"}, "language": "english", "review": "A walking simulator in the wh40k universe.", "timestamp_created": 1663863845, "timestamp_updated": 1663863845, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "122634605", "author": {"steamid": "76561198076286876", "personaname": "Triangle", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198076286876/", "num_games_owned": 3859, "num_reviews": 137, "playtime_forever": 384, "playtime_last_two_weeks": 0, "playtime_at_review": 384, "last_played": 1585244299, "avatar": "35735c62219628f50d8d485916ba64d16d2fa59b"}, "language": "english", "review": "Did you know that the enemies are health packs?\nThey are just hidden inside them, so you use a Chainsword to get them out.", "timestamp_created": 1663860550, "timestamp_updated": 1663860550, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "122608062", "author": {"steamid": "76561199112533572", "personaname": "La-llama-del-Rey", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199112533572/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 38430, "playtime_last_two_weeks": 0, "playtime_at_review": 10014, "last_played": 1788026848, "avatar": "1c2952c7f6d4b1fb9f2784708c3bf5e62bc458cb"}, "language": "english", "review": "Haha Chainsword goes Brrrrrrrrtttt !!!", "timestamp_created": 1663810775, "timestamp_updated": 1663810775, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "122580407", "author": {"steamid": "76561197982363521", "personaname": "Fyren", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/FyreNL/", "num_games_owned": 0, "num_reviews": 62, "playtime_forever": 391, "playtime_last_two_weeks": 0, "playtime_at_review": 391, "last_played": 1422736305, "avatar": "0ef323df434428be4bddaf4fb3ed28a892b05af5"}, "language": "english", "review": "Is this game worth your time? Absolutely, it's one of the best hack & slashers out there. Story is a bit cliche, but such is often the case with 40k, but it's engaging enough for you to pull through. They really nailed the design, and overall i absolutely recommend it. \n\nWhy the negative review, though?\n\nWell, it's €45 for an almost 10 year old title. They forcefully added in all the DLC on top of it, which might sound like a great deal until you figure out half of the 'content' was released for multiplayer. MP's been dead for many years. There's a small fanbase still out there that host sessions every now and then, which is unfortunately very much dependent on your timezone if that's even realistically feasible. Regardless, and i expect most people do, you're probably not interested in that and just want to play the singleplayer. Unfortunately, you don't get to choose that anymore. The base game used to be sold seperately at a far lower price than it's currently going for.\n\nIt's simply malevolent business practice.", "timestamp_created": 1663764554, "timestamp_updated": 1663764554, "voted_up": false, "votes_up": 8, "votes_funny": 0, "weighted_vote_score": "0.564020395278930664", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": [{"reaction_type": 6, "count": 1}]}]}