status": "offline", "profile_url": "https://steamcommunity.com/id/SeanMaxMyla/", "num_games_owned": 315, "num_reviews": 39, "playtime_forever": 538, "playtime_last_two_weeks": 0, "playtime_at_review": 255, "last_played": 1635575436, "avatar": "65c98e48932f5832f79e2a6d95652cdea606a6bc"}, "language": "english", "review": "its pretty good i guess\nnot enough team fortress 2 though so yeah this game gets 6 hot dogs out of an undefined amount of burritos", "timestamp_created": 1596176089, "timestamp_updated": 1646455545, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "73541651", "author": {"steamid": "76561197993727588", "personaname": "ibelle42", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197993727588/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 7601, "playtime_last_two_weeks": 0, "playtime_at_review": 6933, "last_played": 1725593076, "avatar": "806b5bc4392e061f7ac101834ed9a087d055ece6"}, "language": "english", "review": "Every other action shooter type game (except Doom 2016) has you cower like a weakling to regain health.  Space Marine has you diving headfirst into the enemy to regain health.  It's over the top and glorious.\n\nDoes it get a bit repetitive?  Yes.  But does it stay totally rad the whole time?  Yes.  Will you sometimes forget that you even HAVE guns?  Maybe.", "timestamp_created": 1596162653, "timestamp_updated": 1596162653, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "73536578", "author": {"steamid": "76561198080158449", "personaname": "tomTheRanger", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198080158449/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 703, "playtime_last_two_weeks": 0, "playtime_at_review": 703, "last_played": 1596139839, "avatar": "68355d9688b579ea1d6bc5cab7e38bc8f2389c82"}, "language": "english", "review": "Simple good fun.\n\nThis is possibly one of the most generic shooter with a bit of fighter games I've ever played but in that lies it's appeal. The story is standard GW warhammer stuff, the design is pulled straight out of the GW world. The shooting works fine but is nothing that hasn't been done elsewhere a thousand times and so is the hand to hand combat. \n\nBut it is just good fun. \n\nThe sound, feeling and visuals of the space marine stomping shooting and smashing up orcs just work. The game isn't too hard or too long to get boring and for the price it is now it's a blast.", "timestamp_created": 1596151727, "timestamp_updated": 1596151727, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}