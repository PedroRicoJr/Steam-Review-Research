id": "10430720", "author": {"steamid": "76561198044709703", "personaname": "Deadman", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198044709703/", "num_games_owned": 0, "num_reviews": 87, "playtime_forever": 933, "playtime_last_two_weeks": 0, "playtime_at_review": 905, "last_played": 1409112356, "avatar": "4ccab8ae0e9d6dbbcb405e78f221e9310b349692"}, "language": "english", "review": "I love the Warhammer 40k universe. This was a fun campaign to go through. What's better than fighting a bunch of Orks? How about Chaos! The only thing I didn't really like about the game was the combat system and mobility just felt really restrictive. Not enough to degrade the gameplay however. \n\nIf you like Warhammer 40k you should pick this game up.", "timestamp_created": 1402512952, "timestamp_updated": 1402512952, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.516129076480865479", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "10410788", "author": {"steamid": "76561198006025433", "personaname": "MartinMcc", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Gigolo81/", "num_games_owned": 489, "num_reviews": 6, "playtime_forever": 937, "playtime_last_two_weeks": 0, "playtime_at_review": 937, "last_played": 1402347608, "avatar": "773ebd213434e75652c0b5f6a2f427db117b8033"}, "language": "english", "review": "Space Marines 3rd Person View is the perfect setting for this intresting story set in the Warhammer 40K Universe. Sometimes I felt that it was a bit of a grind in some areas but overall I would recommend this game. If you see it on sale well worth picking up and playing.", "timestamp_created": 1402347857, "timestamp_updated": 1402837436, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.556247591972351074", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "10407362", "author": {"steamid": "76561198010938393", "personaname": "Zanuth", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198010938393/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 5606, "playtime_last_two_weeks": 0, "playtime_at_review": 5425, "last_played": 1568701650, "avatar": "90281bcb08a9d28ef4c343c5f6b8b75f093e4a9b"}, "language": "english", "review": "It's an absolute shame that this game is effectively dead due to the producers going belly up - but if you've got a group of friends you can play this, it's an absolute gem of a game (thankfully weapon perks and armor pieces can be unlocked in private versus lobbies)\n\nThe single-player campaign, while not a diamond of writing is still a lot of fun to go through for a \"classical\" space marine experience, regardless of my personal feelings for the Ultrasmurfs and the multiplayer, specifically the \"Exterminatus\" mode, is outrageous, pulse-pounding fun when you get a group of friends together in a skype call while you're playing it.\n\nIf you can get the boys together for a few rounds, I heartily recommend it!", "timestamp_created": 1402326684, "timestamp_updated": 1402326684, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}