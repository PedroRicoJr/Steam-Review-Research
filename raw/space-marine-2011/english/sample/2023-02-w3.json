se, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "133249273", "author": {"steamid": "76561198010423636", "personaname": "Oscar the Ham Bandit", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198010423636/", "num_games_owned": 666, "num_reviews": 81, "playtime_forever": 764, "playtime_last_two_weeks": 0, "playtime_at_review": 764, "last_played": 1676918740, "avatar": "77c1ee7557bdaf2ac16f3c79c86d3245deae29dd"}, "language": "english", "review": "I was having a pretty good time for a while with this game but the clunky controls and poor design decisions eventually catch up with it. Lots of pathing troubles and unintuitive controls make you feel like you're piloting a rock with tiny feet. The concept of executions to restore your health is fairly cool until you realize you're locked into a 10 second animation you can't cancel, taking damage all the while. Hopefully the next one will be more mechanically sound, but this one is more frustration than fun.", "timestamp_created": 1676919017, "timestamp_updated": 1676919017, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.470270842313766479", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}