": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "221405971", "author": {"steamid": "76561198121154471", "personaname": "rヨn", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/renancarvz/", "num_games_owned": 0, "num_reviews": 145, "playtime_forever": 560, "playtime_last_two_weeks": 0, "playtime_at_review": 560, "last_played": 1774146325, "avatar": "e002797f05e2475007b93b110bdedbf6fe69bf88"}, "language": "english", "review": "[h1]Above average fun that's mostly for fans of the source material. [/h1]\r\n[hr][/hr] \r\nCombat loop is fun, but nothing amazing.\r\n\r\nStory is ok, takes a while to get interesting.\r\n\r\nRan fine, when I had it installed on a HDD. Funny enough, the game would straight up not work when I had it installed on a SSD, but it worked after I moved it to a hard drive.\r\n\r\nSome graphical glitches here and there, nothing major.\r\n\r\n[h1]6/10[/h1]", "timestamp_created": 1774197890, "timestamp_updated": 1774197890, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}