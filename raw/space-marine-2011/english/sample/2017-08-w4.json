sonaname": "blasio83", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198018292879/", "num_games_owned": 118, "num_reviews": 8, "playtime_forever": 624, "playtime_last_two_weeks": 0, "playtime_at_review": 624, "last_played": 1504116442, "avatar": "c115c88294260d07078f6adb4fab56b0a9ea5a44"}, "language": "english", "review": "I demand a sequel!", "timestamp_created": 1504113387, "timestamp_updated": 1504113387, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.550641894340515137", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "34587290", "author": {"steamid": "76561198048126206", "personaname": "Ronan Inozuka", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198048126206/", "num_games_owned": 149, "num_reviews": 8, "playtime_forever": 2324, "playtime_last_two_weeks": 0, "playtime_at_review": 2103, "last_played": 1589951564, "avatar": "e89cfe17c679951524116deaaafe0c05b80d0a1e"}, "language": "english", "review": "To be perfectly honest, it was my little brother that introduced me to the Warhammer series, before he showed me I never even heard of Warhammer and a lot of my friends never talked about it plus the fact that I never saw any trailers on tv or YouTube about it so yea. BUT, the instant he showed me this series many years ago, I became the biggest Warhammer nerd he had ever seen, to the point where I even was coming up with blueprints to make my own Space Marine Armor (Out of METAL), he said that I had a problem but the fact is that I had my eyes opened. Also, I'm not a welder so I wouldn't have been able to make the armor anyway, but my uncles and grandfather was. Sadly we didn't have the money to buy the materials.\n\nBottom line is, I LOVE WARHAMMER, and the fact that you get to play as a SPACE MARINE, damn near died from a heart attack when I first heard about this game, and that was years ago yes, but that doesn't change the fact that I love this series. FOR THE EMPEROR!!!\n\n\"WE MARCH FOR MACRAGGE, AND WE SHALL KNOW NO FEAR!!!\"\nUltramarines: A Warhammer 40,000 Movie - 2010", "timestamp_created": 1504037519, "timestamp_updated": 1504037519, "voted_up": true, "votes_up": 4, "votes_funny": 3, "weighted_vote_score": "0.537242770195007324", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "34552456", "author": {"steamid": "76561198031085339", "personaname": "Tajfun", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198031085339/", "num_games_owned": 0, "num_reviews": 71, "playtime_forever": 587, "playtime_last_two_weeks": 0, "playtime_at_review": 587, "last_played": 1503934897, "avatar": "18c55a89041eb61a95c3fa115bed184dd7ded61b"}, "language": "english", "review": "Just good entertainment.\nEmperor protects.", "timestamp_created": 1503925661, "timestamp_updated": 1503925661, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.490654200315475464", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}