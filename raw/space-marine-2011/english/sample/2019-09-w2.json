g_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "55103131", "author": {"steamid": "76561198810957120", "personaname": "Saint Remillia", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198810957120/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 1792, "playtime_last_two_weeks": 0, "playtime_at_review": 823, "last_played": 1589698795, "avatar": "2fb5bf32a42b0351bcb8ca5853240077a98df48f"}, "language": "english", "review": "The game is absolutely amazing.", "timestamp_created": 1568450897, "timestamp_updated": 1568450897, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "55093930", "author": {"steamid": "76561198119338485", "personaname": "mullacabra", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198119338485/", "num_games_owned": 236, "num_reviews": 129, "playtime_forever": 802, "playtime_last_two_weeks": 0, "playtime_at_review": 380, "last_played": 1610928667, "avatar": "1ee2b13de8e854fe6e76e371f576a5ed527eade2"}, "language": "english", "review": "I love the Warhammer 40k franchise, I love it to death and that is why I love this game so much. My love for the game shall not blind me to its blatant, and experience dulling faults. Faults such as being basically on rails, a lot of time in game is filled with walking and nothing more, bullet sponges, and a transparent plot. \n\nDon't get me wrong, this is a great game for its time and worth every penny I spent on it. However I will not be recommending it to anyone outside of current Warhammer fans. It is a dated game, with dated game play and mechanics. The only thing within the game that can truly be boasted about is the environment, which doesn't stand up to the test of time when you really get pedantic with your observations. \n\nIf you are just looking for a third person shooter, in the style of Warhammer 40k, then I'd say go ahead and make the purchase because you won't regret it. If you are looking to buy this game as a noob to the franchise or with no knowledge whatsoever, immerse yourself with youtube videos first and see if the universe is even to your tastes.\n\nIt took me all of six hours to beat the campaign on the lowest difficulty, finding most of the audio logs, and taking care of a baby in the process. I have yet to try the multiplayer, but as I am a preferred player of single player I will leave my review as is.", "timestamp_created": 1568396161, "timestamp_updated": 1568396787, "voted_up": false, "votes_up": 4, "votes_funny": 1, "weighted_vote_score": "0.466714859008789062", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "55089260", "author": {"steamid": "76561197973237490", "personaname": "Obbosus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197973237490/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 2811, "playtime_last_two_weeks": 0, "playtime_at_review": 2320, "last_played": 1750892002, "avatar": "a1d3e8f85aa900665d7722cbb96fb40cb05dc567"}, "language": "english", "review": "Where is the next one?", "timestamp_created": 1568374827, "timestamp_updated": 1568374827, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.559748470783233643", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}