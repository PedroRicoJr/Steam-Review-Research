{"game": "space-marine-2011", "language": "english", "appid": 55150, "month": "2015-04", "window": 4, "start_date": 1429747200, "end_date": 1430438399, "month_true_total": 75, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 17:50:33 UTC", "reviews": [{"recommendationid": "15630196", "author": {"steamid": "76561198058618492", "personaname": "The Hive", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198058618492/", "num_games_owned": 0, "num_reviews": 20, "playtime_forever": 1732, "playtime_last_two_weeks": 0, "playtime_at_review": 787, "last_played": 1609975677, "avatar": "eb41d4b82ff358e2252f018ffdb56f0b2ba4387f"}, "language": "english", "review": "A regretably often overlooked third person shooter, even among fans of the 40k universe. The controls are solid, the weapons are satisfying and even though it deviated from the original plans (which would have been fantastic) it still has a fun, and sometimes exhilarating campaign. Having friends to play the multiplayer is a must, since finding games can be a little difficult without others to fill the spaces.\n\nUsing a jump pack and turning ork mobs to puddels of blood never felt better..\n\n9/10", "timestamp_created": 1430438378, "timestamp_updated": 1430438378, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "15629616", "author": {"steamid": "76561198008649607", "personaname": "Brendan1374", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198008649607/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 378, "playtime_last_two_weeks": 0, "playtime_at_review": 352, "last_played": 1430901377, "avatar": "ec6e90ec7c44bc0cd732524a03f4f05147419913"}, "language": "english", "