: 1386, "playtime_last_two_weeks": 0, "playtime_at_review": 1386, "last_played": 1541353196, "avatar": "f0be867b2de9fac872a3d2afa2f8f2664678f56f"}, "language": "english", "review": "Haven't had this much fun in a shooter for ages. Looks and sounds visceral - especially when you get the chance to rip a heavy bolter off it's mounting and open up on a mob of orks. Doesn't take huge amounts of brain power and is a great way of just emptying the mind after a long day. The best thing for me was that it really captures the feeling of the 40K genre - in some ways it actually enchances it. Makes me want to buy a squad of Ultramarines just to paint them up. I won't though.", "timestamp_created": 1542148630, "timestamp_updated": 1542148630, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}