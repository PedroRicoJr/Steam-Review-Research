: []}, {"recommendationid": "209858967", "author": {"steamid": "76561197977597227", "personaname": "Zig", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Zig216/", "num_games_owned": 1485, "num_reviews": 176, "playtime_forever": 582, "playtime_last_two_weeks": 0, "playtime_at_review": 582, "last_played": 1675105748, "avatar": "5f756ae6cfdd2a4ca7ad24e9f39335e3fc84de01"}, "language": "english", "review": "+ Beautiful design and good portrayal of the universe\r\n+ Pleasant game length\r\n+ Good weapon feel and satisfying explosions\r\n+ Melee combat feels powerful and weapons pack a punch\r\n+ Melee finishers are a great concept and look cool\r\n-+ Solid story but nothing outstanding\r\n- Controls are awkward and probably designed for consoles\r\n\r\nI can recommend this game to anyone who wants to shoot their way through the 40k universe.\r\n\r\n\r\n(DE:\r\n+ schönes Design und gut das Universum rüber gebracht\r\n+ angenehme Spiellänge\r\n+ gutes Waffengefühl und es knallt schön\r\n+ Nahkampf fühlt sich mächtig an und Waffen haben ordentlich wumms\r\n+ Nahkampf-Finisher sind tolles Konzept und sieht cool aus\r\n-+ solide Story aber nichts herausragendes\r\n- Steuerung ist umständlich und vermutlich für Konsolen ausgelegt\r\n\r\nJeder der im 40k Universum ballern möchte, kann ich das Spiel empfehlen.)", "timestamp_created": 1763830385, "timestamp_updated": 1763830385, "voted_up": true, "votes_up": 7, "votes_funny": 1, "weighted_vote_score": "0.546282947063446045", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": [{"reaction_type": 12, "count": 1}]}, {"recommendationid": "209854687", "author": {"steamid": "76561197979592167", "personaname": "slimak", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/slime_k/", "num_games_owned": 0, "num_reviews": 104, "playtime_f