steamid": "76561198174781253", "personaname": "trungquang1999", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/trungquang1999/", "num_games_owned": 224, "num_reviews": 3, "playtime_forever": 41359, "playtime_last_two_weeks": 0, "playtime_at_review": 2978, "last_played": 1724509516, "avatar": "e954d9a2ed7de4d64cd612dda2ccbc68dd6b56d4"}, "language": "english", "review": "You play as a Space Marine. \n\nYou hack and slash and shoot and kill through the horde of Ork in the name of the Emperor.\n\nNeed I say anything more?", "timestamp_created": 1571685484, "timestamp_updated": 1571685484, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "55699664", "author": {"steamid": "76561198056606996", "personaname": "-GK- Paladin", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198056606996/", "num_games_owned": 328, "num_reviews": 76, "playtime_forever": 161726, "playtime_last_two_weeks": 91, "playtime_at_review": 15998, "last_played": 1790537627, "avatar": "35c4a2de2033aeebfe6d8ce4c3842644e4fab39a"}, "language": "english", "review": "Despite this game's age it is still plenty of fun with dedicated fans.\n\nCampaign is a good start to learn the basics of this over the shoulder 3rd person perspective shooter.\n\nMultiplayer still has a few strong communities going with friendly and honest players.\n\nMultiplayer is both exciting and action orientated with plenty of builds for the 3 classes to choose from to suit your individual style of play.\n\nVarious modes to choose from in multiplayer as well as a co-operative multiplayer mode called Exterminatus (further expanded via dlc for a second Exterminatus map) where you face progressively challenging waves of enemy mobs similar to The Last Stand on Dawn of War 2. \nLevel your hero by doing this latter mode for easier experience gain and to get a better feel for the game before diving into player versus player action.\n\nGraphics are good.\nSound is good.\nStory in campaign is good.\n\nNothing negative about this game except the few cheaters in multiplayer and the P2P hosting system for multiplayer.\n100% recommend for hack and slash fans as well as shooter fans.", "timestamp_created": 1571645539, "timestamp_updated": 1571645621, "voted_up": true, "votes_up": 12, "votes_funny": 0, "weighted_vote_score": "0.595408380031585693", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": [{"reaction_type": 9, "count": 1}, {"reaction_type": 14, "count": 1}, {"reaction_type": 1, "count": 1}]}, {"recommendationid": "55699318", "author": {"steamid": "76561198135129080", "personaname": "FadeToBlood", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/wolf805/", "num_games_owned": 100, "num_reviews": 8, "playtime_forever": 133, "playtime_last_two_weeks": 0, "playtime_at_review": 15, "last_played": 1575954379, "avatar": "222a0de021600cd59f5e858c999efbcf07dc66ed"}, "language": "english", "review": "A true classic its a ♥♥♥♥♥♥♥ BLAST! 10/10", "timestamp_created": 1571642605, "timestamp_updated": 1571642605, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}