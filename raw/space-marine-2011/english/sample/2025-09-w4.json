e, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "205422378", "author": {"steamid": "76561198165835022", "personaname": "Elric", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198165835022/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 1906, "playtime_last_two_weeks": 0, "playtime_at_review": 1906, "last_played": 1758804775, "avatar": "9198fa90f479fe66619b33c21ffc309f4012734d"}, "language": "english", "review": "First of all, played it in 2025.  Secondly, I'm not great at first person shooters, but this one was fun and the controls were easy. There are some reviews that thought the plot was rigid, but I liked how it evolved as you progressed, naturally, and not from some quest giver. Not every game is going to have an amazing twist you didn't see coming, sometimes its nice to have a straight-forward mission. There is beauty in simplicity.", "timestamp_created": 1759085861, "timestamp_updated": 1759085861, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}