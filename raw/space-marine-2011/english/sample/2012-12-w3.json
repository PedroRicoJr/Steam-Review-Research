nt_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "6415960", "author": {"steamid": "76561198065815549", "personaname": "ODRiN", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/odryn/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 3594, "playtime_last_two_weeks": 0, "playtime_at_review": 2638, "last_played": 1673011318, "avatar": "1603f6cedeb60792429ba635480d789da460c9f8"}, "language": "english", "review": "МЯСЦО С ТАКИМИ ЖЕ ЛЮДЬМИ КАК И ТЫ", "timestamp_created": 1356198847, "timestamp_updated": 1356198847, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "3392474", "author": {"steamid": "76561198021953280", "personaname": "Chuck88", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198021953280/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 1828, "playtime_last_two_weeks": 0, "playtime_at_review": 1656, "last_played": 1445916319, "avatar": "76502ac8a395b6124147a3fd9ae7743119d57665"}, "language": "english", "review": "fun game !", "timestamp_created": 1356195969, "timestamp_updated": 1356195969, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "1373882", "author": {"steamid": "76561197992332891", "personaname": "SPACEMAN", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/howtodestiny/", "num_games_owned": 1142, "num_reviews": 130, "playtime_forever": 1531, "playtime_last_two_weeks": 0, "playtime_at_review": 1499, "last_played": 1703674191, "avatar": "fff4a0af5c5a2f6cd91d9f402e0c69e48af5416b"}, "language": "english", "review": "I played through the solo-campaign in this third-person shooter and I was kind of blasted. Im a huge Warhammer 40K fan and this game was basically a must buy for me. If you finished the campaign which took me like 5 or 6 hours the bloodthirst of your bolta is not over, not even close to be over! \n\nThe war continues in fast paced online battles where you gain levels for achiving challenges or killing other players. You unlock new outfits and new weapons. There are not many maps, but the maps available are awesome and hard to master. \n\n\nI can REALLY recommend this to EVERYONE who loves Warhammer 40k, you will not regret it. \n\nFor all guys who like action, grab it aswell! For those who like to experience a long single player campaign, this is not the game you are looking for. \n\nPS: The DLC`s are actually worth it.", "timestamp_created": 1356193130, "timestamp_updated": 1387217838, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.458092957735061646", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}