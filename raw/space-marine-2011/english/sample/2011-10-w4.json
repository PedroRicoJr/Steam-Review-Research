_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "937166", "author": {"steamid": "76561197982534601", "personaname": "Dale", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/tripkomaniak/", "num_games_owned": 0, "num_reviews": 43, "playtime_forever": 3628, "playtime_last_two_weeks": 0, "playtime_at_review": 3545, "last_played": 1430338511, "avatar": "32d23645515799ca2cca98f84cb0e7b0507a2529"}, "language": "english", "review": "WWWAAAAGGGGGGGGHHHHHHHHHH!!!!!!!!!!!!!!!!!!!!!!!!", "timestamp_created": 1320060464, "timestamp_updated": 1385418694, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "788324", "author": {"steamid": "76561197978374804", "personaname": "Faded Tiger", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197978374804/", "num_games_owned": 0, "num_reviews": 62, "playtime_forever": 3384, "playtime_last_two_weeks": 0, "playtime_at_review": 3384, "last_played": 1335682800, "avatar": "eb89dcaad32cc26b3be6e63177faffc06c494f82"}, "language": "english", "review": "An amazing game with very close to perfect atmosphere. If you are a 40k fan get this game! If you like 3rd person shooters, get this game! If you like sci fi get this game! Space marine is brutal, fast paced, hectic, and powerful. The only complaint i have is the length of the campaign (8 hours) and the companys statment that they probably will not make a sequal or expansion. The multiplayer is great too, however the fact it uses P2P to host servers is a extreemly large wrench in the gears...", "timestamp_created": 1320001372, "timestamp_updated": 1320001372, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "1813518", "author": {"steamid": "76561197998340897", "personaname": "Mononc Pator", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/MononcPator/", "num_games_owned": 0, "num_reviews": 34, "playtime_forever": 795, "playtime_last_two_weeks": 0, "playtime_at_review": 795, "last_played": 1326528000, "avatar": "c9ff3234a5084addd5bdb8e371931881ba938226"}, "language": "english", "review": "WH40k: Space Marine is a must for fanatics of both Epic beat-em ups and most things about the WH40k Universe, from the setting to the art design.\nIt's a masterful marriage between epic action and cinematic beauty. The attention to details is exquisite! -Though most likely familiar to most linear action games such as Dante's Inferno, God of War, and even Ghostbusters.\n\nNothing is made overboard, except -maybe- how the Tabletop version differ from the game, regarding how powerful Space Marines are. It's an epic action game with a captivating story and a thrilling soundtrack.\n\nMy only complain: It gets repetitive and frustrating at a later point in the game.", "timestamp_created": 1319956319, "timestamp_updated": 1319956319, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}