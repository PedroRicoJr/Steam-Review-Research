mid": "76561198015357478", "personaname": "PotterAndMatrixFan", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/PAMF/", "num_games_owned": 472, "num_reviews": 213, "playtime_forever": 581, "playtime_last_two_weeks": 0, "playtime_at_review": 580, "last_played": 1524694563, "avatar": "ef61e4dc2eea031115cadd781cd3e7fc9a746101"}, "language": "english", "review": "Warhammer 40,000: Space Marine was a pleasant surprise. It's a third-person shooter combined with a hack n slash element. And I'm a sucker for both. Killing orcs is a joy, but at times it can get a bit repetitive and the combos are way too simple. There's some design choices that felt odd, like limiting you to smaller guns when using the heaviest melee weapon in the game. You should be able to drop the melee weapon, instead of having no other way to fight your way through with inferior firearms. But that's just a small nitpick.\nGraphically, it does look nice except up-close where you'll notice the age of the game. I am not story-wise into Warhammer at all, but that didn't stop me from somewhat understanding the story in this game.\nIt's a pretty fun 9 hours of endless slaughter. 8/10\nSPEHSS MAHREENS", "timestamp_created": 1524695758, "timestamp_updated": 1524695758, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": [{"reaction_type": 6, "count": 1}]}, {"recommendationid": "41657868", "author": {"steamid": "76561198083319033", "personaname": "Metal", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198083319033/", "num_games_owned": 343, "num_reviews": 110, "playtime_forever": 2954, "playtime_last_two_weeks": 0, "playtime_at_review": 692, "last_played": 1603400364, "avatar": "95d8f1c00bbdc43e289e494f3dad027a6f930ac4"}, "language": "english", "review": "English/Englisch: Great Game, Love to kill the Xenos (Orks). I think it´s even somewhat of a must-have for Warhammer 40k Fans. But also for None-Fans the game is GREAT.\n\nGerman/Deutsch: Großartiges Spiel. Ich Liebe die Xenos (orks) abzuknallen. Ich denke es ist so etwas wie ein muss für Warhammer 40k fans. Ist aber auch für nicht fans gut.", "timestamp_created": 1524564873, "timestamp_updated": 1524564873, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "41652900", "author": {"steamid": "76561198033757204", "personaname": "shadow_of_mind666", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198033757204/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 97, "playtime_last_two_weeks": 0, "playtime_at_review": 96, "last_played": 1787931027, "avatar": "b75a41cc24226ff00fbfbf34f4aca8f69db2bd37"}, "language": "english", "review": "loved the game on ps3, still getting use to playing on PC my only issue is that the second game was cancled.", "timestamp_created": 1524534227, "timestamp_updated": 1524534227, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}