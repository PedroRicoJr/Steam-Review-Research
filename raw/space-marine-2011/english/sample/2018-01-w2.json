1515972892, "voted_up": true, "votes_up": 17, "votes_funny": 0, "weighted_vote_score": "0.693352758884429932", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "39335761", "author": {"steamid": "76561197995132155", "personaname": "greentiger", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/luckygreentiger/", "num_games_owned": 296, "num_reviews": 142, "playtime_forever": 468, "playtime_last_two_weeks": 0, "playtime_at_review": 292, "last_played": 1558764381, "avatar": "5a67ad8bc6afde5c690c500acd9c4681bb96dffd"}, "language": "english", "review": "This game is cool, but could have stood more testing.\n\nPROS\n+ It's orks vs. space marines, that's a golden setting right there!\n+ great voice acting and solid 40K story\n+ the shooty bits are great!\n+ the stabby bits are great too!\n\nCONS\n- the controls are wonky to me, obviously made for consoles first\n- I can get about an hour into the game but then I get to the room that stops my game COLD.\n(it has orks, a nob/nobs?, and squigs all charging at you--I do fine until the squigs as they run up to you and explode--the game sprinkles enemies at you the whole time but this room just swamps you); most people can get past this but this room just frustrated me and I quit playing -- up until that point I was having a rocking time and if I could ever get past that room I'm sure the rest of the game would be fun.\n\nif you like 3rd person cover shooters with console controls, give this one a shot.\notherwise just watch a let's play on youtube (like I did to see the full game).\n", "timestamp_created": 1515929647, "timestamp_updated": 1515929647, "voted_up": false, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.367017835378646851", "comment_count": 3, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "39311361", "author": {"steamid": "76561198011905858", "personaname": "chithwe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198011905858/", "num_games_owned": 169, "num_reviews": 53, "playtime_forever": 234, "playtime_last_two_weeks": 0, "playtime_at_review": 228, "last_played": 1561877563, "avatar": "7bd7b679c5366ab21aa4e22dc10f36102ecf6517"}, "language": "english", "review": "great action, hours of fun and intense battles. great game.", "timestamp_created": 1515856080, "timestamp_updated": 1515856080, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "39311292", "author": {"steamid": "76561198080044303", "personaname": "Wuu.", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198080044303/", "num_games_owned": 617, "num_reviews": 43, "playtime_forever": 334, "playtime_last_two_weeks": 0, "playtime_at_review": 334, "last_played": 1514366623, "avatar": "a196d03e0a9b9c30578b29299cb0f0f530d6835e"}, "language": "english", "review": "Green Skins ? Heresy ? Apocalypse ?\n\nSend in the UltraSmurfs !", "timestamp_created": 1515855887, "timestamp_updated": 1515855887, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}