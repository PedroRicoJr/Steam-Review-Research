nded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "211781047", "author": {"steamid": "76561199224984029", "personaname": "Revan", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199224984029/", "num_games_owned": 108, "num_reviews": 23, "playtime_forever": 449, "playtime_last_two_weeks": 0, "playtime_at_review": 315, "last_played": 1769195189, "avatar": "cbd2b44990d8d467c71b9d3f8a3133ad64a61212"}, "language": "english", "review": "The game's a great start for a starter that doesn't want to get all nerdy in the lore. Game's great, aswell is the 2nd one. It's a nice and very adaptive start into the universe of Warhammer, without being so strict with the books or lore. It's a thing warhammer has, attracts every type of dude; Movie's fans, serie's fans, book fans, strategy fans.. And this game is in the 3rd person shooter fans tag. It's a fantastic way of watching the Ultramarines develop in combat, even tho it's not as lore accurate as it's inside the books/other games, it's still nice and good to watch. \r\n\r\nIf you're looking into a headstarter of the saga and don't know what to play, it's best to play these kinds of games.\r\n", "timestamp_created": 1764465194, "timestamp_updated": 1764465194, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}