"steamid": "76561198069856935", "personaname": "RageKnight", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198069856935/", "num_games_owned": 329, "num_reviews": 9, "playtime_forever": 372, "playtime_last_two_weeks": 0, "playtime_at_review": 372, "last_played": 1626372713, "avatar": "7a741b8d9d4b80e71571ba1bdb1d4fd8814f740d"}, "language": "english", "review": "FOR THE EMPEROR!!!!", "timestamp_created": 1626372795, "timestamp_updated": 1626372795, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "95793784", "author": {"steamid": "76561197973421998", "personaname": "ZeroFocus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197973421998/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 5790, "playtime_last_two_weeks": 0, "playtime_at_review": 4744, "last_played": 1650290464, "avatar": "46f37b677359ecc6d3dcfdea72bab15f55c2838f"}, "language": "english", "review": "Probably the best WH40K game on the market. What is lacks in playable multiplayer content (more than 2 game modes and 3 maps) it makes up for in sheer customizability of your space marine. Eight or nine armor sets that can be mixed and matched and all individual pieces can be painted, all your favorite 40k weapons. This games offers loads of toys, but not enough rooms to play in.", "timestamp_created": 1626367646, "timestamp_updated": 1626367646, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}, {"recommendationid": "95793432", "author": {"steamid": "76561198247967992", "personaname": "AceEchelon", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198247967992/", "num_games_owned": 0, "num_reviews": 225, "playtime_forever": 717, "playtime_last_two_weeks": 0, "playtime_at_review": 717, "last_played": 1626367048, "avatar": "cbf64011e21d3f9f2e866da22befe7dd6abc777f"}, "language": "english", "review": "Must be played by every Warhammer fan, good story of Titus, simple but going good with game. The game is actuion combat one, with focus on melee. Theres shooting but i think it could be done better. Once i got my hands on hammer i basically paved my way through the game with it. Locations are ok, not too fancy but still good with lore. Story is not long. Overall good to get on discount. If you are new to Warhammer, its a pretty fun starter.", "timestamp_created": 1626367251, "timestamp_updated": 1626367251, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.546059191226959229", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}