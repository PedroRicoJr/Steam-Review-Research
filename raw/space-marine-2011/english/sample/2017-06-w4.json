ona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198046212755/", "num_games_owned": 0, "num_reviews": 36, "playtime_forever": 1120, "playtime_last_two_weeks": 0, "playtime_at_review": 615, "last_played": 1712178270, "avatar": "b16bd58f554cd177e5488bf9ffb496ebbed258fb"}, "language": "english", "review": "I keep gettint the feeling like this game had its' budget cut half way through development. There does seem to be a few good ideas in what is just a realy mediocare cover shooter(just because there isn't a button for your character to stick him self to a wall doesn't mean the game isn't set up like a covershooter) like the having to attack to refill your health meater. Although this mechanic seems to have been better implammented in the new DOOM game. I honestly would like to see a company attempt this again, even the same company if they learned anything. Given how vaslty different Alien Isolation turned out from Colonial Marines I am willing to see if SEGA ever comes back around to this. I rather like the idea of a shooter first or third person perspective set in the Warhammer 40k universe. But if they do I hope they give it a better setting than brown blown out buildings.", "timestamp_created": 1498709723, "timestamp_updated": 1498709723, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.44899594783782959", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1315281600", "reactions": []}]}