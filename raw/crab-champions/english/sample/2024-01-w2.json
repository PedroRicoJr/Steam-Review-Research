tions": []}, {"recommendationid": "156056995", "author": {"steamid": "76561198834229536", "personaname": "bjx", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198834229536/", "num_games_owned": 85, "num_reviews": 3, "playtime_forever": 10372, "playtime_last_two_weeks": 0, "playtime_at_review": 4371, "last_played": 1780116487, "avatar": "bc10be6a669ed681ed521a250c31316affc14156"}, "language": "english", "review": "Phenomenally fun game! After finally deciding to go and beat every achievement I think a review is most definitely needed from my side. The core gameplay loop is fun and very replayable whether you're going  for a simple win on nightmare or a challenge run to see how high up you can get(personally I got to 240 on nightmare before King Skull's fire inevitably burned me to death) the game is ultra fun, personally I find that the further you go into a run the more the fun increases as the challenge also ups so go for those loops after you beat the boss. I'd say this was possibly the most fun of any game that I've had that released recently after all the disappointments that were AAA titles to me.  I'd strongly recommend this game to anyone looking for a fun replayable and fast paced game. The newest Variety update has made the game so much more fun and allowed builds to be taken to the next level, if you're on the fence about purchasing this game. Just do it, do it. It is so worth the money and the time into the game will be well rewarding for you.", "timestamp_created": 1705350917, "timestamp_updated": 1705350917, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "156044993", "author": {"steamid": "76561198066828770", "personaname": "JHoff23", "persona_status": "of