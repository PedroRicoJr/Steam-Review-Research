s_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "139706126", "author": {"steamid": "76561198115476356", "personaname": "Sir Turlock", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/fzulu444/", "num_games_owned": 409, "num_reviews": 4, "playtime_forever": 6863, "playtime_last_two_weeks": 0, "playtime_at_review": 603, "last_played": 1787433298, "avatar": "d5ff90ae073ba5e89555debf1f6db98c589e0371"}, "language": "english", "review": "Crab moves funny and has a gun. 10/10", "timestamp_created": 1686171480, "timestamp_updated": 1686171480, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "139705166", "author": {"steamid": "76561198049994940", "personaname": "Gadsd3n", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198049994940/", "num_games_owned": 0, "num_reviews": 21, "playtime_forever": 1297, "playtime_last_two_weeks": 0, "playtime_at_review": 283, "last_played": 1687918032, "avatar": "09dbac9313cae4772048e068104808a083456aab"}, "language": "english", "review": "heres the feedback i left in their official discord\n\nFirst;\n\nthis game is absolutely meaningless. you have us run through a gauntlet of enemies only for us to lose everything except keys upon victory or death. its absurd. There's no reward system and playing your game is ultimately worthless as a result. it would be much better if you could take with you what you earn and build a loadout before heading into matches- ESPECIALLY for nightmare mode.\nI'm placing this complaint above all others because it is by far the most egregious. when I play other games, there's a sense of accomplishment. I leave matches knowing that i earned something. there is NOTHING worth my time in this game as it stands.\n\nSecond;\nYour difficulty system is atrocious. You need 5 difficulties, not 3. normal is way too easy, and a blind monkey could play on easy. nightmare is way too difficult for new players. also, what videogame has ever gone from normal to nightmare??? it makes no sense. Very Easy, Easy, Normal, Hard, Nightmare. \n\nThird;\nRewards for kills are TERRIBLE. You know how frustrating it is when you do 90% of the damage to a boss or miniboss but 100% of the crystals go to the person who last-shot the enemy? The system rewards whatever toolbag teammate sits on the back to farm last-shots away from their teammates doing all the work and damage.\n\nFourth;\nAs for bugs? I've been getting shot THROUGH WALLS by bosses and minibosses. I've had chests fall into rocks (lucky i was still able to loot them), I've completed tasks that should unlock cosmetics but they havent actually unlocked, I've had gound-based AOE kill me while I'm mid air. \n", "timestamp_created": 1686170017, "timestamp_updated": 1686170017, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.409701377153396606", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": [{"reaction_type": 1, "count": 1}]}, {"recommendationid": "139703971", "author": {"steamid": "76561199026091241", "personaname": "underwearsmella5", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199026091241/", "num_games_owned": 41, "num_reviews": 8, "playtime_forever": 1992, "playtime_last_two_weeks": 0, "playtime_at_review": 182, "last_played": 1769751287, "avatar": "fef49e7fa7e199731