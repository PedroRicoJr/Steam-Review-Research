time_forever": 2778, "playtime_last_two_weeks": 0, "playtime_at_review": 518, "last_played": 1764432887, "avatar": "9de324b2f3b038205c99f91e5f775e658e9b96b8"}, "language": "english", "review": "This game is flippin awesome!", "timestamp_created": 1716498121, "timestamp_updated": 1716498121, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "165932815", "author": {"steamid": "76561198215931336", "personaname": "Hopping Panther", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hoppingpanther/", "num_games_owned": 231, "num_reviews": 6, "playtime_forever": 347, "playtime_last_two_weeks": 0, "playtime_at_review": 319, "last_played": 1716499333, "avatar": "70df51e86abab9fcec0b0fa3d45b987225c613e3"}, "language": "english", "review": "Extremely smooth and satisfying to play.", "timestamp_created": 1716497677, "timestamp_updated": 1716497677, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "165925038", "author": {"steamid": "76561198079205509", "personaname": "Orphan Crushing Machine", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198079205509/", "num_games_owned": 0, "num_reviews": 67, "playtime_forever": 5085, "playtime_last_two_weeks": 0, "playtime_at_review": 4591, "last_played": 1762065202, "avatar": "3671b1a4b7b369afc6186fe8efc5b1d4a29e9f56"}, "language": "english", "review": "[h1]Summary:[/h1]\nA crabulous experience! High octane level driven play with a nice difficulty curve and huge replay value. A rogue-lite that measures up among the best of them.\n\n[h1]Pros:[/h1]\n- Game play is consistently smooth until the upper level range where the game starts to freak out like all rogue lites tend to.\n- Lots of guns, good amount of variety in damage and style\n- The music matches the vibe of the game perfectly\n- Great difficulty scaling system\n- Mini-games are a nice touch for practicing and warming up\n- Multiplayer feels fantastic\n\n[h1]Cons:[/h1]\n- Low Biome diversity currently\n- Some enemies are absolute ♥♥♥♥♥♥♥♥♥ (looking at you Ice Slug)\n\n[h1]Overall:[/h1]\nOne of the best rogue-lites for a multiplayer experience that is just similar enough to Risk of Rain 2 to deserve the comparison, but stays far enough in its own lane to justify recognition in its own right. Grappling Hook + Hammer forever.\n\n[h2]Score: 8.5/10[/h2]", "timestamp_created": 1716488001, "timestamp_updated": 1716488019, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}]}