, {"recommendationid": "140515575", "author": {"steamid": "76561198117170832", "personaname": "Lil'Chizzy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/LilChizzy/", "num_games_owned": 414, "num_reviews": 12, "playtime_forever": 1176, "playtime_last_two_weeks": 0, "playtime_at_review": 1067, "last_played": 1713053431, "avatar": "1fa48f3adeb9594213eb5579244b70f7430ff46e"}, "language": "english", "review": "This has truly phenomenal gameplay. It's definitely repetitive in terms of the variety of maps and enemies but the gameplay is just so good that the repetitiveness isn't an issue. The randomness of the perk drops and builds makes every game feel fresh and this game has that addictive quality where I always want to play another game. In it's current state, this game is already a great value for just $10 and a must have, but I really hope the dev adds more maps and modes over time.", "timestamp_created": 1687464213, "timestamp_updated": 1687464213, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "140513653", "author": {"steamid": "76561199451718097", "personaname": "gold cap", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199451718097/", "num_games_owned": 158, "num_reviews": 9, "playtime_forever": 1161, "playtime_last_two_weeks": 0, "playtime_at_review": 807, "last_played": 1783375515, "avatar": "531580668709d36bb700885d4ece85ee0712a907"}, "language": "english", "review": "If you like Rougelikes And carbs get it its woth the 10 bucks the onlly problems is no enemy counter in Arena or Hordes and the feedback button is broken but still pleaseeee buy it its worth it", "timestamp_created": 1687461860, "timestamp_updated": 1687481719, "voted_up