persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198208990697/", "num_games_owned": 171, "num_reviews": 16, "playtime_forever": 17359, "playtime_last_two_weeks": 0, "playtime_at_review": 16782, "last_played": 1778648149, "avatar": "b7066fb6ff81e0241bea7620e0bda9e06b669c13"}, "language": "english", "review": "Yeah I think its pretty good.\r\n\r\n", "timestamp_created": 1766525417, "timestamp_updated": 1766525417, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "214026475", "author": {"steamid": "76561198127305169", "personaname": "mcfussybear", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198127305169/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 22730, "playtime_last_two_weeks": 0, "playtime_at_review": 19962, "last_played": 1787556445, "avatar": "82014075aa308f67a46c0cfa2ed9ec36282c8f26"}, "language": "english", "review": "Great game with a great dev that listens to people.", "timestamp_created": 1766519482, "timestamp_updated": 1766519482, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "214020710", "author": {"steamid": "76561199648752433", "personaname": "Mortemrose", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199648752433/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 823, "playtime_last_two_weeks": 0, "playtime_at_review": 182, "last_played": 1768876419, "avatar": "3dd9229b07ea24b45b19ab4b918d76e03efc7528"}, "language": "english", "review": "This game is great. It feels like a complete game even in early access, but I can see where there is much more room for growth. (Hats!) Crab champions is classified as a roguelike. It got great rewards, plenty of them to change your build each time. The first (bronze) difficulty is not too hard to frustrate you, but not too easy that it bores you. It has multiple other difficulties to make it harder, and you can choose the negative and positive effects. my favorite part is that it's multiplier! It works great with two people and playing a little bit alone and with someone else, I can tell that they scale it for multiplayer, but it doesn't make it impossible. the BEST part of this game is the save feature. I was randomly kicked out of my multiplayer lobby once (early access bug, understandable) and the save feature saved us. I didn't notice any bugs other than that one instance of being kicked, but other than that, GREAT game so far!", "timestamp_created": 1766514589, "timestamp_updated": 1766514589, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}]}