.com/profiles/76561199017881892/", "num_games_owned": 0, "num_reviews": 45, "playtime_forever": 1643, "playtime_last_two_weeks": 0, "playtime_at_review": 1256, "last_played": 1766801445, "avatar": "8cdc71f048cde50318b3abc77fbe0e0a3249c746"}, "language": "english", "review": "good game", "timestamp_created": 1699991778, "timestamp_updated": 1699991778, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.488205909729003906", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "150131569", "author": {"steamid": "76561198050940352", "personaname": "Ginja Ninja", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Ginjaninjaplaysgames/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 2665, "playtime_last_two_weeks": 0, "playtime_at_review": 1176, "last_played": 1763862065, "avatar": "db1382126b55a2709386f99d0727732927d42cd2"}, "language": "english", "review": "Carcinisation is the process in which nature repeatedly evolves things into crabs. This is because crabs are truly the ultimate life form. This game is an example of how even in the virtual world, crabs reign supreme. While many games make you play as ineffective humans, this game lets you become a legend, a champion, a CRAB. \n", "timestamp_created": 1699990533, "timestamp_updated": 1699990533, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.488205909729003906", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "150125498", "author": {"steamid": "76561198255675448", "personaname": "ojsan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ojsano