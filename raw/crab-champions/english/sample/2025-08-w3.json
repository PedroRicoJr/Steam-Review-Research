nd progression since it feels like 20 hours is as much as the game is going to get out of me.", "timestamp_created": 1755981010, "timestamp_updated": 1755981050, "voted_up": true, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.566774070262908936", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "202735913", "author": {"steamid": "76561199142994257", "personaname": "King Crab", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199142994257/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 10385, "playtime_last_two_weeks": 13, "playtime_at_review": 4396, "last_played": 1789807139, "avatar": "b0f8e04dbc18c5c7639a92cd4d869916ad5367f7"}, "language": "english", "review": "its very funny", "timestamp_created": 1755975839, "timestamp_updated": 1755975839, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}]}