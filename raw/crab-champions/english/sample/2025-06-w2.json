{"game": "crab-champions", "language": "english", "appid": 774801, "month": "2025-06", "window": 2, "start_date": 1749340800, "end_date": 1750031999, "month_true_total": 286, "quota": 5, "returned": 5, "pulled_at": "2026-09-30 05:50:19 UTC", "reviews": [{"recommendationid": "197326475", "author": {"steamid": "76561198021232448", "personaname": "Smeaglethegreat", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198021232448/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 980, "playtime_last_two_weeks": 0, "playtime_at_review": 305, "last_played": 1776640182, "avatar": "4efe1e4699f427f3dac9a9bf9d66c9968d91db66"}, "language": "english", "review": "amazing game for 10 bucks", "timestamp_created": 1750014681, "timestamp_updated": 1750014681, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "197325665", "author": {"steamid": "76561198046317880", "personaname": "FEYB", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/feyb/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 15582, "playtime_last_two_weeks": 0, "playtime_at_review": 11932, "last_played": 1787931999, "avatar": "d556379647a0639f63cfa2cd19d8dacf4eea41e6"}, "language": "english", "review": ".", "timestamp_created": 1750013951, "timestamp_updated": 1750013951, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "197310842", "author": {"steamid": "76561197985372889", "personaname": "xollner", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/xollner/", "num_games_owned": 1426, "num_reviews": 12, "playtime_forever": 4230, "playtime_last_two_weeks": 0, "playtime_at_review": 4218, "deck_playtime_at_review": 4127, "last_played": 1787945221, "avatar": "d4a5f556e61b8f2a0ba150d837a2b14753a59107"}, "language": "english", "review": "This game is a gem - it looks like it'll be a meme game but it's actually so good. It's worth every penny. \n\nRuns great on the steamdeck, a single run is the perfect length for playing through a lunch break.\n\nThe amount of content already is impressive with more to come in the future. There's so many weapons to play around with and tons of cosmetics to unlock which give you incentive to try them all. The movement is so fluid and responsive it's just a joy to play.  \n\nBuy it!\nEdited to nominate for the 2025 Steam Awards - Labor of Love ❤️", "timestamp_created": 1750001673, "timestamp_updated": 1764020328, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": true, "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "197279593", "author": {"steamid": "76561199146292462", "personaname": "handypill", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561199146292462/", "num_games_owned": 53, "num_reviews": 1, "playtime_forever": 2734, "playtime_last_two_weeks": 0, "playtime_at_review": 373, "last_played": 1789256346, "avatar": "18cf9e93edbe79213f24fd277a0c8fc05e9ec68f"}, "language": "english", "review": "WHY TF CANT I PLAY WITH OTHER PEOPLE\r\n\r\n", "timestamp_created": 1749972178, "timestamp_updated": 1749972178, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.451127827167510986", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1750000804, "developer_response": "If you aren't finding lobbies with quickplay that is likely because the game is currently between updates and most people are waiting for the next one before hopping back in.\n\nThat said though, there is a healthy community over on Discord where you can find people to party up with in the #looking-for-group channel\n\nhttps://discord.com/channels/547513194353131530/1093668079185170432\n\nIf you mean that you can't join your friends lobby, make sure you aren't using a VPN and that everyone has restarted their PC and Steam. Usually down to someone missing an update of some kind. You can also try joining via the Steam friends list menu or just all joining quickplay at the same time as alternative solutions.", "app_release_date": "1680364802", "reactions": []}, {"recommendationid": "197274205", "author": {"steamid": "76561199100894623", "personaname": "Dungathunga", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199100894623/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 4063, "playtime_last_two_weeks": 0, "playtime_at_review": 2577, "last_played": 1776416198, "avatar": "b44af1f89743046dd46b70d70bb4b76696bd4e61"}, "language": "english", "review": "crab", "timestamp_created": 1749965379, "timestamp_updated": 1749965379, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1680364802", "reactions": []}]}