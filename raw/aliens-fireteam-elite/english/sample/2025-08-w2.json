d_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "202170940", "author": {"steamid": "76561198984273876", "personaname": "mig_31d", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198984273876/", "num_games_owned": 574, "num_reviews": 114, "playtime_forever": 2084, "playtime_last_two_weeks": 0, "playtime_at_review": 2084, "last_played": 1684259558, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "I'm not big fan of shooter games, usually. But huge fan Alien and Aliens movies. So just had to try this game, luckily on discount.\n\nAnd it was fun to play for a while. It gives pretty good idea, how deadly swarm of those creatures is. No matter how hard marines try to shoot and blast, they mostly just die. Game feel somewhat grindy, but I think it is supposed to be that way. \n\nAfter initial fascination wears off, game turns out to be just a shooter. Someone who actually likes shooters, might enjoy it much more than I did.\n\nThere is way too less gore in this game. To get authentic Alien feeling, maximum gore is mandatory.\n\nStill, have to recommend this game, with some reservations.", "timestamp_created": 1755252213, "timestamp_updated": 1755275093, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "202151006", "author": {"steamid": "76561198037481201", "personaname": "Notshaye", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198037481201/", "num_games_owned": 278, "num_reviews": 33, "playtime_