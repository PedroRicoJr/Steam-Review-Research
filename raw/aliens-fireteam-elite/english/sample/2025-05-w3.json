 []}, {"recommendationid": "195447402", "author": {"steamid": "76561199221356070", "personaname": "AMOG", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199221356070/", "num_games_owned": 0, "num_reviews": 31, "playtime_forever": 2521, "playtime_last_two_weeks": 0, "playtime_at_review": 2521, "last_played": 1747912787, "avatar": "eb23df03a20358cf36c94ff5a6ddb0b186aa91cc"}, "language": "english", "review": "A great game to play with friends. Leveling up items is relatively quick and not frustrating. The challenge cards provide a lot of enjoyable experiences. The shooting feels comfortable; you can't jump, but you can roll, which doesn't make you feel trapped. The levels are beautifully and intricately designed. The high difficulty mainly comes from the enemies dealing massive damage. This creates a challenge, but once you know how to play, it's not too hard. The hardcore mode is confusingly easy. As a result, grinding for achievements becomes extremely boring. It's simply playing a level multiple times. Finally, I apologize if my English sounds like AI.", "timestamp_created": 1747965151, "timestamp_updated": 1747965151, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}