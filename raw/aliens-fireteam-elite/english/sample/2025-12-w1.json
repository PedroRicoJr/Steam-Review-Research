profile_url": "https://steamcommunity.com/id/heartboat/", "num_games_owned": 0, "num_reviews": 26, "playtime_forever": 621, "playtime_last_two_weeks": 0, "playtime_at_review": 486, "last_played": 1765157754, "avatar": "8c516fc00df5e381c8f9961893bbfe85f5fd7d2e"}, "language": "english", "review": "Is it a great game? No.\n\nThe voice acting is second rate. The animations feel stiff. The enemy AI is a bit too mindless. The quantity of content is a little thin. I could carry on.\n\nDo I have fun playing it? Yes. $30 seems a little steep, but if you find it on sale... it's something to do. Don't see myself logging 100+ hours here. I don't feel \"hooked\" by playing. But it's not a bad time.", "timestamp_created": 1765057673, "timestamp_updated": 1765057673, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.508861362934112549", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "212632087", "author": {"steamid": "76561198810742102", "personaname": "Kainya", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198810742102/", "num_games_owned": 247, "num_reviews": 34, "playtime_forever": 8625, "playtime_last_two_weeks": 1, "playtime_at_review": 8578, "last_played": 1787412379, "avatar": "7a98d429d9fb61bb6065773f2005fce7257463a8"}, "language": "english", "review": "Super fun when you can get into a game. I played on Xbox game pass but I got the whole game on sale for like £11. Hope there's plans for a similar game with a first person view or a moding mode so the community can contribute.", "timestamp_created": 1764959185, "timestamp_updated": 1764959185, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_