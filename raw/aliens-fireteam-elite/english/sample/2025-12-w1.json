{"game": "aliens-fireteam-elite", "language": "english", "appid": 1549970, "month": "2025-12", "window": 1, "start_date": 1764547200, "end_date": 1765151999, "month_true_total": 78, "quota": 5, "returned": 5, "pulled_at": "2026-09-04 02:25:48 Pacific Daylight Time", "reviews": [{"recommendationid": "212803799", "author": {"steamid": "76561199577605716", "personaname": "ADMRL_Sandog", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561199577605716/", "num_games_owned": 146, "num_reviews": 3, "playtime_forever": 1339, "playtime_last_two_weeks": 0, "playtime_at_review": 1073, "last_played": 1785529624, "avatar": "84f9f02900c90a5f64850af50300b9c0059c1be0"}, "language": "english", "review": "brilliant game, one little addition maybe for DLC that could be added which was an idea of mine, is that a mode kind of like helldivers could get added, where we drop to planets like LV426 and kill xenomorphs with assigned tasks that need to be completed, like extracting survivors, killing a queen. The timer on missions could be the countdown before a atmospheric processor explodes or something along those lines. just a suggestion/idea I had, Other than that this game is brilliant and that is coming from a die hard fan of the alien franchise.", "timestamp_created": 1765138594, "timestamp_updated": 1765138711, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "212785022", "author": {"steamid": "76561198882591712", "personaname": "Bombastic Booty", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198882591712/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 10008, "playtime_last_two_weeks": 0, "playtime_at_review": 7403, "last_played": 17853744