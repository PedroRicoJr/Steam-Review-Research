iew": "This is a really fun game to play with friends. I like the lore and the game style. You have lots of options for weapons and set up. I really just enjoy going through it with my friends trying out new things. The new update is a lot harder then some of the previous levels but I had a great time playing it and will continue to.", "timestamp_created": 1671128667, "timestamp_updated": 1671128667, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "128585426", "author": {"steamid": "76561198192986002", "personaname": "Wolf of Lua", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Lupus1155153/", "num_games_owned": 265, "num_reviews": 2, "playtime_forever": 1302, "playtime_last_two_weeks": 0, "playtime_at_review": 1255, "last_played": 1719433019, "avatar": "95d8f1c00bbdc43e289e494f3dad027a6f930ac4"}, "language": "english", "review": "Extreme fun", "timestamp_created": 1671079744, "timestamp_updated": 1671079744, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}