aused.\r\nNeed to use the bathroom?  F*ck you.\r\nThe batteries on your controller died?  Likely so will your character & progress.\r\nAlso, the game gets harder as your character levels up even on the 1st level despite there being a difficulty toggle which to me reveals a lack of awareness by the people who made the game.  I also like run-on sentences...\r\nOtherwise it can be fun.", "timestamp_created": 1721656332, "timestamp_updated": 1721656332, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.542280197143554688", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "170468140", "author": {"steamid": "76561197983564876", "personaname": "DsC.sashusilver", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197983564876/", "num_games_owned": 0, "num_reviews": 59, "playtime_forever": 935, "playtime_last_two_weeks": 0, "playtime_at_review": 780, "last_played": 1721681057, "avatar": "9fcc94f506a100e72020d44ef69664692d35c8c3"}, "language": "english", "review": "its fun", "timestamp_created": 1721644105, "timestamp_updated": 1721644105, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}