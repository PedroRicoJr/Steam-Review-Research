77600", "reactions": []}, {"recommendationid": "162430281", "author": {"steamid": "76561198160233211", "personaname": "Larnievc", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198160233211/", "num_games_owned": 174, "num_reviews": 4, "playtime_forever": 14608, "playtime_last_two_weeks": 0, "playtime_at_review": 12469, "last_played": 1779386190, "avatar": "beff12ad9b50eb44198e09965ff797d82f1730ae"}, "language": "english", "review": "Lots of aliens to kill.", "timestamp_created": 1712513169, "timestamp_updated": 1712513169, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "162419027", "author": {"steamid": "76561198022775548", "personaname": "Evisus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198022775548/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 2414, "playtime_last_two_weeks": 0, "playtime_at_review": 2382, "last_played": 1712888100, "avatar": "a5e804adc4b82c1a06134c576b4bc799571bc076"}, "language": "english", "review": "Amazing game with one or two friends to regularly play with, otherwise you won't get very far with the cruddy AI team mates.  By time you get run through the campaign once or twice and get tired of just doing that, you'll have enough items and levels to start pushing up the difficulty for better things.  By time you get tired of that, you'll be experimenting with your armory of unused weapons to level them up and getting out of your comfort zone to complete the daily/weekly challenges.  The game is worth full price, but it's a steal on a discount.", "timestamp_created": 1712503032, "timestamp_updated": 1712503032, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "162386577", "author": {"steamid": "76561197998184903", "personaname": "Schmiesen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197998184903/", "num_games_owned": 695, "num_reviews": 35, "playtime_forever": 5500, "playtime_last_two_weeks": 0, "playtime_at_review": 5500, "last_played": 1712446655, "avatar": "408f40c23b77ec0c7b9c5d2def1044937213beec"}, "language": "english", "review": "Underrated Shooter that features a great approach on and a lot of content\nfor classes, skills, stats and weapon customization \nas well as good gun play. Enemy variety is also pretty solid.\n\nBut all these good aspects become stale really fast due to\nthe lack of variety in levels or amount. You basically move from an area\nyou need to defend from enemy waves to the next one (mostly through tubes or tunnels).\nThe campaign consists of 4 acts, each containing 3 chapters (plus another act in the DLC).\nEach chapter takes about 20 to 25 minutes to complete. \n\nOnce you completed the campaign once (no matter which difficulty), you've just \nscratched surface on what AFE actually has to offer in terms of gameplay.\nThe game also gives you a horde mode in which you don't have to move from area to area through tubes\nbut stay in just one area. \n\nI got the game for free and bought the Pathogen DLC. I highly recommend it\nif you own or buy the base game because it features the best missions in the game.\nBut be aware of the repetitiveness of the levels. \n\nI recommend it on sale (with DLC). Good game for achievements as well.", "timestamp_created": 1712464413, "timestamp_updated": 1712464413, "voted_up": true, "votes_up": 29, "votes_funny": 1, "weighted_vote_score": "0.668269038200378418", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": [{"reaction_type": 6, "count": 1}, {"reaction_type": 8, "count": 1}]}]}