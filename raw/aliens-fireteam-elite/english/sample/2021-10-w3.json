te_score": "0.549928188323974609", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "101507157", "author": {"steamid": "76561198927053139", "personaname": "ASTHAGOTBEEF", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198927053139/", "num_games_owned": 574, "num_reviews": 8, "playtime_forever": 14550, "playtime_last_two_weeks": 1005, "playtime_at_review": 7683, "last_played": 1787781764, "avatar": "5ac6e872bdb28225917601b599e5c6ec8b03f474"}, "language": "english", "review": "I am a hardcore aliens fan and have played most alien games since the megadrive era . i really wanted this to be something special after getting my fingers burnt with aliens colonial marines . when i first played it it was enjoyable but then the repetitive nature of the game kicks in . stand here defend this is basically what you do over and over again mission after mission . i feel like the devs got lazy with this game . the settings and sounds are where this game shines so after 128 hours playing this game i got bored i might return if new levels come out . its no where near as bad as colonial marines . but if your looking to buy this game wait until its dirt cheap .", "timestamp_created": 1635010601, "timestamp_updated": 1635010601, "voted_up": false, "votes_up": 7, "votes_funny": 0, "weighted_vote_score": "0.547713279724121094", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "101505953", "author": {"steamid": "76561197973232798", "personaname": "armistice", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/katme/", "num_games_owned": 0, "num_reviews": 9, "playtime_