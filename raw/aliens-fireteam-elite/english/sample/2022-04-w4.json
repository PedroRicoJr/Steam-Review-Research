: "1629777600", "reactions": []}, {"recommendationid": "114721947", "author": {"steamid": "76561197972673082", "personaname": "Duckforceone", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/duckforceone/", "num_games_owned": 620, "num_reviews": 19, "playtime_forever": 4413, "playtime_last_two_weeks": 0, "playtime_at_review": 2224, "last_played": 1722692156, "avatar": "19b05eac157e278968e27c2c9b19e86e4566ba0b"}, "language": "english", "review": "If you are just playing with yourself, i can see this game only being fun for 15-20 hours until you complete the campaign...\nBut playing with a friend or two on voice, makes this game so much fun to replay, at least for a few hours a week...\n\nIt needs something to make it more longer lasting, but for an on and off game, it's good. Just don't expect much random teamups if you don't bring your own friends.\n\nBut i do wish they had done more with this. You can put 1 decal on a gun.. that's it.. but nothing on your armor.. you can't even change armor colour...\nAnd once you have gotten your class to max level, there's really nothing left to unlock or grind for unless you love the other classes and want a few of their abilities...\n\nBut i do feel like i have gotten my moneys worth of entertainment at 37 hours of gameplay...", "timestamp_created": 1651327357, "timestamp_updated": 1651327357, "voted_up": true, "votes_up": 12, "votes_funny": 2, "weighted_vote_score": "0.61494368314743042", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}