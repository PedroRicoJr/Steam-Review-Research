[]}, {"recommendationid": "216443568", "author": {"steamid": "76561198042320667", "personaname": "GGChyba", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/GGChyba/", "num_games_owned": 213, "num_reviews": 48, "playtime_forever": 1475, "playtime_last_two_weeks": 0, "playtime_at_review": 1475, "last_played": 1768957120, "avatar": "599f677646dbb6f728fe10d79cddadcc9ccee62f"}, "language": "english", "review": "Positives:\n- shoot and run (for some)\n- grinding (for some)\n- map is well designed\n- very little, but there is - interesting mechanics implemented\n\nnegatives:\n-terrible animation of shooting, runing, reloading, emotes, etc.\n-alien universum is weak on this one, lore is weak\n-a lot of problems related with features which can be abused\n-too little replayabe options other than changing classes\n-most weapons feels like copy paste, terrible sound design\n-abandon game by dev, quick cash grab on popular universum, very little players left in community\n\nso overall this is a bottom of 'medicore' game i would say, for 10-20h at max and then just forget, community is very little, AI is kinda ok at standard diff, get only if you really doesnt have to play on anything else, and dont mind a medicore gameplay - get on 80% discount only.", "timestamp_created": 1768957825, "timestamp_updated": 1768957825, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.487338662147521973", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "216413026", "author": {"steamid": "76561198998316860", "personaname": "Svenson", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/iodine_magnet/", "num_games_owned": 0, "num_reviews": 45, "playtime_forever": 1311, "playtime_last_two_weeks": 0, "playtime_at_review": 1311, "last_played": 1786226750, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "This game makes me incredibly angry. The matchmaking sucks, there are no players basically and when you do get a player they are so incredibly stupid and uncooperative. And there is no way to communicate with them. They either speed run solo and then get themselves killed.\n\nFriendly fire is also stupid for a game like this, the corridors are incredibly tight, it's difficult enough to aim with the third person already and this makes it almost impossible. That is probably why no one plays this ♥♥♥♥♥♥♥ stupid game.", "timestamp_created": 1768928118, "timestamp_updated": 1786227015, "voted_up": false, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "216375118", "author": {"steamid": "76561197963303858", "personaname": "Scarto", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197963303858/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 2233, "playtime_last_two_weeks": 0, "playtime_at_review": 1680, "last_played": 1769739462, "avatar": "0466342362167b546a574c2cce513d1879007c0d"}, "language": "english", "review": "I like being surrounded by the enemy and being able to shoot in every direction", "timestamp_created": 1768877048, "timestamp_updated": 1768877048, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}