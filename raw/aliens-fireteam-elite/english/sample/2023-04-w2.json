um_games_owned": 391, "num_reviews": 11, "playtime_forever": 832, "playtime_last_two_weeks": 0, "playtime_at_review": 832, "last_played": 1681534967, "avatar": "ff38337170630cfc81cc99000d9f8193f0643893"}, "language": "english", "review": "This game might have the worst soundtrack I've ever heard. It literally sounds like it was made by a third grader.", "timestamp_created": 1681535400, "timestamp_updated": 1681535400, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": "0.47826087474822998", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "136717779", "author": {"steamid": "76561198039840767", "personaname": "All~Hard*No~HUD", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/flexytime/", "num_games_owned": 0, "num_reviews": 54, "playtime_forever": 38, "playtime_last_two_weeks": 0, "playtime_at_review": 38, "last_played": 1681267474, "avatar": "9e45b65b91dcab32681483551c3a475f5242f563"}, "language": "english", "review": "Holy smokes, this is an awful game. Point&shoot at waves of aliens, zero story, zero context; 1 cut-scene then begin. 3rd person movement feels stifled and janky, minimal character animations, shooting is so basic they probably just bought a  plug-in on the Unreal marketplace and inserted it with default settings. You move to an objective on a boring map, the aliens die around you, on top of you, the models disappear and there is no acid blood. Feels like a tutorial demo done by a teenager, honestly. This was part of the Humble  bundle, I only have this game incidentally but I was still looking forward to it. Man was I disappointed, this game would be boring even if it were free.", "timestamp_created": 1681529772, "timestamp_updated": 1681529772, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.472202897071838379", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "136717751", "author": {"steamid": "76561198070712751", "personaname": "DevilFangs", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/DevilFangs/", "num_games_owned": 0, "num_reviews": 46, "playtime_forever": 6747, "playtime_last_two_weeks": 0, "playtime_at_review": 521, "last_played": 1747098017, "avatar": "00b5ab2f00e0b77e7cb375801d66d615fa70b57b"}, "language": "english", "review": "Ever want to go on a bug hunt like in the Alien films?!\nEver play The Division or WWZ?!\n\nBOTH You say?!\n\nIn space no one can hear you scream!\n\nThe look, the feel, the sound fx, everything here captures the feeling of the film franchise.\n\nThe A.I. Bot Teammates are kind of lame & wonky, but for understandable reasons since this game is best enjoyed with friends.\n Lore would even explain these wonky bots away as lesser grade synths by Seegson...\n\nREAL Fans of Aliens will enjoy it!\n\nI recommend turning OFF the 'X' kill marker & the outline in casual & standard settings for a more immersive feel!", "timestamp_created": 1681529715, "timestamp_updated": 1683989275, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.525862038135528564", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}