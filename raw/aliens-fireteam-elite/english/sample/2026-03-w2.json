ten_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "220680587", "author": {"steamid": "76561197994438050", "personaname": "Asmodae", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197994438050/", "num_games_owned": 0, "num_reviews": 19, "playtime_forever": 2156, "playtime_last_two_weeks": 0, "playtime_at_review": 2156, "last_played": 1729386674, "avatar": "2d1fb1885ea73b19dc4eb4f79a51a45057a61471"}, "language": "english", "review": "great game, unique skill system, and fun gameplay.  I wish there was more content for it.", "timestamp_created": 1773518054, "timestamp_updated": 1773518054, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "220431388", "author": {"steamid": "76561198165119213", "personaname": "ZT Link", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198165119213/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 42, "playtime_last_two_weeks": 0, "playtime_at_review": 42, "last_played": 1752189492, "avatar": "088105712de3dc7ae91dba7377221f0dace3168d"}, "language": "english", "review": "I looked at all the positive reviews on this game and decided to get it. I immediately got a refund after playing 30 minutes of the game. So what was wrong with it? Note: this is only my opinion and my experience.\n\nI launched the game made my character was ready for a mission. At the time I was playing, nobody was online. I didn't understand why but nobody was on a server, it was empty. So I decided to play with computer players. \n\nAnd the result? This game was not fun. The environment was really cool but some of the Xenomorphs were a little too easy to kill and not challenging even when I played hard. Now I come from playing Halo games ever since I was 7 and this felt like a missed opportunity to make a Halo game with Aliens theme, especially since Halo was inspired by Aliens. \n\nThe enemies were not that hard, the campaign felt very repetitive and tedious, and right when I was about to finish the first mission, the game decided to make it hard. This game could have been more like a fun little Halo game, but it wasn't enough and it wasn't fun for me.", "timestamp_created": 1773245951, "timestamp_updated": 1773245951, "voted_up": false, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.445676028728485107", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": [{"reaction_type": 28, "count": 3}]}, {"recommendationid": "220299542", "author": {"steamid": "76561198204511188", "personaname": "RIP2UALL", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198204511188/", "num_games_owned": 639, "num_reviews": 381, "playtime_forever": 53, "playtime_last_two_weeks": 0, "playtime_at_review": 53, "last_played": 1773086573, "avatar": "08e59551df90e40310c20a68cb666c5c2f768949"}, "language": "english", "review": "It's fine.", "timestamp_created": 1773086588, "timestamp_updated": 1773086588, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}