reated": 1766411802, "timestamp_updated": 1766411802, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "213854553", "author": {"steamid": "76561199771433735", "personaname": "Dark_Victoryy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199771433735/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 447, "playtime_last_two_weeks": 0, "playtime_at_review": 447, "last_played": 1766346172, "avatar": "a35977abdc2bcdd9f9893e0b3e39ff4a931020ff"}, "language": "english", "review": "Overall, I would not recommend this, this is like colonial marines all over again. The AVP game from 2010 is significantly more fun. I got this on sale for 5$ and still didnt have fun. The game consists of aliens that rush you in a single path, every corner one will jump on you thats about it. The \"perfect organism\" does not strategize or anything, just hundreds rush in a single file line. The ending is awful, i wont spoil (spoiler dont buy), but you have to blow up a ship to remove the infestation, theres no cutscene boom or anything, no boss fight. Just buy space marine or gears.", "timestamp_created": 1766346635, "timestamp_updated": 1766346635, "voted_up": false, "votes_up": 7, "votes_funny": 0, "weighted_vote_score": "0.518929064273834229", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": [{"reaction_type": 8, "count": 1}]}]}