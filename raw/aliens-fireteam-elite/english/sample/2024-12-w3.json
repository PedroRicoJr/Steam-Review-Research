steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "183502378", "author": {"steamid": "76561198007134052", "personaname": "Meekay", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/meekayuk/", "num_games_owned": 395, "num_reviews": 81, "playtime_forever": 165, "playtime_last_two_weeks": 0, "playtime_at_review": 84, "last_played": 1752059743, "avatar": "9952ccbd522755ded48d55bee2852062273fac47"}, "language": "english", "review": "This was initially one of those games where I purchased it and then it left Sitting in my steam library for probably over a year before I actually played it properly and when I did I was actually quite surprised at justice how fun it was it's not exactly a triple A blockbuster hit game but it does offer quite a bit it's one of those games where you will pick it up and play it for about half an hour an hour maybe and then put it back down but during that time it's got a lot going for it The graphics are nice it's well optimised and the game play is pretty fun and addictive playing with people on line is a pleasant experience the service work great and I enjoy playing some support rules while everyone else guns down those aliens it's a lot of fun and I can imagine it being more fun with friends but I am enjoying playing by myself with randoms online so I'm glad I picked it up I would recommend this game but just make sure that you're paying the right price for it because it is just a quick arcade shooter", "timestamp_created": 1734979944, "timestamp_updated": 1734979944, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}