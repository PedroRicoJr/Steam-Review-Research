tory and lore adds just enough to the Alien universe to open up all kinds of possibilities, merging the Alien and Aliens movies with a little bit of Prometheus' world.", "timestamp_created": 1673821892, "timestamp_updated": 1673821892, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "130928739", "author": {"steamid": "76561199044180024", "personaname": "Mercy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199044180024/", "num_games_owned": 0, "num_reviews": 38, "playtime_forever": 1531, "playtime_last_two_weeks": 0, "playtime_at_review": 441, "deck_playtime_at_review": 37, "last_played": 1745542120, "avatar": "9948a4caf117fc9957c29adedf8f3b82b6d8c141"}, "language": "english", "review": "aliems", "timestamp_created": 1673813941, "timestamp_updated": 1673813941, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.459183663129806519", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}]}