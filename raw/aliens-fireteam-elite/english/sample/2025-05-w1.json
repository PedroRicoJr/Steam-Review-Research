{"game": "aliens-fireteam-elite", "language": "english", "appid": 1549970, "month": "2025-05", "window": 1, "start_date": 1746057600, "end_date": 1746662399, "month_true_total": 221, "quota": 5, "returned": 5, "pulled_at": "2026-09-04 02:24:56 Pacific Daylight Time", "reviews": [{"recommendationid": "194440384", "author": {"steamid": "76561199092380676", "personaname": "MemeCreep420", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199092380676/", "num_games_owned": 0, "num_reviews": 120, "playtime_forever": 783, "playtime_last_two_weeks": 0, "playtime_at_review": 594, "last_played": 1763345770, "avatar": "d404a79a772c0921351cca1584573c246354ab19"}, "language": "english", "review": "If you are an aliens fan and enjoy PVE co op shooters, this is a no brainer on sale for around $6. You will need other players to play on the harder difficulties and there isnt a huge playerbase but the bots are competent on Normal difficulty. \n\nThe biggest downside is the 4 main campaigns and 1 dlc campaign are essentially the same levels every time. The replayabilty comes from trying different classes, weapons, perks, and difficulties. So do not buy if you don’t like aliens or fun or want 100+ hours out of it.", "timestamp_created": 1746660389, "timestamp_updated": 1746660389, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "194432587", "author": {"steamid": "76561199000798818", "personaname": "Lover Boi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199000798818/", "num_games_owned": 0, "num_reviews": 22, "playtime_forever": 11492, "playtime_last_two_weeks": 0, "playtime_at_review": 770, "last_played": 1787008998, "avatar": "04a4a86109ee341ce7fb3