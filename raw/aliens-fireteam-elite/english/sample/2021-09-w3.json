last_two_weeks": 0, "playtime_at_review": 457, "last_played": 1632289140, "avatar": "a465bb898a3f42785a383c1e3c2e5e7e87d7fae9"}, "language": "english", "review": "Honestly Aliens Fireteam is a triumph in AA game making. It nails the list of items it sets out to succeed at. The game has fun classes, solid weapons, a great upgrade and perk system, with a competent story mode and great horde-based combat, that's obviously taken a lot of notes from Left 4 Dead. \n\nThe game does have some bugs, and lacks a lot of the bells and whistles of AAA games, (cutscenes, lip synching, etc,) but it doesn't matter, because the core gameplay is competent and enjoyable, especially with friends.", "timestamp_created": 1632297334, "timestamp_updated": 1632297334, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99774098", "author": {"steamid": "76561198040162118", "personaname": "Hugh Jass", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198040162118/", "num_games_owned": 0, "num_reviews": 73, "playtime_forever": 1969, "playtime_last_two_weeks": 0, "playtime_at_review": 1299, "last_played": 1634061523, "avatar": "d84079b6b48b0470712a5929ccee5222ff258dcd"}, "language": "english", "review": "Yay", "timestamp_created": 1632295094, "timestamp_updated": 1632295094, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99771587", "author": {"steamid": "76561198123800031", "personaname": "DerpDynasty", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198123800031/", "num_games_owned": 0, "num_reviews": 19, "playtime_forever": 259, "playtime_last_two_weeks": 0, "playtime_at_review": 186, "last_played": 1635393464, "avatar": "8dfe278c7493b6984540e57ecd57b791df13841e"}, "language": "english", "review": "No reliable way to play multiplayer, even with your friends.\nShort content >5 hours\nNo in game chat or communication.\nReleased with a tiny amount of content. even a few weeks from release it's difficult to find randoms to play with.\n\nDon't give these people your money until they do better,\n", "timestamp_created": 1632289526, "timestamp_updated": 1632289526, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.535477280616760254", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99769949", "author": {"steamid": "76561198059815521", "personaname": "Danzer91", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198059815521/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 799, "playtime_last_two_weeks": 0, "playtime_at_review": 686, "last_played": 1634960485, "avatar": "f9ca15b91cecec1f43033d901ac729299c560f8f"}, "language": "english", "review": "Great time playing", "timestamp_created": 1632285949, "timestamp_updated": 1632285949, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99769770", "author": {"steamid": "76561198413736223", "personaname": "|Corvus|", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198413736223/", "num_games_owned": 85, "num_reviews": 15, "playtime_forever": 55487, "playtime_last_two_weeks": 0, "playtime_at_review": 9574, "last_played": 1770987640, "avatar": "0c838c325902c3bdabc4b455037519ce07852363"}, "language": "english", "review": "After all the updates, the game is very playable. Match making and cross play have revitalised the game.\nStill needs some form of chat though but it's fine.\n\nRecommended if you enjoy a mindless slaughter and then, in the higher difficulties, some choke point madness.", "timestamp_created": 1632285612, "timestamp_updated": 1689558219, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99769546", "author": {"steamid": "76561198038478107", "personaname": "HuckleMyBerries", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198038478107/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 4099, "playtime_last_two_weeks": 0, "playtime_at_review": 2445, "last_played": 1724214583, "avatar": "019970dd3edd82d11c72b0fa2dcfa25713819dea"}, "language": "english", "review": "a lot of fun", "timestamp_created": 1632285132, "timestamp_updated": 1632285132, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99769024", "author": {"steamid": "76561198323117386", "personaname": "GramZzz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198323117386/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 3697, "playtime_last_two_weeks": 0, "playtime_at_review": 3543, "last_played": 1668752913, "avatar": "a521352ec938d97a89f4b9655f75924d3cea6344"}, "language": "english", "review": "Really fun. Everything I expected and wanted it to be, and the cards keep things interesting when re-running campaigns.\nBUT!!..theres always a but..\nThere needs to be a quick play option!!!  Sometimes you dont care what map you play, youre just looking for a fireteam and get stuck in \"the cycle\".  Que a map, wait until countdown hits 10 secs, back out and re-que hoping people join. And this will happen several times over, and over, even if you load in to a 2 person fireteam. Utility is extremely important in the end game, so no one wants to run it with a slot empty/AI. SO DUH, QUICKPLAY OPTION! \n\nI also  wish the cards could be sold or discarded since they accumulate quickly if you loot every map.  Once your characters and guns are leveled out, the XP/Credits rewards are basically pointless.\n\n", "timestamp_created": 1632284200, "timestamp_updated": 1632284200, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.487152010202407837", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99768405", "author": {"steamid": "76561197988465680", "personaname": "Oriangel", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/oriangel/", "num_games_owned": 249, "num_reviews": 5, "playtime_forever": 1016, "playtime_last_two_weeks": 0, "playtime_at_review": 866, "last_played": 1633100845, "avatar": "a521352ec938d97a89f4b9655f75924d3cea6344"}, "language": "english", "review": "RPG Lite horde shooter with requires decent teamwork and skill (at higher difficulties).\n\nBest played with 2 friends although 1 should suffice.\n\nFor its price point, it's a decent pick me up game where you blast away at aliens with pure unbridled joy while being immersed in a complete Aliens setting. Can be quite challenging at higher levels. Card system provides some decent bonuses, replayability and challenges to spice things up.\n\nIf this game is on discount I'd highly recommend it. For it's full price, you can choose to get it if you and your buddies are looking for some co-op shooters now.", "timestamp_created": 1632283194, "timestamp_updated": 1632283194, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.566929101943969727", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99767826", "author": {"steamid": "76561198271183341", "personaname": "Crosshair", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198271183341/", "num_games_owned": 46, "num_reviews": 7, "playtime_forever": 2353, "playtime_last_two_weeks": 0, "playtime_at_review": 1528, "last_played": 1710562459, "avatar": "79f21f524cdb5d25073173848f1f39773e50be00"}, "language": "english", "review": "Fun game. Specially when you play with friends", "timestamp_created": 1632281915, "timestamp_updated": 1632281915, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1629777600", "reactions": []}, {"recommendationid": "99767140", "author": {"steamid": "76561198385161286", "personaname": "khlp111", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198385161286/", "num_games_owned": 108, "num_reviews": 6, "playtime_forever": 532, "playtime_last_two_weeks": 0, "playtime_at_review": 310, "last_played": 1632638436, "