{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2021-02", "window": 4, "start_date": 1613952000, "end_date": 1614556799, "month_true_total": 68, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:18:59 UTC", "reviews": [{"recommendationid": "87636716", "author": {"steamid": "76561198205978423", "personaname": "Voidbox", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198205978423/", "num_games_owned": 340, "num_reviews": 9, "playtime_forever": 6106, "playtime_last_two_weeks": 0, "playtime_at_review": 6034, "last_played": 1699055998, "avatar": "5c5f443980dec613bc527e5819b977501af7b7c6"}, "language": "english", "review": "Great game, but sometimes buggy and frustrating. The refined experience can be found in Risk of Rain 2 but if your PC can't handle that then this is a great alternative.", "timestamp_created": 1614552487, "timestamp_updated": 1614552487, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "87582894", "author": {"steamid": "76561198150758836", "personaname": "Gay Talon", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/billypeaches/", "num_games_owned": 610, "num_reviews": 32, "playtime_forever": 340, "playtime_last_two_weeks": 0, "playtime_at_review": 220, "last_played": 1669002889, "avatar": "0932f9282d8c56be0c4ef9d21c63b26342e8c325"}, "language": "english", "review": "good game\n", "timestamp_created": 1614483621, "timestamp_updated": 1614483621, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.492700725793838501", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "87557970", "author": {"steamid": "76561198121315333", "personaname": "takeout central", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198121315333/", "num_games_owned": 215, "num_reviews": 40, "playtime_forever": 367, "playtime_last_two_weeks": 0, "playtime_at_review": 290, "last_played": 1618720539, "avatar": "f18f7a4b978bd26183910e3517209894710bd75b"}, "language": "english", "review": "definitely more difficult than risky rain 2 but if you have the chance you should still check it out", "timestamp_created": 1614449822, "timestamp_updated": 1614449822, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "87511505", "author": {"steamid": "76561199016014954", "personaname": "𝙌𝙪𝙖𝙠𝘽𝙏𝙒", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199016014954/", "num_games_owned": 0, "num_reviews": 92, "playtime_forever": 110, "playtime_last_two_weeks": 0, "playtime_at_review": 110, "last_played": 1614313758, "avatar": "86f2722f6671a5b885a1a7ffb81b521984f6f81a"}, "language": "english", "review": "risk rain funny", "timestamp_created": 1614387879, "timestamp_updated": 1614387879, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.493409216403961182", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": [{"reaction_type": 3, "count": 1}]}, {"recommendationid": "87498270", "author": {"steamid": "76561198330117398", "personaname": "Amogus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198330117398/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 2323, "playtime_last_two_weeks": 0, "playtime_at_review": 2237, "last_played": 1686297805, "avatar": "f624ac49beae20d01cef2983513ae9575c800fc6"}, "language": "english", "review": "Definitely a bang for the buck. The game has high replay value thanks to the variety of builds you can try on each and every unique character in the game. I find the game enjoyable even after I am done with the achievements. You may also enjoy the game playing solo as you get to stack your items faster. However, I do believe that you will have a great time playing with your friends as you unlock new items or characters together. (The game supports Steam Remote Play, Local Co-Op and Online Co-Op). Do note that you may need to emulate the LAN connection through the use of a VPN app if you are playing with a friend via Online Co-op. Overall, it was a pleasant roguelike experience for me and I hope that you will give this game a try.\n\nP.S: Although I have mentioned that you are free to build your character however you want, do note that the rare item Hyper-Threader can cause a memory leak when paired with a high attack speed. Hence, it is not advisable to stack too much attack speed when you are using the Hyper-Threader as the memory leak may lead to a game crash on your potential best run. If you insist on using the Hyper-Threader with a high attack speed build, I recommend keeping the stacks of Soldier's Syringe below 10.", "timestamp_created": 1614369467, "timestamp_updated": 1614369467, "voted_up": true, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.573045670986175537", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": [{"reaction_type": 2, "count": 1}]}]}