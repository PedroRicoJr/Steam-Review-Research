s_owned": 0, "num_reviews": 7, "playtime_forever": 52, "playtime_last_two_weeks": 0, "playtime_at_review": 52, "last_played": 1741123962, "avatar": "ed439b6c7c36eb7c238d8e62b4c88f599021ce1c"}, "language": "english", "review": "Went in with 0 knowledge (I like to be surprised) the controls are un-intuitive and uncomfortable, the game puts no effort into guiding you and the combat is not fun. The movement is jerky, inaccurate and desperately lacks flow. Being unable to turn whilst shooting is a huge downside for me. My last run the game put up a message \"sucks to suck\". Ye it does, buddy. Uninstalled. Not for me.", "timestamp_created": 1741124464, "timestamp_updated": 1741124464, "voted_up": false, "votes_up": 6, "votes_funny": 7, "weighted_vote_score": "0.457810580730438232", "comment_count": 1, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": [{"reaction_type": 19, "count": 1}]}, {"recommendationid": "189337534", "author": {"steamid": "76561198075115581", "personaname": "heartilation", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198075115581/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 3669, "playtime_last_two_weeks": 0, "playtime_at_review": 3668, "last_played": 1741085841, "avatar": "1117d273e310990c98a21c5df067346343c6b1ba"}, "language": "english", "review": "ye", "timestamp_created": 1741085766, "timestamp_updated": 1741085766, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "189314913", "author": {"steamid": "76561199187239564", "personaname": "luigines64", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199187239564/", "num_games_owned": 192, "num_reviews": 81, "playtime_forever": 1556, "playtime_last_two_weeks": 0, "playtime_at_review": 1556, "last_played": 1700167466, "avatar": "b414cad0a6958cd10b03bfc0518bad11f89c0acf"}, "language": "english", "review": "I won't say this game is bad, just that you should totally check out Risk of Rain Returns instead. It has better visuals (which is actually really nice as it's much easier to see many smaller details), new content like items, characters, new character abilities, better balancing, and even a new gamemode. Overall, it's much better than this version of the game, and it isn't missing anything this game has. Do yourself a favor and get that instead.", "timestamp_created": 1741056658, "timestamp_updated": 1741056658, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.517750442028045654", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": [{"reaction_type": 19, "count": 1}]}, {"recommendationid": "189265385", "author": {"steamid": "76561198828582374", "personaname": "Salamitur", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198828582374/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 9007, "playtime_last_two_weeks": 0, "playtime_at_review": 7784, "last_played": 1760482865, "avatar": "c46516fcf08cef3444e5bfdce40cf1cdd385e7fa"}, "language": "english", "review": "Es muy buen juego jueguenlo nomas. . . :D puede tener controles raros pero se van a acostumbrar con practica ya van a ver que les sale", "timestamp_created": 1741009016, "timestamp_updated": 1741009016, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early