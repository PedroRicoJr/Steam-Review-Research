elease_date": "1383930480", "reactions": []}, {"recommendationid": "8058340", "author": {"steamid": "76561198008430759", "personaname": "mikey d", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/dbro/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 1235, "playtime_last_two_weeks": 0, "playtime_at_review": 1196, "last_played": 1415315980, "avatar": "523bed88e7ebbe542a5e007f74e5a865a0dc756c"}, "language": "english", "review": "♥♥♥♥♥♥♥♥ ♥♥♥♥♥♥♥♥ game of ♥♥♥♥ 5 stars", "timestamp_created": 1387134589, "timestamp_updated": 1387134589, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.497287511825561523", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8058242", "author": {"steamid": "76561197970659427", "personaname": "duncecap", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Duncecap/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 9990, "playtime_last_two_weeks": 0, "playtime_at_review": 2530, "last_played": 1538690433, "avatar": "170273477d15f5cde33097553781478a1693ae34"}, "language": "english", "review": "If you like dying and wasting hours of time on pointless ventures this is the game for you. Enjoy the first 20 minutes of hardship and tedium and then either die or ascend into a paragon of violence and get your retribution against all who have wronged you.", "timestamp_created": 1387134130, "timestamp_updated": 1387134130, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.557471275329589844", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8058194", "author": {"steamid": "76561198045172029", "personaname": "Christov", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198045172029/", "num_games_owned": 372, "num_reviews": 3, "playtime_forever": 6688, "playtime_last_two_weeks": 0, "playtime_at_review": 289, "last_played": 1495345530, "avatar": "e9a8ad939fdec56855d5de95e3347a516b8d4341"}, "language": "english", "review": "Pros: Fun character progression, lots of items to collect, local coop rocks\n\nCons: Levels seem a little less randomized than they should be, and you better like dying, because you will die...a lot\n\nOverall a great game, definitely recommend it", "timestamp_created": 1387133938, "timestamp_updated": 1387134000, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8056336", "author": {"steamid": "76561198039766236", "personaname": "Steve The Red Shirt", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Megamario/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 3006, "playtime_last_two_weeks": 0, "playtime_at_review": 923, "last_played": 1501782988, "avatar": "9af85539bf824031bdf3d8c0e8a55fe6209b5407"}, "language": "english", "review": "Risk of Rain I find is one of those games i can just sit down with and pass a half hour or and hour. This does not mean there is no tectical desicions in it though. when you aquire the enginier, you have turents and mines wich you have to set up tactifuly in order to survive. Now pay atention on your time thyats how you know how hard the game is going to get. the gameplay is fun and controls are nice (plus you can rebind them so if you dont like the layout you can change.) the art style makes you feel small and some of the creatures you will face with enforce that. I would definetly recomend this if you have the $10.", "timestamp_created": 1387125146, "timestamp_updated": 1387125146, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8055702", "author": {"steamid": "76561198008781610", "personaname": "tweakystraw", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198008781610/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1913, "playtime_last_two_weeks": 0, "playtime_at_review": 1471, "last_played": 1642214775, "avatar": "a76b1d2ac2d92676644aa6dcfbc19bfb7d0df265"}, "language": "english", "review": "one of the funest games i played this year", "timestamp_created": 1387122041, "timestamp_updated": 1387122041, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8055070", "author": {"steamid": "76561198014192312", "personaname": "[KFC] The Colonel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/kfcbruh/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 5201, "playtime_last_two_weeks": 0, "playtime_at_review": 2304, "last_played": 1431552349, "avatar": "9b1ca48cef587b235a3262ff901a6adb42be775d"}, "language": "english", "review": "You may begin this game an understand nothing and that's fine, but as you play it it becomes a beautiful and yet loney world where you are your only friend and EVERYTHING wants your life. The game may look simple overall, and it pretty much is, however you're quickly dragged into a world where the feeling of dispair hits hard only to be even more enhanced by the bomb ass music that plays with it. Whether you play this game alone or with friends you'll at least LIKE it. I bought the 4 pack and although I never played with my friends we all still liked it. Don't be discouraged if you're frustrated by the multiplayer function, this game is great just give it a chance.\n\nPROS (In my opinion):\n-Powerups even the playing field against massive bosses\n-Difficulty increases over time keeping the game fun\n-Many different heroes for whatever your play style\n-It's not an expensive title and you WILL play it a lot\n\nCONS (In my opinion):\n-Multiplayer isn't a simple setup (It will take some getting used to)\n-Chat in game is text based ( better keep those fingers flying)\n-THERE'S NO SEQUEL!!!", "timestamp_created": 1387118518, "timestamp_updated": 1403454739, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8054054", "author": {"steamid": "76561198025774200", "personaname": "sorryskies", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198025774200/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 4494, "playtime_last_two_weeks": 0, "playtime_at_review": 696, "last_played": 1555036147, "avatar": "793db9dbb48c782c2b8e7d7ee9f7c41dde1d9bfb"}, "language": "english", "review": "if you're looking for a challenge, and have a penchant for a myriad of quirky side-scrolling shooter fun, along with a dash of pain and agony, this is the game for you. actually, scrap that, this is the game for everyone!", "timestamp_created": 1387112500, "timestamp_updated": 1387112500, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8052320", "author": {"steamid": "76561198041306044", "personaname": "Vagrant Knight", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198041306044/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 2907, "playtime_last_two_weeks": 0, "playtime_at_review": 313, "last_played": 1403942127, "avatar": "11a109aa395bd5c2a89b14921020676fb0d2d95d"}, "language": "english", "review": "I great game if your looking for a challenge. With unlockable characters andonline co-op their's a huge amount of replayability. Their is also a huge learning curve playing the game. You'll die alot.. but when you succed it will be that much \nbetter. The sound track is amazing. Sometimes relaxing and ethereal other times intense when the action picks up. \nWith the ever increasing difficulty you never want to stop moving in this game.", "timestamp_created": 1387100922, "timestamp_updated": 1387100922, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8052106", "author": {"steamid": "76561197978870194", "personaname": "Sigil of the Void", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Acclue/", "num_games_owned": 3176, "num_reviews": 7, "playtime_forever": 1259, "playtime_last_two_weeks": 0, "playtime_at_review": 658, "last_played": 1497322489, "avatar": "b355154deaeb54d587e792960ee4b551088202a9"}, "language": "english", "review": "Amazing game. It starts off slow, but you feel panicked to rush through as fast as possible so that you can keep ahead of the difficulty timer. When it gets to the final difficulty and you're heading into the final stage, you somehow feel both absurdly powerful and hopelessly outgunned against the enemies at the same time. I kept feeling like there was no possible way that the game was going to step itself up further, but it just kept throwing stuff at me. A very challenging game, and that's just what I expected going into it. Now to play on monsoon difficulty...\n\nGreat replayability too with the different classes. Acrid was definitely my favorite though; had a very interesting playstyle and character design.", "timestamp_created": 1387099010, "timestamp_updated": 1387099010, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}