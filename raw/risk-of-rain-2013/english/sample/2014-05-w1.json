{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2014-05", "window": 1, "start_date": 1398902400, "end_date": 1399507199, "month_true_total": 360, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:08:24 UTC", "reviews": [{"recommendationid": "10047997", "author": {"steamid": "76561197970977641", "personaname": "MrDude", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/MrDudeCA/", "num_games_owned": 0, "num_reviews": 39, "playtime_forever": 3002, "playtime_last_two_weeks": 0, "playtime_at_review": 458, "last_played": 1590544714, "avatar": "0638b40b15cbc757417a623b8a913340564d4a80"}, "language": "english", "review": "Pros\n-Lots of characters to choose from, if you unlock them\n-Music is cool\n-Tons of stuff to unlock\n\nCons\n-Multiplayer is completely archaic, damn near worthless\n-The game relies almost exclusively on luck, skill factors minimally\n-Enemies are unbelievably cheap and frustrating\n\nThis game sells for 10 bucks, I got it for about 3 as part of a bundle. Had I spent more than that, I would have been upset.", "timestamp_created": 1399503278, "timestamp_updated": 1399503278, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "10046810", "author": {"steamid": "76561198110879289", "personaname": "UtriGermz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198110879289/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 2941, "playtime_last_two_weeks": 0, "playtime_at_review": 1515, "last_played": 1668194641, "avatar": "d4371bdba4c8c3484bc5b88edc6ee3c15d2bc250"}, "language": "english", "review": "Great game, i love the challages to  the game", "timestamp_created": 1399492668, "timestamp_u