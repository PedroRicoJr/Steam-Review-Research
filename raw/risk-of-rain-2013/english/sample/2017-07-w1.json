{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2017-07", "window": 1, "start_date": 1498867200, "end_date": 1499471999, "month_true_total": 145, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:13:19 UTC", "reviews": [{"recommendationid": "33356394", "author": {"steamid": "76561198332581380", "personaname": "Hooch", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198332581380/", "num_games_owned": 297, "num_reviews": 21, "playtime_forever": 3089, "playtime_last_two_weeks": 0, "playtime_at_review": 1340, "last_played": 1706422986, "avatar": "1fa48f3adeb9594213eb5579244b70f7430ff46e"}, "language": "english", "review": "After a good 7 years this game still holds up pretty well by itself. But with Risk of Rain Returns  dropping I can't really recommend the base gameplay provided by the original over Returns... but I will say that you should still get this game not for the fact that it's still solid but for the fact that the mod support for the original is more active and has more content to offer than Returns mod support. That could change in the near future, but please, give this game a go. If not for the base game, then for the mods. It's worth it.", "timestamp_created": 1499466815, "timestamp_updated": 1705483198, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "33353665", "author": {"steamid": "76561198101534053", "personaname": "Pageel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198101534053/", "num_games_owned": 97, "num_reviews": 4, "playtime_forever": 4941, "playtime_last_two_weeks": 0, "playtime_at_review": 2815, "last_played": 1667331823, "avatar": "81f1f2038d4089da4bc0ddf26b4e43eb6