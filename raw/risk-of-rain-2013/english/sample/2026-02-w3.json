{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2026-02", "window": 3, "start_date": 1771113600, "end_date": 1771718399, "month_true_total": 23, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:25:48 UTC", "reviews": [{"recommendationid": "218897797", "author": {"steamid": "76561198085993893", "personaname": "Catwashere", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/catwashere/", "num_games_owned": 1494, "num_reviews": 585, "playtime_forever": 1265, "playtime_last_two_weeks": 0, "playtime_at_review": 1265, "last_played": 1756590480, "avatar": "598c2a1a6f75b38ebc0e5665fe7a8e7cd3fc8acd"}, "language": "english", "review": "Risk of Rain (2013) is a chaotic, pixel-art roguelite that somehow still holds up as a genuine classic — the unpredictable runs, the wild item stacking, and that iconic soundtrack kept me coming back long after I should have called it quits. Made by two college students, it has that rare kind of soul that modern games rarely replicate, and dying for the hundredth time never stopped feeling like my own fault in the best possible way. That said, the current situation with the EULA and Gearbox's data collection practices is genuinely concerning, and it's hard to ignore when writing a recommendation in good conscience. If you want the definitive experience, Risk of Rain Returns is probably the better pick at this point — but the original still deserves respect as the game that started it all.", "timestamp_created": 1771707915, "timestamp_updated": 1771707915, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "218874130", "author": {"steamid": "76561199803943564", "personaname": "Vault Dweller's Sea Shop", "pers