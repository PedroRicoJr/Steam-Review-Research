{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2023-10", "window": 1, "start_date": 1696118400, "end_date": 1696723199, "month_true_total": 44, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:23:01 UTC", "reviews": [{"recommendationid": "147760560", "author": {"steamid": "76561198104742784", "personaname": "Cheeto", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/weirdostuff/", "num_games_owned": 197, "num_reviews": 29, "playtime_forever": 83, "playtime_last_two_weeks": 0, "playtime_at_review": 81, "last_played": 1699729394, "avatar": "9cc5c77d13af4362f4442f6e826456a55432bff8"}, "language": "english", "review": "A total classic, I've known this game before I even heard about the existence of RoR2. It's a typical roguelike game, you start the game weak as ♥♥♥♥, then you get items as you progress throughout the level and take out the big boss at the end. If you succeed you get thrown into an even harder level, if you fail you restart. Everything is randomized for each playthrough of course, as is expected of roguelike games such as this. It can keep you playing for a while with it's randomness and difficulty. You should definitely try it.", "timestamp_created": 1696623049, "timestamp_updated": 1696658414, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "147686786", "author": {"steamid": "76561198013072578", "personaname": "IM THE PATRICK OF WAR", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198013072578/", "num_games_owned": 292, "num_reviews": 47, "playtime_forever": 2009, "playtime_last_two_weeks": 0, "playtime_at_review": 2009, "last_played": 1696357721, "avatar": "40b965d60f91363de8a948a7b6fb5044bbd