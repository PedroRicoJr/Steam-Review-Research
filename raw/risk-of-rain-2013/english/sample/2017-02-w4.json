ed_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "30237143", "author": {"steamid": "76561198259405030", "personaname": "auu", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/itsauu/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 987, "playtime_last_two_weeks": 0, "playtime_at_review": 872, "last_played": 1730504041, "avatar": "14c94ace391b90e2c5c3e07e44f518f25a3d4376"}, "language": "english", "review": "Absolutely amazing OST and sound effects!\nGameplay is great, especially in two player co-op mode which works flawlessly, but make sure to look out for each other as one might not keep up with other one in later levels if not leveling/powering up alike. One thing to point out however is that game at first feels like it should be played slow and with some tactics in mind, but after a while you realize that it has a totally opposite pace, which isn't bad, just different from what you thought it was at first.\nWhat isn't great or at least could be improved on is the overall game and level design which are somehow procedural generated, but fails at some spots completely. From what I have read game was done by one programmer, one designer and one composer so it is absolutely amazing from that perspective, however I wish they had put a much more content and polish into it as game engine and overall feel of the game is superb.\nMaybe a sequel?\nGet it if you are looking for some rad co-op shoot-em-up to kill half an hour in the evening!", "timestamp_created": 1488274946, "timestamp_updated": 1488274946, "voted_up": true, "votes_up": 4, "votes_funny": 1, "weighted_vote_score": "0.559043347835540771", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}