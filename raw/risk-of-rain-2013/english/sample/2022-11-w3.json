estamp_updated": 1680242983, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "125912216", "author": {"steamid": "76561198172306430", "personaname": "Ramen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198172306430/", "num_games_owned": 189, "num_reviews": 29, "playtime_forever": 3407, "playtime_last_two_weeks": 0, "playtime_at_review": 1647, "last_played": 1700338064, "avatar": "52c0598d84ed9f28496fa9e0ecbeb1468b72cca0"}, "language": "english", "review": "just play the second one\n\n5/5 best game ever made", "timestamp_created": 1669092880, "timestamp_updated": 1669092880, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "125911972", "author": {"steamid": "76561198191100579", "personaname": "Vegas", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198191100579/", "num_games_owned": 626, "num_reviews": 7, "playtime_forever": 2763, "playtime_last_two_weeks": 0, "playtime_at_review": 583, "last_played": 1686620963, "avatar": "813c67200fba7cff5f487d63ea0dad7510cd988a"}, "language": "english", "review": "who up risking they rain", "timestamp_created": 1669092320, "timestamp_updated": 1669092320, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "125895409", "author": {"steamid": "76561198083776409", "personaname": "hubert", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/theubercannon/", "num_games_owned": 276, "num_reviews": 50, "playtime_forever": 2636, "playtime_last_two_weeks": 0, "playtime_at_review": 2636, "last_played": 1617508874, "avatar": "00a28f68226aa27fa08394361302f8bd2ebeaf18"}, "language": "english", "review": "just to get this out of the way, gearbox bought the risk of rain IP and have full creative control of risk of rain and future content from it. they're not realistically going to touch this game, but they have made some of the well received content for the sequel's first expansion survivors of the void, so I wouldn't say they'll ruin that game, but I believe any bad content or balancing they make for it will be mediocre at it's worst, not absolutely terrible. thankfully this game's upcoming remake risk of rain returns will have hopoo's full creative control and it looks promising, so the fire isn't gone yet I assure you.\n\nwith that said, this is still a fun game if you can get past the noticeably higher difficulty curve than it's sequel and having to port forward to play on online multiplayer, although the second game and it's dlc have a lot more love, polished content and longevity to it. and of course, this game's soundtrack still holds a candle to this day.", "timestamp_created": 1669063975, "timestamp_updated": 1673376708, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}