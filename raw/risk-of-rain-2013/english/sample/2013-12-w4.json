e": "1383930480", "reactions": []}, {"recommendationid": "8465763", "author": {"steamid": "76561197979139015", "personaname": "butterchubbs", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197979139015/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 813, "playtime_last_two_weeks": 0, "playtime_at_review": 276, "last_played": 1388978959, "avatar": "d388ff26b4102143c0d3268cbe511b4ed409a0ed"}, "language": "english", "review": "Risk of Rain is a challenging platformer that has tons of replayability. It reminds me of \"I wanna be the guy\" with an emphasis on action instead of impossible platforming. And with co-op mode, so you can share your frustrations with your friends! Definitely worth a try!", "timestamp_created": 1388524885, "timestamp_updated": 1388524885, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8464451", "author": {"steamid": "76561198002566012", "personaname": "ShaiPie", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198002566012/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 1233, "playtime_last_two_weeks": 0, "playtime_at_review": 544, "last_played": 1459666554, "avatar": "cdff433c9ea96c9933449fa59011b1dc31a4f0a2"}, "language": "english", "review": "Extremely fun platformer roguelike. If you like FTL, Binding of Isaac, etc, it's a good chance you'll also like Risk of Rain. Multiplayer is a blast as well; although it isn't built directly into the game and you'll have to host a server with a tool like Hamachi.", "timestamp_created": 1388520798, "timestamp_updated": 1388520798, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.519999980926513672", "comment_coun