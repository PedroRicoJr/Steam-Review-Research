lease_date": "1383930480", "reactions": []}, {"recommendationid": "154105962", "author": {"steamid": "76561198075958302", "personaname": "Sirius", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198075958302/", "num_games_owned": 0, "num_reviews": 66, "playtime_forever": 314, "playtime_last_two_weeks": 0, "playtime_at_review": 314, "last_played": 1702687062, "avatar": "3ceb6a2a5f3d59a0067f52d6d22c7ff676aa72cb"}, "language": "english", "review": "It's even worse than RoR2 which is a pretty bad game once you realise how ridiculously shallow the game is. The camera to me is what makes it unplayable. It's either zoomed 30 km away from the action and you see nothing or so zoomed in you can't see beyond arms reach of your character. The core gameplay resolve around pressing 3 keys and waiting for your movement ability cooldown to come off so you can use it again to move faster and loot unsatisfying items, most of them are either useless or horrible. The musics are great tho.", "timestamp_created": 1703217986, "timestamp_updated": 1703217986, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.325523704290390015", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "154043653", "author": {"steamid": "76561198989551114", "personaname": "LittleSalty", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198989551114/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 366, "playtime_last_two_weeks": 0, "playtime_at_review": 241, "last_played": 1705900183, "avatar": "99b82671f7b8d6cb3c66d3ce690322a2b2acbc3e"}, "language": "english", "review": "I have 200+ hrs in risk of rain 2 ( on ps4 ) so i thought i would give the first game a try and its pretty fun of course i haven't played it for to long but still. Also its much much harder than ROR2 is honestly the Monsoon difficulty of ROR2 is about as hard as the drizzle of this. to me at least but maybe i'm just to used to ROR2.\n\nBut i would also say if you want this game in this day and age its only worth getting on sale like i did.", "timestamp_created": 1703138506, "timestamp_updated": 1705871983, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "153947867", "author": {"steamid": "76561198041341688", "personaname": "dave", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198041341688/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 1518, "playtime_last_two_weeks": 0, "playtime_at_review": 532, "last_played": 1746581791, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "game is really good. classic platformer. A+++++++++++++++++++++++++", "timestamp_created": 1703024744, "timestamp_updated": 1703024744, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.480769246816635132", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}