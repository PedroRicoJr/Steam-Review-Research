ount": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "229758990", "author": {"steamid": "76561198044000625", "personaname": "Thicket", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198044000625/", "num_games_owned": 0, "num_reviews": 20, "playtime_forever": 599, "playtime_last_two_weeks": 0, "playtime_at_review": 599, "last_played": 1622097024, "avatar": "81f1f2038d4089da4bc0ddf26b4e43eb66fef405"}, "language": "english", "review": "Simple, clean and well-polished fun. In all of its pixel-y glory you will, eventually on every run, become a psychotic whirlwind of rockets, stars, lazers and drones as you smash your way around these platforms in search of bigger numbers. \r\n\r\nI think after 5-6 hours, the novelty really wears thin on the challenge, but then the game (like all good roguelites) becomes about how ridiculous you can take it. Looping the levels 10 times in a row, 15 times in a row, looking for billions of coins or 20+ stacks of the most powerful items, trying to reach the point of unstoppable critical mass. It's fun for every moment you play but I do think it has a fairly tight window of real value.\r\n", "timestamp_created": 1783336633, "timestamp_updated": 1783336633, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "229739656", "author": {"steamid": "76561198147969367", "personaname": "Zvonimir", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Jijijijiji2233/", "num_games_owned": 0, "num_reviews": 19, "playtime_forever": 399, "playtime_last_two_weeks": 0, "playt