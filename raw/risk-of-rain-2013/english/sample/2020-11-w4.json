elease_date": "1383930480", "reactions": []}, {"recommendationid": "81196705", "author": {"steamid": "76561197976347286", "personaname": "grape", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/grape/", "num_games_owned": 0, "num_reviews": 95, "playtime_forever": 41, "playtime_last_two_weeks": 0, "playtime_at_review": 41, "last_played": 1606690378, "avatar": "d38dc2a2abacfa83e724906206b0de97c2ed9643"}, "language": "english", "review": "I can't get behind this. Maybe I missed the 16-bit golden age it's harking back to, but the mechanics feel a bit stilted, the graphics uncompelling, and it's brutal without providing any sense of reward.  I even pushed the difficulty back to 'very easy' in case I'd just lost my edge... and I still only once made it through the first stage.  Maybe it's fine \"if you like that sort of thing\", but I'd sooner spend an evening dying repeatedly in some other game, where dying repeatedly is fun.\n\nThe game seems polished and complete and this all tells me I'm probably missing something, but unless I know what I'm missing, I can hardly recommend it.", "timestamp_created": 1606731532, "timestamp_updated": 1606731532, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.404183149337768555", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "81195400", "author": {"steamid": "76561198032244964", "personaname": "suzuk1v", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/suzuk1v/", "num_games_owned": 303, "num_reviews": 6, "playtime_forever": 2813, "playtime_last_two_weeks": 0, "playtime_at_review": 2417, "last_played": 1626820098, "avatar": "0c527d79e26c9a8b6a2823011799e71cd94da9ff"}, "language": "english", "review": "nice", "timestamp_created": 1606730748, "timestamp_updated": 1606730748,