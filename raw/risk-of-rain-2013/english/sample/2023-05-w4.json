access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "139296853", "author": {"steamid": "76561198091650021", "personaname": "♄ Sqrk ♄", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/cinnveris/", "num_games_owned": 107, "num_reviews": 5, "playtime_forever": 5879, "playtime_last_two_weeks": 0, "playtime_at_review": 2209, "last_played": 1784195016, "avatar": "1c4523fb6ab032179cd68bf911b101cf00037de8"}, "language": "english", "review": "With as popular as the sequel is, I wish this game got so much more love. While the world isn't 3D, it still feels so organic. The creatures feel just as alive, and higher detail to their texturing really sells the reality of the world. It truly feels like I am a survivor, trying to make it off this place.", "timestamp_created": 1685501159, "timestamp_updated": 1685501159, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "139249913", "author": {"steamid": "76561198214678101", "personaname": "hi", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198214678101/", "num_games_owned": 137, "num_reviews": 16, "playtime_forever": 43668, "playtime_last_two_weeks": 0, "playtime_at_review": 43586, "last_played": 1761793901, "avatar": "e5116e01a9619c0cfc8e30292c27163fa2426abe"}, "language": "english", "review": "good heavens", "timestamp_created": 1685421679, "timestamp_updated": 1685421679, "voted_up": true, "votes_up": 21, "votes_funny": 7, "weighted_vote_score": "0.673494219779968262", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_dat