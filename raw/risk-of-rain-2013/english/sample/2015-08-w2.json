ly_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "17551760", "author": {"steamid": "76561198114260731", "personaname": "Brillint", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Brillint/", "num_games_owned": 132, "num_reviews": 20, "playtime_forever": 3537, "playtime_last_two_weeks": 0, "playtime_at_review": 2371, "last_played": 1682253907, "avatar": "313ba58143890f1318c84db8aa96b730af7401f3"}, "language": "english", "review": "This is an incredibly good platformer that involves lots of skill, I love it 10/10", "timestamp_created": 1439650033, "timestamp_updated": 1439650033, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "17545006", "author": {"steamid": "76561197963546290", "personaname": "NearHi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Nearhi/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 363, "playtime_last_two_weeks": 0, "playtime_at_review": 363, "last_played": 1435933411, "avatar": "89db9cfe20f6f63fd34ecd1fd28b10156e550e0b"}, "language": "english", "review": "Pretty fun game. Gamepad support is garbage, which is disappointing. Game can be infuriatingly hard, which is fun, sometimes.", "timestamp_created": 1439609326, "timestamp_updated": 1439609326, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "17544318", "author": {"steamid": "76561198126356394", "personaname": "Ludi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198126356394/", "num_games_owned": 346, "num_reviews": 11, "playtime_forever": 5095, "playtime_last_two_weeks": 0, "playtime_at_review": 4823, "last_played": 1660414484, "avatar": "73be52e91e06ada499a0b7fd0336762b5825260a"}, "language": "english", "review": "This is be a great game with loads of (sort of unexplored) potential. The graphics give the game an amazing atmosphere, the different classes are varied and really fun to play, the soundtrack kicks ass. You can easily spend 70+ hours if you like roguelike stuff, probably triple that if you find the Commando relic (which lets you choose which items you pick).\n\nBut the only problem is that, while the game has support for multiplayer, due to engine limitations, you'll have to either use portforwarding or programs such as Hamachi or Evolve. There's no actual official server list or browser.\n\nThe devs also release some bugfixes from time to time while they're focusing on Risk of Rain 2.", "timestamp_created": 1439605022, "timestamp_updated": 1543110962, "voted_up": true, "votes_up": 165, "votes_funny": 21, "weighted_vote_score": "0.772238075733184814", "comment_count": 11, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}