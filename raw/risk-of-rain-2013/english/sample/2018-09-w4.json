{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2018-09", "window": 4, "start_date": 1537660800, "end_date": 1538351999, "month_true_total": 64, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:15:13 UTC", "reviews": [{"recommendationid": "45007443", "author": {"steamid": "76561198330957727", "personaname": "【ツ】", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198330957727/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 884, "playtime_last_two_weeks": 0, "playtime_at_review": 750, "last_played": 1562789961, "avatar": "ece6d04a832925d5341a76c8d76486d6022e57a0"}, "language": "english", "review": "Risk of rain, one of my favorite roguelikes. I've played games like gungeon, nuclear throne, and BOI and this game is very different from all of them. Ror is a 2d platformer instead of the top down roguelikes I'm use to. Risk of rain exceeded my expectations with it's fun variety of items and characters. There is so much playability in this game like any good roguelike and the addition of artifacts makes this game vene better. The multiplayer function however is a little finicky. You have to download this application called hamachi which is basically a vpn that allows other people acess to your router, so only play with people you trust. Other than that this game is great and I would reccomend it.", "timestamp_created": 1538250232, "timestamp_updated": 1538250232, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.556675076484680176", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "44996254", "author": {"steamid": "76561198286119766", "personaname": "Vortigaunts and Bullsquids", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/vortigaunted/", "num_game