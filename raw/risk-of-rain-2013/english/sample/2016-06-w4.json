: 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "23945593", "author": {"steamid": "76561198082857236", "personaname": "cherry bomb", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/dawnzoom/", "num_games_owned": 252, "num_reviews": 9, "playtime_forever": 7275, "playtime_last_two_weeks": 0, "playtime_at_review": 4105, "last_played": 1526424955, "avatar": "882ebd7ec8473e23859b1073bd9dce13f909d854"}, "language": "english", "review": "I have 100% completed this game multiple times over, and I have to say, this is EASILY worth the $10 if you like games similar to this.\n\nPros:\n-Nice & Consistent art style\n-Fun & Unique characters\n-High replay value (Every run is different)\n-Things can spiral out of control\n-Very difficult\n-Multiplayer\n-Both keyboard and controller buttons work & feel very nice to play with\n\nCons:\n-PC players don't get automatic matchmaking, while PS Vite & PS4 players do.\n-Multiplayer is buggy\n-Multiplayer needs port forwarding or externall programs such as Hamachi or the Evolve Client (not the game)\n-You haven't bought this yet\n-Many things can crash the game easily during runs of 100+ minutes and you need to be careful of those\n\nNow, this game gets much less fun if you don't enjoy roguelike games or games that are very hard, and you should keep that in mind before buying it.", "timestamp_created": 1467264148, "timestamp_updated": 1467264500, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}