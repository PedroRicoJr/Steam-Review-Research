{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2017-10", "window": 3, "start_date": 1508112000, "end_date": 1508803199, "month_true_total": 68, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:13:46 UTC", "reviews": [{"recommendationid": "35953073", "author": {"steamid": "76561198042142106", "personaname": "zacvrono", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/zacvrono/", "num_games_owned": 0, "num_reviews": 27, "playtime_forever": 3543, "playtime_last_two_weeks": 0, "playtime_at_review": 1737, "last_played": 1510111410, "avatar": "f28170f6e870fd03249c2b4981d35667032afad6"}, "language": "english", "review": "How did I not write a review for this game yet?! It's VERY good! It's extremely hard, but you start to learn how the difficulty ramps up and how to deal with it. It highly rewards learning the mechanics and increasing your skill. I beat the game after about 18 hours, but I still haven't played many of the characters much, or gotten all the secrets. The secrets (not called secrets, but I don't want to spoil anything), can drastically affect the way you play the game and even the main mechanics. This is also a true rogue game. You completely start from scratch and try to unlock secrets and characters. However the high benifit from learning and quickly getting better makes it feel like there is progression. This is the example of how true rogue games are supposed to be.", "timestamp_created": 1508790633, "timestamp_updated": 1508790633, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "35952282", "author": {"steamid": "76561198064840455", "personaname": "Miss Mayor", "persona_status": "in-game", "profile_url": "https://steamcommunity.com