, "reactions": []}, {"recommendationid": "25893131", "author": {"steamid": "76561198026612137", "personaname": "Jim", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/SniperViper76/", "num_games_owned": 949, "num_reviews": 61, "playtime_forever": 5656, "playtime_last_two_weeks": 0, "playtime_at_review": 5209, "last_played": 1537488390, "avatar": "8c93318d5bfba898d47b333bc0f732337d226a82"}, "language": "english", "review": "Great indie rogue like, challenging at first but the mechanics aren't too hard to master. Has the awesome ability to stall the final boss fight and instead farm previous levels, except they are amped up with super dense enemies and multiple 'level bosses'. Leads to epic numbers of enemies on screen and hilarious amounts of loot. Definitely a 'feast or famine' roguelike, but a damn good one at that. Very small dev team, few bugs that won't be getting patched as this game is definitely done with. Classes are actually very unique to the point of requiring dramatic shifts in strategies and itemization.", "timestamp_created": 1475795324, "timestamp_updated": 1475795324, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "25883432", "author": {"steamid": "76561198038383413", "personaname": "Proven Paradox", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198038383413/", "num_games_owned": 479, "num_reviews": 43, "playtime_forever": 5477, "playtime_last_two_weeks": 0, "playtime_at_review": 4636, "last_played": 1476764071, "avatar": "bc8d0db59d1a55b3c078ae96c5ea07b3e0e4e624"}, "language": "english", "review": "This is awesome on many levels. Totally recommended.", "timestamp_created": 1475754042, "timestamp_updated": 1475754042, "voted_u