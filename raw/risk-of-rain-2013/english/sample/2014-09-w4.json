{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2014-09", "window": 4, "start_date": 1411430400, "end_date": 1412121599, "month_true_total": 193, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:09:01 UTC", "reviews": [{"recommendationid": "12306807", "author": {"steamid": "76561198034539668", "personaname": "Leap", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/CuzICan/", "num_games_owned": 568, "num_reviews": 2, "playtime_forever": 9813, "playtime_last_two_weeks": 0, "playtime_at_review": 6174, "last_played": 1577587763, "avatar": "54bde19a76b8930f68c90919b0faac93e0d4da2a"}, "language": "english", "review": "Worth. 10/10\nTop 10. Gold star.\nYes.", "timestamp_created": 1412121177, "timestamp_updated": 1412121177, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "12305489", "author": {"steamid": "76561198047353724", "personaname": "SaintCrazy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/saintcrazy/", "num_games_owned": 0, "num_reviews": 37, "playtime_forever": 12627, "playtime_last_two_weeks": 0, "playtime_at_review": 9220, "last_played": 1486789707, "avatar": "3adcf747db2beef2e838db511fa803a8dad250c9"}, "language": "english", "review": "So it's been quite a while and I'm still in love with this game. It's pretty different from the typical rogueluke experience; the levels and monsters aren't really random, but it's still got that feel to it that makes it equal parts frustrating and addicting. The single player experience is awesome as you watch yourself become an unstoppable god or get your puny body crushed by more enemies than you know what to do with. The multiplayer is my only real complaint about the game, only because it COULD be amazingly fun to co-op, but the experience is so buggy that it just doesn't make it worth it for me - even after the most recent patch I still had issues with the game crashing or being unable to complete levels. Other than that, a really great game that I still come back to even though I've unlocked almost everything.", "timestamp_created": 1412111991, "timestamp_updated": 1419139416, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "12299642", "author": {"steamid": "76561198028156534", "personaname": "SharkBait", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/BabySharkBait/", "num_games_owned": 1124, "num_reviews": 13, "playtime_forever": 1190, "playtime_last_two_weeks": 0, "playtime_at_review": 595, "last_played": 1473384254, "avatar": "1e4bec531bddabc42e95211b0f9fe2520da2c224"}, "language": "english", "review": "For some reason having to start over repeatedly doesn't bother me with this game...", "timestamp_created": 1412077528, "timestamp_updated": 1412077528, "voted_up": true, "votes_up": 13, "votes_funny": 0, "weighted_vote_score": "0.492180436849594116", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "12299057", "author": {"steamid": "76561198096250561", "personaname": "RangaD", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/RangaD/", "num_games_owned": 233, "num_reviews": 25, "playtime_forever": 2522, "playtime_last_two_weeks": 0, "playtime_at_review": 1199, "last_played": 1674346541, "avatar": "7baa13c671732fd13a61ec13f2c4741e1e6ce9b4"