{"recommendationid": "54341872", "author": {"steamid": "76561198040967620", "personaname": "Fieel", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Fieel/", "num_games_owned": 597, "num_reviews": 102, "playtime_forever": 2667, "playtime_last_two_weeks": 0, "playtime_at_review": 2665, "last_played": 1568923009, "avatar": "28c86ac757249555d23a08d8b40723b5b1f487f6"}, "language": "english", "review": "Fantastic couch co-op game", "timestamp_created": 1564329367, "timestamp_updated": 1564329367, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.465116292238235474", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "54331163", "author": {"steamid": "76561197986276194", "personaname": "VinchenzoTheJackal & Shoon", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197986276194/", "num_games_owned": 0, "num_reviews": 182, "playtime_forever": 3167, "playtime_last_two_weeks": 0, "playtime_at_review": 3167, "last_played": 1430087862, "avatar": "75b09df987402dcc36f24a610236446772bc3f07"}, "language": "english", "review": "A simple side-scrolling old school pixel graphics game with lots of mechanics, monsters, and levels. Super fun! Lots of history, character, item, monster, and more descriptions inside and outside of game to learn to help get a feel for... WTF its raining fragments of our space ship and loads of angry aliens?!?! Risk of Rain!!! Just buy it!", "timestamp_created": 1564275028, "timestamp_updated": 1564275028, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "54325525", "author": {"steamid": "76561198110383211", "personaname": "Jarmuz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Jarmuz/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 2441, "playtime_last_two_weeks": 0, "playtime_at_review": 2067, "last_played": 1632683334, "avatar": "0c0720067301732be8c1a533b002443845b0c17e"}, "language": "english", "review": "Risk of Rain is a very fun 2D rogue-like game. You have lots of items you can unlock, different playable characters, secrets and difficult challenges you can try to complete. I enjoy the art style of this game and the music is really good as well. You can play this game with friends too. \n\nOverall it is a challenging game with really nice gameplay and a good game to just jump right into. I recommend.", "timestamp_created": 1564247818, "timestamp_updated": 1564247818, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}