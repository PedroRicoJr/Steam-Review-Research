763", "author": {"steamid": "76561198179437075", "personaname": "Minys", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198179437075/", "num_games_owned": 107, "num_reviews": 3, "playtime_forever": 4058, "playtime_last_two_weeks": 0, "playtime_at_review": 1779, "last_played": 1729256924, "avatar": "d1a2f79e5a07892b2789f910fac8df599004022a"}, "language": "english", "review": "Game on Ubuntu or Mac cannot sync properly with Windows. I lost my game progress. The Save.ini which contains progress is different in format......Not recommand if you want to play this game on different platform.", "timestamp_created": 1520320735, "timestamp_updated": 1520320735, "voted_up": false, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": "0.463917523622512817", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "40599540", "author": {"steamid": "76561198077575613", "personaname": "Spartan Hero", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Spartan_Hero/", "num_games_owned": 0, "num_reviews": 57, "playtime_forever": 3609, "playtime_last_two_weeks": 0, "playtime_at_review": 3245, "last_played": 1691184689, "avatar": "7baa13c671732fd13a61ec13f2c4741e1e6ce9b4"}, "language": "english", "review": "A very fun collectathon for every item you can find as you murder everything on the planet and great with friends.", "timestamp_created": 1520308980, "timestamp_updated": 1520308980, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "40588320", "author": {"steamid": "76561198030842060", "personaname": "PolishedPerspective", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198030842060/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 10999, "playtime_last_two_weeks": 0, "playtime_at_review": 5893, "last_played": 1635727929, "avatar": "38bbe30ace58cdffc98d9949b5204934d6999a18"}, "language": "english", "review": "This is a very good game, especially if you like platformers and roguelikes. There is one major issue with it though, some items are bugged and using them wil cause the game to crash, considering that you can spend an indefinite amount of time running around and getting stronger but you do not have the ability to save it's a really frustrating problem, especially when the game crashes out of the blue when you've been playing for over an hour. There are lists of items you shouldn't use because they are most likely to crash the game but even if you stick to those sometimes the game will crash anyway.\n\nThe developer is showing no intentions of fixing this and they seem focused on developing Risk of Rain 2.", "timestamp_created": 1520264992, "timestamp_updated": 1520264992, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}