id": "8818428", "author": {"steamid": "76561198013727442", "personaname": "Mbone_[HAGG]", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198013727442/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 1536, "playtime_last_two_weeks": 0, "playtime_at_review": 1424, "last_played": 1422732518, "avatar": "0979344c0cbc990a7ac2e088ea99ffd9e23afbc4"}, "language": "english", "review": "D", "timestamp_created": 1390483301, "timestamp_updated": 1390483301, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.50590217113494873", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8816681", "author": {"steamid": "76561197962430547", "personaname": "Bulletstopper", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Bulletstopper/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 3170, "playtime_last_two_weeks": 0, "playtime_at_review": 1533, "last_played": 1441063184, "avatar": "448805489ac0698b4f4648fd00c9998d1649bb9e"}, "language": "english", "review": "A fantastic co-op game with a silly amount of content, and enough item and character unlocks to keep anyone busy for aquite a long time. A must buy for nearly anyone.", "timestamp_created": 1390464754, "timestamp_updated": 1390464754, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8816662", "author": {"steamid": "76561198083929911", "personaname": "Lucky_kairiVT", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Lucky_kairiVT/", "num_games_owned": 979, "num_reviews": 3, "playtime_forever": 2802, "playtime_last_two_weeks": 0, "playtime_at_review": 1398, "last_played": 1547419775, "avatar": "6c5bf930054f37f8a7f6af089f1c416717f9f038"}, "language": "english", "review": "If you like action platforming shooting with some difficulty and rougelike elements splashed in there, then this is something that deserves a look.\n\nRisk of Rain is a simple yet satisfying game.\nStorywise, you crash land on a strange planet and now must survive and find a way back on your ship using the teleporter placed in each world.\n\nYou pick a character with four skills. Then you gun down baddies and constantly augment yourself with items you find on the field, all the while the enemies become stronger over time and begin appearing in overwhelming numbers.\nThe goal is to find a teleporter somewhere in the world and survive a countdown and a boss fight, in which upon completion you teleport to a new world where you repeat until endgame. Each world has its own visual theme and often its own set of monsters to fight.\n\nHowever, upon death, you have to start over, no items collected during your past playthrough are stored or saved so its back to square one (rougelike kicking in).\n\nThere's tons of items to unlocked and the characters themselves have interesting skill sets. \nEach feels and plays differently than the others.\n\nThe game is a blast, even more so with its multiplayer. Its where things get really interesting.\nNo regrets.\n\n9/10", "timestamp_created": 1390464544, "timestamp_updated": 1390464544, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "8815252", "author": {"steamid": "76561198008659806", "personaname": "pwndcube", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/pwndcube/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 1224, "playtime_last_two_weeks": 0, "playtime_at_review": 207, "last_played": 1672972956, "avatar": "61d643bc67bdfedfeb7a93079990e662f619ea34"}, "language": "english", "review": "A solid 2d action platformer with a lot of variety in individual runs.", "timestamp_created": 1390448644, "timestamp_updated": 1390448644, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}