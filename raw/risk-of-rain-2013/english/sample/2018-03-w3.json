purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "40948703", "author": {"steamid": "76561198059193133", "personaname": "Da Trae", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198059193133/", "num_games_owned": 199, "num_reviews": 10, "playtime_forever": 78, "playtime_last_two_weeks": 0, "playtime_at_review": 78, "last_played": 1521333086, "avatar": "d513e66c26e27c27da8a49d361d06bbab949db34"}, "language": "english", "review": "This is not a review, just a note of a few issues I've had with the game so far.\n\nNo character variety at the beginning, only one playable character until others are unlocked.\nNo online servers on Steam. Requires a direct IP connection like outdated online games.\nEnemies swarm much faster than damage is dealt when difficulty rises, making a chaotic environment that either is or is not your cup of tea. I personally would be prefer a bit more variety in combat without only making more enemies to sponge bullets.\n\nIt's alright, but I regret buying the 4-pack for online friends at this point.", "timestamp_created": 1521593909, "timestamp_updated": 1521593909, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.458591878414154053", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "40928486", "author": {"steamid": "76561198170140834", "personaname": "A Moon Shaped Pool", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198170140834/", "num_games_owned": 299, "num_reviews": 43, "playtime_forever": 15539, "playtime_last_two_weeks": 0, "playtime_at_review": 10530, "last_played": 1528320424, "avatar": "fc1ed972f2