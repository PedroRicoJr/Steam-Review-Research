 true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "55606799", "author": {"steamid": "76561198106259105", "personaname": "Geekz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198106259105/", "num_games_owned": 0, "num_reviews": 35, "playtime_forever": 187, "playtime_last_two_weeks": 0, "playtime_at_review": 187, "last_played": 1554357998, "avatar": "367e1ba9e188f5c16035f3000333145abb5bbee2"}, "language": "english", "review": "Simply a cheap option to burn some time.\n\nYou fight, get upgrades, game gets harder over time. There isn't much that makes you want to stay. The world is huge and bland and the monsters aren't all that amazing. Sure, new equipment and heroes are exciting but what's the point if everything else is dull.\n\nGranted the price of the game, I couldn't ask for more, but these are my opinions.", "timestamp_created": 1571085918, "timestamp_updated": 1571085918, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.356936395168304443", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "55561495", "author": {"steamid": "76561198307699499", "personaname": "past-tense crab", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/papa_crub/", "num_games_owned": 616, "num_reviews": 15, "playtime_forever": 3188, "playtime_last_two_weeks": 0, "playtime_at_review": 387, "last_played": 1674543327, "avatar": "08c78ad2551705b02b2f860462709cdfa41c1723"}, "language": "english", "review": "Absolutely amazing and still worth playing today. Action-packed, difficult, and Metroidvania-like. Has a sick soundtrack, full of bosses, secrets, and a great character progression system. The difficulty in this game is the real kicker. Progressively increasing as you play the game, it's intuitive and fun in the same instance. A beautiful piece of 2013.", "timestamp_created": 1570854454, "timestamp_updated": 1571512107, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.520547926425933838", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "55512499", "author": {"steamid": "76561198976944860", "personaname": "stranger things", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/thechronicle/", "num_games_owned": 0, "num_reviews": 32, "playtime_forever": 20997, "playtime_last_two_weeks": 0, "playtime_at_review": 120, "last_played": 1590154451, "avatar": "1ed7d2802a39cb0b4a0783320d9a3144d101d872"}, "language": "english", "review": "Risk of Rain is one of the best Rogue-like games. \nFor its modest cost, 6 £ includes: an excellent soundtrack, nice-looking graphics in the form of pixels and many other pleasant introductions.\nYou can play with friends or alone.\nIt will brighten up a couple of evenings.\nI remember that 5 people gathered, carried a stream, called it Risk of Rain and a cup of coffee.\nThe nights were perfect, I definitely recommend this game.", "timestamp_created": 1570553005, "timestamp_updated": 1570592273, "voted_up": true, "votes_up": 12, "votes_funny": 0, "weighted_vote_score": "0.65988922119140625", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}