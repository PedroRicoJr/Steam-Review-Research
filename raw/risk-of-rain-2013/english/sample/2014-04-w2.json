{"game": "risk-of-rain-2013", "language": "english", "appid": 248820, "month": "2014-04", "window": 2, "start_date": 1396915200, "end_date": 1397606399, "month_true_total": 271, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 09:08:19 UTC", "reviews": [{"recommendationid": "9824942", "author": {"steamid": "76561198044033178", "personaname": "Holderiano", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/holderiano/", "num_games_owned": 321, "num_reviews": 84, "playtime_forever": 850, "playtime_last_two_weeks": 0, "playtime_at_review": 142, "last_played": 1618715673, "avatar": "9b5d046499e5d31383f629b7e3f19dc215a507b2"}, "language": "english", "review": "Indie games need more focus on gameplay like this and not pretentious deep story crap. Risk of Rain is an action platformer with randomly generated levels, and it does it right. All the classes you can play as feel different and add a lot replay value; the bosses have awesome design and the items you can grab make every game a different experience. It also has MULTIPLAYER and CONTROLLER SUPPORT.", "timestamp_created": 1397573856, "timestamp_updated": 1397573856, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.481400430202484131", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "9823183", "author": {"steamid": "76561198053430966", "personaname": "RivenX", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/rivenx/", "num_games_owned": 837, "num_reviews": 31, "playtime_forever": 8503, "playtime_last_two_weeks": 0, "playtime_at_review": 3250, "last_played": 1628576174, "avatar": "cb6be4db63b55f53302bb65640e02a1bc507a45b"}, "language": "english", "review": "Do you want to pick up forty thousand items and become OP within seconds?  This is the game for you.", 