d": "76561198350608838", "personaname": "The Tickle Monster", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198350608838/", "num_games_owned": 294, "num_reviews": 24, "playtime_forever": 275, "playtime_last_two_weeks": 0, "playtime_at_review": 211, "last_played": 1689565232, "avatar": "c4e01823348d99587959572e478cd241db775cac"}, "language": "english", "review": "balls and ♥♥♥♥\n", "timestamp_created": 1601336266, "timestamp_updated": 1601336266, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "76734824", "author": {"steamid": "76561198238458006", "personaname": "Naro Cal", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198238458006/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 1452, "playtime_last_two_weeks": 0, "playtime_at_review": 360, "last_played": 1768063815, "avatar": "4ab3db0761bdfb0b02c32de00e0924e1270cf81a"}, "language": "english", "review": "This game is a gem of a rogue, from maps with plenty to see and explore, enemies to face off in massive battles, and plenty of items to scratch that looter-itch you may have. So if you've the time and the will, and maybe some friends to invite to the mix too, this game is for you. And before I end it here, be sure to buy Risk of Rain 2! It's as great as the first if not a bit better!", "timestamp_created": 1601331599, "timestamp_updated": 1601331616, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "76729079", "author": {"steamid": "76561198058990037", "personaname": "Marauder", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hexamer/", "num_games_owned": 0, "num_reviews": 72, "playtime_forever": 3098, "playtime_last_two_weeks": 0, "playtime_at_review": 1125, "last_played": 1784725337, "avatar": "eb1ffddfb08d51979da2134977698106739e2d40"}, "language": "english", "review": "This is a charming game that my friend introduced me to (thanks Andrew!). It has a very cool soundtrack, and the game really kicks off once you unlock the right character that fits your play style, and collect the correct items.\n\nIt is immense fun playing co-op, and a fun activity for the trophy-hunter/collector types, since the premise of the game revolves around becoming acquainted (by shooting them) with creatures that escaped the cargo hold of the crashed spaceship, and threaten your survival. One of the definitive games for me in 2017.", "timestamp_created": 1601322808, "timestamp_updated": 1601322808, "voted_up": true, "votes_up": 8, "votes_funny": 0, "weighted_vote_score": "0.586627364158630371", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "hardware": {"system_ram": "31849", "os": "Windows 11", "cpu_name": "AMD Ryzen 7 7700X 8-Core Processor             ", "adapter_description": "AMD Radeon RX 6750 XT", "vram_size": 12242}, "reactions": [{"reaction_type": 2, "count": 1}]}]}