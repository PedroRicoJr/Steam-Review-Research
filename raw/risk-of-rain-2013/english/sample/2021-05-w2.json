review": 2078, "last_played": 1536168681, "avatar": "8faa369e91cde9afa7a2f30199bfeaac30d1ac7d"}, "language": "english", "review": "Absolute classic roguelike.\nWhat made risk of rain special back then was it's focus on stacking items and varied stat progression throughout a run - and making it fun. Usually, stats in roguelikes are boring, but by laser-focusing on stackable\nitems the devs created something fresh.\nTop that off with an interesting difficulty mechanic that guarantees the game to stay engaging throughout the run, great athmosphere and an amazing soundtrack, Risk of rain is a great package.\n\nThe only real thorn in its side is the somewhat mundane combat gameplay and the sluggish feel of it's movement, particularly the jumping, that could have been a lot better but doesn't detract too much because of the game's focus.", "timestamp_created": 1620886304, "timestamp_updated": 1620886304, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}