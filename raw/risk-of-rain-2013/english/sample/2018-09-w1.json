eactions": []}, {"recommendationid": "44576116", "author": {"steamid": "76561198059211902", "personaname": "taro", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/raijuutaro/", "num_games_owned": 196, "num_reviews": 58, "playtime_forever": 351, "playtime_last_two_weeks": 0, "playtime_at_review": 341, "last_played": 1554160609, "avatar": "a7cea47118edc5577fddf0aeaaa63d8fd91574f5"}, "language": "english", "review": "not garbage", "timestamp_created": 1536114605, "timestamp_updated": 1536114605, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "44544153", "author": {"steamid": "76561198071549863", "personaname": "João Caju", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/joaocaju/", "num_games_owned": 157, "num_reviews": 18, "playtime_forever": 2719, "playtime_last_two_weeks": 0, "playtime_at_review": 1818, "last_played": 1716101980, "avatar": "cc818cc51123ac1ab7e68241f910b80122bd7548"}, "language": "english", "review": "[b][u]The Roguelike Paragon[/u][/b]\n\nRisk of Rain is a Roguelike game based on progressing through different stages, collecting random itens and killing increasingly difficult waves of enemies, all coated in a nice minimalistic pixel-art. It is probably one the first Roguelikes, and it holds quite well today.\n\n[b][u]Pros:[/u][/b]\n- Gameplay is simple to pick, hard to master.\n- Each stage and run is varied, because of monster diversity and item drops.\n- Beautifully crafted world: visuals, soundtrack and storytelling are one of a kind.\n\n[b][u]Cons:[/u][/b]\n- Multiplayer must be done using third-party programs like Haimachi.\n- The skill-based gameplay (that isn't very influenced by permanent upgrades) will throw some people out of their confort zones.\n- Single-player balance could be better, since the Huntress character seems to be heavily favored.\n- Item randomess can be an headache - but there are ingame options to change it latter.\n\n[b]Overall Score: 5 / 5[/b]", "timestamp_created": 1535956905, "timestamp_updated": 1535956999, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.553746819496154785", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}, {"recommendationid": "44539497", "author": {"steamid": "76561198062494303", "personaname": "TOOFGIB", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/supersassin77/", "num_games_owned": 412, "num_reviews": 19, "playtime_forever": 3237, "playtime_last_two_weeks": 0, "playtime_at_review": 2490, "last_played": 1607377807, "avatar": "1ed904790b71f822fb87c449bc34f012f45996f0"}, "language": "english", "review": "Only buy this game if you have a week or so to be completely consumed.", "timestamp_created": 1535927654, "timestamp_updated": 1535927654, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1383930480", "reactions": []}]}