{"game": "redfall", "language": "english", "appid": 1294810, "month": "2024-04", "window": 3, "start_date": 1713225600, "end_date": 1713830399, "month_true_total": 26, "quota": 5, "returned": 5, "pulled_at": "2026-09-02 17:05:30 Pacific Daylight Time", "reviews": [{"recommendationid": "163397012", "author": {"steamid": "76561198013807829", "personaname": "NeonJordan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198013807829/", "num_games_owned": 0, "num_reviews": 54, "playtime_forever": 578, "playtime_last_two_weeks": 0, "playtime_at_review": 73, "last_played": 1774890586, "avatar": "df2ee1fb7b7afa270cfcc6088747e59db79dfc72"}, "language": "english", "review": "I just bought the game on sale under $20. The game is good so far, seems like they fixed the game from all the problems from launch. Crazy how they charge $70 for this new, you should buy this game,but on sale ,do not buy any game for $70, because they will eventually feel confident enough to make them $100", "timestamp_created": 1713811772, "timestamp_updated": 1714091569, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.518803417682647705", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": []}, {"recommendationid": "163311872", "author": {"steamid": "76561198852695914", "personaname": "zFoxe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198852695914/", "num_games_owned": 0, "num_reviews": 21, "playtime_forever": 1007, "playtime_last_two_weeks": 0, "playtime_at_review": 929, "last_played": 1784761925, "avatar": "9d024911a9b313552237c5c1ad0db17b19c170cf"}, "language": "english", "review": "good", "timestamp_created": 1713704644, "timestamp_updated": 1713704644, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.475681960