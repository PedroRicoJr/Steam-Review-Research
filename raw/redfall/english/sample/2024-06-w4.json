rsona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198000542425/", "num_games_owned": 373, "num_reviews": 12, "playtime_forever": 3044, "playtime_last_two_weeks": 0, "playtime_at_review": 399, "last_played": 1727581714, "avatar": "397fdc373af287c1f263c3f51aaeb9b97db0e529"}, "language": "english", "review": "Is it dishonored? no\r\nDoes it look like dishonored? yes and it has references\r\nDoes it play like dishonored? in a more gun fighty way yes\r\nIs the story good? yes, scary and kinda campy to lower the tension\r\nIs it creepy? yes I get the heebie jeebies just walking around\r\nis it hard? medium difficulty isnt\r\n\r\nListen I loved Arkane, a piece of me died when that studio closed.\r\nThis is not a bad game, is it perfect? no. \r\nAm I having fun playing by myself? yes\r\n\r\nIf any of the Arkane guys read this, thanks for all you've done with your games.\r\nI'm really going to miss you.", "timestamp_created": 1719553506, "timestamp_updated": 1719553506, "voted_up": true, "votes_up": 55, "votes_funny": 3, "weighted_vote_score": "0.699868440628051758", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": [{"reaction_type": 2, "count": 4}, {"reaction_type": 17, "count": 3}, {"reaction_type": 19, "count": 3}, {"reaction_type": 14, "count": 2}, {"reaction_type": 18, "count": 1}]}]}