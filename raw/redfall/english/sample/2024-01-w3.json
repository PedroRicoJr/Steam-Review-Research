up": false, "votes_up": 70, "votes_funny": 0, "weighted_vote_score": "0.784409165382385254", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": [{"reaction_type": 18, "count": 1}]}, {"recommendationid": "156492019", "author": {"steamid": "76561198228105944", "personaname": "BLurriiTheBat", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/BLurriiTheBat/", "num_games_owned": 0, "num_reviews": 79, "playtime_forever": 106, "playtime_last_two_weeks": 0, "playtime_at_review": 106, "last_played": 1704037908, "avatar": "738345e90541ec9e092fdad6321ae639eed49e4b"}, "language": "english", "review": "why are all vampire games so bad?", "timestamp_created": 1705864313, "timestamp_updated": 1705864313, "voted_up": false, "votes_up": 34, "votes_funny": 3, "weighted_vote_score": "0.510968983173370361", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": []}, {"recommendationid": "156325993", "author": {"steamid": "76561198027903892", "personaname": "Aonyx", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/AonyxTheOttergirl/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 1556, "playtime_last_two_weeks": 0, "playtime_at_review": 359, "last_played": 1715747781, "avatar": "28b0fc3b108799c2141796e16e7646cae28bc5ba"}, "language": "english", "review": "DO NOT PAY FULL PRICE FOR THIS GAME! Now that we've gotten that out of the way, if you see this game for $40 or less, YOU GRAB THIS GAME! Once you get to $40 this game is every bit worth that price. You are in a town that's been overrun with vampires and the cultists that support them. Your job is to SMITE them with extreme prejudice. You can go in with a team of your friends and charge in and defeat them all or you can take a rouge approach and solo stealth through the town taking them all down on the sly. There are lots of little adventures that honestly made me giggle and super strong vampires that will challenge your abilities. This game is absolutely fantastic from the combat to the environment, it's just not anywhere near $70 fantastic.", "timestamp_created": 1705700408, "timestamp_updated": 1705700408, "voted_up": true, "votes_up": 5, "votes_funny": 1, "weighted_vote_score": "0.439788848161697388", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": [{"reaction_type": 19, "count": 3}, {"reaction_type": 13, "count": 1}, {"reaction_type": 22, "count": 1}, {"reaction_type": 6, "count": 1}]}, {"recommendationid": "156322675", "author": {"steamid": "76561198005607449", "personaname": "Mightylink", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/mightylink/", "num_games_owned": 171, "num_reviews": 50, "playtime_forever": 657, "playtime_last_two_weeks": 0, "playtime_at_review": 579, "last_played": 1717256089, "avatar": "2f6cac0c8b32db8bf7ac8ab36e3f25d3a07448fd"}, "language": "english", "review": "At least we got the offline patch...\n\nI tested it myself, you don't even need to create a new character it just downloads your online save file. At the very least now the game won't die with Arkane and they finally followed through with the promise of releasing a single player mode, even from beyond the grave.\n\nRIP Arkane Austin.", "timestamp_created": 1705697318, "timestamp_updated": 1717247642, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.511111080646514893", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app