alse, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": [{"reaction_type": 23, "count": 1}]}, {"recommendationid": "186985805", "author": {"steamid": "76561199496781720", "personaname": "PaulMyFinger", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199496781720/", "num_games_owned": 0, "num_reviews": 38, "playtime_forever": 2663, "playtime_last_two_weeks": 0, "playtime_at_review": 165, "last_played": 1745667824, "avatar": "c22ac103f8f18a6d4c7bb57ca3e37cd79358764c"}, "language": "english", "review": "I have been playing offline for two hours now and I think this game is fun. Apart from having to hit the space bar when the game cant log on.\r\nThis game moves smooth, has great aiming precision with a day and night cycle which works well with the enemies. \r\nThere has been lots of negativity and problems with this game, but I think they have fixed a lot of issues.", "timestamp_created": 1738496285, "timestamp_updated": 1738496285, "voted_up": true, "votes_up": 10, "votes_funny": 3, "weighted_vote_score": "0.503043770790100098", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": []}, {"recommendationid": "186942940", "author": {"steamid": "76561197992173774", "personaname": "XGingyBeardX_TTV", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/XGingyBeardX_TTV/", "num_games_owned": 123, "num_reviews": 2, "playtime_forever": 2890, "playtime_last_two_weeks": 106, "playtime_at_review": 1604, "last_played": 1788304023, "avatar": "926dda5abf48ec4e0138712ed367e479df0e6ed4"}, "language": "english", "review": "got a few minor bugs but overall great game play and multiplayer", "timestamp_created": 1738447979, "timestamp_updated": 1738447979, "voted_up"