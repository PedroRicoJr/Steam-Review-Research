time_forever": 451, "playtime_last_two_weeks": 0, "playtime_at_review": 314, "last_played": 1742329600, "avatar": "dad609e1b164bf76ec1db688fb6dff11cc4e0c96"}, "language": "english", "review": "Sad that this studio closed. I know this isn't the best game but its far from the worst. I beat the game on xbox and there was potential. The Devs never wanted to make this and then got shut down due to its reception. I actually had fun playing the game so will still recommend but there are issues - Thankfully the devs were able to add one last update to make the game playable offline.", "timestamp_created": 1717727859, "timestamp_updated": 1717727859, "voted_up": true, "votes_up": 8, "votes_funny": 1, "weighted_vote_score": "0.587478399276733398", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": []}, {"recommendationid": "166832389", "author": {"steamid": "76561199592392903", "personaname": "Bubba Peidao", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199592392903/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 1096, "playtime_last_two_weeks": 0, "playtime_at_review": 879, "last_played": 1727501809, "avatar": "95d8f1c00bbdc43e289e494f3dad027a6f930ac4"}, "language": "english", "review": "very cool\r\n", "timestamp_created": 1717714976, "timestamp_updated": 1717714976, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.490552335977554321", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1682985798", "reactions": []}]}