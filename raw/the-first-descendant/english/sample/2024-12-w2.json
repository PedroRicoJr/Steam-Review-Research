s": []}, {"recommendationid": "182853717", "author": {"steamid": "76561198308993781", "personaname": "Besho", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198308993781/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 3136, "playtime_last_two_weeks": 0, "playtime_at_review": 1199, "last_played": 1735867180, "avatar": "19ed6e38515314a780a4cb75807c6853327a4106"}, "language": "english", "review": "nice game", "timestamp_created": 1734302405, "timestamp_updated": 1734302405, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "182851496", "author": {"steamid": "76561198047739979", "personaname": "Kalamidy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/zuizftw/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 10128, "playtime_last_two_weeks": 0, "playtime_at_review": 10101, "last_played": 1766397152, "avatar": "c08706846ed58d5fb19b5940dba88f2f61a123b3"}, "language": "english", "review": "This game has potential, but it has serious balance issues. There are two characters that can basically kill everything in the hardest game mode without doing anything. One of them runs around and everything dies and the other drops a puddle on the ground and if one person steps on it then it spreads to everyone else in the zone. I would stand around a corner and watch for a solid minute as numbers popped up as enemies died. It was a game of just picking up loot and not fighting. I have 168 hours and that is what made me quit the game. The game has potential, but that needs to be fixed immediately.", "timestamp_created": 1734300119, "timestamp_updated": 1734300119, "voted_up": false, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.530718624591827393", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": [{"reaction_type": 9, "count": 1}]}, {"recommendationid": "182851065", "author": {"steamid": "76561199520331471", "personaname": "LilTender97", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199520331471/", "num_games_owned": 71, "num_reviews": 3, "playtime_forever": 1748, "playtime_last_two_weeks": 0, "playtime_at_review": 1744, "last_played": 1734300219, "avatar": "6330c0531c83e7262767b52a29728f6801bcc289"}, "language": "english", "review": "i have put money into this game, at the minimum $30 besides buying it. i took a couple months off to play other games and now i have deleted and re-downloaded and still cannot even log into or open this game. all i get is error codes and sent to websites that have nothing to do with my issue.", "timestamp_created": 1734299693, "timestamp_updated": 1734299693, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "182849710", "author": {"steamid": "76561198814963959", "personaname": "Hatsune Mumu", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198814963959/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 50940, "playtime_last_two_weeks": 271, "playtime_at_review": 21263, "last_played": 1790779897, "avatar": "3d33f66b32ec28c1cf4a124eba516f80934bf53c"}, "language": "english", "review": "This is my first looter-shooter and have been absolutely hooked since it released in the summer. I've never played Warframe or Destiny so there was nothing for me to compare my experience to like others whom have reviewed this game. The characters are absolutely gorgeous, the maps detailed and beautiful and its well optimized.\n\nHowever, this game is a grind, it takes so long to get the pieces you need for a descendant or ultimate weapon but at the same time its something to do and makes the game worth picking up whenever. I'm about 350 hours in and I have every descendant and their ultimate variant. I'm missing about 3-4 ultimate weapons and the newly released fellow and descendant. As someone who for the last decade has played nothing but FPS, this has been an amazing game to just play and not having to worry about reaching the next rank or if packet loss is the reason I'm 0-6.\n\nThis game is great and its made even better by the devs who are always listening to feedback and are consistently providing QoL updates. I recommend this game if you have the time to dedicate to grinding out for the content.", "timestamp_created": 1734298389, "timestamp_updated": 1734298389, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "182849322", "author": {"steamid": "76561199054457729", "personaname": "American Kodiak Bear", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199054457729/", "num_games_owned": 237, "num_reviews": 36, "playtime_forever": 52, "playtime_last_two_weeks": 0, "playtime_at_review": 52, "last_played": 1720487936, "avatar": "6a7e39460bc9b55118dc174598fca4a68b81929b"}, "language": "english", "review": "don't play this", "timestamp_created": 1734298031, "timestamp_updated": 1734298031, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false,