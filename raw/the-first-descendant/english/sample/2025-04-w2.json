.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "192818262", "author": {"steamid": "76561198107079947", "personaname": "Raceplay 2", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198107079947/", "num_games_owned": 111, "num_reviews": 23, "playtime_forever": 931, "playtime_last_two_weeks": 0, "playtime_at_review": 931, "last_played": 1721408884, "avatar": "479af55d2f4fba26ffcabea4aeeeeaa812b9067c"}, "language": "english", "review": "One of the most mindnumbingly boring games I'd ever played. I thought maybe it was just a simplified early game for the sake of a tutorial, but as I traveled through different zones it became abundantly clear that the entire game was ♥♥♥♥♥♥♥ destiny patrols and world events. It combines leveled gear and warframe's upgrade system, which was meant to be a replacement for leveled gear.  As a result you have like 4 things to level to make a single gun usable. Unlock paths for new characters are completely linear and they are all incredibly basic. Customization is terrible. Yo cannot recolor the default gear and do not unlock colors, but are instead given an allowance to use a single color a single time.", "timestamp_created": 1744743645, "timestamp_updated": 1744743659, "voted_up": false, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.515938222408294678", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}]}