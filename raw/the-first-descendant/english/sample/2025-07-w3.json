y_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "200471118", "author": {"steamid": "76561198085581748", "personaname": "ZackDozza", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198085581748/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 2553, "playtime_last_two_weeks": 0, "playtime_at_review": 406, "last_played": 1754184387, "avatar": "8d4313cbfa439a8b1ea54a68b987c8cd666f405f"}, "language": "english", "review": "a little overwhelming at first, but if youve played warframe or destiny youll catch on quick", "timestamp_created": 1753313500, "timestamp_updated": 1753313500, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.503377854824066162", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "200471089", "author": {"steamid": "76561197986340664", "personaname": "Bouncy Boner Forest", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/boredsnowflakemoderator/", "num_games_owned": 253, "num_reviews": 7, "playtime_forever": 122129, "playtime_last_two_weeks": 0, "playtime_at_review": 108161, "last_played": 1766941047, "avatar": "19e01698c19c77b28efdf09bcd83c39559d85b88"}, "language": "english", "review": "why not", "timestamp_created": 1753313467, "timestamp_updated": 1753313467, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.503377854824066162", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "200460621", "author": {"steamid": "76561199474233479", "personaname": "Shadowboy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199474233479/", "num_games_owned": 73, "num_reviews": 8, "playtime_forever": 2955, "playtime_last_two_weeks": 0, "playtime_at_review": 1343, "last_played": 1783954537, "avatar": "f244bb35b40880070403cbbafd5ff156a68a5980"}, "language": "english", "review": "The game is peak. The story is skippable, so if you think it sucks or don’t care (like me), you can just skip everything.\r\nGameplay is so much fun — it feels like you’re just shooting and enemies are dying really fast. It might seem repetitive, but trust me, it’s insanely fun.\r\n\r\nAfter 20 hours, I’m still ready to spend 200 more. It’s super satisfying. Some things get complicated, but that’s solved easily since there’s an option to let the game recommend stuff for you.\r\n\r\nIt’s easy, fun, and rewarding to get new characters. It requires grinding, but I don’t mind. You can get every character, and that’s what makes the game awesome.\r\n\r\nThere are so many cosmetics, which might make it seem like a cash grab — but it’s really not. They don’t force you to buy anything or throw ads in your face, and that makes me respect the devs.\r\n\r\nPlay it!", "timestamp_created": 1753300638, "timestamp_updated": 1753300638, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.520224988460540771", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}]}