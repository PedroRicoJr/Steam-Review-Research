{"game": "the-first-descendant", "language": "english", "appid": 2074920, "month": "2025-11", "window": 4, "start_date": 1763856000, "end_date": 1764547199, "month_true_total": 455, "quota": 5, "returned": 5, "pulled_at": "2026-10-01 15:48:44 UTC", "reviews": [{"recommendationid": "212195406", "author": {"steamid": "76561197991168280", "personaname": "General Mario", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/2566556/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 30735, "playtime_last_two_weeks": 0, "playtime_at_review": 24750, "last_played": 1788391618, "avatar": "60c9123939ce24ec7cfb8ab375bd6a61369b8c77"}, "language": "english", "review": "As with any live service MMORPG, The First Descendant is an ever evolving experience with each subsequent season update adding more depth to it's ever changing systems. The characters are fun to play as with each sporting their own unique skill sets and play styles. The looter shooter elements while not as wacky with the random stats as most other contemporaries, does have some depth thanks to new systems introduced during the games life cycle such as the adjustment system and weapon core systems. Heck the shear variety of systems layered upon each other definitely means that though you may find a meta build online for a character or weapon, chances are thanks to RNG, your build will still be slightly more unique to just you and I kind of applaud the developers for that.", "timestamp_created": 1764546507, "timestamp_updated": 1764546507, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.503450930118560791", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "212185744", "author": {"steamid": "76561199102965381", "personaname": "Burai", "persona_status": "offline", "profile_url