alse, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "184360540", "author": {"steamid": "76561198106130762", "personaname": "Sparks", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198106130762/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 136599, "playtime_last_two_weeks": 4158, "playtime_at_review": 5125, "last_played": 1790868474, "avatar": "5ad9da4eea7585f73ae9be2f99bdd4de6ce56ad0"}, "language": "english", "review": "The skins are too expensive but other than that, its a solid and fun game.", "timestamp_created": 1735674396, "timestamp_updated": 1735674396, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "184356079", "author": {"steamid": "76561198070916295", "personaname": "3RUC3-L33", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/110120130/", "num_games_owned": 62, "num_reviews": 13, "playtime_forever": 116, "playtime_last_two_weeks": 0, "playtime_at_review": 115, "last_played": 1763500857, "avatar": "3207b04421ee122a9fdd6174c5bbbb46b01ad7f0"}, "language": "english", "review": "game have good graphics but game play is not that good HIGH CPU usage and not fun that much MPC's in the game are way too much robotic and not good movement i don't know just don't like it that much  u can't even know what u are doing and what is going on ? :))", "timestamp_created": 1735670925, "timestamp_updated": 1735670925, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "184353827", "author": {"steamid": "76561198140316565", "personaname": "Piroko Loko", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/PirokoLoko/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 52692, "playtime_last_two_weeks": 0, "playtime_at_review": 52692, "last_played": 1733255805, "avatar": "caa203c871cd844ad0319dee7db36a48e6b2ca49"}, "language": "english", "review": "Pew pew pew, cakes, b00bas, lots of rng (real nasty grinding), but it can be pretty fun if you play with friends or people that know what they're doing :)", "timestamp_created": 1735669278, "timestamp_updated": 1735669278, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.51776653528213501", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "184351936", "author": {"steamid": "76561199144979903", "personaname": "FRODO_GOGGINS", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/BLK_YOUNG/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 8611, "playtime_last_two_weeks": 0, "playtime_at_review": 2662, "last_played": 1770930500, "avatar": "5b8825b34c5d77b00c3a18897f2f1175fa0e0e57"}, "language": "english", "review": "Feels like a mixture of games with a grind factor highly enjoyable.", "timestamp_created": 1735667871, "timestamp_updated": 1735667871, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "184342234", "author": {"steamid": "76561198339933602", "personaname": "Don Fuego", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198339933602/", "num_games_owned": 0, "num_reviews": 17, "playtime_forever": 566, "playtime_last_two_weeks": 0, "playtime_at_review": 566, "last_played": 1735660087, "avatar": "d8f162e133afcc7237a21da32f5a4d335af0509d"}, "language": "english", "review": "The First Descendant is a mid tier at best 3rd person shooter. Reason I gave it that is because the gameplay leaves much to be desired. Don't get me wrong, when it comes to visuals and sound... its amazing. There are times I'd find myself admiring the scenery... on both the setting and its people.\n\nThe grind is as expected from a Korean MMO. Prepare to beat the crap out of the boss again and again until you have enough resources to do anything else. Cash shop is to be expected. Pay to lessen the grind or to doll up your current avatar/descendant. \n\nNow as for the gameplay... it is lacking in comparison to other shooters. As your characters lack the ability to crouch. As a result, you're always an easy target. This is made worse when you're holding a bag and can't shoot back. Now, I get it if you're equipped with nothing but rifles. Those are two-handed. But pistols? Just...why? Its even more irritating when you're trying to use powers and the bag drops. So, any mission that involves you picking up stuff is just suffering. Also a personal nitpick. There's no melee weapons. You're playing as super-powered humans and you can't even pick up a sword or use a knife. \n\nI'll give it this though. The progression is quite simple. You pick up gun, you fight with characters and you progress. You slot in your mods and that gets the job done. So if you want to just turn off your brain and do stuff... you can do so with this game.\n\nAlso, much of the game is centered around multiplayer. So its recommended to bring a friend to help the early-game grind. Though honestly, you're better off introducing that friend to better games than this one. \n\n\n\n", "timestamp_created": 1735661686, "timestamp_updated": 1735661686, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "184342197", "author": {"steamid": "76561199052379488", "personaname": "macharoni", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199052379488/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 1048, "playtime_last_two_weeks": 0, "playtime_at_review": 995, "last_played": 1735664801, "avatar": "3ff1582c7ff97357ac76852eacd69d18a26dea6a"}, "language": "english", "review": "gg", "timestamp_created": 1735661662, "timestamp_updated": 1735661662, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.51776653528213501", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}]}