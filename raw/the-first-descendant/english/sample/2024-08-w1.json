ase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171647269", "author": {"steamid": "76561198145463712", "personaname": "Phantom Wipe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/BingusVEVO/", "num_games_owned": 139, "num_reviews": 95, "playtime_forever": 463, "playtime_last_two_weeks": 0, "playtime_at_review": 463, "last_played": 1720316867, "avatar": "20232e051cd32a54c211db809658478e3b34415c"}, "language": "english", "review": "This game is like if Destiny and Warframe had a child but the infant was accidentally swapped out in the infirmary with an abandoned Chinese daughter.", "timestamp_created": 1723072167, "timestamp_updated": 1723072173, "voted_up": false, "votes_up": 2, "votes_funny": 2, "weighted_vote_score": "0.527923464775085449", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171646196", "author": {"steamid": "76561198006889979", "personaname": "Pops", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198006889979/", "num_games_owned": 0, "num_reviews": 51, "playtime_forever": 12719, "playtime_last_two_weeks": 0, "playtime_at_review": 11975, "last_played": 1727140444, "avatar": "b7fbf78e6d2abb73de19ff818cf221d1264cca7f"}, "language": "english", "review": "Developers, \n     This game is fun, but STOP BEING SO GREEDY.  Nexon's ancestors are looking down on them in disgust.  A 3% drop rate on something that requires hours to grind the prereq for? Ridiculous.  Not only that, but Nexon lies about their drop rates - they've already been legally prosecuted for it.  Rated -10/10 for RNG grind and lying to the player about drop rates.", "timestamp_created": 17230