ent_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171647875", "author": {"steamid": "76561198029725038", "personaname": "Kuriri", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/kurikameme/", "num_games_owned": 573, "num_reviews": 54, "playtime_forever": 9259, "playtime_last_two_weeks": 0, "playtime_at_review": 6654, "last_played": 1724454087, "avatar": "2a3a0c751464c4c9a780f14b55c2bd6365966a74"}, "language": "english", "review": "i like turning my brain off and grinding", "timestamp_created": 1723072977, "timestamp_updated": 1723072977, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171647807", "author": {"steamid": "76561197979947332", "personaname": "crypto.Grim", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/zetapunk/", "num_games_owned": 63, "num_reviews": 9, "playtime_forever": 9824, "playtime_last_two_weeks": 0, "playtime_at_review": 7225, "last_played": 1747783247, "avatar": "316fa2ea26e0ee26223e76952ba2d160e145ebe6"}, "language": "english", "review": "Legit Free To Play\r\nAwesome fun\r\nDiablo-like loot system\r\nIf they bring clans, pvp, true raids -- going to be a banger", "timestamp_created": 1723072884, "timestamp_updated": 1723072884, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.512195110321044922", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171647699", "author": {"steamid": "76561199082246024", "personaname": "Raylo11", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199082246024/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 24162, "playtime_last_two_weeks": 0, "playtime_at_review": 12218, "last_played": 1756271127, "avatar": "b7fbf78e6d2abb73de19ff818cf221d1264cca7f"}, "language": "english", "review": "This game is decent but the amount of grinding for materials to unlock new descendants and  weapons is insanely slow. Your descendant goes back to level 1 every time you insert a catalyst and there are multiple catalysts, this is just an unnecessary grind and a waste of time. There is no need to level up every time you use a catalyst, they need to get rid of this. \n\nI did enjoy the campaign! But after you complete the campaign there is not much to do, other than to grind for materials and unlock new descendants, and that's where the game becomes insanely grindy. Some times you need to play the same activity 20 times to get one material...that unlocks another material... that you need to unlock descendants, and that's just boring. It took me almost two weeks to unlock one descendant.\n\nThe developer needs to increase the drop rates for weapons and descendants' materials because 4%, 6%, 20% is too low and that makes the game boring. I was going to purchase the game but decided not to due to the low drop rates and slow grind. \n\nThe game has much potential. It's up to the developers now. We'll see if they make positive changes to the game. The campaign was fun and I do recommended it but the low material drop rates make the boring.  \n\n\n3 months of playing the game and about 200 hours in and I was unable to unlock an ULTIMATE descendant. I know they need to make money but the drop rates remained the same in the new season,...low. So you can not unlock ultimate descendants unless you buy them at an expensive price. I was going to buy the new season but noticed descendants' material drops rates remained the same, low but for me a big zero . So I'm changing my review to negative for those reasons. \n\nThe grind in this game is insane, frustrating, and drop rates are very disappointing. This game is not even worth playing for free. I would not recommend this game.", "timestamp_created": 1723072740, "timestamp_updated": 1724966483, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.512195110321044922", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171647656", "author": {"steamid": "76561199101196475", "personaname": "Abyss_EM", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199101196475/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 1238, "playtime_last_two_weeks": 0, "playtime_at_review": 1016, "last_played": 1732984470, "avatar": "8442685651231b08503c282a75c5f324df2ae085"}, "language": "english", "review": "w game", "timestamp_created": 1723072700, "timestamp_updated": 1723072700, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1719730800", "reactions": []}, {"recommendationid": "171647571", "author": {"steamid": "76561198150188884", "personaname": "Dead", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198150188884/", "num_games_owned": 254, "num_reviews": 9, "playtime_forever": 19926, "playtime_last_two_weeks": 0, "playtime_at_review": 14699, "last_played": 1728627090, "avatar": "c59cb9bd6c967b2925f8d7efdd50a80f44d6147f"}, "language": "english", "review": "Don't.", "timestamp_created": 1723072580, 