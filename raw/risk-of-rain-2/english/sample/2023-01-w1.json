{"game": "risk-of-rain-2", "language": "english", "appid": 632360, "month": "2023-01", "window": 1, "start_date": 1672531200, "end_date": 1673135999, "month_true_total": 2909, "quota": 5, "returned": 5, "pulled_at": "2026-09-13 02:47:05 Pacific Daylight Time", "reviews": [{"recommendationid": "130388849", "author": {"steamid": "76561198439776303", "personaname": "Duffin", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198439776303/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 7865, "playtime_last_two_weeks": 0, "playtime_at_review": 4200, "last_played": 1784080250, "avatar": "3f05cb0fe31cd5c3d324b9e6f8526c03ca6f8799"}, "language": "english", "review": "This game is extremely fun and addicting. There are quite literally countless ways to play it (especially when you add modding into the mix) and every single way is equally as enjoyable as the others. The items and characters are very fun to use and play with, and the enemies are fun to fight. This game is also extremely hard (if you want it to be), so it's a great game for people that want a challenge. I would definitely recommend this game, 10/10. As for the price, I would absolutely say that it's worth the $25, and while the DLC doesn't add an overwhelming amount of content, it adds several items that completely change the way you play as well as two new characters that I loved playing as (plus a new mode that's fun for a lot of people).", "timestamp_created": 1673134948, "timestamp_updated": 1673134948, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1553788800", "reactions": []}, {"recommendationid": "130388821", "author": {"steamid": "76561198084286945", "personaname": "pepeLaugh", "persona_status": "offline", "profile_url": "https://steamcommunity