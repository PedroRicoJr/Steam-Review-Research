_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1553788800", "reactions": []}, {"recommendationid": "162448267", "author": {"steamid": "76561199122326054", "personaname": "cern104", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199122326054/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 254, "playtime_last_two_weeks": 0, "playtime_at_review": 191, "last_played": 1773753222, "avatar": "6ee9bd02e413b237f6581092555a85370f65082d"}, "language": "english", "review": "yes", "timestamp_created": 1712532127, "timestamp_updated": 1712532127, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1553788800", "reactions": []}, {"recommendationid": "162448047", "author": {"steamid": "76561198144994401", "personaname": "Avery", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Niher/", "num_games_owned": 168, "num_reviews": 8, "playtime_forever": 21468, "playtime_last_two_weeks": 0, "playtime_at_review": 17634, "last_played": 1782455437, "avatar": "7589ba859c4f70ec7963afe1eb0fe63f49394b3c"}, "language": "english", "review": "In the realm of Risk of Rain 2, where pixels dance in ethereal light, I find a joy that eclipses the carnal pleasures shared with my beloved wife. In the intimacy of our embrace, there lies warmth and tenderness, fleeting echoes of love's gentle embrace. Yet, amidst the chaos of virtual battle, where every moment is a symphony of adrenaline and strategy, I discover a euphoria that transcends the physical realm. The thrill of conquest, the rush of adrenaline as foes fall before me—it's a sensation more intoxicating than any shared breath or whispered endearment. In this juxtaposition of worlds, I am torn between the tender caress of love and the fiery passion of conquest, each offering its own brand of ecstasy, each leaving me yearning for more.\n\n11/10\n\n\n\n", "timestamp_created": 1712531839, "timestamp_updated": 1712531839, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1553788800", "reactions": []}, {"recommendationid": "162446504", "author": {"steamid": "76561198870198733", "personaname": "jax", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/jaxmusic/", "num_games_owned": 116, "num_reviews": 9, "playtime_forever": 16410, "playtime_last_two_weeks": 138, "playtime_at_review": 4589, "last_played": 1788661810, "avatar": "de39886607e4a347bbf7af6a7a4075294a80c747"}, "language": "english", "review": "yeah its ok i guess (i cannot stop playing this game)", "timestamp_created": 1712529857, "timestamp_updated": 1712529857, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1553788800", "reactions": []}]}