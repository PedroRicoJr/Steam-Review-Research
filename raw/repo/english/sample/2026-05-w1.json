eceived_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}, {"recommendationid": "224998310", "author": {"steamid": "76561198757008083", "personaname": "engineer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198757008083/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 30844, "playtime_last_two_weeks": 349, "playtime_at_review": 20804, "last_played": 1791165193, "avatar": "0227a240393e6d62f539ee7b306dd048b0830eeb"}, "language": "english", "review": "its just an experience untellable i cant describe the best game\r\n", "timestamp_created": 1778197278, "timestamp_updated": 1778197278, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 4, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}, {"recommendationid": "224997962", "author": {"steamid": "76561199389206951", "personaname": "Zidru", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Zidru/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 9192, "playtime_last_two_weeks": 22, "playtime_at_review": 1793, "last_played": 1791155447, "avatar": "e26a0635c4840490c192f8c85ab75b4205b8cc0c"}, "language": "english", "review": "peakness", "timestamp_created": 1778196842, "timestamp_updated": 1778196842, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}, {"recommendationid": "224997718", "author": {"steamid": "76561198819701085", "personaname": "Kyren", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/dumbestidiotonsteam/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 1964, "playtime_last_two_weeks": 0, "playtime_at_review": 1480, "last_played": 1789524582, "avatar": "c8f09e81c3924e14e512a3ef8ec7032a49fbbc73"}, "language": "english", "review": "It's incredibly clear that the developers love what they do. This isn't some quick cashgrab trying to get in on the \"you are screwed, but with friends\" trend. This is an actual, full-on, from the heart game.\r\nWhich makes me really sad since the actual gameplay is... awful at best.\r\nNow, the actual \"grab this and go put it there\" part of the game, I enjoy it! It's fun and puzzling trying to get giant objects from one end of the map to the other. What bugs me is the other part of the main gameplay loop. The monsters. More than probably 90% of the time, you dying is based purely on luck. Full on no way to fight back against a monster, and it's not even that you aren't equipped with anything. Hell, you are meant to start out with nothing, but even then you should be able to at least *sneak* around or something but even that isn't possible majority of the time. It wouldn't be such a pain if the monsters weren't also like Lethal Companies, where one hit from them is an instant game-over. I get being defenseless and all that adds strategy, but what strategy is there if a single mistake means its game over, no take-backsies? Theres other games for that. I don't want to play with my friends just to get killed within a minute and be forced to sit back and watch as everyone else struggles too. Oh yeah, my gripes aren't exclusive to the singeplayer mode (which I admit, I play a bit of.) and leak their way into multiplayer too. Too many times have I sat back in spectator and watched as my friends with several upgrades and power-ups just... die. No way around it, just picked off one by one and we have to start over. I don't think we've ever gotten past level 4 or anything like that. I know I kind of suck at the game, but my buds are definitely better than anybody that YOU know so don't be thinking it's some skill issue. You'll share the same fate as us whether you like it or not.\r\nThe game is extremely well done and continues to recieve updates, but I just can't get past how much of a snoozefest it turns out to be after not even 10 minutes. Sure, you'll have fun laughing and screaming with your friends and making mistakes, and thats fine! I do that too with my pals, and it's great! But am I really buying a game just to die, lose, laugh, die, lose, laugh, die, lose, get bored and we all do something else? If you and your pals have money to spare, I would recommend you try it, and if you don't like it, request a refund. Obviously too late for me but hey, if you find enjoyment in the game, then I'm glad. I really wish I could've liked it.", "timestamp_created": 1778196485, "timestamp_updated": 1778196485, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.479122906923294067", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}, {"recommendationid": "224997583", "author": {"steamid": "76561198745607558", "personaname": "BigChungus_981", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198745607558/", "num_games_owned": 8, "num_reviews": 2, "playtime_forever": 723, "playtime_last_two_weeks": 0, "playtime_at_review": 304, "last_played": 1786932663, "avatar": "a4abacb6c5d7eb68df0f6aacc70d11cf1bbd3bc6"}, "language": "english", "review": "game runs well even with low graphics card", "timestamp_created": 1778196292, "timestamp_updated": 1778196292, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_earl