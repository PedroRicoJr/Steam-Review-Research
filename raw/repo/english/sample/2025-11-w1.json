playtime_at_review": 799, "last_played": 1786009524, "avatar": "c23ee15955869f85eff23070a8fbd25f099671b1"}, "language": "english", "review": "I really like this game, however! It can be really unforgiving sometimes, especially on some of the later levels. this is made up for by how easy it is to just start another run. the shop provides a nice break inbetween areas, but it never feels like there is anything good or useful to buy but character upgrades. still a very good game, especially to play with friends.", "timestamp_created": 1762549693, "timestamp_updated": 1762549693, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}]}