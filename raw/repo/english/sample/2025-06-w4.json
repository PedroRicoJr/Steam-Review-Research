ived_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}, {"recommendationid": "198597222", "author": {"steamid": "76561198846774341", "personaname": "Six_Foot_Stiffy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198846774341/", "num_games_owned": 0, "num_reviews": 18, "playtime_forever": 2466, "playtime_last_two_weeks": 0, "playtime_at_review": 537, "last_played": 1778135254, "avatar": "b7fbf78e6d2abb73de19ff818cf221d1264cca7f"}, "language": "english", "review": "ONLY PLAY IF YOU HAVE A FEW FRIENDS. This game is sweet and very fun if you have people to play with. and ONLY if you have people to play with. If you solo random matchmaking you WILL have a bad time right off the bat. Screaming kids, Screaming adults, constant spamming of text chat. They knock you down, pick you up, and throw you in fires, acid, at monsters ect... I played 15 back to back games because surely there was a nice lobby out there somewhere. I was wrong. all 15 lobbies were exactly the same. Toxic kids having a laugh by ruining the game for other people. Its a fun game. Just don't play solo online. you wont make it past the first 3-4 min. if you do. HIDE. Also if you play solo. Good luck. The game is NOT built for 1 person. Im unsure as to why thats even an option. You get 1 tapped 9 times out of 10. Or, the monsters will destory all your loot and there will be no more on the whole level and you're just stuck.", "timestamp_created": 1751326672, "timestamp_updated": 1751328195, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1740578356", "reactions": []}, {"recommendationid": "198597217", "author": {"steamid": "76561199655233155", "personaname":