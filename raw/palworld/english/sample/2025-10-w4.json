funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "208082826", "author": {"steamid": "76561198297682278", "personaname": "Madd4D", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198297682278/", "num_games_owned": 0, "num_reviews": 21, "playtime_forever": 41708, "playtime_last_two_weeks": 0, "playtime_at_review": 28136, "last_played": 1787761401, "avatar": "e1426ca8faede5b699b2c00af163aadcc26396b4"}, "language": "english", "review": "It’s like Stardew Valley if it's dev had a midlife crisis and decided farming was too wholesome, so he added assault rifles and sweatshops. You’ll have 50 Pals mining ore while you sip coffee, wondering if you’re the villain. Spoiler: you are.", "timestamp_created": 1761947782, "timestamp_updated": 1782747247, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}]}