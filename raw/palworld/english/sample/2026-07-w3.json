ck_playtime_at_review": 1812, "last_played": 1785919935, "avatar": "3d288a6c0e639a5d18426c213580c04648c73a54"}, "language": "english", "review": "DO NOT PLAY THIS GAME IF YOU HAVE ANY RESPONSIBILITIES AT ALL.\n\nThis game is some kind of warp magic. You log in to check something out, maybe finish what you did the night before, you say \"oh I'll just play an hour then hop off\" , then next thing you know 8 hours have passed and you need to think up an excuse for your boss as to why youre an hour late to work\n\nHeed my warning", "timestamp_created": 1784847697, "timestamp_updated": 1784847697, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": true, "app_release_date": "1705651175", "reactions": []}]}