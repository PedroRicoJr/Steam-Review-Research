, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "217296308", "author": {"steamid": "76561199508160003", "personaname": "Phoenixproxy48", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199508160003/", "num_games_owned": 0, "num_reviews": 29, "playtime_forever": 6207, "playtime_last_two_weeks": 28, "playtime_at_review": 6179, "last_played": 1790713104, "avatar": "f80096dbf6ae8dc69620956b6a79b4085264a69a"}, "language": "english", "review": "Palworld is a game where you’re babysitting Pokémon on steroids… except they can also die horribly, get sold, or be forced into factory labor while you harvest resources and ride a T-Rex into battle. It’s adorable, chaotic, and somehow makes “murdering cute monsters” feel like a light weekend hobby. 10/10, I am morally bankrupt and giggling. 🦖💥🐾", "timestamp_created": 1769901965, "timestamp_updated": 1769901965, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "217296290", "author": {"steamid": "76561199055687244", "personaname": "dvacha", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199055687244/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 1704, "playtime_last_two_weeks": 0, "playtime_at_review": 1556, "last_played": 1785224292, "avatar": "e643c812feece27c17ad274ee113b3c2efb3d202"}, "language": "english", "review": "sometimes just doesnt load in ever when playing on multiplayer", "timestamp_created": 1769901947, "time