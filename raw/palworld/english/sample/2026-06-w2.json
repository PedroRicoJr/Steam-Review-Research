ifficult content you will not be able to solo on \"default\" settings encouraging team play. \n\nCritters are cute, combat is brutal (if you want it to be) and the graphics are good. By far one of the best crafting/survival games i've played.", "timestamp_created": 1781564473, "timestamp_updated": 1781564473, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.550172984600067139", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "228061592", "author": {"steamid": "76561198055725321", "personaname": "Emperor Of Mankind Obama", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198055725321/", "num_games_owned": 284, "num_reviews": 39, "playtime_forever": 5823, "playtime_last_two_weeks": 0, "playtime_at_review": 2282, "deck_playtime_at_review": 445, "last_played": 1784936698, "avatar": "36aa1ac3cf848fc4dfa64ea82ca9b11421a8fbf7"}, "language": "english", "review": "yeeeeee", "timestamp_created": 1781564127, "timestamp_updated": 1781564127, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}]}