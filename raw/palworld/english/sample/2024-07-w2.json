written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "169962024", "author": {"steamid": "76561199117689594", "personaname": "B0wgarden", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199117689594/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 5468, "playtime_last_two_weeks": 0, "playtime_at_review": 2719, "last_played": 1784864958, "avatar": "ef0b593186502edc26e69ea065197d1f5050c8a8"}, "language": "english", "review": "As the community says this game is like Pokemon with firearms. This game reminds me of The Legend of Arceus but more freedom on what you can do. You can customize the settings of you game to make it easier or harder for yourself. The only down thing about this game is there really isn't anything to tell you the controls and how to play. Yes, their is a Survival Guide but who wants to read that? I just wish their was some quick tutorial on what the controls are. Finally their is multiplayer so you can play with your friends. I did really enjoy this game and go out of my way to make time to play it.", "timestamp_created": 1721087316, "timestamp_updated": 1721087316, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "169961983", "author": {"steamid": "76561198056966374", "personaname": "Meta", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198056966374/", "num_games_owned": 257, "num_reviews": 6, "playtime_forever": 6555, "playtime_last_two_weeks": 1369, "playtime_at_review": 654, "last_played": 1791361976, "avatar": "054e41e10046b6367f8a3cb3991e50373d7840a7"}, "language": "english", "review": "My friend and I were playing, his power went out and closed our session, we came back to all of the world being corrupted and we've tried every recovery option and we weren't able to get any of our progress back, apparently this is a common bug, unfortunate as I was enjoying the game and had already put in 11 hours of gametime and lost it all the progress so easily, THIS is a major issue if you're common bug is \"hey btw you might lose all your progress at some random point in time\" then we've got BIG issues and it needs to be fixed asap until then I will not play this game", "timestamp_created": 1721087252, "timestamp_updated": 1721087252, "voted_up": false, "votes_up": 3, "votes_funny": 2, "weighted_vote_score": "0.47826087474822998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "169960575", "author": {"steamid": "76561198024373364", "personaname": "rakelo24", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198024373364/", "num_games_owned": 1034, "num_reviews": 14, "playtime_forever": 21031, "playtime_last_two_weeks": 0, "playtime_at_review": 8097, "last_played": 1786247548, "avatar": "22c1f9e3d5d8391d918be8595139570153867dfb"}, "language": "english", "review": "I've played since it first came out, and have loved it a lot, there's nothing I can really pinpoint that's bad, you can make it as hard or as easy as you want with the settings, and it's a fun world to explore and adventure in.", "timestamp_created": 1721085340, "timestamp_updated": 1721085340, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}]}