{"game": "palworld", "language": "english", "appid": 1623730, "month": "2025-04", "window": 2, "start_date": 1744070400, "end_date": 1744761599, "month_true_total": 1270, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 16:58:37 UTC", "reviews": [{"recommendationid": "192831799", "author": {"steamid": "76561199447533244", "personaname": "🍪Cookies🍪", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199447533244/", "num_games_owned": 29, "num_reviews": 8, "playtime_forever": 7454, "playtime_last_two_weeks": 0, "playtime_at_review": 3152, "last_played": 1781297805, "avatar": "c31e7e7db6840a3e440fdfc6d00645ed5acb7e76"}, "language": "english", "review": "i like slavery👍", "timestamp_created": 1744758456, "timestamp_updated": 1744758456, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.468610763549804688", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "192823916", "author": {"steamid": "76561198016945099", "personaname": "theesem", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198016945099/", "num_games_owned": 1237, "num_reviews": 27, "playtime_forever": 6159, "playtime_last_two_weeks": 0, "playtime_at_review": 5134, "last_played": 1745109094, "avatar": "2b52d427d868a4c8f1c4b2e2bba81e430e29d64a"}, "language": "english", "review": "This game is good. It will be even better when it's finished. For now, the world is a bit empty, the dungeons repeat quite a lot, and there are some balance issues. But there is huge potential, and it seems to be going the right way.\nThe pal mechanics and abilities are interesting, combat is good, the world size is more than adequate, difficulty is OK and scales well as the game progresses.\nDownsides: no meaningful loot (aside from pendants; everything else has to be crafted, could have more variety too, and no visual customisation), limited item upgrades, missing quality of life improvements: better pal sorting and selection tools, search boxes in inventories, trade between players etc. I think these items will come in time, I guess they are focusing on the \"core\" gameplay. Still, a very good game worth getting even in early access. And this comes from someone who has NOT played  pokemon or similar games before.", "timestamp_created": 1744749358, "timestamp_updated": 1744749453, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "192822775", "author": {"steamid": "76561198061417895", "personaname": "Ford", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198061417895/", "num_games_owned": 0, "num_reviews": 76, "playtime_forever": 2861, "playtime_last_two_weeks": 0, "playtime_at_review": 1152, "last_played": 1787503580, "avatar": "4676daf9271cf62acf47cbc811468bbff83bffe9"}, "language": "english", "review": "fun.", "timestamp_created": 1744748174, "timestamp_updated": 1785715802, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.487804889678955078", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1705651175", "reactions": []}, {"recommendationid": "192822092", "author": {"steamid": "76561199440177847", "personaname": "KinGamer1628", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199440177847/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 24884, "playtime_last_two_weeks": 0, "playtime_at_review": 10836, "last_playe