Игра хорошая, весёлая. Без компании друзей не очень, но и рандомы хорошие люди.\r\nМне игра понравилась, но нужно ждать скидок,  а не покупать на релизе и наиграть 3 часа ( сейчас больше, я за 2 дня наиграл почти 8))", "timestamp_created": 1729636870, "timestamp_updated": 1729636870, "voted_up": true, "votes_up": 3, "votes_funny": 1, "weighted_vote_score": "0.511713922023773193", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "177493513", "author": {"steamid": "76561198087156036", "personaname": "S.T.A.R.S.", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198087156036/", "num_games_owned": 0, "num_reviews": 26, "playtime_forever": 40212, "playtime_last_two_weeks": 0, "playtime_at_review": 184, "last_played": 1786307610, "avatar": "02e90a84cb5784a995a429e7f6c2a79de55dcd48"}, "language": "russian", "review": "Nice", "timestamp_created": 1729553638, "timestamp_updated": 1729553638, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.519999980926513672", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}]}