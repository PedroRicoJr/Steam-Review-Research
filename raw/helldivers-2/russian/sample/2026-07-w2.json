aname": "TheOatGoat", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199587809886/", "num_games_owned": 16, "num_reviews": 1, "playtime_forever": 3812, "playtime_last_two_weeks": 40, "playtime_at_review": 3707, "last_played": 1787937538, "avatar": "5663cbed4779e3099d0e7148643bf016627218be"}, "language": "russian", "review": "сво, 2122 год, где-то под Днепропетровском...", "timestamp_created": 1784142352, "timestamp_updated": 1784142352, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "230550919", "author": {"steamid": "76561198374010448", "personaname": "ifykyk", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198374010448/", "num_games_owned": 183, "num_reviews": 45, "playtime_forever": 1817, "playtime_last_two_weeks": 516, "playtime_at_review": 30, "last_played": 1788004586, "avatar": "12e7d16da17215df496f44367c3b06da73435f7d"}, "language": "russian", "review": "ОТЗЫВ ДЛЯ ТЕХ У КОГО ИГРА УЖЕ БЫЛА НА КОНСОЛИ! (и думают покупать на пк)\r\n\r\nИграю в игру с момента выхода, покупал изначально на ps5, были просадки, снижения разрешения в файтах и прочий дискомфорт, перешел на pro версию картинка стала немного лучше, но все остальное осталось, долго думал над покупкой на пк, потому что джойстик очень ограничивал управление, стрельбой с некоторых оружий, было жалко прогресс + донат в игру, наиграл немного 200+ часов, но все же 77 уровень, донат и прочие прокачки давали сомнения в покупке. Но все же решил брать себе на пк, и не жалею, качество графики запредельное если брать макс. настройки и сравнивать с ps5 pro, управление, плавность и анлок 60 fps имба, взрывы и прочее за что мне так игра полюбилась стали куда лучше и красивее, я принял решение полноценно уйти на пк в плане этой игры, не жалея о прогрессе и донате, в прочем как и скины эксклюзивные которые выдавали по праздникам, потому что Helldrivers 2 на пк - это как глоток свежего воздуха, как качественный апгрейд игре которая меня затянула на две покупки, донат и потраченное время. \r\n\r\nСоветую к покупке тем кто думал покупать или нет, и тем кто игру еще не купил.\r\n", "timestamp_created": 1784139044, "timestamp_updated": 1784139044, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "hardware": {"system_ram": "31820", "os": "Windows 11", "cpu_name": "AMD Ryzen 7 7800X3D 8-Core Processor           ", "adapter_description": "NVIDIA GeForce RTX 5070 Ti", "vram_size": 15995}, "reactions": []}]}