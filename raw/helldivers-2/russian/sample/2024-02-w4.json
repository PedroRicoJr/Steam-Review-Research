не жалею денег отданых за игру. Всем кто еще сомневается, не сомневайтесь вы определенно получите кайф от игры. За свободу! За демократию!\r\nP.S. В момент написания прилег сервер. И у меня появилось время на этот отзыв. Надеюсь демократия защитит нас от падающих сервов", "timestamp_created": 1709235112, "timestamp_updated": 1709235112, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "159558563", "author": {"steamid": "76561198980518435", "personaname": "ᚨᛗᚨᛚᚷᚨᛗ", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/koffemaner/", "num_games_owned": 0, "num_reviews": 31, "playtime_forever": 6778, "playtime_last_two_weeks": 718, "playtime_at_review": 341, "last_played": 1788003909, "avatar": "cd9dc4d7c22609d659a327e382b43c725af82811"}, "language": "russian", "review": "tckb tcnm lhepmz", "timestamp_created": 1709234360, "timestamp_updated": 1709234360, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "159557451", "author": {"steamid": "76561198044505897", "personaname": "Шторм Z", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198044505897/", "num_games_owned": 0, "num_reviews": 97, "playtime_forever": 8863, "playtime_last_two_weeks": 0, "playtime_at_review": 30, "last_played": 1771795898, "avatar": "fdd2f11c571c6493284b6a5714650e84c72336f6"}, "language": "russian", "review": "Будто из Звёздного десанта, Вархаммера и Старкрафта сварили ГУСТОЙ, НАВАРИСТЫЙ борщ. Лучшая сессионка на сегодня.\n\