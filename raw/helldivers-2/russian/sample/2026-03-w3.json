_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "221504954", "author": {"steamid": "76561198809900405", "personaname": "[Banned] ЗлойЗадрот", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Reymiksplay/", "num_games_owned": 139, "num_reviews": 9, "playtime_forever": 3451, "playtime_last_two_weeks": 20, "playtime_at_review": 3248, "last_played": 1786894857, "avatar": "14fa45d90d1774068441651602af9b2de61890b4"}, "language": "russian", "review": "Пропустил жука в туза, считай ты труп, если не успел отпрыгнуть как \"НЕО\"\r\n10 жуков из 10", "timestamp_created": 1774285896, "timestamp_updated": 1774285896, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "221503843", "author": {"steamid": "76561199791516458", "personaname": "MorbusD", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199791516458/", "num_games_owned": 50, "num_reviews": 8, "playtime_forever": 4065, "playtime_last_two_weeks": 116, "playtime_at_review": 2634, "last_played": 1788029592, "avatar": "97b220dfbd68c9444132f468c567f2b094dbb24f"}, "language": "russian", "review": "Прекрасная игра для веселия и друзей.", "timestamp_created": 1774285107, "timestamp_updated": 1774285107, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "221502492", "author": {"steamid": "76561199164806811", "personaname": "Requiem", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76