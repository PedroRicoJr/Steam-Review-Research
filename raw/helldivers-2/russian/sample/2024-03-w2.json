review": 4229, "last_played": 1753011475, "avatar": "3888362ab20fb98a19c74e38d9fe2235f79d53da"}, "language": "russian", "review": "[h1][b]⇩ ⇧ ⇦ ⇩ ⇧ ⇨ ⇩ ⇧[/b][/h1]\nВ огне галактик, где хаос царит,\nДесантники в бой за свободу летят.\nС оружием в руках, с отвагой в сердцах,\nНа чуждых планетах их ждёт смертный страх.\n\n«Адские десантники» — имя их гордо,\nВрагов побеждают, не зная укоров.\nКооперативный бой, команда — семья,\nВместе сражаются, дружбу храня.\n\nСатира и пафос, как в старом кино,\nНо в битве за правду не всё так смешно.\nНа грани абсурда, где смерть — лишь игра,\nОни защищают галактику с утра.\n\nПусть будет непросто, пусть враг не сдаётся,\nНо дух «Хеллдайверов» в битвах несётся.\nЗа мир и порядок, за свет и за честь —\nИх подвиг бессмертен, их слава не счесть!\n\n\nhttps://steamcommunity.com/sharedfiles/filedetails/?id=3176725770", "timestamp_created": 1710538838, "timestamp_updated": 1777750530, "voted_up": true, "votes_up": 6, "votes_funny": 1, "weighted_vote_score": "0.532304704189300537", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "160615339", "author": {"steamid": "76561198279557833", "personaname": "Goku", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198279557833/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 5585, "playtime_last_two_weeks": 0, "playtime_at_review": 1869, "last_played": 1765366451, "avatar": "b486379a3f2f431315959d81df23fdc71916b6ff"}, "language": "russian", "review": "fye", "timestamp_created": 1710537991, "timestamp_updated": 1710537991, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_rele