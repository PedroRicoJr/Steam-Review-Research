ndo lo.", "timestamp_created": 1717077246, "timestamp_updated": 1717077246, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.454545468091964722", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": true, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "166324645", "author": {"steamid": "76561198100532909", "personaname": "Envy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198100532909/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 3334, "playtime_last_two_weeks": 0, "playtime_at_review": 549, "last_played": 1751588367, "avatar": "6357b841d4fb8b596cdba14b4cbcfce965a4acb2"}, "language": "latam", "review": "FOR THE SUPER EARTH !", "timestamp_created": 1717060387, "timestamp_updated": 1717060387, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "166320941", "author": {"steamid": "76561198840693178", "personaname": "SmokeSs", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198840693178/", "num_games_owned": 87, "num_reviews": 14, "playtime_forever": 12869, "playtime_last_two_weeks": 1254, "playtime_at_review": 1393, "last_played": 1787621844, "avatar": "64455b3f80e6419b182bf68c483de214f5f56d75"}, "language": "latam", "review": "Por la democracia... vale la pena comprarlo", "timestamp_created": 1717053372, "timestamp_updated": 1717053372, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": fa