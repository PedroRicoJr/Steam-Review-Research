s": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "165948900", "author": {"steamid": "76561199084380962", "personaname": "Sestiian ℓ Dysphoria", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/Sestiian/", "num_games_owned": 193, "num_reviews": 40, "playtime_forever": 7011, "playtime_last_two_weeks": 56, "playtime_at_review": 6954, "last_played": 1787957865, "avatar": "4f1a1148cfd219b3d3fb1f17049cbe71b34d332e"}, "language": "latam", "review": "Hermano, 4 weyes se lanzan desde una nave hacia un planeta lleno de bichos, máquinas o webones azules, para que terminen desmembrados, mutilados o asesinados por los enemigos, o acabes muriendo por “culpa” de tu compañero, que te lanzó una nuclear a 2 metros de ti, o te haya caído un reabastecimiento, te hayas chocado por no saber usar el jetpack, sobrecargaste un arma y te explotó en las manos, matándote al instante… oye, no sé, deberías comprarlo, creo yo.\n\nGOTY 2024 (ni de pedo)\n\n\n⍫ - Muy bueno", "timestamp_created": 1716523516, "timestamp_updated": 1771147424, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}]}