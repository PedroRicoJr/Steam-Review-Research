en_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "209047521", "author": {"steamid": "76561198280496493", "personaname": "Poro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198280496493/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 41017, "playtime_last_two_weeks": 1470, "playtime_at_review": 25784, "last_played": 1787967763, "avatar": "af1cf9cf15be50bc6eda5a5c35bb1698bbf77ecd"}, "language": "latam", "review": "Aunque con amigos es un shooter cooperativo extremadamente divertido, jugar con desconocidos tampoco está mal. Las posibilidades de situaciones tan ridículas como cinematográficas son infinitas. \n\nEl universo que presenta el juego es muy sólido, con mucho carácter, y el tono general es un rango que va de lo épico a lo absurdo.\n\nLo malo es la optimización y el enorme espacio que ocupa en el disco.\n\nLas microtransacciones son muy amigables con el jugador y no se necesita gastar en ellas para disfrutar el juego al máximo.", "timestamp_created": 1762971259, "timestamp_updated": 1762971259, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "209005438", "author": {"steamid": "76561199165413030", "personaname": "Calcio-SUPREMO", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199165413030/", "num_games_owned": 0, "num_reviews": 19, "playtime_forever": 18341, "playtime_last_two_weeks": 170, "playtime_at_review": 656, "last_played": 1787970683, "avatar": "e6fd518f874dd79985ac50344f9ec2e461fda5eb"}, "language": "latam", "review": "por democracia\r\n", "timestamp_created": 1762917444, "timestamp_updated": 1762917444, "voted_up":