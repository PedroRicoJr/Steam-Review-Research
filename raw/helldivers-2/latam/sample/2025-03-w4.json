eriencia en armas, nada. Imagina que juegas por media hora y te saca, lo dejas pasar pero la siguiente partida tambien, y luego otra vez, hora y media perdida.", "timestamp_created": 1743397977, "timestamp_updated": 1780527027, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.49331355094909668", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "191611885", "author": {"steamid": "76561199082484325", "personaname": "Revan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199082484325/", "num_games_owned": 41, "num_reviews": 5, "playtime_forever": 12020, "playtime_last_two_weeks": 0, "playtime_at_review": 10778, "last_played": 1753629916, "avatar": "fb293bbac4dfbbd98a85fa04dbbd98ad8395d394"}, "language": "latam", "review": "FOR SUPER EARTH!!", "timestamp_created": 1743381927, "timestamp_updated": 1743381927, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}]}