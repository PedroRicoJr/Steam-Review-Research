709222171, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "159545975", "author": {"steamid": "76561198082685443", "personaname": "恶魔五月哭", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198082685443/", "num_games_owned": 231, "num_reviews": 30, "playtime_forever": 8400, "playtime_last_two_weeks": 0, "playtime_at_review": 1505, "last_played": 1734095871, "avatar": "f0f5d95ecd5e63a577af952be7be1ccbdcc33fcf"}, "language": "schinese", "review": "去他妈的PSN", "timestamp_created": 1709221699, "timestamp_updated": 1714806582, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "159544880", "author": {"steamid": "76561198071690701", "personaname": "CuiB", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198071690701/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 12899, "playtime_last_two_weeks": 0, "playtime_at_review": 5262, "last_played": 1722179042, "avatar": "9c6037b3b6b68af99e36a9820edbb29f6da4cd06"}, "language": "schinese", "review": "有朋友一起玩，好玩程度加倍", "timestamp_created": 1709220673, "timestamp_updated": 1709220673, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "159544792", "author": {"steamid": "765611980