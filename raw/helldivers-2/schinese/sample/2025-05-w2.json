ype": 7, "count": 1}, {"reaction_type": 8, "count": 1}, {"reaction_type": 12, "count": 1}, {"reaction_type": 18, "count": 1}, {"reaction_type": 21, "count": 1}, {"reaction_type": 23, "count": 1}]}, {"recommendationid": "194931381", "author": {"steamid": "76561199619879916", "personaname": "亚空间", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/Montana-BB67/", "num_games_owned": 29, "num_reviews": 7, "playtime_forever": 37174, "playtime_last_two_weeks": 0, "playtime_at_review": 37021, "last_played": 1781847691, "avatar": "b5b9f67d71cf7f93c782feb52fb7f5c890e9dcde"}, "language": "schinese", "review": "bug太多了，什么时候真正修一下", "timestamp_created": 1747300626, "timestamp_updated": 1778150960, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "194931243", "author": {"steamid": "76561199166723542", "personaname": "zfr123", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199166723542/", "num_games_owned": 68, "num_reviews": 7, "playtime_forever": 2686, "playtime_last_two_weeks": 0, "playtime_at_review": 1964, "last_played": 1769269979, "avatar": "eb0bc04e9f043dde25f1f091fa3aee6ca4a2ef4c"}, "language": "schinese", "review": "1", "timestamp_created": 1747300409, "timestamp_updated": 1747300409, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "194929643", "author": {"steamid": "76561198446314699", "personaname": "SpBoris", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198446314699/", "num_games_owned": 387, "num_reviews": 22, "playtime_forever": 7919, "playtime_last_two_weeks": 325, "playtime_at_review": 7310, "last_played": 1787842403, "avatar": "5fa5e1f42c0ac6204a0aa7c61eecf3597b94e00c"}, "language": "schinese", "review": "拿着初始枪械在什么教程都不给（初始教程只教会你怎么走路开枪扔雷开技能，没有教你地图里那堆任务该怎么做），什么敌人都不清楚的情况下被扔进没有任何技术性纯粹堆怪的战场，这就是新潜兵入伍需要面对的一切，学会开枪和扔手雷了？太好了，慷慨赴义就在今天！自豪的去填线罢！几坨厚的离谱的肉瘤子刷的到处都是，被一刷就刷一群的小怪撵得鸡飞狗跳，还要在换弹--跑路的同时试着搓技能，再搭配几个戴甲拿大棍的长得像隔壁星盟精英的玩意给你一围起来，让你真切的感受到什么叫爪爪有温度，棍棍有力度，所谓的甩棍沾碘伏，边打边消毒也不过如此了，就算你费尽千辛万苦给他们全突突了，没及时消灭无人机被扫到就等着喜提再来一轮；既然超级地球这般对待新兵，那就让超级地球燃烧吧o7\n\n2025/05/21新增：\n你11G就更出来这么些玩意？几个大洲长得一样复制粘贴的超级都市，仍然四处乱刷的光能者，AI战斗小组的战斗智商和路径点处理甚至赶不上隔壁低成本的地球防卫军，满大街乱跑的平民更是神人设计师想出来的纯DEBUFF，导致潜兵根本不敢使用任何会造成友伤的爆炸性武器和自动机枪塔，要不然等着裤衩子都赔掉吧；\n那我问你，敌人都来超级都市骑脸了，你的超级地球陆军呢？地面装甲部队增援呢？空中的舰队甚至近地轨道炮台支援呢？这么大个城市到现在连个自动防空系统都没有？还要潜兵手动从广场地下摇出炮台来手动调整着弹点，然后手动开炮装一炮打一炮，太伟大了超级史密斯专员！靠一堆只有步枪和无后坐力炮的防卫军战斗小组和几个潜兵就想击退铺天盖地的光能者入侵？我看这超级地球武装力量最高指挥部里都是猪啊！怎么打的赢这场仗啊！\n\n2025/05/30补：\n向超级地球武装部队的战士们致敬！为了你们我愿意再改为好评o7\n\n2026/05/09:\n恶性BUG要玩拖派战术，有利于玩家的BUG就光速修复；加强敌人各种升级毫不手软，加强潜兵出些垃圾武备还变着花样的下毒，PAY TO LOSE?GOOD JOB!我TAMA几百块买债券充到敌人身上了是吧？你这债券收益到底是给超级地球了还是给机器人，终结族了啊？", "timestamp_created": 1747297800, "timestamp_updated": 1778310963, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.4847908616065979", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}]}