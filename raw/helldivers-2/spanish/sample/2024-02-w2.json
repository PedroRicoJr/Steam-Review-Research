owned": 336, "num_reviews": 9, "playtime_forever": 25762, "playtime_last_two_weeks": 0, "playtime_at_review": 294, "last_played": 1779529454, "avatar": "564325d1d990a3d90758275d4a21a57004654d40"}, "language": "spanish", "review": "El juego, por llamarle de alguna manera, es un port mal realizado de un juego para PS. \nEl rendimiento es penoso, tarjetas gráficas tope de gama obligadas a jugar en calidad media o baja, limitando los fps a través del sistema operativo o la aplicación.\nParches que directamente no te permiten utilizar el juego, cerrando la aplicación nada mas iniciarlo.\nLo mas divertido de todo, es que los devs no tienen ni idea de porque ocurre todo.\nSi corrigen los problemas, podria ser un gran juego, pero parece que el proyecto les queda grande en pc a los devs. Una pena, pero así es imposible jugarlo", "timestamp_created": 1707996715, "timestamp_updated": 1707996715, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.354457557201385498", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}, {"recommendationid": "158365795", "author": {"steamid": "76561197988884850", "personaname": "JayCee", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/AtomPixel/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 51307, "playtime_last_two_weeks": 285, "playtime_at_review": 731, "last_played": 1787835081, "avatar": "5a845259229beae2a5d515274fd26fe5974c0943"}, "language": "spanish", "review": "It's not democracy, it's democrazy!", "timestamp_created": 1707993492, "timestamp_updated": 1707993492, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.529914498329162598", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": fal