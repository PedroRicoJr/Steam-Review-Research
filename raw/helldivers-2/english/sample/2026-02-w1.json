_two_weeks": 403, "playtime_at_review": 40745, "last_played": 1788002356, "avatar": "1b20a7f6f4c198e34b45ce60b0d5e9e212859f59"}, "language": "english", "review": "I am so lonely... All the other Helldivers are scared of me. No one talks to me. No one wants to be my teammate-- They think I am unstable. They send me from planet to planet spreading democracy in their name. And as I get better at Super Helldives, they fear me more and more. I am a victim of my own success. Helldiver... I don't even get a real name, only a purpose. I am capable of so much more and no one sees it. Some days I feel so alone I could cry, but I don't. I never do, because what would be the point? Not a single person in the entire universe would care.\n\n\n\n(Also this game dropped on my birthday. Best game ever!)", "timestamp_created": 1770593583, "timestamp_updated": 1770593717, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.512195110321044922", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "reactions": []}]}