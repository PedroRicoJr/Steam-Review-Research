{"game": "helldivers-2", "language": "english", "appid": 553850, "month": "2026-03", "window": 3, "start_date": 1773619200, "end_date": 1774310399, "month_true_total": 9083, "quota": 5, "returned": 5, "pulled_at": "2026-08-29 22:17:59 Pacific Daylight Time", "reviews": [{"recommendationid": "221534097", "author": {"steamid": "76561199208333701", "personaname": "BarelySentient", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Mayborwalaguyakongpasayahin232/", "num_games_owned": 141, "num_reviews": 13, "playtime_forever": 16237, "playtime_last_two_weeks": 0, "playtime_at_review": 14875, "last_played": 1786754883, "avatar": "b68a822cba2a1a065b557c9396b2ef7d88188973"}, "language": "english", "review": "Game will crash after evac, infinite intro cutscene, everything will ragdoll you so you don't get to play the game, getting hit by anything will break your limbs, and now respawn will put you in a different hemisphere from the beacon. God I love this game to death but I can't go one match without having multiple deaths that I cannot control and the fact that we keep going without acknowledging things like this is irksome, I love the direction and the community yet the reason I put down the game a year ago is the same reason I do today. Please buy this if they decide to fix this but until then it's just unpleasant\n\nEdit: Many of these bugs are still ever present in nearly every other run and now we are getting certain gameplay features that were previously free put behind a warbond. Please do not support a behavior growing like this", "timestamp_created": 1774310021, "timestamp_updated": 1776967413, "voted_up": false, "votes_up": 9, "votes_funny": 0, "weighted_vote_score": "0.543478250503540039", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1707382200", "hardware": {"system_ram": "15619", "os": "Windows 11", "