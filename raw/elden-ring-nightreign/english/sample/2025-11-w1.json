{"game": "elden-ring-nightreign", "language": "english", "appid": 2622380, "month": "2025-11", "window": 1, "start_date": 1761955200, "end_date": 1762559999, "month_true_total": 5409, "quota": 21, "returned": 21, "pulled_at": "2026-10-04 23:46:47 UTC", "reviews": [{"recommendationid": "208671319", "author": {"steamid": "76561198101344764", "personaname": "GymBro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/weebsosala/", "num_games_owned": 255, "num_reviews": 4, "playtime_forever": 895, "playtime_last_two_weeks": 0, "playtime_at_review": 381, "last_played": 1786577084, "avatar": "5b8825b34c5d77b00c3a18897f2f1175fa0e0e57"}, "language": "english", "review": "A stuffy timer that rushes the player. It would be better to make exclusionary choices about where to go. It would be more in the DS style.\nWhy is it not possible to try to kill the boss after death in order to get used to it? The reward and kill will not be counted, but you will not have to play the entire run for a new attempt.\nOne of the main charms of DS was the ability to try over and over again without being punished for trying.", "timestamp_created": 1762558615, "timestamp_updated": 1762558615, "voted_up": false, "votes_up": 9, "votes_funny": 2, "weighted_vote_score": "0.549682199954986572", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": [{"reaction_type": 19, "count": 2}]}, {"recommendationid": "208670432", "author": {"steamid": "76561197966081514", "personaname": "RaiderOne", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197966081514/", "num_games_owned": 0, "num_reviews": 21, "playtime_forever": 67229, "playtime_last_two_weeks": 970, "playtime_at_review": 26409, "last_played": 1791152725, "avatar": "795c219463307003db9efb5b961c913865f08715"}, "language": "english", "review": 