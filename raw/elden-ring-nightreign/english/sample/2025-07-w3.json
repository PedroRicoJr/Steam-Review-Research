amz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198006531591/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 6299, "playtime_last_two_weeks": 0, "playtime_at_review": 1010, "deck_playtime_at_review": 156, "last_played": 1783216756, "avatar": "733ff202d8f8fccfeef289c3b0079af75a46c29b"}, "language": "english", "review": "A condensed Souls/Elden Ring experience. It is refreshing in its speed and the added multiplayer elements can scratch that end-game feeling itch if you are familiar with MMORPG's or Raiding. Grab some friends and take out some night lords, it is very fun.", "timestamp_created": 1753307502, "timestamp_updated": 1753307502, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "200466494", "author": {"steamid": "76561199054228667", "personaname": "HanaPiink", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199054228667/", "num_games_owned": 75, "num_reviews": 2, "playtime_forever": 25715, "playtime_last_two_weeks": 0, "playtime_at_review": 7201, "last_played": 1789900274, "avatar": "5b66784e597b716dd1068e2209e6db50905c095b"}, "language": "english", "review": "Se pasa  bien con amigos.", "timestamp_created": 1753307403, "timestamp_updated": 1753307403, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "200465977", "author": {"steamid": "76561197993926407", "personaname": "shooter", "persona_status": "offline", "profile_url": "https://steamcommunity