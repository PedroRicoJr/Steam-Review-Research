282, "playtime_last_two_weeks": 0, "playtime_at_review": 2282, "last_played": 1757295386, "avatar": "8442685651231b08503c282a75c5f324df2ae085"}, "language": "english", "review": "I said that Elden Ring was my least favorite souls game. Now it is my second least favorite, and this takes the cake. Difference is, Elden Ring is still a peak game, just not as peak as the rest. This one is the first souls game that actually kinda stinks ngl. It kind of ran bad, the pacing was way too fast and jank, and the whole thing felt like you needed to be on adderall to have any sort of fun. Add on the fact that the whole thing is basically just a asset dump from older games (wherein the bosses from older games do not at all fit with the style/movement of Elden Ring ESPECIALLY THE DS2 ONES) and it starts to stank.", "timestamp_created": 1761257226, "timestamp_updated": 1761257226, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.47750285267829895", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}]}