layed": 1775753176, "avatar": "bb9373be5d1fbace1c6bb444bc1f40c5d2a86b52"}, "language": "english", "review": "i freakin love this game. it makes my pp go brrrrrrrrrr", "timestamp_created": 1764543697, "timestamp_updated": 1764543697, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "212188857", "author": {"steamid": "76561199074087407", "personaname": "Rares28RO", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199074087407/", "num_games_owned": 107, "num_reviews": 3, "playtime_forever": 5270, "playtime_last_two_weeks": 0, "playtime_at_review": 4522, "last_played": 1775317208, "avatar": "661c117c9259b4619c2afa3abe7d19d08217577a"}, "language": "english", "review": "Executor = Wolf", "timestamp_created": 1764543603, "timestamp_updated": 1764543603, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "212188476", "author": {"steamid": "76561198127692966", "personaname": "Jeice", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Okido/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 30987, "playtime_last_two_weeks": 0, "playtime_at_review": 22786, "last_played": 1775455235, "avatar": "84024e2b6b460f6ab852bfa28d5f7fca528b897a"}, "language": "english", "review": "Elden Ring Nightreign is more Elden Ring and its co-op. Join a round with a buddy or two or some randoms and take on Elden Ring's B-class bosses. No Malenia, but we have Lansseax. No Radahn, but we have Commander Niall. The bosses unique to this game are pretty fun to fight. \r\n\r\nChange up your fighting style on the fly using the randomly generated loot. The game can be fun, but the main game lacks the randomness of Depth of Night, a hard mode. Despite being a rouge-lite there's little variety besides weapon drops. The map mostly remains the same between runs with Shifting Earth events to shake up the geography. Character stats are mostly static and the Relic System is quite poorly thought out and far too random. There are too few guest bosses and enemies from Dark Souls. Hopefully, more Souls bosses and enemies will be added in future updates.\r\n\r\nIn spite of my negative review, it's more Elden Ring that I can play it with my buddies without mods. The game has good bones, but still needs more enemy, map, and weapon variety.", "timestamp_created": 1764543448, "timestamp_updated": 1764543448, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}]}