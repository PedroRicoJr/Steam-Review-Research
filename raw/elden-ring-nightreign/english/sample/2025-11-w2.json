ring_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "209309155", "author": {"steamid": "76561198767939063", "personaname": "John Nightreign", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198767939063/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 25276, "playtime_last_two_weeks": 0, "playtime_at_review": 316, "last_played": 1783807818, "avatar": "b1a2b437477deb4c83603a99d1c6f41fc479fd3c"}, "language": "english", "review": "Le perfection", "timestamp_created": 1763229910, "timestamp_updated": 1763229910, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "209307618", "author": {"steamid": "76561199226918654", "personaname": "vypsi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199226918654/", "num_games_owned": 156, "num_reviews": 7, "playtime_forever": 12030, "playtime_last_two_weeks": 0, "playtime_at_review": 8685, "deck_playtime_at_review": 15, "last_played": 1782842964, "avatar": "054bf744c48d4cc6ea8185a15aa6924c1487cd3f"}, "language": "english", "review": "Overall a pretty good game and fun to play with friends. Me and my brother played this wayyy too much at release and finished the game in about 3 or 4 days. At release it was pretty hard to play solo but that has been pretty much fixed now. The Everdark sovereigns and the deep of night mode were a pretty cool addition to the game and gave it some fresh wind. The nightlords are mostly fun to fight and have really cool designs and the roguelike aspect of the game has been nailed too in my opinion. All the classes feel unique and play really well so there's bound to be something for every play style. I also love how the Nightlords all have weaknesses so you have to keep that in mind while making your build which is especially important in the deep of night mode. You can make your own strats and plan out a route which is really fun even tho there's just one core map. The shifting earths make up for that which were also really interesting and a lot of fun to discover and explore and since there are so many its never really boring. The way you find out the storys of the nightfarers is also really unique and a lot of fun while the story itself is really well written and emotional in my opinion!!! So overall it's a really good pickup and worth the price :) Excited for the DLC :P", "timestamp_created": 1763228970, "timestamp_updated": 1763228970, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "209306898", "author": {"steamid": "76561198055640309", "personaname": "Krushul", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Krushul/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 31319, "playtime_last_two_weeks": 522, "playtime_at_review": 17918, "last_played": 1791035290, "avatar": "7c32bb882637b2dff42f1173344935a0b8fbd2ad"}, "language": "english", "review": "Revenant and Undertaker, that is all.", "timestamp_created": 1763228524, "timestamp_updated": 1765064100, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1748555952", "reactions": []}, {"recommendationid": "209304280", "author": {"steamid": "76561198050402214", "personaname": "John Helldive