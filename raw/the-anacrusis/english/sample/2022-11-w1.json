ame": "Minor Antagonist", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/w0ckyslush/", "num_games_owned": 657, "num_reviews": 69, "playtime_forever": 8, "playtime_last_two_weeks": 0, "playtime_at_review": 7, "last_played": 1669718625, "avatar": "015a06e9b3b57eaffe6687512efd4ab497219652"}, "language": "english", "review": "doesn't even start", "timestamp_created": 1669587410, "timestamp_updated": 1669587410, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.396722853183746338", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1670026790, "developer_response": "We have fixed the bug that was causing the game to take a really long time to launch as part of the 6.1 hotfix that was released on December 2.", "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126968301", "author": {"steamid": "76561198002193644", "personaname": "Phrieksho", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/phrieksho/", "num_games_owned": 1199, "num_reviews": 215, "playtime_forever": 268, "playtime_last_two_weeks": 0, "playtime_at_review": 177, "last_played": 1689716925, "avatar": "0fd3c06d3a7ddcb6acc3445b6048b1fb3214f75a"}, "language": "english", "review": "Incredibly solid foundation. Already feels a bit more up my alley than L4D and B4B. I like having upgrade systems and randomized elements, but B4B just felt like it tried too hard and failed in most ways. This game, meanwhile, feels a bit more focused. Great atmosphere, visually distinct enemies (particularly the elites -- a problem that B4B had in spades), fairly tight gunplay, solid replayability.\n\nDefinitely looking forward to more.", "timestamp_created": 1669448862, "timestamp_updated": 1669448862, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.481626272201538086", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126855367", "author": {"steamid": "76561198245506788", "personaname": "DugTyler", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/dugtyler/", "num_games_owned": 591, "num_reviews": 15, "playtime_forever": 1588, "playtime_last_two_weeks": 0, "playtime_at_review": 1039, "last_played": 1749324625, "avatar": "2fe2347a89b8c7b0bf5d004400aa96404b56411a"}, "language": "english", "review": "l4D in space", "timestamp_created": 1669399084, "timestamp_updated": 1669399084, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.451517015695571899", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126726783", "author": {"steamid": "76561197977016926", "personaname": "Duderman", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/letsgetinthere/", "num_games_owned": 279, "num_reviews": 11, "playtime_forever": 554, "playtime_last_two_weeks": 0, "playtime_at_review": 554, "last_played": 1666975994, "avatar": "67b3a1f04ee4857cfa8a0e1a6a1bda5b8ac0c9ca"}, "language": "english", "review": "Fantastic foundation.  It needs work, but the developers are doing the slow but steady method.  I feel confident the final product will be solid and well-rounded, and fit well among popular and excellent coop horde shooters.  For now, however, it is clearly not feature complete and leaves you wanting more.  Give it time, it'll be great.", "timestamp_created": 1669335353, "timestamp_updated": 1669335353, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.507187187671661377", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126726473", "author": {"steamid": "76561198020565819", "personaname": "Derped Crusader", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Derped_Crusader/", "num_games_owned": 489, "num_reviews": 55, "playtime_forever": 483, "playtime_last_two_weeks": 0, "playtime_at_review": 54, "last_played": 1772407022, "avatar": "3949c61346965e6eeb81b1a4594d4e417d79b22b"}, "language": "english", "review": "Very fun\n\nmostly played on Gamepass, which is why i have less than an hour", "timestamp_created": 1669335217, "timestamp_updated": 1669335217, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.451517015695571899", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126542517", "author": {"steamid": "76561198200449430", "personaname": "CrazyGoodDude", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198200449430/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 190, "playtime_last_two_weeks": 0, "playtime_at_review": 190, "last_played": 1644695034, "avatar": "dbbb50782c05f760b0270f9647ccca5442428c80"}, "language": "english", "review": "Honestly pretty fun if a little repetitive and buggy, but I think with time the game will get better just like the L4D series.", "timestamp_created": 1669271805, "timestamp_updated": 1669271805, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.451517015695571899", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126344538", "author": {"steamid": "76561198046900933", "personaname": "Avyssos", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198046900933/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4419, "playtime_last_two_weeks": 0, "playtime_at_review": 4297, "last_played": 1715553323, "avatar": "4abdfca844c67bd3aece3f10f109b90695a9d5c6"}, "language": "english", "review": "What I can say is that the game holds potential. Though it has lengths to go, you do see the signs for a labor of love towards the zombie genre or Left 4 Dead's legacy. Anyone who loves this genre will inevitably find a fondness for the game too. From what I know the team behind it are few compared to an established company, but I can say that this small team have managed to bring more updates and patches than most other games have or would. The final statement is this. For what the game is now I've been enjoying it. Many try to copy Left 4 Dead's style and fail at it at the wrong action of a mimic, but The Anacrusis understands that style. The game brings back plenty of memory to what the Left 4 Dead gameplay is, and that is fun. However aside appearances I've yet to find that thrill that leaves me with the thought, \"This is The Anacrusis\". The important question to ask is this. What is beyond that Left 4 Dead game-play that makes it more than a mod or something of its own? Still, one must bear in mind that this is an early access review meaning the game is still in first stages of development not nearing its ending stage, and, whether or not the team will tap into the game's full potential or give more than what the game is now that is another question yet to be answered. If you love the genre or like to play co-op games with friends, there is no reason to not try the game. But if you are testing the waters and you have one choice for one game to try, Left 4 Dead still sits at the pedestal. It's difficult to write just that sentence because I don't want to belittle this game. One must bear in mind that the team behind The Anacrusis were also part of the team behind the Left 4 Dead series and in a way it's a love that was already there from many, or acceptance, for the gameplay and work they have done in the past and continue to do so on with this game. And that is the why I have been enjoying this game.", "timestamp_created": 1669212855, "timestamp_updated": 1688879923, "voted_up": true, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.512206673622131348", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": [{"reaction_type": 19, "count": 1}]}, {"recommendationid": "126269047", "author": {"steamid": "76561198004468758", "personaname": "Elyrien Valkyr", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ElyrienValkyr/", "num_games_owned": 0, "num_reviews": 305, "playtime_forever": 10, "playtime_last_two_weeks": 0, "playtime_at_review": 10, "last_played": 1669198024, "avatar": "66235464222399aa27c6499e5f0fe14c88bf3139"}, "language": "english", "review": "It feels like this could be a truly great game, but it's sadly completely dead.\n\nDon't buy this, not even on sale. Not unless you have 3 friends to play with. You won't get a match.", "timestamp_created": 1669198143, "timestamp_updated": 1669198143, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.496106952428817749", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1669930774, "developer_response": "Playercount on Steam is up and down throughout the day while we're in Early Access, but we typically have a good pool of players across Steam and the Microsoft platforms. Unfortunately, we had a bug with matchmaking in the 6.0 release that left people in orphaned sessions by themselves. We're working on fixing that (and have disabled quickplay in the meantime), but are waiting on external partners for a potential fix. \n\nWhile we're working on that, there are always people looking for games on our Discord (https://discord.gg/straybombay) and the game's Discord integration makes it easy to start a lobby and post an invite for folks to get games going.", "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "126106881", "author": {"steamid": "76561198403384917", "personaname": "RINGER", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198403384917/", "num_games_owned": 818, "num_reviews": 36, "playtime_forever": 440, "playtime_last_two_weeks": 0, "playtime_at_review": 420, "last_played": 1702740524, "avatar": "dcc5feeb800d813e61589b69552b6330f685e98e"}, "language": "english", "review": "A simple fun 4-player PvE wave-based co-op game from developers who worked on Left 4 Dead. What it lacks in content it (somewhat) makes up for in improved gunplay. The characters are interesting, and the variety of enemies is cool. More variety of guns would definitely improve it a lot. \n\nA must pick-up if on sale.", "timestamp_created": 1669161684, "timestamp_updated": 1669161684, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.493815839290618896", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "125677809", "author": {"steamid": "76561198216065817", "personaname": "McSam", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198216065817/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 1733, "playtime_last_two_weeks": 0, "playtime_at_review": 969, "last_played": 1777081799, "avatar": "8dc62b81b3175aa2c36357a658683e339b03a75f"}, "language": "english", "review": "Enough of a challenge to keep you coming back. Great visuals and lots of fun.", "timestamp_created": 1668764155, "timestamp_updated": 1668764155, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "125642380", "author": {"steamid": "76561198025223700", "personaname": "cthulhuplus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/cthulhuplus/", "num_games_owned": 286, "num_reviews": 28, "playtime_forever": 1374, "playtime_last_two_weeks": 0, "playtime_at_review": 1121, "last_played": 1703912517, "avatar": "d51ccef8c75b9441124bee772ae069ac1ff844e0"}, "language": "english", "review": "Left 4 Dead 2, Space, but in the 70s. This game is great and the developers are super into engaging with the community. They make changes based on player feedback and have even been providing modding tools! I'm super excited for this games continued development!", "timestamp_created": 1668710216, "timestamp_updated": 1668710216, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "125287999", "author": {"steamid": "76561199002219069", "personaname": "B", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Comexatxmexbro/", "num_games_owned": 0, "num_reviews": 29, "playtime_forever": 11, "playtime_last_two_weeks": 0, "playtime_at_review": 11, "last_played": 1654873767, "avatar": "f5d5d