_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "118352178", "author": {"steamid": "76561198304925090", "personaname": "MTD", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/MTD_BK/", "num_games_owned": 960, "num_reviews": 55, "playtime_forever": 1911, "playtime_last_two_weeks": 0, "playtime_at_review": 622, "last_played": 1715661692, "avatar": "8b045802cbfe45224995d63c1a098571c75d1d54"}, "language": "english", "review": "Even in the current partially-complete state it's in, What's available so far is extremely fun and replayable to progress through. I've encountered a few bugs here and there that hindered my progress, but I'm confident they will be ironed out sometime throughout the EA period. Very much looking forward to the future of this game.", "timestamp_created": 1657147559, "timestamp_updated": 1659339465, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.485894709825515747", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1642097723", "reactions": []}, {"recommendationid": "118301376", "author": {"steamid": "76561198004150397", "personaname": "HypnoJuice", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hypnojuice/", "num_games_owned": 0, "num_reviews": 93, "playtime_forever": 25, "playtime_last_two_weeks": 0, "playtime_at_review": 25, "last_played": 1657073180, "avatar": "f008645b651e0bc6c46ecd6907b231993fd4d469"}, "language": "english", "review": "left 4 wack", "timestamp_created": 1657080170, "timestamp_updated": 1657080170, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.465631932020187378", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": true, "primarily_steam_deck": false