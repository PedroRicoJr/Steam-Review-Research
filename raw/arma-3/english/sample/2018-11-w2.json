community.com/id/RY0NIX/", "num_games_owned": 769, "num_reviews": 40, "playtime_forever": 1728, "playtime_last_two_weeks": 0, "playtime_at_review": 400, "last_played": 1574889323, "avatar": "ad503388840403f44640706ac14a7c56522a727d"}, "language": "english", "review": "Arma 3 makes big steps forward with a huge world and more vehicles and weapons. This time around its trump card is Steam workshop integration though, making downloading mods effortless. A smart move by Bohemia Interactive because it are those mods that will give Arma 3 its long lifespan. Unfortunately Arma 3 is quite inaccessible and doesn't seem to grow along with modern game design on certain fronts. Space time and perseverance are your best friends here, until Bohemia's support starts paying off.", "timestamp_created": 1542303822, "timestamp_updated": 1542303822, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}