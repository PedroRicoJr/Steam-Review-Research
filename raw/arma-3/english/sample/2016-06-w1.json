2, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "23442964", "author": {"steamid": "76561198135996957", "personaname": "PVRAMID", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/PVRAMID/", "num_games_owned": 256, "num_reviews": 6, "playtime_forever": 262870, "playtime_last_two_weeks": 0, "playtime_at_review": 172980, "last_played": 1585772529, "avatar": "5153666925015452806095bde6c281a6ea43072e"}, "language": "english", "review": "This is an amazing game it's swallowed up a lot of my life with a lot of different servers to check out and explore, ranging from Roleplay servers to hardcore Military simulation.\n\nThe ArmA 3 community on the whole is great, however if you are looking for \"Community spirit\" when playing a Roleplay server such as the \"Life\" series, I'd go ahead and not even bother purchasing the game.\n\nOtherwise, this is a very good game and I would reccomend this to anyone who has the spare time that it will consume.", "timestamp_created": 1465338315, "timestamp_updated": 1465338315, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.519999980926513672", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "23442813", "author": {"steamid": "76561198242142072", "personaname": "Gman", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198242142072/", "num_games_owned": 350, "num_reviews": 55, "playtime_forever": 35909, "playtime_last_two_weeks": 0, "playtime_at_review": 13353, "last_played": 1720892789, "avatar": "74e620db784ff4e832b43ef918d6abf64aadfbad"}, "language": "english", "review": "This game is 100% worth the money.  It is so realistic.  This game is more of an adult version of gmod.  It has so many custom gamemodes off of the base game.  The main storyline is incredible.  Buy this game!!!", "timestamp_created": 1465337532, "timestamp_updated": 1489265861, "voted_up": true, "votes_up": 1, "votes_funny": 20, "weighted_vote_score": "0.5", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "23442563", "author": {"steamid": "76561198308542767", "personaname": "Raven33", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198308542767/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 17008, "playtime_last_two_weeks": 0, "playtime_at_review": 2559, "last_played": 1661133141, "avatar": "1a6a946be04b03a5f9373ec1e9f6cf8e07d6c7cd"}, "language": "english", "review": "awsome", "timestamp_created": 1465336318, "timestamp_updated": 1466799962, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 3, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}