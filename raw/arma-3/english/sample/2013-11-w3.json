{"game": "arma-3", "language": "english", "appid": 107410, "month": "2013-11", "window": 3, "start_date": 1384560000, "end_date": 1385164799, "month_true_total": 317, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 11:01:23 UTC", "reviews": [{"recommendationid": "7719455", "author": {"steamid": "76561198011098795", "personaname": "The Machine", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/i_am_the_machine/", "num_games_owned": 775, "num_reviews": 31, "playtime_forever": 121035, "playtime_last_two_weeks": 0, "playtime_at_review": 119317, "last_played": 1783140836, "avatar": "ab91719780c1cff30df93975b4145f70b7059d2e"}, "language": "english", "review": "Why doesn't anyone want to play? Optimized and running smooth, best military simulation.\n\nUpdate Nov 23, 2016 @ 8:03pm: Since release this game has slowly degraded into a low performing, buggy, storage hogging, memory leaking game. Unfortunately I still recommend this game because there is contention in wanting a well performing, immersive, and massive open world shooter. The survival mods of this game are what keeps it going.\n\nUpdate 2: You can make mods for this game with the sqf scripting language. The game is a time suck, that still leaves a lot to be desired.\n\nUpdated 3: Game still receiving updates for some reason. They added some good multi-threading recently. Runs at 120 fps in KoTH multiplayer on a 9800X3D.", "timestamp_created": 1385161613, "timestamp_updated": 1764036214, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.502487540245056152", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "7718560", "author": {"steamid": "76561197960287287", "personaname": "xan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/xanvalk/", "num_games_ow