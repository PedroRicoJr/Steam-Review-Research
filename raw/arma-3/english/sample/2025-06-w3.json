ase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "197902943", "author": {"steamid": "76561198259308042", "personaname": "CopyG", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/copyG/", "num_games_owned": 178, "num_reviews": 43, "playtime_forever": 10316, "playtime_last_two_weeks": 0, "playtime_at_review": 5675, "last_played": 1763679120, "avatar": "e21a0adc89c75bd2b02fae2d3641f40ea51d6db4"}, "language": "english", "review": "Like virtual legos, Arma is the perfect game to make custom experiences, is almost like playing D&D + mil sim.", "timestamp_created": 1750617648, "timestamp_updated": 1750617648, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}