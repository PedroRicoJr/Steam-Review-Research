378969200", "reactions": []}, {"recommendationid": "7958291", "author": {"steamid": "76561198042529316", "personaname": "AcquiredLuck", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hamerbro/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 10454, "playtime_last_two_weeks": 0, "playtime_at_review": 5236, "last_played": 1486087320, "avatar": "2200692b7b75e5f35a4976c5435551ae31d5e1ad"}, "language": "english", "review": "Want a good war game? Look no further this is the game for you. It doesn't have as much action as COD or BF at first, but if you find the right server and have the right friends this will be more fun by far.", "timestamp_created": 1386446234, "timestamp_updated": 1386446283, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523103237152099609", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "7958055", "author": {"steamid": "76561197982550559", "personaname": "Rubber", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TheFoxz/", "num_games_owned": 315, "num_reviews": 10, "playtime_forever": 1746, "playtime_last_two_weeks": 0, "playtime_at_review": 1001, "last_played": 1478373613, "avatar": "77d3d121527d6c21d9b9293862eb99bc397d3b00"}, "language": "english", "review": "This game was released as an incomplete game, but content is added on a regular basis. In a couple of years it'll actually be worth the $30 price tags it'll be by then. I don't recommend it at its current price, but overall it's a very solid military simulation game.", "timestamp_created": 1386445286, "timestamp_updated": 1386446007, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.511002421379089355", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "7957938", "author": {"steamid": "76561198060151962", "personaname": "CoCo", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198060151962/", "num_games_owned": 193, "num_reviews": 2, "playtime_forever": 66076, "playtime_last_two_weeks": 0, "playtime_at_review": 10013, "last_played": 1722943115, "avatar": "31a9b62dfd2960a11d02af31c7ae0fb7d67a74b8"}, "language": "english", "review": "ArmA 3 is an excellent game for 2 reasons. Number one, its engaging and immersive and fun, and number two is the fact that Bohemia Interactive cares about its modding community (Hence the competition \"Make ArmA, not war\"). But ArmA 3 comes with a few flaws. Chief among these, in my opinion, is optimization as I own a very good mid-level PC and I seem to be getting around 16 to 20fps. Also is the lack of vehicles and weaponry, although I know that is set to change, I would have liked the game to be complete and not an \"about to finish up Beta\". But if you have some friends that are interested, then why don't you visit the islands of Altis and Stratis. Live a new life in Altis or Stratis Life, fight for survival in Wasteland, or work together to defeat OPFOR AI in Invade and Annex. Just bare in mind that this is a Military simulator, so no run and gun or Rendezook's here, just good ol' fashioned tactical warfare.", "timestamp_created": 1386444797, "timestamp_updated": 1386444999, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}