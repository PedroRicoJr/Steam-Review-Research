{"game": "arma-3", "language": "english", "appid": 107410, "month": "2023-10", "window": 4, "start_date": 1698105600, "end_date": 1698796799, "month_true_total": 715, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 11:17:02 UTC", "reviews": [{"recommendationid": "149279186", "author": {"steamid": "76561197962550502", "personaname": "Nixxen", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/nixx1/", "num_games_owned": 1813, "num_reviews": 56, "playtime_forever": 128157, "playtime_last_two_weeks": 348, "playtime_at_review": 96901, "last_played": 1791320595, "avatar": "050a901c258494f8fa1bd01045dd5cbcfa1307b7"}, "language": "english", "review": "The game you love to hate, and hate to love.\n\nGreat sandbox game where you can do anything you want to, but set to a military setting.\nThe content is up to which missions you are able to get your hands on.\nThe community has tons of missions and mods available.\n\nI play with a community where we have enough mission makers to pump out new custom missions every week, which brings a never ending stream of new content.\nThe people you play the game with also makes a lot of the experience.\nYou might shoot some baddies and get some objectives, but in the end you romp around and talk junk with your friends.\n\n10/10 experience if you look past the Arma jank.", "timestamp_created": 1698792180, "timestamp_updated": 1698792180, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "149278262", "author": {"steamid": "76561198081926274", "personaname": "gono", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198081926274/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 315459, "playti