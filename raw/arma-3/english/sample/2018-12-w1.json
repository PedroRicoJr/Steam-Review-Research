": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "47361143", "author": {"steamid": "76561198102527726", "personaname": "Johnny Enrico", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/JohnnyEnrico/", "num_games_owned": 386, "num_reviews": 69, "playtime_forever": 232623, "playtime_last_two_weeks": 0, "playtime_at_review": 151715, "last_played": 1680796826, "avatar": "bd8714b82ae6ee3a9a6d68d2aa24aa1e972c8be7"}, "language": "english", "review": "love this game spent almost 3000 hours on this game alone would buy it again if i could.", "timestamp_created": 1544200354, "timestamp_updated": 1544200354, "voted_up": true, "votes_up": 20, "votes_funny": 7, "weighted_vote_score": "0.654178857803344727", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "47358523", "author": {"steamid": "76561198523127420", "personaname": "hank_madness_", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198523127420/", "num_games_owned": 256, "num_reviews": 21, "playtime_forever": 60823, "playtime_last_two_weeks": 0, "playtime_at_review": 31097, "last_played": 1748164725, "avatar": "52e974f7a988c7d37ad831010d79efc9cecb2437"}, "language": "english", "review": "You want to drive tanks. Flying like a bird or rather a wild boar in the dirt? In Arma you can be everything from pilot to reconnaissance. The workshop leaves almost nothing to be desired: D", "timestamp_created": 1544195942, "timestamp_updated": 1544195942, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "47356580", "author": {"steamid": "76561198070306157", "personaname": "Hazo", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/sycosumatc_/", "num_games_owned": 239, "num_reviews": 7, "playtime_forever": 11313, "playtime_last_two_weeks": 60, "playtime_at_review": 3956, "last_played": 1790366533, "avatar": "82c79aa488da18c10e83f8bf1f2de598b8276680"}, "language": "english", "review": "I knew what to expect going into Arma III from previous experience with Bohemia Interactive games, yet I was still overwhelmed by the amount of features I had to wrap my head around before I could play it with even moderate proficiency. It’s a first-person shooter alright, but it’s not another “left trigger to aim down the sights, right trigger to shoot” kind of game. You’re going to have to use almost every key on your keyboard, memorize specific key combinations and what each does depending on whether you’re on foot, in a tank, a helicopter, etc.\n\n===[ Audience: ]=== \n☐ Kids\n☐ Everyone\n☐ Casual players\n☑ Pro players\n\nGreat game to play with a group that can orginise events, BUT this game sucks if you play alone and the huge learning curve for all the keybinds this game doesnt make is any better.\nBut I can for certain say that if you play this enough there will be amazing moments that you'll never forget and there a zues' out there that will make bloodly amazing missions the people you pick to play with really matters.\n\n┅¦ $ Price $ ¦┅ \n☐ Full price\n☑ Wait for sale\n", "timestamp_created": 1544192628, "timestamp_updated": 1544192628, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}