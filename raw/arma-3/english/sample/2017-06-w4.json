, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "33057021", "author": {"steamid": "76561198094249981", "personaname": "The Robotkiller", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198094249981/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 26150, "playtime_last_two_weeks": 0, "playtime_at_review": 2809, "last_played": 1591390770, "avatar": "4f9315a081ffd8e458bcab7822ec8e2083baed24"}, "language": "english", "review": "I played with my buddies. It was getting intense as the enemies pushed towards us. We were able to get a ammunition drop.  We saw the helicopter. Landed good enough. It was about to take off. Chrashed into some destroyed buildings. I got hit. I was really injured. Got to a medic. (He was busy). Came to mind \"oh wait, I can heal myself\". went to see my inventory and healing oppurtunities. BAM!!! I was unconscious. Were about to die. I could hear the medics talking about me, but they didnt hear me. It was needed 4 medics to help little me. :) Really love you guys <3\n\n11/10 Good teamwork!", "timestamp_created": 1498858969, "timestamp_updated": 1498858969, "voted_up": true, "votes_up": 2, "votes_funny": 2, "weighted_vote_score": "0.541666686534881592", "comment_count": 3, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}