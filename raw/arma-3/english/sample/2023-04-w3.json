atches in dialogue are negligible and the rest of the game brings immersion to your brain fully. It's impossible to not get sucked into Arma and Arma 4 can only be THAT MUCH better than this game already is. Full 10/10 all round.", "timestamp_created": 1682197555, "timestamp_updated": 1682197555, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "137134508", "author": {"steamid": "76561198812660066", "personaname": "M06Zilla", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198812660066/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 31718, "playtime_last_two_weeks": 0, "playtime_at_review": 20875, "last_played": 1779595872, "avatar": "09e3520372eb2de37902302ed977d69f3b984da7"}, "language": "english", "review": "much boom, very wow", "timestamp_created": 1682196997, "timestamp_updated": 1682196997, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}