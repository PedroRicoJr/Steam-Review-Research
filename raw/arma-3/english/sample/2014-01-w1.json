ove it.", "timestamp_created": 1389126152, "timestamp_updated": 1389126152, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "8610080", "author": {"steamid": "76561198066842855", "personaname": "BrokenRecord", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198066842855/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 599, "playtime_last_two_weeks": 0, "playtime_at_review": 417, "last_played": 1455588489, "avatar": "c9e9eae467125ea95af65fc09004506a75ed1ef7"}, "language": "english", "review": "this is a very good game that is worth what i paid for it.", "timestamp_created": 1389124320, "timestamp_updated": 1389124320, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "8609974", "author": {"steamid": "76561198043260361", "personaname": "hermao", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198043260361/", "num_games_owned": 169, "num_reviews": 2, "playtime_forever": 40091, "playtime_last_two_weeks": 0, "playtime_at_review": 8881, "last_played": 1773342016, "avatar": "d115a8efd13e8033367c87818e28d740c262d69a"}, "language": "english", "review": "So fun to play with friend\n", "timestamp_created": 1389123833, "timestamp_updated": 1389123833, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "8609553", "author": {"steamid": "76561197978523967", "personaname": "Hero93", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/best-trigger/", "num_games_owned": 0, "num_reviews": 56, "playtime_forever": 2804, "playtime_last_two_weeks": 0, "playtime_at_review": 1795, "last_played": 1726281338, "avatar": "44cbaaf8d7092119ebdcb76efb1b4f9615bdd4b9"}, "language": "english", "review": "This game is the closest thing you'll ever get to the real modern war! Realistic to the MAX! You also need a powerful pc (Like mine) in order to handle all the details in this game from the small leaves that fall off the trees as you shoot through them to pierce your enemy, to the small fishes that swim away as you approach your enemy's flank. This game is not easy to get the hang of, there is no rushing, no killstreaks, and especially no 12 year olds screaming for kills. This game makes a good use of your keyboard, thank you steam for making this game exclusive to pc gamers.", "timestamp_created": 1389122106, "timestamp_updated": 1389122106, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}