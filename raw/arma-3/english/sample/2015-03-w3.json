se_date": "1378969200", "reactions": []}, {"recommendationid": "15026558", "author": {"steamid": "76561198088712479", "personaname": "jimbo", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/JCaal/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 8810, "playtime_last_two_weeks": 0, "playtime_at_review": 614, "last_played": 1509060914, "avatar": "ea874fba1e868b71182293a8a851f2a19072f620"}, "language": "english", "review": "The game is great! It is a very realistic war simulator that I highly recommend. It makes Call of Duty look like dog poop. There are a lot of mods that are fun to play. You can do just about anything in this game, fly helos, drive quads, trucks, tanks, shoot people, and much more.  It just makes me mad that I bought it for $59.99 three days ago and today it is on sale for $29.99.\n\n11/10 Would pay full price again.", "timestamp_created": 1427150689, "timestamp_updated": 1427150689, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.5317535400390625", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}