34, "playtime_forever": 9069, "playtime_last_two_weeks": 0, "playtime_at_review": 7043, "last_played": 1639860612, "avatar": "3f1d30ba2d8416196fe68e1eac98f3793187ac25"}, "language": "english", "review": "The game is very good and very immersive. Totally recommend to find a good community (I was lucky and I found a great community) to play which are using mods (ACE mod completely changes how the whole game is played!). That being said, the game can have a lot of bugs and very poor performance, even in modern Ryzen CPUs. Unlike most games, they can be ignored and it may not always be fun, it gets more and more interesting each time you play and it gets harder and harder as you learn to really play each role in a team. \n\nTL;DR Totally recommend it if you belong in an ARMA community, it could have bad performance but it's easily ignored! 8/10", "timestamp_created": 1633043059, "timestamp_updated": 1633043059, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}