ed_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "61021571", "author": {"steamid": "76561198107460180", "personaname": "narwall14", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198107460180/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 154769, "playtime_last_two_weeks": 0, "playtime_at_review": 60912, "last_played": 1785794345, "avatar": "db367f7701524b721ec7abd1aa162e79dfbc6818"}, "language": "english", "review": "It's ok I guess....", "timestamp_created": 1577834634, "timestamp_updated": 1577834634, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "61021240", "author": {"steamid": "76561198839773430", "personaname": "rpk", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/rpkbutbetter/", "num_games_owned": 160, "num_reviews": 55, "playtime_forever": 87, "playtime_last_two_weeks": 0, "playtime_at_review": 64, "last_played": 1742169876, "avatar": "42c438f5c98429ed04801c2c15394ce4a9905eb4"}, "language": "english", "review": "[h1] Probably one of the worst shooters out there [/h1]\n[u] In a nutshell: [/u]\nArma 3 is a military simulator, a very realistic shooter with one of the biggest maps you'll ever see.\nYou'd think these are already reasons to think this is a good game...well no.\nIm stating the pros and cons now:\n\n[h2] Pros: [/h2]\n-Big map\n-Lots of content\n-Multiplayer experience\n-Hours on top of hours of gameplay\n-Realistic \n [h2] Cons: [/h2]\n-Terrible performance issues for a 2015 game\n-Graphics suck ass, that in hand with the performance is just disappointing\n-Sounds suck ass\n-Its so frustrating, that i feel the need to say it again, the performance is crap even on high end pc's\n-Too realistic, turning it unfun\n-Controls super difficult to learn\n-Driving is awful\n-Slow paced gameplay, no dynamic at all, turning it boring\n-Man im serious, even in the first tutorial without terrain i had stuttering some times, the performance sucks!\n-Servers in NA and SA are compltely unexisting sadly \n-Uninteresting story\n-♥♥♥♥♥♥♥♥ Performance\n\nBasically if this game had a better campaign and it had a better performance i would not be so judging about the rest, because its not  a big deal, but the stuttering and boring gameplay makes me want to close the game every tiime. sad \n\n[spoiler] Soap dies in the end :c [/spoiler]\n\n[h1] Score: [u] 5/10 [/u] [/h1]", "timestamp_created": 1577834212, "timestamp_updated": 1577982632, "voted_up": false, "votes_up": 2, "votes_funny": 2, "weighted_vote_score": "0.461559265851974487", "comment_count": 6, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "61020587", "author": {"steamid": "76561198129132467", "personaname": "Squid", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198129132467/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 61412, "playtime_last_two_weeks": 0, "playtime_at_review": 16107, "last_played": 1658435153, "avatar": "29ea1142f004525938bcfcffbb476769c0f7892b"}, "language": "english", "review": "She's pppuuurrrttyyyy guuuuuudddd", "timestamp_created": 1577833263, "timestamp_updated": 1577833263, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primar