47384262085", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "13171775", "author": {"steamid": "76561198121546453", "personaname": "Higgo", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Higgoz/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 190678, "playtime_last_two_weeks": 0, "playtime_at_review": 18048, "last_played": 1726788338, "avatar": "9bab4712685430c44ac1ddb5354829e784d1684f"}, "language": "english", "review": "One of the best FPS games out there, highly recomend this to any one in need of a change from the usual, close quarters Call of duty type games.", "timestamp_created": 1417386131, "timestamp_updated": 1417386131, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.528634369373321533", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "13171075", "author": {"steamid": "76561198075153334", "personaname": "Luke", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/LukeM99/", "num_games_owned": 100, "num_reviews": 10, "playtime_forever": 123012, "playtime_last_two_weeks": 0, "playtime_at_review": 5735, "last_played": 1777665279, "avatar": "aee738f54e5e184b0cabdee89e11ac3459b381d3"}, "language": "english", "review": "excellent game, 10/10- excellent graphics and gameplay if you get this you must try altis life and king of the hill they are both excellent gamemodes and you get alot of action from them, Would recommend this game to anyone", "timestamp_created": 1417383370, "timestamp_updated": 1417383370, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "13171062", "author": {"steamid": "76561198054536204", "personaname": "G0LDF1SH", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/G0LDF1SH_ZA/", "num_games_owned": 161, "num_reviews": 2, "playtime_forever": 8545, "playtime_last_two_weeks": 0, "playtime_at_review": 5894, "last_played": 1574539257, "avatar": "d1c68323e48d80e5ba3d2eb75b0c79b1c7d9f00a"}, "language": "english", "review": "Want to sneak around in a camo suit and sabotage the enemy's base from afar? Want to drive into the enemy base with a tank, pockets loaded with explosives and heavy weaponry? Or do you just feel like transporting your allies to key strategic positions for today? Well, the good news is that in Arma 3, you can do all of that and more.\n\nThis game was designed to be a sandbox military simulator, and it is just that. The beauty of it, is that it's not locked to either small-scale fast-paced run and gun or massive scale 24-hour battles. It can be both those things, and everything in between due to fantastic modding and custom map-creation tools that every player has access to. I haven't taken much of a look at the campaign, but to  be honest, the Arma series was never really created for its campaign. Multiplayer is excellent, graphics are excellent. What else is there to say? Just make sure you have a beast of a PC if you want to run it on ultra-high settings.", "timestamp_created": 1417383332, "timestamp_updated": 1417383332, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}