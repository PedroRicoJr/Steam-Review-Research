ersona_status": "offline", "profile_url": "https://steamcommunity.com/id/slothhyrule/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 229, "playtime_last_two_weeks": 0, "playtime_at_review": 229, "last_played": 1513350516, "avatar": "2939e7b7d8e209d64efac078c781299874f8ca6c"}, "language": "english", "review": "Don't", "timestamp_created": 1567279244, "timestamp_updated": 1567279244, "voted_up": false, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": "0.382610172033309937", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "54906785", "author": {"steamid": "76561197970000282", "personaname": "lunaticpandora(philjo)", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/lunaticpandora/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 40179, "playtime_last_two_weeks": 0, "playtime_at_review": 32734, "last_played": 1739470658, "avatar": "ca2c5591c1ef1c9883ea47a2fe058eb8552c264a"}, "language": "english", "review": "This is in my top 5 military sims ever played. It has subtly done futuristic elements  with military vehicles and weapons closely based on existing real world weapons.\nIt's very stable, has astronomical levels of workshop content and looks excellent.\n\nThe maps are huge and detailed which provide near endless variety for tactical situations.\n\nThe vehicles are superb to control, a great balance with options between semi sim arcade or even high complexity sim.\n\n There is a decent variety of weapons with attachments and firing modes.\n\nOn it's own, I didn't really enjoy the game campaign. But the scenario editor is amazing. The foundational gameplay this game provides is incredible. Combined with survival type mods and progression, you can invest time in building persistent bases and arsenals from which to base your operations. Multiplayer with friends will create memorable moments.\nOverall this game gets 9 out of 10 from me.\n\nPros:\nThe futuristic setting is subtle and believable, not overcooked in the slightest.\nModding and workshop community is rich & massive.\nGraphics can be changed to suit many levels of capability, and are very good quality.\nSounds are immersive and realistic.\nThe scenario editor is easy to use and great fun to test out all the game assets.\nHuge detailed maps.\nTaking down that enemy heli with a well placed armor piercing shot to the cockpit while your friend stares agape is priceless and you'll get moments like this in this game.\n\nCons: \nSome DLCS can be a bit on the pricey side.\nAwkward disorienting single player campaign, at times extremely hard,  and generally bad pacing.\n", "timestamp_created": 1567278638, "timestamp_updated": 1567278638, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "54903432", "author": {"steamid": "76561198391539154", "personaname": "Kek9", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198391539154/", "num_games_owned": 75, "num_reviews": 13, "playtime_forever": 556, "playtime_last_two_weeks": 0, "playtime_at_review": 58, "last_played": 1689649104, "avatar": "8d24569c36edf575d61aa8475e15051e1e223b8b"}, "language": "english", "review": "good shooty shoot game lul", "timestamp_created": 1567264876, "timestamp_updated": 1567264876, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}