endationid": "68758549", "author": {"steamid": "76561198045785792", "personaname": "RG_Haywire", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198045785792/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 11732, "playtime_last_two_weeks": 0, "playtime_at_review": 9575, "last_played": 1623956761, "avatar": "f4c9d6393d9bf5a439dbac06f937923d6db5a8a3"}, "language": "english", "review": "Hands down.. the best community driven and accurate MilSim out there.  There are mods out there for everything from lighting to Aircraft.. AI Tweaks and Uniforms... the list is endless.  The learning curve is just that..  but once you get in and get the mechanics of movement and vehicle operation.. you will see why this game has been around so long.  A Joystick is ALOT easier for manipulating aircraft and driving.. but you can still do it with mouse and keyboard. A VR Headtracker will help a ton while in cockpit.  If your looking for something other then the 1000 Mph run and gun make believe shooters.. and a game you can truly immerse yourself in.. LOOK NO FURTHER.  With a truly friendly and helpful community base.. it is the least volatile game community i have come across in years.", "timestamp_created": 1588891204, "timestamp_updated": 1588891204, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "68757925", "author": {"steamid": "76561198049511553", "personaname": "Wraithlord", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198049511553/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 33917, "playtime_last_two_weeks": 0, "playtime_at_review": 31705, "last_played": 1598134932, "avatar": "cf32e64cc7ec533160bfe67da172047a65f