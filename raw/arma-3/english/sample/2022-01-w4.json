{"game": "arma-3", "language": "english", "appid": 107410, "month": "2022-01", "window": 4, "start_date": 1642982400, "end_date": 1643673599, "month_true_total": 1317, "quota": 5, "returned": 5, "pulled_at": "2026-10-09 11:14:15 UTC", "reviews": [{"recommendationid": "109213704", "author": {"steamid": "76561198062877962", "personaname": "Bread", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198062877962/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 165695, "playtime_last_two_weeks": 0, "playtime_at_review": 130309, "last_played": 1758806948, "avatar": "6bc12292b3d6e3cf5a6e9667b9b48edbb0c84a44"}, "language": "english", "review": "If you're looking for a game that can give you anything from small scale special ops missions, to massive campaigns that take days to complete, this is the game for you. The modding community for this game is truly massive, you can write your own scripts and cut scenes, and the code library available to mission makers is nothing short of massive. This game looks superb, but runs like dog doo. It's mostly locked to a single CPU core. For reference, I have an RTX 3090 and 8700k @ 5GHz, but I still dip to 20-30 FPS at times no matter the graphics settings. It's just something you'll have to deal with, unfortunately. If you can look past that issue, this is truly an amazing game. May you have 1000's of hours of enjoyment and tales like I do.", "timestamp_created": 1643672888, "timestamp_updated": 1643672888, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523614108562469482", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "109213062", "author": {"steamid": "76561198865504458", "personaname": "Penguin811", "persona_status": "offline", "profile_url": "https://steamcommunity.com/p