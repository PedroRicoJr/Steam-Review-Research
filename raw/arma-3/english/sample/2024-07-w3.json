or": {"steamid": "76561199111266458", "personaname": "KFC", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199111266458/", "num_games_owned": 0, "num_reviews": 85, "playtime_forever": 1091, "playtime_last_two_weeks": 0, "playtime_at_review": 198, "last_played": 1740897285, "avatar": "101649ef43ae6940ecff603b964e3f378078525e"}, "language": "english", "review": "yes", "timestamp_created": 1721777981, "timestamp_updated": 1721777981, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "170588991", "author": {"steamid": "76561198452439395", "personaname": "jacelmoffett", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198452439395/", "num_games_owned": 86, "num_reviews": 18, "playtime_forever": 428, "playtime_last_two_weeks": 0, "playtime_at_review": 392, "last_played": 1722276193, "avatar": "8dc62b81b3175aa2c36357a658683e339b03a75f"}, "language": "english", "review": "I'm getting cooked", "timestamp_created": 1721776551, "timestamp_updated": 1721776551, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}, {"recommendationid": "170588329", "author": {"steamid": "76561199047003458", "personaname": "NINE TλILED FOX", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199047003458/", "num_games_owned": 174, "num_reviews": 49, "playtime_forever": 6667, "playtime_last_two_weeks": 0, "playtime_at_review": 1210, "last_played": 1779401237, "avatar": "725bacf57f6cc2c43ccf5be83cb6c56051d099cd"}, "language": "english", "review": "I bought this game on the Steam summer sale and I was able to get it for only 2 bucks. Well, ARMA 3 is one of the most relevant MilSims nowadays, its community is still alive in 2024, more than 10 years later. \n\nIt has a single player campaign as well as online gamemodes, my favorite being KOTH (King Of The Hill), This gamemode consists of 3 factions (BLUFor, OPFor and Independent) trying to capture and keep a city in the map. People also play role-playing servers, though I never played them. \n\nThe game has some DLCs, they add content such as planes, cars, weapons and etc to the game. The game also has its workshop page, most of the mods focus on historical backgrounds, even including wars you don't see too much in other games, such as the Falklands War, the Korean War, Soviet-Afghan War and the Iran-Iraq War.\n\nThe game runs pretty good on my Intel UHD Graphics 620 from 10 years ago, which I wasn't expecting. I thought this game would have pretty complicated mechanics, but they are actually not really hard or anything, though be willing to learn.\n\nOverall, It's a pretty good game with realistic mechanics, I mean, just search up how Arma 3's bullet system works. The game is still going strong after a decade and there's a reason for it.", "timestamp_created": 1721775676, "timestamp_updated": 1723415768, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}