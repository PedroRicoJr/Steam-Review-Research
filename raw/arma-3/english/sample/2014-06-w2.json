rsona_status": "offline", "profile_url": "https://steamcommunity.com/id/nolanrdr/", "num_games_owned": 187, "num_reviews": 1, "playtime_forever": 61092, "playtime_last_two_weeks": 0, "playtime_at_review": 8557, "last_played": 1591288989, "avatar": "fd55b2377aec648bde5fb157462b73175575d145"}, "language": "english", "review": "This game goes above and beyond. The way you play the game is completely up to you. If you want to be in a big ass artillery piece than you can do it. if you wanna fly guns and provide close air support than you can do it. You can roll into a town in a big ass tank and blow ♥♥♥♥ up or you can kill a high-value target from over a mile away. It's up to you. With a map of 270 square kilometers the playing field is huge. If you though battlefield maps were big, it's time to put your big-boy pants on. Arma 3 is by far the best shooter/milsim there is. BUY IT", "timestamp_created": 1402855582, "timestamp_updated": 1402855582, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1378969200", "reactions": []}]}