{"game": "gunfire-reborn", "language": "english", "appid": 1217060, "month": "2020-08", "window": 2, "start_date": 1596844800, "end_date": 1597535999, "month_true_total": 1605, "quota": 11, "returned": 11, "pulled_at": "2026-09-27 01:47:21 UTC", "reviews": [{"recommendationid": "74373485", "author": {"steamid": "76561198048129544", "personaname": "OreoSalad", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/zack2070/", "num_games_owned": 0, "num_reviews": 30, "playtime_forever": 5741, "playtime_last_two_weeks": 0, "playtime_at_review": 2176, "last_played": 1681872858, "avatar": "4f7bcfd19d6cfaec1b48a8d5b6512100e46b3059"}, "language": "english", "review": "Very fun game\n\nThink borderlands mixed with Risk of Rain and the regular updates have been very refreshing!\nWell worth the current price so get it while it's cheap.\n\n\n\nUpdate: They added a new character and he's pretty slick", "timestamp_created": 1597533127, "timestamp_updated": 1599235612, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "74372252", "author": {"steamid": "76561198119244217", "personaname": "Cathulhu", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198119244217/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 3892, "playtime_last_two_weeks": 0, "playtime_at_review": 324, "last_played": 1753667587, "avatar": "115e34d60299cea7558ecddb2351604aa96ac04b"}, "language": "english", "review": "Extremely fun game, except the bosses are VERY frustrating. You make one mistake and you are just DEAD. Looking at Sand Worm.", "timestamp_created": 1597530831, "timestamp_updated": 1597530831, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "c