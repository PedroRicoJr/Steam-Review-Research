se": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "74367799", "author": {"steamid": "76561198043058958", "personaname": "Rad Raccoon", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/poopybottom/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 2400, "playtime_last_two_weeks": 0, "playtime_at_review": 522, "last_played": 1725910037, "avatar": "c81187e84206749ff9993abe0590a634ede9bb55"}, "language": "english", "review": "Great game for early access, the guns work on a borderlands type system with randomized properties.\nThe difficulty spikes associated with the 3 zones can be a little jarring but it's not too bad that it feels unfair.\nThe 2 currently playable characters are completely different with different upgrades, giving plenty of variety.\nReally excited to see what they do with this game in the future!", "timestamp_created": 1597523457, "timestamp_updated": 1597523457, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.506061971187591553", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "74367705", "author": {"steamid": "76561198121361764", "personaname": "ᴵ ᶜʳᵃᵛᵉ ᴹᵘˢˢʸ", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/mooneymoons/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 9130, "playtime_last_two_weeks": 0, "playtime_at_review": 1140, "last_played": 1770527861, "avatar": "37cf1dc1f48ac849fb89a0b11182816609a9e6eb"}, "language": "english", "review": "pew pew", "timestamp_created": 1597523305, "timestamp_updated": 1597523305, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "74367225", "author": {"steamid": "76561198416799740", "personaname": "laserboss44", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198416799740/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 2377, "playtime_last_two_weeks": 0, "playtime_at_review": 141, "last_played": 1665980944, "avatar": "b8c93317a3a238f8f7f95b45881e9a0b0d484fdf"}, "language": "english", "review": "amazing game, a bit short on content as far as weapons and heroes go, but its early access so its excusable. This game won't top my hours on ror2 or dead cells or anything like that, but it is a blast and even more so with friends. DEFINITELY worth 12 USD and holds a respectable place in my library. Amazing job Hong Kong Interactive. \n", "timestamp_created": 1597522608, "timestamp_updated": 1597522608, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.506061971187591553", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "74365436", "author": {"steamid": "76561198262378586", "personaname": "Togan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/_Togan_/", "num_games_owned": 0, "num_reviews": 18, "playtime_forever": 3050, "playtime_last_two_weeks": 0, "playtime_at_review": 813, "last_played": 1629919177, "avatar": "1b5f6a8081b3a41aba586a1c46386e1aa9b625b6"}, "language": "english", "review": "Incredibly fun and addictive FPS Roguelite. Nice visual design and satisfying combat. Runs well with stable 60+ FPS @1080p on my GTX 1650 laptop and over 240 FPS @1440p on a GTX 1080 Ti desktop.\n\nMy only gripe is that I wish there was more variety in starting levels sort of like Dead Cells. You play the same levels in the same order each time. Despite the lack of level variety, there is a good amount of enemy types, which in different combos keep the gameplay fresh and interesting.\n\nIn its current state, it's and 8 to 8.5/10 for me; mainly due to lack of level variety. With more content, this is easily a 9/10 game. I'm having a blast.", "timestamp_created": 1597519936, "timestamp_updated": 1597537212, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": [{"reaction_type": 19, "count": 1}]}, {"recommendationid": "74365074", "author": {"steamid": "76561198047007583", "personaname": "BLACKBEARD", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198047007583/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4674, "playtime_last_two_weeks": 0, "playtime_at_review": 2516, "last_played": 1652194110, "avatar": "3033467236e88d3ab0adaff484caaf9903d18e09"}, "language": "english", "review": "Buy it ♥♥♥♥♥♥", "timestamp_created": 1597519376, "timestamp_updated": 1597519376, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "74361594", "author": {"steamid": "76561199067132050", "personaname": "budder", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199067132050/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 13851, "playtime_last_two_weeks": 0, "playtime_at_review": 1