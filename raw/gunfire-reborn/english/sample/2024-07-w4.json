: {"steamid": "76561199576382165", "personaname": "Boom man", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199576382165/", "num_games_owned": 36, "num_reviews": 22, "playtime_forever": 1290, "playtime_last_two_weeks": 0, "playtime_at_review": 929, "last_played": 1751060959, "avatar": "ad005700acacc95ac29e03985930975e4ab44529"}, "language": "english", "review": "cool", "timestamp_created": 1722440102, "timestamp_updated": 1722440102, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "171154399", "author": {"steamid": "76561197994076549", "personaname": "Scribbles", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/djscribbles/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 1884, "playtime_last_two_weeks": 0, "playtime_at_review": 1594, "last_played": 1770176436, "avatar": "fc0fd8c7293575f02dd0c42cb2ee15a2ce2b4bcc"}, "language": "english", "review": "Edit: I haven't had a chance to test this but the patch notes report my primary complaint was fixed, so I've changed my review\n\nThis game is tons of fun. But it's got a fatal flaw that the devs completely ignore.\nIt's a 2+ hour long game where anyone who disconnects/game-crashes/etc has no ability to reconnect, and the player slot cannot be filled. There is a short (60sec IIRC) lag grace period before a player is removed from the game, which is a very poor attempt to address the issue, since it only works for short lag spikes (and even then it is iffy if it works)\nIn my experience most multiplayer games have had this happen to at least one player. Usually it cripples the run, and definitely kills the fun when you lose a friend.\n\nSearch the forums, you'll see it frequently requested and never addressed. Some of the community even tries to pretend it will be bad for the game somehow if this is fixed. I won't recommend the game unless it's added. If it were here, the game is extremely fun, and an easy recommend for co-op fun, but it's just an exercise in \"how can technical issues ruin a night\".", "timestamp_created": 1722421332, "timestamp_updated": 1740628217, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.713971495628356934", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": [{"reaction_type": 9, "count": 1}, {"reaction_type": 22, "count": 1}]}, {"recommendationid": "171152203", "author": {"steamid": "76561199466752752", "personaname": "heysweethanggg", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199466752752/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 9362, "playtime_last_two_weeks": 0, "playtime_at_review": 8500, "last_played": 1764139185, "avatar": "f0f14d001cc62e3da040933f1101b9a27e9fa1f4"}, "language": "english", "review": "fun", "timestamp_created": 1722418269, "timestamp_updated": 1722418269, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.54356849193572998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": [{"reaction_type": 32, "count": 1}]}]}