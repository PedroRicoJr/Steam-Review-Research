ndationid": "115516408", "author": {"steamid": "76561198272013710", "personaname": "ThatJesusFreak9", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198272013710/", "num_games_owned": 0, "num_reviews": 60, "playtime_forever": 3740, "playtime_last_two_weeks": 0, "playtime_at_review": 1588, "last_played": 1764102915, "avatar": "d270b5085e1ff3c13174db6c761615f18ae25021"}, "language": "english", "review": "fun", "timestamp_created": 1652643780, "timestamp_updated": 1652643780, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "115515519", "author": {"steamid": "76561198026804935", "personaname": "DrColdHands", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198026804935/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 1165, "playtime_last_two_weeks": 0, "playtime_at_review": 854, "last_played": 1653018887, "avatar": "b2a52cfba01fc8be5a5c488a7a3c74a8829f1e63"}, "language": "english", "review": "Game is totally worth the asking price. Great opportunities for weapon and build variety between runs, good progression path, and the core gameplay is just fun. If you're looking for a game to satisfy that \"just one more run\" itch, this is it.", "timestamp_created": 1652642684, "timestamp_updated": 1652642684, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "115510203", "author": {"steamid": "76561198012250134", "personaname": "Breghyn", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198012250134/", "num_games_owned": 249, "num_reviews": 5, "playtime_forever": 11257, "playtime_last_two_weeks": 0, "playtime_at_review": 8306, "last_played": 1778995697, "avatar": "125e1f493c4fceecc442e9835765ca973991616e"}, "language": "english", "review": "I really enjoy Gunfire Reborn. Here is my Pro/Con list.\n\n----Pro-----\n- Replay-ability is very high due to different characters, difficulty levels, different weapons, and different skills that all allow you to test out different builds\n- Every character **feels** pretty different. They also each have unique skills that naturally lend some synergy to certain builds, which allows newbies to have *some* direction\n- Gameplay actually feels very smooth and fun and doesn't feel janky like in some other games.\n- Enemy variety is pretty high - snipers, flyers, chargers, aoe, summoners - and that means that people on your team can prioritize the monsters they're best equipped to handle. It helps everyone feel like they can bring something to the table.\n- It's not timed! Go at your own pace. Do you want a leisurely game that challenges your aim on a lazy Sunday afternoon? Go the tiger + sniper build. Do you want an adrenaline rush, fast paced game? Go the turtle tackle build.\n- It has built-in save points during a run unlike other games in the genre. So you can save ~10-20 minutes after a biome.\n\n----Con----\n- The graphics are very simple and sometimes that gets a bit boring\n- If you're a min-maxer, you'll \"solve\" and choose a build that does extremely well. (e.g. sniper, tri-elemental) Some builds are just superior.\n\n", "timestamp_created": 1652635979, "timestamp_updated": 1652635979, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}