new gun offers a new play style encouraging the player to reevaluate potential synergies and novel tricks.\n\nThe game purposely holds back all it has to offer in a tight progression, keeping things very fresh. I don't expect the game to get old for a while yet, even as players progress into endgame.\n\nThe feedback system is surprisingly accessible, \n\nIt's worth every penny, even for early access 12 bucks criminally under priced. \n\nPick it up, and grab some friends.", "timestamp_created": 1590967691, "timestamp_updated": 1637286770, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "70120313", "author": {"steamid": "76561197997580947", "personaname": "Wind", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/xpoir/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 4384, "playtime_last_two_weeks": 0, "playtime_at_review": 650, "last_played": 1777810881, "avatar": "ee5cc428258a2f7f5775ae66f8bbcde744738e44"}, "language": "english", "review": "Boarderland?", "timestamp_created": 1590967424, "timestamp_updated": 1590967424, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}