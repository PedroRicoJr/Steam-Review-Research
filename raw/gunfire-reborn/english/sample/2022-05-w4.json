rimarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "116288163", "author": {"steamid": "76561197972618103", "personaname": "Skie", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/skied/", "num_games_owned": 0, "num_reviews": 44, "playtime_forever": 6111, "playtime_last_two_weeks": 0, "playtime_at_review": 1590, "last_played": 1776370522, "avatar": "c1b19f109f77ba9c4981c40f81f661486e35b7da"}, "language": "english", "review": "This is a good co-op game which scales well to 2-4 players. \n\nIf you have a few friends who want to invest a few dozen hours into a medium-to-fast paced fps gameplay loop where you level up and loot better gear as you go, this one's for you. Permanent character empowering unlocks between runs, 6 hero classes, additional difficulty levels, new unlockable bosses and weapons keep the game interesting. Once you start sharing the loot intelligently during runs to tailor broken builds, it gets really fun.", "timestamp_created": 1654005799, "timestamp_updated": 1654005840, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "116285407", "author": {"steamid": "76561199090679907", "personaname": "mka", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/mk4kun/", "num_games_owned": 69, "num_reviews": 2, "playtime_forever": 7290, "playtime_last_two_weeks": 0, "playtime_at_review": 3895, "last_played": 1767885449, "avatar": "4a038f5e1e8e8722cdff327749107f5535c0faab"}, "language": "english", "review": "nice game", "timestamp_created": 1654001171, "timestamp_updated": 1654001171, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "116283453", "author": {"steamid": "76561198014720049", "personaname": "Flashflood8", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Flashflood8/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 5225, "playtime_last_two_weeks": 0, "playtime_at_review": 2884, "last_played": 1714177914, "avatar": "74c3e007cf52909a5d054ad448bc012fc035e50f"}, "language": "english", "review": "Great skill progression and weapon selections. Each character seems to have a distinct play style that suits it best, so they can take a while to get used to, but it's like riding a bike and it's easy to come back to. Very fun and chill game overall.", "timestamp_created": 1653997298, "timestamp_updated": 1653997298, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}