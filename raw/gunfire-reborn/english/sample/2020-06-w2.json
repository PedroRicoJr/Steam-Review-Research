e": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "70844224", "author": {"steamid": "76561197970623720", "personaname": "Schmelon Ma Schnuts", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/cleverjohn/", "num_games_owned": 262, "num_reviews": 20, "playtime_forever": 2263, "playtime_last_two_weeks": 0, "playtime_at_review": 478, "last_played": 1749781463, "avatar": "2f164f7863d1fb98b8eb77d72b222174ede051d3"}, "language": "english", "review": "7 hours into play. Can't get enough of it. Every run is a challenge.", "timestamp_created": 1592254301, "timestamp_updated": 1592254301, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "70843810", "author": {"steamid": "76561197996297444", "personaname": "Gumby", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197996297444/", "num_games_owned": 0, "num_reviews": 319, "playtime_forever": 4866, "playtime_last_two_weeks": 0, "playtime_at_review": 2201, "last_played": 1593904063, "avatar": "8fecc75b474d7207fe6943aa737e8bd4e8f6622b"}, "language": "english", "review": "This is a great co-op game, despite the poor English (which at times makes deciphering what weapons and items actually do quite hard). Unlike most games these days, this game is actually difficult. If you can't handle difficult games you probably won't like this because there's no difficulty selection, you have to actually work at improving your character before you have any hope of completing it.", "timestamp_created": 1592253574, "timestamp_updated": 159225