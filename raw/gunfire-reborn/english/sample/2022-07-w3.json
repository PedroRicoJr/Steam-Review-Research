, {"recommendationid": "119345798", "author": {"steamid": "76561198271932257", "personaname": "ILuvPopeyes", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198271932257/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 5015, "playtime_last_two_weeks": 0, "playtime_at_review": 2910, "last_played": 1747455391, "avatar": "81f20ff8ad1bfd57dee67577e05b2742d460152b"}, "language": "english", "review": "This game is dope, I want more.", "timestamp_created": 1658611868, "timestamp_updated": 1658611868, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "119334767", "author": {"steamid": "76561198055181574", "personaname": "Drumbas", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198055181574/", "num_games_owned": 0, "num_reviews": 274, "playtime_forever": 578, "playtime_last_two_weeks": 0, "playtime_at_review": 578, "last_played": 1643481386, "avatar": "5b8825b34c5d77b00c3a18897f2f1175fa0e0e57"}, "language": "english", "review": "Gunfire Reborn is a fun 3D FPS Roguelite. Getting upgrades feels fun and every run can feel pretty different from the last if you actually try for it. Game rewards exploration as well which is nice to see. Enemy designs are diverse and overall pretty fun. Characters change up the game drastically. There is even multiplayer if you are into that. Guns are fun and have a lot of modifiers that can change the game up drastically, I do wish it was a bit easier to process the modifiers easily but these are overall still a really fun part of the game.\n\nMy 2 biggest complaints is that the game can get so chaotic to the point that you feel like you die randomly in 1 hit, its hard to tell when you get hit and there is very little stopping enemies from just killing you instantly at some point in the game. My other complaint is that there is a really annoying skill tree that takes a very long time to fill in. That skill tree very clearly gives you a huge advantage at times and feels like a major time sink rather then a fun part of the game.\n\nBesides that I think this is a very fun game that can offer quite a lot of replay time for a low price. Overall fun and worth your time.", "timestamp_created": 1658598030, "timestamp_updated": 1658598132, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "119333631", "author": {"steamid": "76561198072785428", "personaname": "Zamboni", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198072785428/", "num_games_owned": 220, "num_reviews": 17, "playtime_forever": 6462, "playtime_last_two_weeks": 0, "playtime_at_review": 3967, "last_played": 1751758252, "avatar": "d42cfd115aa2df8f1ffad8e40cd09566596c6470"}, "language": "english", "review": "Scratches the itch that many roguelike games try to achieve. Strong community and is well supported by devs. Borderlands-esque shooting and looting with lots of room for making each run feel unique between the character selection and item pick-ups.", "timestamp_created": 1658596690, "timestamp_updated": 1658596690, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}