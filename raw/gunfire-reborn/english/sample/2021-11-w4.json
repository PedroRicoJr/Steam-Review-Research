vote_score": "0.52173912525177002", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "104903085", "author": {"steamid": "76561198035244735", "personaname": "voltzila", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/voltzila/", "num_games_owned": 398, "num_reviews": 17, "playtime_forever": 6828, "playtime_last_two_weeks": 0, "playtime_at_review": 1338, "last_played": 1780797589, "avatar": "b2618ceac583d323e3daf66ab68d140a03a5b827"}, "language": "english", "review": "Borderlands rougelite with cute animals, whats not to love?", "timestamp_created": 1638311411, "timestamp_updated": 1638311411, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "104902331", "author": {"steamid": "76561198033656300", "personaname": "Cardonas", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ncard4/", "num_games_owned": 349, "num_reviews": 5, "playtime_forever": 10687, "playtime_last_two_weeks": 0, "playtime_at_review": 7328, "last_played": 1726346533, "avatar": "e2992627969be814f9b5c880626fc936708f1d3f"}, "language": "english", "review": "Fantastic rogue-like shooter that combines dungeon running with borderlands-style combat. Varied enemies and as much build diversity as you can manage to get away with.", "timestamp_created": 1638310919, "timestamp_updated": 1638310919, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "104902262", "author": {"steamid": "76561198042852071", "personaname": "SlimeJesus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/SlimeJesus/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 7906, "playtime_last_two_weeks": 0, "playtime_at_review": 7586, "last_played": 1686182714, "avatar": "885c4029fff92a6978617e0b730bcf245df812bb"}, "language": "english", "review": "I picked up on Gunfire Reborn early, back when there was only two characters and a handful of bosses. Seeing how the developer has continuously listened to feedback, implemented balance patches, added now four new characters, and several bosses I can confidently say that this game is a strong recommendation. It's no longer the niche early access game that I had to pester my friends to play with me locally due to how laggy and unresponsive the online could be. Instead it is an extremely fun looter shooter with a core gameplay loop that never seems to get old no matter how many times I play.\n\nI would highly recommend this game to any fan of first person shooters looking for a fun challenge, or rouge-like fans who want to try out a deceptively simple shooter. The constant updates and balancing means that the current state of the game is always changing, and if you burn yourself out just wait a week to month and you'll have almost a completely different game to play.", "timestamp_created": 1638310876, "timestamp_updated": 1638310876, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "104901716", "author": {"steamid": "76561198178656242", "personaname": "Zxeno", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198178656242/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 5827, "playtime_last_two_weeks": 0, "playtime_at_review": 3783, "last_played": 1684729994, "avatar": "31bd184d6229c1bc2da4dba72af073130fcaf167"}, "language": "english", "review": "this game is really fun with friends", "timestamp_created": 1638310525, "timestamp_updated": 1638310525, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "104901075", "author": {"steamid": "76561198040014671", "personaname": "PizzaCutterz", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198040014671/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 23442, "playtime_last_two_weeks": 0, "playtime_at_review": 5491, "last_played": 1788580037, "avatar": "4886e82d574736d74317b3351d9577e1a565ce36"}, "language": "english", "review": "I'm been play this off and on for a couple years now watching it grow from EA to release. This game has grown alot, adding guns/swords, and scrolls (basically buffs that affect your run, from boosted damage/move speed, to giving you tough choices like: Do i skip the scroll that doubles crit damage, but halfs bodyshot?) Sometime a single scroll can define your run.\n\nI'v had alot of fun with this game and you always feel like your progressing, getting stronger both statwise with the standard style talent tree, and learning how some enemies can ruin ur ♥♥♥♥ if your not careful. (Exploding lanturn trauma flashbacks)\n\nThe dev's have worked hard to make this game great, its got a wonderful style and sound, you can hear death coming most times. As well making big changes to the game such as completely reworking the \"angelic aura\", my most hated gun into something i will pickup rarely but enjoy while i have it. Overall, it feels very borderlands 2 with alot of concepts that bleed over. (the \"gunzerker\" dog had a lvl up that gives him \"double the fun\" tossing 2 grenade for the cost of 1) This is a game i will keep coming back to, just to enjoy a random fun run to see what happens. Maybe one day i'l try the multiplayer!", "timestamp_created": 1638310135, "timestamp_updated": 1638310314, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}