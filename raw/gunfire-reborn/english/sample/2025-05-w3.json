teamid": "76561197986372053", "personaname": "Tyflyias", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561197986372053/", "num_games_owned": 685, "num_reviews": 27, "playtime_forever": 11654, "playtime_last_two_weeks": 85, "playtime_at_review": 8132, "deck_playtime_at_review": 50, "last_played": 1789412499, "avatar": "608b1c13dc7169951af9a62f999b9bf2a9788515"}, "language": "english", "review": "still getting updates.", "timestamp_created": 1748029372, "timestamp_updated": 1748029372, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "195492459", "author": {"steamid": "76561198116641786", "personaname": "Not Flaptoad 🐸", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/flaptoad/", "num_games_owned": 248, "num_reviews": 16, "playtime_forever": 1109, "playtime_last_two_weeks": 0, "playtime_at_review": 1109, "last_played": 1749661089, "avatar": "544dce14540c1d6103f22f4dc73c8900d8f47a4a"}, "language": "english", "review": "Poorly balanced game.\n\nOn higher difficulties, most builds just don't work, and builds that do work are OP meta stuff that just instantly clears entire rooms. That is if you get lucky and RNG actually gives you the stuff you need for the build. Usually roguelikes have other means to build your characters that aren't affected by RNG or you get multiple means to manipulate even bad RNG in your favor. And roguelites usually just don't put this much effort on RNG and instead allow mechanical skill expression to mitigate bad RNG.\nThis game has mechanical skill expression in the form of dodging enemy attacks and aiming. Your typical movement shooter stuff. But all of that just doesn't matter on higher difficulties because bosses and elite enemies have so much health and armor that you HAVE TO win the numbers game. And you win it by getting good RNG. And if you aren't, then you are not playing the game. It's just a glorified casino simulator and that's a shame because I actually love the amount of variety you can have with different characters, weapons, ascensions, etc. Unfortunately, all this variety goes out of the window because of bad balance.\n\nIt's also one of those games that has a tacked on co-op mode without actually being designed for co-op from the ground up. Eventually you will just have one player in the party getting lucky with RNG for their OP build and clearing all enemies instantly without allowing others to play the game.", "timestamp_created": 1748026870, "timestamp_updated": 1755674089, "voted_up": false, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.439230948686599731", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "195490037", "author": {"steamid": "76561198082481958", "personaname": "Dad", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198082481958/", "num_games_owned": 708, "num_reviews": 4, "playtime_forever": 6962, "playtime_last_two_weeks": 0, "playtime_at_review": 4657, "last_played": 1776133805, "avatar": "1fa48f3adeb9594213eb5579244b70f7430ff46e"}, "language": "english", "review": "Game is pretty good man", "timestamp_created": 1748024569, "timestamp_updated": 1748024569, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}