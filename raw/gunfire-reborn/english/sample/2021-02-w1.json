count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "86166175", "author": {"steamid": "76561198161295531", "personaname": "RainingRats", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198161295531/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 2226, "playtime_last_two_weeks": 0, "playtime_at_review": 1063, "last_played": 1732409834, "avatar": "dacd76c36fd15ddb0c65cf6e3b980a71ab233244"}, "language": "english", "review": "This game is great, i came from playing Risk of Rain 2 but had finished everything on it that I didn't know what to do, then i found this gem. So far it has 4 characters, but i can't wait to see more in the upcoming updates. Each character has different abilities, each gun is unique on its own and the maps are very nice looking. It was so fun that i ended up gifting the game to 4 of my friends, and anyone of my friends who saw us playing it on stream would get it immediately after.  I def recommend this game for anyone trying to find a new game to play with friends and i cannot wait until it fully comes out!", "timestamp_created": 1612733410, "timestamp_updated": 1612733410, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "86165935", "author": {"steamid": "76561198025489079", "personaname": "[TBS] Velheru", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198025489079/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 3103, "playtime_last_two_weeks": 0, "playtime_at_review": 414, "last_played": 1737905754, "avatar": "6ecbe