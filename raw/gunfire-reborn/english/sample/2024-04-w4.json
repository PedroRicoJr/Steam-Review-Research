, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "163925910", "author": {"steamid": "76561198039201133", "personaname": "wx1000", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/wx1000/", "num_games_owned": 0, "num_reviews": 41, "playtime_forever": 1470, "playtime_last_two_weeks": 0, "playtime_at_review": 1470, "deck_playtime_at_review": 1153, "last_played": 1696986848, "avatar": "60a952976b69babf1a2f67b8a465574466cf93e1"}, "language": "english", "review": "Cannot play 100% offline. You can authenticate online and play offline afterwards though.\n\nHero diversity is good. But I did I find myself going after the same weapons because I don't feel they are very balanced. So it turns this roguelike into more of an action RPG - killing the replay value. Fun while it lasted.", "timestamp_created": 1714497923, "timestamp_updated": 1714497923, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": true, "app_release_date": "1637202540", "reactions": []}]}