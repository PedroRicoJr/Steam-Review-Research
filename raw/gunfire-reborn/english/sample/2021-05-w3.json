tions": []}, {"recommendationid": "92463688", "author": {"steamid": "76561199127183699", "personaname": "Shrimp", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199127183699/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 5418, "playtime_last_two_weeks": 0, "playtime_at_review": 2727, "last_played": 1749419575, "avatar": "fab32d5d7261d73e15dc105bc704823f92b15c38"}, "language": "english", "review": "game good. fun game. would recommend", "timestamp_created": 1621770397, "timestamp_updated": 1621770397, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "92461570", "author": {"steamid": "76561197982894667", "personaname": "»Kasu«", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197982894667/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 5317, "playtime_last_two_weeks": 0, "playtime_at_review": 2247, "last_played": 1691257589, "avatar": "cc65b2e51c12c364fdb62d61b2232e804b4c789a"}, "language": "english", "review": "Very fun Roguelike, especially in Coop.\nSolid shooter mechanics and enough variety / unlockable items to keep you engaged for quite a while.\nMore and more content is added to the game consistently.\nIt is a steal considering the price of ten bucks.", "timestamp_created": 1621767264, "timestamp_updated": 1621767264, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "92459367", "author": {"steamid": "76561198094493111", "personaname": "Auntie Everclear", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/mr_chu01/", "num_games_owned": 209, "num_reviews": 27, "playtime_forever": 1333, "playtime_last_two_weeks": 0, "playtime_at_review": 207, "last_played": 1688798000, "avatar": "2a94e8ccd22af2a5c76444d37692357de2f3ec49"}, "language": "english", "review": "Reminds me of Enter the Gungeon and Risk of Rain. The game is actually fun to grind unlike many popular games. I have not had the chance to play multiplayer yet, but playing alone is still very fun and actually challenging. I might be stupid but it did take me awhile to figure out the leveling system in the game. A players level is based on a skill tree, each skill is a level. The way skills are gotten is by collecting \"soul essence\" which is dropped by enemies. Soul essence can only be spent in the match it is collected in once all players are dead.  The reason I bring this up is because I spent a long time playing, confused as to why I wasn't leveling up. Once I found the skill tree and understood how levels and skills worked, the game became %100 better. If you are a fan of Risk of Rain or Enter the Gungeon I would definitely suggest trying this game out.", "timestamp_created": 1621763903, "timestamp_updated": 1621764829, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}