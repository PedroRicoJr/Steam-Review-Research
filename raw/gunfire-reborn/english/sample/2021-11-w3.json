{"game": "gunfire-reborn", "language": "english", "appid": 1217060, "month": "2021-11", "window": 3, "start_date": 1637020800, "end_date": 1637625599, "month_true_total": 4274, "quota": 29, "returned": 29, "pulled_at": "2026-09-27 01:49:21 UTC", "reviews": [{"recommendationid": "103301920", "author": {"steamid": "76561198035897244", "personaname": "Mammer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198035897244/", "num_games_owned": 269, "num_reviews": 4, "playtime_forever": 15985, "playtime_last_two_weeks": 0, "playtime_at_review": 5887, "last_played": 1738638708, "avatar": "0c878a3d2a878a93e8acd449dd7b36845f6ef488"}, "language": "english", "review": "In a world of PC games that aren’t functional on launch, Gunfire Reborn brings light and hope to the world of gaming. \n\n The game is incredibly fun, repeatedly, as you try different hero’s, or attempt a new synergy. Sometimes you’re trying the new synergy because you want to, and sometimes the game forces you to try something new! \n\nThe Devs have proven that they listen to feedback from their community and make it known that they hear you. \n\nThank you gunfire for 98 hours of joy. I intend to keep playing on the increased difficulty modes. \n\nThanks for making an amazing game, and keeping it amazing !", "timestamp_created": 1637625189, "timestamp_updated": 1637625189, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "103300715", "author": {"steamid": "76561198264747281", "personaname": "FARTGOD44★", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/noahiscringe/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 5250, "playtime_last_two_weeks": 0, "playtime_at_review": 5232,