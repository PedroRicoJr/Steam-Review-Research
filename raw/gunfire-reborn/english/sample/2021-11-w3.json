nd I'm sure we'll put in many more.", "timestamp_created": 1637619495, "timestamp_updated": 1637619495, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "103297363", "author": {"steamid": "76561197988460442", "personaname": "Sailorboatface", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Sailorboatfuckface/", "num_games_owned": 0, "num_reviews": 37, "playtime_forever": 20654, "playtime_last_two_weeks": 0, "playtime_at_review": 2466, "last_played": 1775073801, "avatar": "733ff202d8f8fccfeef289c3b0079af75a46c29b"}, "language": "english", "review": "Super fun FPS rogue like. Its different every time you play. Still havent beaten it, but I will continue to try until I do.", "timestamp_created": 1637618603, "timestamp_updated": 1637618603, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "103295596", "author": {"steamid": "76561197971203037", "personaname": "Soy Boy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/MONEYCASHMONEY/", "num_games_owned": 0, "num_reviews": 22, "playtime_forever": 1012, "playtime_last_two_weeks": 0, "playtime_at_review": 735, "last_played": 1716167281, "avatar": "7a741b8d9d4b80e71571ba1bdb1d4fd8814f740d"}, "language": "english", "review": "Yassssss", "timestamp_created": 1637616234, "timestamp_updated": 1637616234, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded