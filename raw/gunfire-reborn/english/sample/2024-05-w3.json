gy with build variety.", "timestamp_created": 1716445981, "timestamp_updated": 1716445981, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.544817924499511719", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "165886523", "author": {"steamid": "76561198360759640", "personaname": "mist", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198360759640/", "num_games_owned": 71, "num_reviews": 10, "playtime_forever": 426, "playtime_last_two_weeks": 0, "playtime_at_review": 339, "last_played": 1788898110, "avatar": "fe5fe8d105d5d1617f755d6c1f9b09688bff585a"}, "language": "english", "review": "ghud game", "timestamp_created": 1716428490, "timestamp_updated": 1716428490, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}