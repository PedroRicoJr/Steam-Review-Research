{"game": "gunfire-reborn", "language": "english", "appid": 1217060, "month": "2023-09", "window": 4, "start_date": 1695427200, "end_date": 1696118399, "month_true_total": 251, "quota": 5, "returned": 5, "pulled_at": "2026-09-27 01:52:14 UTC", "reviews": [{"recommendationid": "147387901", "author": {"steamid": "76561198799383747", "personaname": "moon guts", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198799383747/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 12062, "playtime_last_two_weeks": 290, "playtime_at_review": 2646, "last_played": 1790206257, "avatar": "2f162ba3fd40d8818ce5a044ca89418a3036fdef"}, "language": "english", "review": "I'm quite literally addicted to the game, sometimes there's a super small bug like enemies not spawning even though they're on the map, it only lasts a few seconds, or not being able to discard scrolls (without the scroll that makes it so you can't). But out of everything that could be wrong with the game, that's it. The graphics are gorgeous and the characters you can choose have their own special abilities. Personally, I love Ao Bai. Sound quality is amazing and the enemies remain tough to kill for a while. It took me a few play-throughs to finish my first run, but the relief is craaazy. I'm low-key scared to try elite mode lol", "timestamp_created": 1696108846, "timestamp_updated": 1696108846, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "147379862", "author": {"steamid": "76561198995814441", "personaname": "Adenosine Triphosphate", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/realayr/", "num_games_owned": 92, "num_reviews": 20, "playtime_forever": 14739, "playtime_last_two_weeks":