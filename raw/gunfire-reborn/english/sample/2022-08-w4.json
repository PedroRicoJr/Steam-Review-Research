_status": "online", "profile_url": "https://steamcommunity.com/id/Spookydog/", "num_games_owned": 536, "num_reviews": 114, "playtime_forever": 1588, "playtime_last_two_weeks": 0, "playtime_at_review": 439, "last_played": 1730769013, "avatar": "f4e8cf276110a89aa2c8b3db5154d98ab2102165"}, "language": "english", "review": "goku get'em game if you know what i mean", "timestamp_created": 1661987011, "timestamp_updated": 1661987011, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.481927722692489624", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "121545850", "author": {"steamid": "76561198031724543", "personaname": "manollette", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198031724543/", "num_games_owned": 903, "num_reviews": 151, "playtime_forever": 1853, "playtime_last_two_weeks": 0, "playtime_at_review": 1853, "last_played": 1664941707, "avatar": "e4663e578d1bef5e6e1eb5100e0f0dd05386f57f"}, "language": "english", "review": "Just picked this up with my wife, and found out the fun way after getting two hours into a run that there's no way to reconnect if your game crashes. I can understand sometimes crashes happen, but there's no excuse for not accommodating when it does.\n\nEdit: years later, they're pumping out DLC, and this still isn't a thing. HOW?", "timestamp_created": 1661985599, "timestamp_updated": 1726339482, "voted_up": false, "votes_up": 4, "votes_funny": 1, "weighted_vote_score": "0.457669764757156372", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "121544818", "author": {"steamid": "76561198018542616", "personaname": "deadspawn", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198018542616/", "num_games_owned": 0, "num_reviews": 26, "playtime_forever": 7882, "playtime_last_two_weeks": 0, "playtime_at_review": 609, "last_played": 1664930592, "avatar": "112e0fe766ccce30c6aabc2b5f088719f1dac855"}, "language": "english", "review": "Only played solo, not too bad, a little more explanation on some of the chat chests would be helpful.  Like removing hp, permanently or temporarily makes a big difference.  Replacing inscriptions on the weapons is clunky.  Kind of difficult if you get bad rng when weapons/scrolls drop playing solo. \n\nI don't want to tell anyone how to play this, I only have 10 hours into it and at least one of it was while pausing.  I also don't like that I can't save progress, and if I can then the  game isn't really explaining it well.\n\nFor $20 bucks with the expansion DLC thing was worth it.", "timestamp_created": 1661983479, "timestamp_updated": 1661983479, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}]}