atus": "offline", "profile_url": "https://steamcommunity.com/id/ELITEprogram001/", "num_games_owned": 327, "num_reviews": 23, "playtime_forever": 5964, "playtime_last_two_weeks": 0, "playtime_at_review": 2224, "last_played": 1738469281, "avatar": "56df984b42dfb1fd5cfe518ab476a5d8e6710430"}, "language": "english", "review": "Overall, it's a fun game. \n\nI wish there were more heroes to choose from, but the ones they do have are great. You will have to change your play style if you want to get the most out of each hero.\n\nThe guns are fun to use. Most of them feel satisfying and balanced. 37 hours in and I'm still discovering new guns and unlocking new talents to help me on future runs.\n\nTLDR; Overall, the heroes are unique, the guns are satisfying, and the gameplay is fun. I think it is well worth the price.", "timestamp_created": 1633024523, "timestamp_updated": 1633024523, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.526066362857818604", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": [{"reaction_type": 18, "count": 1}]}]}