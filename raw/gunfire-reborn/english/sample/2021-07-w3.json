last_two_weeks": 0, "playtime_at_review": 3248, "last_played": 1772258106, "avatar": "2b1bdc540b9cb1ed5f7a85e85004c5e2ce66f17e"}, "language": "english", "review": "After putting in 54 hours, i have gotten to max level. I have nothing left to upgrade. The games still super fun to play, even maxed out! considering i picked up this game for only 10$ id say you 100% get your moneys worth. Each time you play, even tho their the same 3 stages, you find different traps, different elites, different scrolls and builds. If you like games like diablo 3 youll love this.", "timestamp_created": 1627075786, "timestamp_updated": 1627075786, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "96256890", "author": {"steamid": "76561198300738110", "personaname": "hi", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/gabervalo/", "num_games_owned": 114, "num_reviews": 19, "playtime_forever": 560, "playtime_last_two_weeks": 0, "playtime_at_review": 229, "last_played": 1681278850, "avatar": "b2b293a2084de9f1e874a9c335e33b6eb2419a0e"}, "language": "english", "review": "good game jump around shoot big boss very cool wapam!", "timestamp_created": 1627072926, "timestamp_updated": 1627072926, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.50127875804901123", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "96254121", "author": {"steamid": "76561199189465855", "personaname": "Burger mcburger", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199189465855/", "num_games