{"game": "gunfire-reborn", "language": "english", "appid": 1217060, "month": "2026-07", "window": 1, "start_date": 1782864000, "end_date": 1783468799, "month_true_total": 119, "quota": 5, "returned": 5, "pulled_at": "2026-09-27 01:56:35 UTC", "reviews": [{"recommendationid": "229889333", "author": {"steamid": "76561198136759647", "personaname": "Jupiter", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198136759647/", "num_games_owned": 0, "num_reviews": 50, "playtime_forever": 42, "playtime_last_two_weeks": 0, "playtime_at_review": 42, "last_played": 1783463274, "avatar": "e7760567f4cf0e9d279f7fdc99c4706541fc811f"}, "language": "english", "review": "Sometimes it feels like I'm very hard to please.\nThis game has mostly everything it needs for me to enjoy it, but in the end I couldn't stop yawning halfway through the second run and decided to call it quits.\nThe gameplay feels too slow and easy, the environments are nothing extraordinary and there's no enemy variety.\n\nNot even the fox character was enough to keep me from uninstalling, and I love fox characters.\nThat's how monotonous Gunfire truly felt like to me.\n\nThere are also rumors about the developers using AI, which is already a huge dealbreaker to me.\n\nAnd so my search for another roguelike continues...", "timestamp_created": 1783464025, "timestamp_updated": 1783464025, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.475155293941497803", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1637202540", "reactions": []}, {"recommendationid": "229878793", "author": {"steamid": "76561198210066625", "personaname": "Fabin", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/_fabin/", "num_games_owned": 460, "num_reviews": 11, "playtime_forever": 5172, "playtime_last_two_weeks": 0, "playtime_