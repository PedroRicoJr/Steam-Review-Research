crifice a few FPS for that.", "timestamp_created": 1776782669, "timestamp_updated": 1776782669, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "hardware": {"system_ram": "64590", "os": "Windows 10", "cpu_name": "AMD Ryzen 7 7800X3D 8-Core Processor           ", "adapter_description": "NVIDIA GeForce RTX 4080 SUPER", "vram_size": 16045}, "reactions": []}, {"recommendationid": "223776355", "author": {"steamid": "76561198129515982", "personaname": "XFinalChanceX", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198129515982/", "num_games_owned": 385, "num_reviews": 60, "playtime_forever": 463, "playtime_last_two_weeks": 0, "playtime_at_review": 463, "last_played": 1767339671, "avatar": "2b1bdc540b9cb1ed5f7a85e85004c5e2ce66f17e"}, "language": "english", "review": "Its a fun game to pass the time", "timestamp_created": 1776781092, "timestamp_updated": 1776781092, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "reactions": []}]}