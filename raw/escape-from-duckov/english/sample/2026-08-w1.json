t there is a performance problem, leading to a VERY poor mid-late game experience.", "timestamp_created": 1785949692, "timestamp_updated": 1785949692, "voted_up": false, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.484137058258056641", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "hardware": {"system_ram": "16217", "os": "Windows 11", "cpu_name": "Intel(R) Core(TM) i5-14400F", "adapter_description": "NVIDIA GeForce RTX 4060", "vram_size": 7956}, "reactions": []}, {"recommendationid": "232127364", "author": {"steamid": "76561199187132045", "personaname": "Chinese_Checkers", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199187132045/", "num_games_owned": 86, "num_reviews": 12, "playtime_forever": 5603, "playtime_last_two_weeks": 0, "playtime_at_review": 5603, "last_played": 1784818948, "avatar": "42c611512fc2fada3e9952a1077d285caf8ab450"}, "language": "english", "review": "Great game if your into extraction shooters", "timestamp_created": 1785946111, "timestamp_updated": 1785946111, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "hardware": {"system_ram": "31653", "os": "Windows 11", "cpu_name": "AMD Ryzen 7 9800X3D 8-Core Processor           ", "adapter_description": "NVIDIA GeForce RTX 5080", "vram_size": 15977}, "reactions": []}]}