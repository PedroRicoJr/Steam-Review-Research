m_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "reactions": []}, {"recommendationid": "214720859", "author": {"steamid": "76561198044359584", "personaname": "j", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198044359584/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4961, "playtime_last_two_weeks": 0, "playtime_at_review": 4961, "last_played": 1767173259, "avatar": "13c77b3feedff014c05380b35af6c71035269a15"}, "language": "english", "review": "For such a funny titled game, it provides a lot of depth in terms of customization, difficulty and gameplay variety. It was so frustrating to drop all my gear and lose it permanently, but at the same time, so rewarding to be able to complete a hard level and progress bit by bit.", "timestamp_created": 1767173388, "timestamp_updated": 1767173388, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "reactions": []}, {"recommendationid": "214718389", "author": {"steamid": "76561198066634370", "personaname": "Maurix6", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/maurix6/", "num_games_owned": 451, "num_reviews": 3, "playtime_forever": 4428, "playtime_last_two_weeks": 554, "playtime_at_review": 1577, "last_played": 1789371659, "avatar": "1bd42a5d6e8df954af757f4c378563a87689acea"}, "language": "english", "review": "This is a great game that really captures the feeling of the extraction genre.\r\nAs someone who played Tarkov for 3–4 years, this game hits the sweet spot.\r\n\r\nJust take into consideration that the game is PvE only, but it still has intense moments when you’re out there looting, scavenging, and fighting.", "timestamp_created": 1767170383, "timestamp_updated": 1767170383, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "reactions": []}, {"recommendationid": "214708361", "author": {"steamid": "76561198044736048", "personaname": "Kaymind", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/id/Kaymind/", "num_games_owned": 882, "num_reviews": 23, "playtime_forever": 3589, "playtime_last_two_weeks": 0, "playtime_at_review": 1210, "last_played": 1768334854, "avatar": "0ca6df56543fdb2ed871982b996f0fc4d2728e0f"}, "language": "english", "review": "Suuuper satisfying singleplayer extraction shooter. It has a surprisinging amount of content (20 hours in and I dont think Im half way through) and the progression feels pretty awesome. I highly recommend using quality of life mods from the workshop even as a first playthrough, it made me enjoy the game even more.", "timestamp_created": 1767157857, "timestamp_updated": 1767157857, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.54356849193572998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1760598013", "reactions": []}, {"recommendationid": "214708093", "author": {"steamid": "76561198928926872", "personaname": "JACKO_192", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198928926872/", "num_games_owned": 223, "num_reviews": 57, "playtime_forever": 731, "playtime_last_two_weeks": 0, "playtime_at_review": 731, "last_played": 1767157530, "avatar": "03f7798558ce22868803fb6ca7b2c46a687d6fbb"}, "language": "english", "review": "quack", "timestamp_created": 1767157536, "timestamp_updated"