e_date": "1738246187", "reactions": []}, {"recommendationid": "200404636", "author": {"steamid": "76561197996635502", "personaname": "Flying Tortoises of Bakla", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/PENGUINSHATEME/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 7774, "playtime_last_two_weeks": 0, "playtime_at_review": 3739, "last_played": 1775976149, "avatar": "e4b0aa17a473486b761b7dd27da3cd95df58217f"}, "language": "english", "review": "A bit buggy, overall a great addition to the series. Always cathartic.", "timestamp_created": 1753229051, "timestamp_updated": 1753229051, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200398168", "author": {"steamid": "76561197990921495", "personaname": "John_Bigbootay", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197990921495/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 3288, "playtime_last_two_weeks": 0, "playtime_at_review": 2721, "last_played": 1753402590, "avatar": "cc45fb9da0754d07b9bbd4f57efce2a9571260e1"}, "language": "english", "review": "The game franchise has simply lost its way. The tile sets are rehashed from older versions, and its story line, granted...it's all about shooting people and things...is just more of the same old song and dance. It's devolved into brain bubble-gum.", "timestamp_created": 1753220089, "timestamp_updated": 1753220089, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200367188", "author": {"steamid": "76561198017967436", "personaname": "Lord_Nazrac", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198017967436/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 23754, "playtime_last_two_weeks": 95, "playtime_at_review": 3868, "last_played": 1790506185, "avatar": "109d4ec9ea3a645c9ad018b3f9a78aa6542b73e9"}, "language": "english", "review": "Its fun but costs alot of CASH if you want to play multi players as everyone has moved onto the DLC", "timestamp_created": 1753188497, "timestamp_updated": 1753188497, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200364818", "author": {"steamid": "76561199512228756", "personaname": "uffe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199512228756/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 5061, "playtime_last_two_weeks": 348, "playtime_at_review": 2932, "last_played": 1791469286, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "Sniper elite, no more no less. Love it!", "timestamp_created": 1753185517, "timestamp_updated": 1753185517, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200350143", "author": {"steamid": "76561197968721403", "personaname": "Horus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197968721403/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 26248, "playtime_last_two_weeks": 0, "playtime_at_review": 8843, "last_played": 1788669747, "avatar": "918e2dc58be09d29381da1131a34b61ec79cc68a"}, "language": "english", "review": "Short but not sweet rehash of SE5. Very much overpriced. Pros: Solid SE5 gameplay (the game engine is obviously very mature by now), familiar gameplay and existing muscle memory from SE5 carry over.  Cons: Where to begin? SER is basically a download-pack for SE5 but sold as a full game. For the asking price thats more than just \"cheeky\". SE Resistance is way too short, one campaign mission location is even reused with only slightly different objectives, assets and enemy voice lines are ca. 90% identical.\n\nThe remaining 10% are performed by the new protagonist, and that one does not come even close to the stoic Karl Fairburne who is rightfully beloved by the Sniper Elite player community. The \"new guy\" annoys me because of, in my opinion, badly written and overly chatty dialogue. The British accent is fine in my book, but an accent alone does not infuse personality or likability into a one-dimensional, scraggly-bearded guy that I find not much reason to care about. Also, he talks so much that I wish being able to mute his voice altogether.\n\nI waited a long time for a Steam sale to purchase the standard edition of Sniper Elite Resistance, and yet I still feel ripped off by Rebellion. Frankly, if I was not an avid fan of the SE franchise from the very beginning and enjoyed how installments of the series kept improving more and more, I would be even more annoyed. I close my eyes and try to think happy thoughts, but SER is too brief and too expensive to warrant my recommendation.", "timestamp_created": 1753162578, "timestamp_updated": 1753162578, "voted_up": false, "votes_up": 48, "votes_funny": 0, "weighted_vote_score": "0.798596799373626709", "comment_count": 5, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": [{"reaction_type": 17, "count": 1}, {"reaction_type": 16, "count": 1}]}, {"recommendationid": "200346059", "author": {"steamid": "76561198036819963", "personaname": "TheGamePyro", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/TheGamePyro/", "num_games_owned": 264, "num_reviews": 5, "playtime_forever": 999, "playtime_last_two_weeks": 0, "playtime_at_review": 330, "last_played": 1771819861, "avatar": "785c0dec17d35de7c792a99609057d2d0f7783a9"}, "language": "english", "review": "it good\r\n", "timestamp_created": 1753155664, "timestamp_updated": 1753155664, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200340593", "author": {"steamid": "76561199085293208", "personaname": "berner.berner1", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199085293208/", "num_games_owned": 95, "num_reviews": 25, "playtime_forever": 357, "playtime_last_two_weeks": 0, "playtime_at_review": 357, "last_played": 1753147167, "avatar": "61c634e2d37864be814e5b78739b7d8ef9b453f5"}, "language": "english", "review": "me & my friend eric played for 6 hours today who needs sleep b4 work lol", "timestamp_created": 1753147579, "timestamp_updated": 1753147579, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200275842", "author": {"steamid": "76561197997263388", "personaname": "Byxbult", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197997263388/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 2620, "playtime_last_two_weeks": 0, "playtime_at_review": 1140, "last_played": 1785717551, "avatar": "2dd48b34875832985b5e2ad875d064afb912fd51"}, "language": "english", "review": "Ok I get it; Karl Fairbourne had to retire so as to not make the franchise ridiculous. I just wish they hadn't picked some Brit chav to do the voice acting. Mighty big shoes to fill and all that. That aside, the Sniper Elite franchise is alive and well with this entry. Meanwhile, it is already obvious that the publisher intends to milk the DLC angle to the hilt so any fan of the series has a choice to make; jump in with both feet and expect to pay possibly $200+ for the full game experience now, or wait 2-3 years for a discounted package deal priced sanely for a Steam Christmas/summer event that includes everything.", "timestamp_created": 1753066585, "timestamp_updated": 1753066585, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}]}