t_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "213372217", "author": {"steamid": "76561198787809310", "personaname": "..", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Mryousef93/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 2136, "playtime_last_two_weeks": 0, "playtime_at_review": 217, "last_played": 1770125431, "avatar": "3a4213bbdc470b0d2ccfc9e683dd190670e78966"}, "language": "english", "review": "realy i like it <3''", "timestamp_created": 1765826071, "timestamp_updated": 1765826071, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "213355267", "author": {"steamid": "76561198102229786", "personaname": "Sportseins1", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198102229786/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 6404, "playtime_last_two_weeks": 0, "playtime_at_review": 760, "last_played": 1780944769, "avatar": "812e30bff92c972c5250939669a54d01440ce191"}, "language": "english", "review": "I can not say enough about this game.  I like how as old as I am all of my reflexes are really slow but I can go Slow or fast My fast i a fast slow turtle but non the less I get through it.  Love the game.", "timestamp_created": 1765808992, "timestamp_updated": 1765808992, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "213325419", "author": {"steamid": "76561198141316708", "personaname": "SteinCatboi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/SteinCatboi/", "num_games_owned": 301, "num_reviews": 20, "playtime_forever": 1449, "playtime_last_two_weeks": 0, "playtime_at_review": 1449, "last_played": 1765763467, "avatar": "9a92d130f72a92f7ca3fb65d925e1fe5a9cce381"}, "language": "english", "review": "As someone who was pretty meh about Sniper Elite 5, this game is a slight improvement but regardless I'm still pretty meh on it. I have a few hundred hours into the previous Sniper Elite games and both Resistance and 5 feel pretty underwhelming in comparison to previous entries. Essentially all my points in a previous review for Sniper Elite 5 hold water here. \n\nResistance has more interesting maps, and an overall improved challenge. But still it feels severely watered down compared to it's predecessors in both gameplay mechanics and especially enemy population. If you want to try it, grab it through GamePass or on a really good sale. \n\nAs it stands this game is not worth full price and is really just a glorified DLC campaign for Sniper Elite 5.", "timestamp_created": 1765764652, "timestamp_updated": 1765767399, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "213308386", "author": {"steamid": "76561199558290741", "personaname": "YippeThee", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ChevyThee/", "num_games_owned": 108, "num_reviews": 39, "playtime_forever": 424, "playtime_last_two_weeks": 0, "playtime_at_review": 60, "last_played": 1781669976, "avatar": "54e87560b83d0d61dd53b3aa7577b28c998ffda7"}, "language": "eng