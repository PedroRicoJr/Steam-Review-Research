vote_score": "0.53125", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200848781", "author": {"steamid": "76561199189028640", "personaname": "Menterama", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199189028640/", "num_games_owned": 0, "num_reviews": 31, "playtime_forever": 2833, "playtime_last_two_weeks": 0, "playtime_at_review": 1539, "last_played": 1790286254, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "I'm a big fan of Sniper Elite and I enjoyed this game, but I feel quite disappointed too. \nThe maps in Sniper Elite 5 are generally bigger and more beautiful than the ones on this game, I have not noticed any memorable improvement here, no memorable mission or map.\nThis game is good but shorter and definitely a step back, it just made me realize how truly great the fifth installment is.", "timestamp_created": 1753631786, "timestamp_updated": 1753631786, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "200754900", "author": {"steamid": "76561199042344967", "personaname": "LandLord123", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/ryan12345656787/", "num_games_owned": 43, "num_reviews": 2, "playtime_forever": 10049, "playtime_last_two_weeks": 547, "playtime_at_review": 3070, "last_played": 1791513771, "avatar": "d8e7de3888249350e4a17330bd07d7ab26246ecc"}, "language": "english", "review": "your biggest enemies will be the ladders", "timestamp_created": 1753537089, "timestamp_updated": 1753537089, "voted_up":