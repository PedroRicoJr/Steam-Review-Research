n shooter set in World War II.", "timestamp_created": 1751259590, "timestamp_updated": 1751259590, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "198512337", "author": {"steamid": "76561198254481034", "personaname": "Micheallosifir", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198254481034/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 654, "playtime_last_two_weeks": 0, "playtime_at_review": 488, "last_played": 1785733026, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "really great game", "timestamp_created": 1751246815, "timestamp_updated": 1751246815, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.494296550750732422", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "198488108", "author": {"steamid": "76561198015563858", "personaname": "IRONMAN", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198015563858/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 839, "playtime_last_two_weeks": 0, "playtime_at_review": 493, "last_played": 1757605470, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "BRIlLIANT again. i love the hole series. great game", "timestamp_created": 1751224766, "timestamp_updated": 1751224766, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.494296550750732422", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": 