t": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}, {"recommendationid": "192723879", "author": {"steamid": "76561198118719728", "personaname": "TIE Fighter Pilot", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198118719728/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 5138, "playtime_last_two_weeks": 0, "playtime_at_review": 336, "last_played": 1762148557, "avatar": "ec9fab8a06f0ffe1217249356a7673ac74be5243"}, "language": "english", "review": "New Sniper Elite 5 DLC is fire.\n\nOn the serious side, if you're into SE, especially SE5, you'll love the levels and weapon variety in this one. The price and pre-order guns do suck, but otherwise, it's pretty good. Get it on a sale, and know what you're in for.", "timestamp_created": 1744626196, "timestamp_updated": 1744626196, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.53847891092300415", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1738246187", "reactions": []}]}