otes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1790718397, "developer_response": "Thanks for the review and glad you've been digging LORT!", "app_release_date": "1769006794", "hardware": {"system_ram": "15535", "os": "Windows 11", "cpu_name": "AMD Ryzen 9 8940HX with Radeon Graphics        ", "adapter_description": "NVIDIA GeForce RTX 5070 Ti Laptop GPU", "vram_size": 11944}, "reactions": []}, {"recommendationid": "236369657", "author": {"steamid": "76561198148265389", "personaname": "Juandissimo", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198148265389/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1815, "playtime_last_two_weeks": 0, "playtime_at_review": 1815, "last_played": 1789944669, "avatar": "7ab0ef8582691c1663006c7b27846dbf427e2b9c"}, "language": "english", "review": "Really fun game initially, until they scrapped off stats. The fact that essentially there are only two consistent upgrade stats; hp and damage which you obtain in ALL color picks leaves us with essentially ZERO player customization or unique expression of gameplay. 3 people play the same class and late game they essentially will be mirror images of each other...that's sad. Randomly picking up different buffs doesn't equal player intended variability or build path. It feels good to intentionally make a build you wanted to play not so much random luck of draw power ups create a randomly slightly different version of a character that you didn't really mean to create.", "timestamp_created": 1790555838, "timestamp_updated": 1790555838, "voted_up": false, "votes_up": 7, "votes_funny": 0, "weighted_vote_score": "0.556473851203918457", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1790718460, "developer_response": "Thanks for the review and heard on the feedback. Our next update will have more ways for you to make the specific build you want, primarily with powerups. Hoping that will address some of your feedback. Let us know once its out and you've tried it. ", "app_release_date": "1769006794", "reactions": []}, {"recommendationid": "236360772", "author": {"steamid": "76561198408515246", "personaname": "AgentProphet47", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/agentprophet47/", "num_games_owned": 135, "num_reviews": 56, "playtime_forever": 1008, "playtime_last_two_weeks": 679, "playtime_at_review": 834, "last_played": 1790804820, "avatar": "91924a25a725d7475c6c51d74dc2d03d40b02bf8"}, "language": "english", "review": "This game is freakin awesome.", "timestamp_created": 1790544921, "timestamp_updated": 1790544921, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1790718337, "developer_response": "you're freaking awesome", "app_release_date": "1769006794", "reactions": []}, {"recommendationid": "236269102", "author": {"steamid": "76561198081228580", "personaname": "S0S", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/505K/", "num_games_owned": 271, "num_reviews": 109, "playtime_forever": 414, "playtime_last_two_weeks": 0, "playtime_at_review": 414, "last_played": 1788155477, "avatar": "118d19b306236de4f6956987bc7c8b6ae8294ea2"}, "language": "english", "review": "[h1] 6/10 [/h1]", "timestamp_created": 1790454798, "timestamp_updated": 1790454798, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free