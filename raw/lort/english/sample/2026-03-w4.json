e": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1769006794", "reactions": []}, {"recommendationid": "222171192", "author": {"steamid": "76561197987630085", "personaname": "Sammie", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/misssammie/", "num_games_owned": 698, "num_reviews": 32, "playtime_forever": 600, "playtime_last_two_weeks": 0, "playtime_at_review": 234, "last_played": 1775103356, "avatar": "ef22fb4124c90fc41d2f50a217971e7e24a14261"}, "language": "english", "review": "I really quite like this game. It's a tad disappointing that you can't play the frog from the beginning, but you unlock them pretty quick so w/e\n\nSo far, the game feels amazing, lots of movement tech if you wanna speedrun around the map and get OP as hell.\n\nGreat fun just running it with friends and joking around\n\nAlso, the sound track goes harder than you'd expect", "timestamp_created": 1774958894, "timestamp_updated": 1774958944, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "app_release_date": "1769006794", "reactions": []}, {"recommendationid": "222169108", "author": {"steamid": "76561198815735397", "personaname": "Legally Blind", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Rosai/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 663, "playtime_last_two_weeks": 0, "playtime_at_review": 267, "last_played": 1775197234, "avatar": "51bb78fd07a616dffa959c285ad0951a7ece4680"}, "language": "english", "review": "YES", "timestamp_created": 1774956430, "timestamp_updated": 1774956430, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count