26181281", "personaname": "RedAGurt", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199626181281/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 67, "playtime_last_two_weeks": 0, "playtime_at_review": 67, "last_played": 1774908425, "avatar": "a521352ec938d97a89f4b9655f75924d3cea6344"}, "language": "english", "review": "Why make the tutorial boss literally impossible for 1-2 people to kill solo. Don't advertise game as good for 1-8, but then not powerscale for 1 player. You NEED 8 because the HP of the boss is the same whether you are 1 or 8 players. DO NOT RECCOMEND.", "timestamp_created": 1774908476, "timestamp_updated": 1774908476, "voted_up": false, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.529009342193603516", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": true, "primarily_steam_deck": false, "timestamp_dev_responded": 1774987028, "developer_response": "Thanks for the review and heard on the feedback. We have more difficulty scaling plans in our next big update, but we just released a small update to adjust normal difficulty. Check it out here: https://store.steampowered.com/news/app/2956680/view/533253197651772627", "app_release_date": "1769006794", "reactions": [{"reaction_type": 28, "count": 1}]}]}