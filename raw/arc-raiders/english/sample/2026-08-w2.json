TS and cheaters.  People also just hide out at quest locations like little ♥♥♥♥♥♥♥ and kill people.  I don't get why they don't just separate the PVP and PVE lobby's all together.   Most of us who want to PVE only are sick of the ♥♥♥♥♥♥♥ that hide and RAT.  Good game, but falling short of how it was designed to be played with the PVE/ PVP concept.", "timestamp_created": 1786834603, "timestamp_updated": 1786834603, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1761816609", "reactions": []}, {"recommendationid": "232924400", "author": {"steamid": "76561199093448091", "personaname": "skandulus", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199093448091/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 26146, "playtime_last_two_weeks": 1664, "playtime_at_review": 19202, "last_played": 1788995995, "avatar": "e525839835ef2189f3b2fc00faba70ced6b8ca3f"}, "language": "english", "review": "the game", "timestamp_created": 1786833735, "timestamp_updated": 1786833735, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1761816609", "reactions": []}]}