ersona_status": "online", "profile_url": "https://steamcommunity.com/id/Corruptionaura/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 29064, "playtime_last_two_weeks": 0, "playtime_at_review": 24248, "last_played": 1780626642, "avatar": "07d40dc17f65fa79acc03c22d6765c455c04a53b"}, "language": "english", "review": "Error 404: Not found\r\n\r\nThis game has been the best extraction shooter, coming from EFT. Less sweat, less management, but still fun and can be intimidating especially when you fight a new Arc for the first time. After about 400 hours I have definitely gotten my money worth, and excited to see the new bigger enemies they bring out, and hope they add more PVE oriented missions like close scrutiny was.", "timestamp_created": 1777591271, "timestamp_updated": 1777591271, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1761816609", "reactions": []}]}