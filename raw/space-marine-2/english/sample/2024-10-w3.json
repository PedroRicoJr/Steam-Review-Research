 "1725898212", "reactions": []}, {"recommendationid": "177611379", "author": {"steamid": "76561199191426722", "personaname": "Moogan", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199191426722/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 11460, "playtime_last_two_weeks": 87, "playtime_at_review": 2994, "last_played": 1789111115, "avatar": "ba84bde1fb490d9499b3360ba4f497d7bf7a16a0"}, "language": "english", "review": "Cannot recommend this game more. I am a Warhammer fan with many hours spent reading the lore, building/painting the models, or playing the games and Space Marine 2 is very respectful of the lore while providing great gameplay. I played SM1, and can say that I love the tie ins, but it is not needed at all to enjoy SM2. To the game devs, thank you. This is everything I wanted from this game and will play this for many more than my 49 hours (sorry I had a son shortly after launch /s). \r\n\r\nOne ask, can we change the colors of just the fists? Asking for a Crimson Fist.", "timestamp_created": 1729723302, "timestamp_updated": 1729723302, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "177611299", "author": {"steamid": "76561198393012033", "personaname": "XXVII", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198393012033/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 32984, "playtime_last_two_weeks": 1362, "playtime_at_review": 25232, "last_played": 1789081536, "avatar": "fb0a1ea5968f9e0ca6146329ed7dfd17e03110c6"}, "language": "english", "review": "remove chaos", "timestamp_created": 1729723193, "timestamp_updated": 1757271224, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weight