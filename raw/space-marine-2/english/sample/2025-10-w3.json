{"game": "space-marine-2", "language": "english", "appid": 2183900, "month": "2025-10", "window": 3, "start_date": 1760572800, "end_date": 1761263999, "month_true_total": 1831, "quota": 5, "returned": 5, "pulled_at": "2026-09-11 02:22:26 Pacific Daylight Time", "reviews": [{"recommendationid": "207424397", "author": {"steamid": "76561198341145901", "personaname": "Acelock", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Acelocked/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1281, "playtime_last_two_weeks": 0, "playtime_at_review": 180, "last_played": 1761845609, "avatar": "1f356e847fde7147c87e6ace88e2468c44a1c52a"}, "language": "english", "review": "We March for Macragge!", "timestamp_created": 1761262526, "timestamp_updated": 1761262526, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "207424157", "author": {"steamid": "76561198063129036", "personaname": "T'Pie", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198063129036/", "num_games_owned": 0, "num_reviews": 118, "playtime_forever": 1125, "playtime_last_two_weeks": 0, "playtime_at_review": 1125, "last_played": 1760965695, "avatar": "fd2538f52a97f86f85d29ffb397ee2d892188ea9"}, "language": "english", "review": "As of Reading this I've completed the main campaign, the Co-Op missions and some PVP and hoarde mode. With no spoilers and getting to my overall impression, this is another great Warhammer game and really improves from the first space marine game. This is dripping with details and the care and attention the Devs have put into this is amazing! Making Meat mists never gets tiring and as a fan of the Warhammer franchise I can't emphasise enough how good this game is. \n\nThe campaign for me was great and I want to play the next one. It gets you thinking of all the races and ways they could take the franchise and it's the perfect place for a Warhammer game to be. To throw my hat in, if they did a story similar to \"Hammer of Demons\" where you are fighting gladiatorial style whilst encountering different enslaved races that would be amazing! \n\nBut yeah this game is great and buy it. With this and a new dawn of war game returning to form us Warhammer fans are eating well! \n\n9/10", "timestamp_created": 1761262231, "timestamp_updated": 1761262231, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "207423697", "author": {"steamid": "76561198049961154", "personaname": "Fury", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198049961154/", "num_games_owned": 151, "num_reviews": 1, "playtime_forever": 11121, "playtime_last_two_weeks": 0, "playtime_at_review": 6144, "last_played": 1786058734, "avatar": "f3eaa32564885623274ba63656691a149ec83ff1"}, "language": "english", "review": "Heat", "timestamp_created": 1761261663, "timestamp_updated": 1761261663, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "207422842", "author": {"steamid": "76561199438093177", "personaname": "Aria", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199438093177/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 11085, "playtime_last_two_weeks": 0, "playt