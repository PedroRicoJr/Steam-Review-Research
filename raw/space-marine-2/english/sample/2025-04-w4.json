lse, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "193937906", "author": {"steamid": "76561197966671661", "personaname": "HellsDelight", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/HellsDelight/", "num_games_owned": 10808, "num_reviews": 59, "playtime_forever": 330, "playtime_last_two_weeks": 0, "playtime_at_review": 145, "last_played": 1785532756, "avatar": "cbb5effefae90a7b340d4a37c6b0c84e959c3e62"}, "language": "english", "review": "10/10", "timestamp_created": 1746055657, "timestamp_updated": 1746055657, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.55214846134185791", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "193935589", "author": {"steamid": "76561198142574080", "personaname": "isatopus", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/isatopus/", "num_games_owned": 463, "num_reviews": 35, "playtime_forever": 1522, "playtime_last_two_weeks": 0, "playtime_at_review": 687, "last_played": 1748052596, "avatar": "8adcd386fed3860980e7833ea1d11a699eee2fd7"}, "language": "english", "review": "Só falta adicionar o Space marine da turma da mônica", "timestamp_created": 1746052445, "timestamp_updated": 1746052445, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "193935183", "author": {"steamid": "76561198135510461", "personaname": "thoR", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/thorindadwarf/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 1267, "playtime_last_two_weeks": 0, "playtime_at_review": 1243, "last_played": 1746303861, "avatar": "a80592c7a6d7bc08e1ddcf06113f08373f9bc0e8"}, "language": "english", "review": "21 Hours Playtime\nIt’s easy to see where this game falls short. Flow constantly gets interrupted; having to hold E to interact, only to sit through a pointless button-pushing animation, wastes time and kills any momentum.\n\nThe PvE is a grind-heavy mess with confusing currencies and forgettable weapons. You're meant to grind out unlocks, but it's not worth the time it takes to upgrade(nor can you, cause of the dumb currencies). The missions are dull, and there’s no real reason to replay them. PvP? Long queue times, forced intro cut-scenes, and a point system that ends matches too fast, only to throw you back into the exact same loop.\n\nI liked making a character, but even that felt limited; prebuilt options rather than giving players the absolute creative control they would want, really missed the mark on what the community would want.\n\nAt £54.99, this isn’t worth it.\nIf you want a solid campaign and better customisation, play Halo Reach.\nIf you want proper PvE that’s fun, play Helldivers 2.", "timestamp_created": 1746051936, "timestamp_updated": 1746051936, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.5", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}]}