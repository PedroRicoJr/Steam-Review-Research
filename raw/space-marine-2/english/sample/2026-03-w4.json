_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "222211857", "author": {"steamid": "76561197999497500", "personaname": "carlstbh", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197999497500/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 1790, "playtime_last_two_weeks": 0, "playtime_at_review": 1765, "last_played": 1775420663, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "I like parts of the game and was able to complete it on Veteran, except for the end where I had to switch back to normal to finish.  The biggest problem I am having is that the controls are very sloppy.  Half the time  when I try to fire it won't fire, try to block it won't block, I mean what the hey.  It seems to take a second or two for the action to take place and by then you have been swarmed.  It gets pretty annoying when you are clearly able to fire or doge or parry, but the controls want to take a second or two to function.  I checked my CPU usage and it rarely goes above 60%, so I don't think it's because I have too slow a CPU.  If someone else has this issue I would love to hear about it.  I am currently trying to play on Angel of Death, and it is a real pain.  The controls have become too much of an issue.  I am playing alone, and I have to say, on the higher level the bots assigned to you seem to become dolts.  I am done with the game for now, it is just too annoying.", "timestamp_created": 1774995766, "timestamp_updated": 1775081072, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}]}