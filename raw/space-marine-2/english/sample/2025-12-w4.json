 664, "num_reviews": 51, "playtime_forever": 15, "playtime_last_two_weeks": 0, "playtime_at_review": 15, "last_played": 1767220928, "avatar": "e477c2866681b1ea94d3aa612959ff56c4c323e2"}, "language": "english", "review": "Not only does this game offer an incredibly expensive set of DLC, seperated into 2, soon probably more season passes that are inscrutable to the Emperor believing mind, not only does this game not run when not put on an SSD (I tried both because of ...reasons), not only does this game not have HDR, but when you install ReShade and an HDR mod it will not ONLY disable Online Mode, but also FLASH you with condescending warnings that you defiled the sanctity of its holy binary and this my Brothers, the Codex Astartes does not support.", "timestamp_created": 1767221582, "timestamp_updated": 1767221582, "voted_up": false, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.496183216571807861", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": [{"reaction_type": 16, "count": 1}]}]}