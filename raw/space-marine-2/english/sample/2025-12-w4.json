{"game": "space-marine-2", "language": "english", "appid": 2183900, "month": "2025-12", "window": 4, "start_date": 1766534400, "end_date": 1767225599, "month_true_total": 2238, "quota": 6, "returned": 6, "pulled_at": "2026-09-11 02:22:43 Pacific Daylight Time", "reviews": [{"recommendationid": "214777026", "author": {"steamid": "76561197978678644", "personaname": "thefenry", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197978678644/", "num_games_owned": 386, "num_reviews": 24, "playtime_forever": 103, "playtime_last_two_weeks": 0, "playtime_at_review": 103, "last_played": 1767209540, "avatar": "92a422137a63da51db22fc6958a2fa6c5c0de238"}, "language": "english", "review": "The game was what I wanted. It was linear shooter with over the top dumb shooting. I wanted something like it so I could just shut my brain off and kill waves of monsters. But the performance issues is brutal. I have above recommended specs and even when I turn down the settings it easily dips below 30fps. I thought maybe the outside levels were the issue, but even inside parts are causing stuttering. I cannot recommend this unoptimized game unfortunately.", "timestamp_created": 1767225353, "timestamp_updated": 1767225353, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.493262618780136108", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "214776268", "author": {"steamid": "76561197970639782", "personaname": "Agent of Oblivion", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/AgentOfOblivion/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 765, "playtime_last_two_weeks": 0, "playtime_at_review": 765, "last_played": 1766877092, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "revie