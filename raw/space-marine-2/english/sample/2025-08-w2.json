release_date": "1725898212", "reactions": []}, {"recommendationid": "202213675", "author": {"steamid": "76561199123546690", "personaname": "PrvtSnickers", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199123546690/", "num_games_owned": 154, "num_reviews": 42, "playtime_forever": 1388, "playtime_last_two_weeks": 0, "playtime_at_review": 1388, "last_played": 1755226345, "avatar": "79d3fe5839617eb83a9661071ed021dd56ac8a5b"}, "language": "english", "review": "Completed the campaign and some of the Operations co-op missions and as someone who knows nothing about Warhammer or has played any games before, this game OOZES COOL. Everything from the combat, the armor, the enemies, the ships, all of it so damn badass. This has been the closest thing to Gears Of War I've played and I have been having so much fun with it. It's better with friends and the graphics are fantastic. \r\n\r\nMy only gripe is how unbelievably stingy the rewards are for cosmetics/loadouts. For such a lack of variety of game modes, there should be way more avenues to gain points for these things. Also, really bummed me out to get SO MUCH DLC with the Ultimate Edition but I cannot equip anything without the currency to unlock it. AND you cannot use any of it in the campaign. That's pretty disappointing.", "timestamp_created": 1755299793, "timestamp_updated": 1755299793, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "202212723", "author": {"steamid": "76561198063647475", "personaname": "Zero Cool", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198063647475/", "num_games_owned": 0, "num_reviews": 99, "playtime_forever": 281, "playtime_last_two_weeks": 0, "playtime_at_review": 226, "last_played": 1767593440, "avatar": "ddcdc9af5affe564873756f64ef35dd84c23955c"}, "language": "english", "review": "Very cool gears of war style third person shooter in the warhammer universe.  Playing as a space marine is satisfying.  All the powerful weapons with swarms of enemies.  The game will constantly throw you opportunities to try different weapons.  Graphics look great with great gameplay.  If you’re a fan of third person shooters with a flood of enemies this is definitely one to try.", "timestamp_created": 1755298529, "timestamp_updated": 1755298529, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}, {"recommendationid": "202212474", "author": {"steamid": "76561198191933335", "personaname": "furotsu", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/vlad_frol/", "num_games_owned": 490, "num_reviews": 89, "playtime_forever": 201, "playtime_last_two_weeks": 0, "playtime_at_review": 201, "last_played": 1749196128, "avatar": "7888f8c9dfe5b55a0625b0ac3f344db1f946db28"}, "language": "english", "review": "Boring", "timestamp_created": 1755298189, "timestamp_updated": 1755298189, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.472972989082336426", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1725898212", "reactions": []}]}