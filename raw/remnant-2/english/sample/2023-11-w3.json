ver": 2557, "playtime_last_two_weeks": 0, "playtime_at_review": 2557, "last_played": 1690648449, "avatar": "49f8b95c69b7c554ba40134a8f887674ff05b3e5"}, "language": "english", "review": "Pew Pew", "timestamp_created": 1700692844, "timestamp_updated": 1700692878, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "151182189", "author": {"steamid": "76561198985506600", "personaname": "Torvenius", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198985506600/", "num_games_owned": 111, "num_reviews": 3, "playtime_forever": 9623, "playtime_last_two_weeks": 0, "playtime_at_review": 8144, "last_played": 1728174812, "avatar": "f05078aef280b9317cafb9c8c69accaf68b28da3"}, "language": "english", "review": "Built craft/theory craft your way through countless permutations of overworld and dungeons. I come from Destiny 2, and honestly I can't get enough of this formula from Gunfire Games. The base game was a smash hit for me in all the right ways with decisions having meaning to your story line and the difficulty of bosses feeling very souls like. Learn the mechanics, train to dodge at the right times, if you fail mix up the strategy and try again. I love this game so much, thanks Gunfire Games crew you all rock!!", "timestamp_created": 1700692723, "timestamp_updated": 1700692723, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "151180276", "author": {"steamid": "76561198089233784", "personaname": "Hoodra", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Ho0dra/", "num_games_owned": 110, "num_reviews": 4, "playtime_forever": 678, "playtime_last_two_weeks": 0, "playtime_at_review": 666, "last_played": 1724103582, "avatar": "e557fbe113ffed0626a0a0897f6af189b77718f7"}, "language": "english", "review": "I like this game a lot. Bought it hoping for a souls-like shooter and it is pretty much what I got. \n+Boss battles have so far been very good.\n+Exploration feels rewarding, espically in the handcrafted areas.\n+Lots of secrets to find, including secret classes (very bold decision imo but respect)\n+Have only been in two zones so far but the enemy designs have been very different both visually and mechanic wise.\n-Some minor bosses have been quite bland.\n-Quite difficult game to run (I have a GTX 1070) but looks surprisingly good even on lower settings.", "timestamp_created": 1700692129, "timestamp_updated": 1700692129, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "151179419", "author": {"steamid": "76561198215844524", "personaname": "art ♪", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ReoIAK/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 1215, "playtime_last_two_weeks": 0, "playtime_at_review": 311, "last_played": 1775183763, "avatar": "c7a15578243721caeda6f123a7bbedb6515376e9"}, "language": "english", "review": "so far its awesome", "timestamp_created": 1700691869, "timestamp_updated": 1700691869, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.519999980926513672", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "ap