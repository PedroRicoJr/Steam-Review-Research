orever": 2494, "playtime_last_two_weeks": 0, "playtime_at_review": 1289, "last_played": 1700724762, "avatar": "118167215b3f6eed50797e45152d0efba55c466b"}, "language": "english", "review": "Received a a gift - Very fun - I liked it way better as Co-op vs. single player.", "timestamp_created": 1699317554, "timestamp_updated": 1699317554, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.517045438289642334", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149679985", "author": {"steamid": "76561198016643186", "personaname": "Utaru", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198016643186/", "num_games_owned": 552, "num_reviews": 46, "playtime_forever": 1955, "playtime_last_two_weeks": 0, "playtime_at_review": 1856, "last_played": 1699322237, "avatar": "9cf396a0da9cb87d7faefe58feeae7acf6e2b363"}, "language": "english", "review": "Playing through the game as a melee focused class and creating a build that capitalizes on your advantages in melee is a lot of fun. Every new ring adds a new interesting trade-off and new build possibilities.\n\nThen you hit the first boss that flies, or sits over a void out of melee range. And you kinda sigh, and shrug, and watch as your friends carry your lack of damage. You tell yourself that you'll be fine, that this is just a one-off boss not meant for you.\n\nThen the next boss is also impossible or nigh-impossible to melee. And the one after that, and the one after that. As you play through this game as a melee build, you will progress through every stage of grief, one boss at a time.\n\nThe only question you have to ask yourself is whether you'll stay a stubborn melee character and go insane, or if you'll reach acceptance and reroll your character. Either way, hopefully I've saved someone some time before they try and play a melee build. Unfortunately I can't recommend this game at full price with such an egregious flaw in the game's design, but the game was fun for what else there was.", "timestamp_created": 1699317478, "timestamp_updated": 1699317478, "voted_up": false, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.443325519561767578", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": [{"reaction_type": 6, "count": 1}]}, {"recommendationid": "149679787", "author": {"steamid": "76561198331994403", "personaname": "Detective McSmogg", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198331994403/", "num_games_owned": 46, "num_reviews": 4, "playtime_forever": 1252, "playtime_last_two_weeks": 0, "playtime_at_review": 943, "last_played": 1701397753, "avatar": "d9e7d21259fbac54b36c921bf2806a8ba0600e38"}, "language": "english", "review": "sick game.", "timestamp_created": 1699317108, "timestamp_updated": 1699317108, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149679485", "author": {"steamid": "76561199190547875", "personaname": "Malteser", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199190547875/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 265, "playtime_last_two_weeks": 0, "playtime_at_review": 242, "last_played": 1727255594, "avatar": "6197d2890b2969a5f965fd955c3faeb164de14bf"}, "language": "english", "review": "Fun, puzzles and co-op...what else do you need?", "timestamp_created": 1699316625, "timestamp_updated": 1699316625, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149678700", "author": {"steamid": "76561198002967714", "personaname": "chenqiangpan", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/chenzhuo/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 1944, "playtime_last_two_weeks": 0, "playtime_at_review": 1132, "last_played": 1699879087, "avatar": "e0345d95a99a0280d31aaec05676eaad7a125d2c"}, "language": "english", "review": "I was at Losomn ready to meet Red Prince, two players joined, half hour later, I saw game credits...what happened? where was I? why I am here?", "timestamp_created": 1699315436, "timestamp_updated": 1699315436, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.527897000312805176", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149674891", "author": {"steamid": "76561198380571950", "personaname": "ThrobbingUncle", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ThrobbingUnlce/", "num_games_owned": 236, "num_reviews": 145, "playtime_forever": 1742, "playtime_last_two_weeks": 0, "playtime_at_review": 1688, "last_played": 1782665914, "avatar": "23587112c2045a280b9a24dcfe0c30b68527a6c9"}, "language": "english", "review": "TLDR: Better than the first, by quite a bit but I don't think it's for me.\n\nIf you are a fan of the first, you'll love this. It improves on Remnant 1 in every aspect. The highlight improvement for me is the environments and world design, a close second is the multi-class-ish type of builds you can do. \nI enjoyed a lot of my time with this game, but I did not finish it. I got real tired of fighting swarms of enemies. Playing co-op feels almost essential to get the most out of this experience, but playing solo just isn't fun for me. The game doesn't feel designed around it being a solo adventure, with some areas & bosses feeling a quite unfun and needlessly tedious to get through. However, these same areas feel like a well balanced challenge in co-op. \n\nTry it out if you liked the first, and with a friend for the best experience.", "timestamp_created": 1699309405, "timestamp_updated": 1699309405, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149674607", "author": {"steamid": "76561198008059855", "personaname": "TheMan489", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198008059855/", "num_games_owned": 0, "num_reviews": 62, "playtime_forever": 652, "playtime_last_two_weeks": 0, "playtime_at_review": 252, "last_played": 1701315529, "avatar": "deabe7ff5ba0c553bae1ff3f65e3c8baafc62f02"}, "language": "english", "review": "I went back and forth on whether or not I should recommend this game to other players, but despite its flaws, yes, I would. It's buggy and janky with a wildly incomprehensible story and some oftentimes \"wait, where am I supposed to go next?\" moments, but it's a really fun shoot-em-up with friends that's simply damn fun. Any friend group of 2-3 looking to just kick ass in a pseudo-Gears style combat system will at minimum be amused and hopefully be pleasantly surprised by this title.", "timestamp_created": 1699309000, "timestamp_updated": 1699309000, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149674174", "author": {"steamid": "76561198858474927", "personaname": "Majora", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198858474927/", "num_games_owned": 58, "num_reviews": 5, "playtime_forever": 11542, "playtime_last_two_weeks": 0, "playtime_at_review": 6984, "last_played": 1787849577, "avatar": "392ef6fb5eb27cf118822c0988dc2c5017b361a8"}, "language": "english", "review": ".", "timestamp_created": 1699308343, "timestamp_updated": 1699308343, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149671583", "author": {"steamid": "76561198889011512", "personaname": "Preda", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/PredaR6/", "num_games_owned": 62, "num_reviews": 2, "playtime_forever": 7600, "playtime_last_two_weeks": 0, "playtime_at_review": 1048, "last_played": 1701648664, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "nice game!", "timestamp_created": 1699304921, "timestamp_updated": 1699304921, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "149671088", "author": {"steamid": "76561198803386134", "personaname": "levz", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198803386134