imarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "203816585", "author": {"steamid": "76561197987340422", "personaname": "StickyStallion", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197987340422/", "num_games_owned": 1063, "num_reviews": 80, "playtime_forever": 1861, "playtime_last_two_weeks": 0, "playtime_at_review": 1861, "last_played": 1757296619, "avatar": "47e16a63eb7da7a0e213c672b71d58f3b154d2f4"}, "language": "english", "review": "Game is way too easy compared to the first one. Absolutely loved the series and the first one is a masterpiece on the hardest difficulty. This one just let me down. Beating bosses on the first try and even killing them before seeing their whole kit is ridiculous.  The 1st one is just better in every way.  Please buff the difficulty scaling for HP/damage on the bosses.", "timestamp_created": 1757268091, "timestamp_updated": 1759891679, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.484228014945983887", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "203815579", "author": {"steamid": "76561198085146041", "personaname": "Duckncover", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198085146041/", "num_games_owned": 319, "num_reviews": 23, "playtime_forever": 2357, "playtime_last_two_weeks": 0, "playtime_at_review": 55, "last_played": 1760930489, "avatar": "3124d2bb20016ea3389daf161e45776a40ad2abd"}, "language": "english", "review": "Crash on Every Cut scene near it's end I assume, and character who is supposed to open a door with me bugs out and can't be prompted to move so I have to reload and start the segment again. Nice only 10 mins in btw sick game, the performance leaves a lot to be desired too. Fixes prob exist but that's not my job, I pay for a game to be working not a buggy mess.", "timestamp_created": 1757267345, "timestamp_updated": 1757267345, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "203795779", "author": {"steamid": "76561198139302926", "personaname": "mauricio_david93", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198139302926/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 13677, "playtime_last_two_weeks": 0, "playtime_at_review": 12274, "last_played": 1757479486, "avatar": "da7c52d6271004609b9ce0c33ce105a96486bdb5"}, "language": "english", "review": "Amazing game! Maybe some secrets are a bit too obtuse, but you can find a lot of stuff by yourself if you pay attention to your surroundings. The build crafting is phenomenal and most of the guns are really fun to play around. Bosses and dungeons are pretty cool, and the lore/world building is surprinsingly good and deep. Also, the voice actors are great. My two advices for new players, start on survivor, as this is the intended experience for newcommers, and don't upgrade your guns until you have a lot of resources, and when you do it, put only two or three levels max, this way you would still be able to use any new gun you find, without needing to gather more materials to upgrade it and make it work for the current power level of the world", "timestamp_created": 1757253407, "timestamp_updated": 1757253407, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}]}