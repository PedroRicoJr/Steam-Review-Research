ck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "215416290", "author": {"steamid": "76561198072706188", "personaname": "spenstarprime", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198072706188/", "num_games_owned": 810, "num_reviews": 18, "playtime_forever": 5572, "playtime_last_two_weeks": 0, "playtime_at_review": 4950, "last_played": 1769712991, "avatar": "752eb38c3b0bc6f74708ec2c3d44d00bda41edde"}, "language": "english", "review": "Love this game, been a fan since the original which I also played through multiple times. Good replay value, great solo game, and lots of fun with friends. Classes feel distinct, but customizable enough to play the game however you want. There are some deep secret unlockables though, so would recommend looking at an online guide to assist you with this, as there are definitely some things you wouldn’t be able to find on your own.", "timestamp_created": 1767806608, "timestamp_updated": 1767806608, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "215411419", "author": {"steamid": "76561199007248176", "personaname": "wolvi", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/wolvi77/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 2197, "playtime_last_two_weeks": 0, "playtime_at_review": 2197, "last_played": 1767801373, "avatar": "dbcdbb34cb5bea931f476735d56306450274f8af"}, "language": "english", "review": "A very nice game, the worlds and level design are amazing. A plethora of secrets: some nice and simple, some genius and some literally impossible to find alone. Interesting npcs found as you explore, interesting boss and combat events. Sucks that you cant find every item and boss in your first run, I was not a big fan of the procedurally generated sections and the little amount of currency you get throughout the game. But otherwise its got a rather immersive story and gameplay, I recommend this game.", "timestamp_created": 1767802525, "timestamp_updated": 1767802525, "voted_up": true, "votes_up": 6, "votes_funny": 1, "weighted_vote_score": "0.546979904174804688", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": [{"reaction_type": 29, "count": 1}, {"reaction_type": 17, "count": 1}]}, {"recommendationid": "215401444", "author": {"steamid": "76561198072547218", "personaname": "Codoriano", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/Smd42069/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 2338, "playtime_last_two_weeks": 0, "playtime_at_review": 2242, "last_played": 1767800222, "avatar": "933860e5e7817b0fcb301f52c49fe266328fec3d"}, "language": "english", "review": "Offers a ton of replayability, grinding is part of the journey and the amount of secrets in the game is a lot. Better experience if playing co op with friends.", "timestamp_created": 1767794238, "timestamp_updated": 1767794238, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}]}