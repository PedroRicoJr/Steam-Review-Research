e": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "158312464", "author": {"steamid": "76561198818167462", "personaname": "想想小黄怎么送", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198818167462/", "num_games_owned": 59, "num_reviews": 7, "playtime_forever": 14597, "playtime_last_two_weeks": 0, "playtime_at_review": 12177, "last_played": 1732152676, "avatar": "5a1520a6d29df85aa7847d53ded031b550512b1b"}, "language": "english", "review": " 十分推荐喜欢探索收集魂类射击的小伙伴。\n已知的bug：耶莎无名巢穴灵智之母开boss之后有队友之后加入再进boss，后来进的队友会直接死。有关工程师炮台bug太多，我怀疑设计师不玩工程师。", "timestamp_created": 1707926632, "timestamp_updated": 1707926632, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "158308586", "author": {"steamid": "76561198429198928", "personaname": "Nacho", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198429198928/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 971, "playtime_last_two_weeks": 0, "playtime_at_review": 971, "last_played": 1707921676, "avatar": "a380f52deb411de08eb28aa0fe564d77cf437569"}, "language": "english", "review": "The 16 hours of Gameplay was amazing put not worth the full price of the game, I do wish it was a lot longer but oh well", "timestamp_created": 1707923119, "timestamp_updated": 1707923119, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.449917227029800415", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "158307433", "author": {"steamid": "76561197993515962", "personaname": "SlackerSupreme", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/slackersupreme/", "num_games_owned": 253, "num_reviews": 24, "playtime_forever": 46664, "playtime_last_two_weeks": 0, "playtime_at_review": 35344, "last_played": 1715371369, "avatar": "bcf17f766f9c80c5ed071f434a140c4b6f075151"}, "language": "english", "review": "I highly recommend this game if you enjoyed Remnant from the Ashes. This sequel introduces way more options for creating builds even at the cost of no longer combining different armor sets for different set bonuses. The only issue I've encountered was that the matchmaking often put me in a game where the host was from the other side of the globe which made the latency annoying. But they later implemented the option to select regions for the matchmaking and after clearing the first DLC I'm patiently waiting for the next DLC to be announced.\n\nMy GPU isn't optimal for the game but ran well enough (Nvidia Geforce 1060 3GB)", "timestamp_created": 1707922025, "timestamp_updated": 1707922025, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}]}