: true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "200463462", "author": {"steamid": "76561198085657717", "personaname": "Kroxin", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Kroxin/", "num_games_owned": 288, "num_reviews": 59, "playtime_forever": 13958, "playtime_last_two_weeks": 0, "playtime_at_review": 13958, "last_played": 1752862653, "avatar": "a2290f6083ea38c5a78fb04d5b2e0f3c9848f4c3"}, "language": "english", "review": "Remnant 2 delivers a solid experience, especially in co-op, which makes the challenges more engaging and dynamic. The variety of enemies and boss fights are well-designed and satisfying, with some being truly challenging at maximum difficulty. However, the game suffers from optimization issues that can affect the overall experience. The story feels rather weak, and some mechanics may become repetitive over time. Overall, it remains a valid choice for those seeking action and cooperative play, despite some technical shortcomings.\n\n", "timestamp_created": 1753303736, "timestamp_updated": 1753303736, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.533678770065307617", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "200456299", "author": {"steamid": "76561198047350542", "personaname": "Laz Caciuma", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198047350542/", "num_games_owned": 724, "num_reviews": 38, "playtime_forever": 1872, "playtime_last_two_weeks": 0, "playtime_at_review": 1640, "last_played": 1773872252, "avatar": "264c8a04aa2c618f2ac82cfd863c3cf7f70a4c90"}, "language": "english", "review": "10/10 game", "timestamp_created": 1753296049, "timestamp_updated": 1753296049, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "200451606", "author": {"steamid": "76561198452118475", "personaname": "SkullOfFortune", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198452118475/", "num_games_owned": 0, "num_reviews": 33, "playtime_forever": 74, "playtime_last_two_weeks": 0, "playtime_at_review": 74, "last_played": 1753290027, "avatar": "3f47c3634c822270cbccf23f4cb4fcf2272e23d1"}, "language": "english", "review": "For some reason kept saying it was missing a file, even afer verifying files 3 times. Then for some reason took my computer hostage and no other program could be opened, even after forcing to restart the computer and reopening steam. Then had to forcefully restart AGAIN, delete the game before opening steam and that seemed to fix my pc.\n\nTLDR:\nDon't put this game on your pc, it ♥♥♥♥♥ it over completely.", "timestamp_created": 1753290985, "timestamp_updated": 1753290985, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.47826087474822998", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}]}