ded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "152602378", "author": {"steamid": "76561198033563761", "personaname": "Keanu Thieves", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/mamasaidspockyouout/", "num_games_owned": 0, "num_reviews": 11, "playtime_forever": 3330, "playtime_last_two_weeks": 0, "playtime_at_review": 2204, "last_played": 1731565218, "avatar": "b93f04b9194fba8980a2dc74947d47d0087ba113"}, "language": "english", "review": "A fantastic follow up to the original. The weapons all have a unique feel and wide variety. The worlds are striking in both their look and design, with doors drawn in pen or opening into the ceiling of another location. Co-op is both fun and rewarding even if Id like to see a little more multi player controls. There are also a number of accessibility controls for motion sickness, but they don't include the spinning loading screens and \nelevators, or the sprint POV change. I really enjoy this game and I hope the on-the-fence \"souls\" folks who tried Elden Ring and liked it give this a shot, because its gold.", "timestamp_created": 1701375221, "timestamp_updated": 1701375221, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "152602263", "author": {"steamid": "76561198086333069", "personaname": "[Nerd]NEXiS911", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198086333069/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 796, "playtime_last_two_weeks": 0, "playtime_at_review": 423, "last_played": 1704571409, "avatar": "95e32023096230bc7aab53881be448e3d5bbb365"}, "language": "english", "re