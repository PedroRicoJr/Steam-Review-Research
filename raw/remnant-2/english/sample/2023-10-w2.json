eck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "148308147", "author": {"steamid": "76561197977081338", "personaname": "Joker_fX", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197977081338/", "num_games_owned": 139, "num_reviews": 33, "playtime_forever": 8621, "playtime_last_two_weeks": 0, "playtime_at_review": 2961, "last_played": 1698436832, "avatar": "7e0164d00b187fb532cffc026527251dd9bfb3d7"}, "language": "english", "review": "Controls are a bit wonky for keyboard and the gunplay could be better but all in all a good game.", "timestamp_created": 1697410587, "timestamp_updated": 1697410587, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.518005549907684326", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "148307667", "author": {"steamid": "76561199182537427", "personaname": "TheDude", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199182537427/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 617, "playtime_last_two_weeks": 0, "playtime_at_review": 530, "last_played": 1697421320, "avatar": "1ef4ad99cb12a11e31129f3e9e333cb2def2ca6d"}, "language": "english", "review": "It's a fun game and the fighting style is great. A little disappointed in the lack of gear and customization features. I am in the second area and there has not been once piece of gear aside from other plays gear, and different weapons which seems pretty basic since you get what you get so to speak. No random drops its all set and staged in specific areas. A lot of walking around to dead ends that add no value aside from making the game take longer. Seems kind of lazy on the creators part. All in all though the story line is great, the game is fun there is no doubt of that, and the Co-op wasn't wrecked like a lot of games tend to do these days. You can save your progress with or without a friend etc but you both get the same exact drops regardless of who is picking it up so there's no competitiveness with your Co-op partner. We all know we want to be better than our friends... lol Overall, id recommend to a friend.", "timestamp_created": 1697409785, "timestamp_updated": 1697409785, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "148307474", "author": {"steamid": "76561199157714581", "personaname": "trashpanda", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199157714581/", "num_games_owned": 111, "num_reviews": 13, "playtime_forever": 3041, "playtime_last_two_weeks": 0, "playtime_at_review": 524, "last_played": 1700628331, "avatar": "1acd843b3b58fdbcf3d1a8f48a61ffccc287e980"}, "language": "english", "review": "I totally underestimated the amount of replay ability in this game!!! I haven't even left the first world yet, as there is so much to find!", "timestamp_created": 1697409436, "timestamp_updated": 1700628315, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "148305396", "author": {"steamid": "76561198155505613", "personaname": "GRIZZ", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/w0g1y0/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 1511, "playtime_last_two_weeks": 0, "playtime_at_review": 1511, "last_played": 16974