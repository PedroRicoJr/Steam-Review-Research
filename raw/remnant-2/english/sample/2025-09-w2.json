app_release_date": "1690300800", "reactions": []}, {"recommendationid": "204394274", "author": {"steamid": "76561198025140062", "personaname": "Laitar", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198025140062/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 16395, "playtime_last_two_weeks": 0, "playtime_at_review": 16391, "last_played": 1769596788, "avatar": "b69fa3acb425a7f0c260172f165a391504626930"}, "language": "english", "review": "Soulslike philosophy combined with gunplay. The minute-to-minute gameplay is satisfying, but the customization available for designing a character build that works for your playstyle is what keeps me coming back.\n\nWhen I started, I couldn't complete the first dungeon. When I finished, I'd beaten the game on the hardest difficulty.\n\nRecommendation: \n• if you enjoy soulslikes and shooters, this is a best-in-show performance—I think you'll love this.\n• If you like one of those, and aren't averse to the other, your intuition form the genre you enjoy will give you a leg up, and you might really love this.\n• If you aren't already a fan of one of these genres, it could definitely overwhelming or frustrating: approach with caution.", "timestamp_created": 1757940642, "timestamp_updated": 1757940642, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}]}