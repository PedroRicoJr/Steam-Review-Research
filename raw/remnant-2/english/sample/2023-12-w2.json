aytime_at_review": 872, "last_played": 1770329332, "avatar": "38f0b6f28a6037fa5814bce75813a61652667a70"}, "language": "english", "review": "crazy hard but fun", "timestamp_created": 1702679657, "timestamp_updated": 1702679657, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "153671759", "author": {"steamid": "76561198436890428", "personaname": "Ludwisch", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198436890428/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 18328, "playtime_last_two_weeks": 0, "playtime_at_review": 8910, "last_played": 1731278332, "avatar": "6330c0531c83e7262767b52a29728f6801bcc289"}, "language": "english", "review": "greatest game of 2023", "timestamp_created": 1702678892, "timestamp_updated": 1702678892, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "153670221", "author": {"steamid": "76561199486099222", "personaname": "p.7md", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199486099222/", "num_games_owned": 0, "num_reviews": 56, "playtime_forever": 204, "playtime_last_two_weeks": 0, "playtime_at_review": 204, "last_played": 1702677075, "avatar": "9ae1084a4ecd2a12ebec3b2282d961ca111c677e"}, "language": "english", "review": "Bad and really bad game. The HP goes down very fast. It's really unprofessional game. Boring as well. I don't know how this game have positive review. You just play in unknown place and unknown objectives. I wish if there was a demo for this game, so that i will not waste my money in such stupid game. Hope these games got banded from all platforms.", "timestamp_created": 1702677254, "timestamp_updated": 1702677254, "voted_up": false, "votes_up": 0, "votes_funny": 2, "weighted_vote_score": "0.384615391492843628", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "153670188", "author": {"steamid": "76561199180837128", "personaname": "black-_-heart", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199180837128/", "num_games_owned": 262, "num_reviews": 83, "playtime_forever": 189, "playtime_last_two_weeks": 0, "playtime_at_review": 189, "last_played": 1702677069, "avatar": "888f5a2ce4ff96e6d8b3016e80b718d736a25947"}, "language": "english", "review": "Horrible game. not recommend for wasting time on this miserable useless game.", "timestamp_created": 1702677226, "timestamp_updated": 1702677226, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.434782594442367554", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "153663823", "author": {"steamid": "76561198030420519", "personaname": "DorcasAurelia", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/dorcasaurelia/", "num_games_owned": 0, "num_reviews": 53, "playtime_forever": 13555, "playtime_last_two_weeks": 0, "playtime_at_review": 9530, "last_played": 1750372254, "avatar": "40b0f00510a73dd3ad3240a494dfab167493246d"}, "language": "english", "review": "First thing: I don't think the game tells you, but to use class abilities, you need to hold down the button for healing then the respective class skill button.\n\nProbably the best part of the game is build variety. There is a good variety of guns and bows, and they're all viable. The downside is that since zones (and enemies) scale with your highest upgraded weapons, it can be expensive early on to try out different weapons unless you don't upgrade very much.\n\nEnemy variety is also strong. Each biome has distinct enemies. Boss design has shifted a bit from the first game to be less dependent on minions for difficulty and more on the main boss itself, which is a positive. Also, the game's final boss is one of the most unique boss fights I've encountered in video games, especially shooters. The main complaint I have about combat is that basically all enemies tend to employee delayed attacks that punish you if you try to dodge instinctively. The times are easy enough once you learn them, but feel unnecessarily punishing on initial encounters.", "timestamp_created": 1702670452, "timestamp_updated": 1702670562, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "153661797", "author": {"steamid": "76561197991283900", "personaname": "hakb", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hakb/", "num_games_owned": 0, "num_reviews": 27, "playtime_forever": 5018, "playtime_last_two_weeks": 0, "playtime_at_review": 4393, "last_played": 1767906788, "avatar": "8b2c635f87d0c4f507405c64e334b978d2364152"}, "language": "english", "review": "Nice", "timestamp_created": 1702668391, "timestamp_updated": 1702668391, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": []}, {"recommendationid": "153651785", "author": {"steamid": "76561198004646918", "personaname": "Darlock", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198004646918/", "num_games_owned": 0, "num_reviews": 80, "playtime_forever": 9911, "playtime_last_two_weeks": 60, "playtime_at_review": 3438, "last_played": 1788354779, "avatar": "cd5621ee55e604a7d8759bccbf7bd118c53d156d"}, "language": "english", "review": "Surprisingly good.\nWay better than Remnant 1 in almost every way. Completely delivers on the idea of \"Soulslike with guns\".\nBuild variety and replayability? Double check.\nFun and satisfying combat? Check. Guns feel great, abilities and mods are properly impactfull, dodges feel great and fun to use. This game boasts probably the best neutral dodge in any soulslike. Kinda makes me think why backsteps don't have any iframes in other soulslikes.\nAppropriate level of challenge? Check. I also hate cubes now.\nLocations are still kinda meh. I wish Yaesha looked like it was in Remnant 1. Now it is all red like earth was in Remnant one. Booo-ring. Two other locations are way too gray. This game could stand to get a splash of colour.\nBosses?\nThey are kinda hit or miss, but this game also gave me two of my most favorite bosses ever. Shoutout to Annihilation and the Red Prince. I like them so much I can't really find any flaw with either one of them. \nSome bosses are real stinkers though, and it is almost surprising that they are in the same game as the good ones.\nOverall? Great. Can't wait for the sequel or other games from the developers.", "timestamp_created": 1702658057, "timestamp_updated": 1702658057, "voted_up": true, "votes_up": 17, "votes_funny": 1, "weighted_vote_score": "0.606434345245361328", "comment_count": 3, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1690300800", "reactions": [{"reaction_type": 19, "count": 1}, {"reaction_type": 5, "count": 1}]}, {"recommendationid": "153642027", "author": {"steamid": "76561197971188876", "personaname": "X, the Everything app", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/sweetyoungpure/", "num_games_owned": 384, "num_reviews": 14, "playtime_forever": 482, "playtime_last_two_weeks": 0, "playtime_at_review": 482, "deck_playtime_at_review": 270, "last_played": 1702649085, "avatar": "0c6e2218841210ddff9b0cab32339e67c2ae6182"}, "language": "english", "review": "Absolute hogslop\nReddit", "timestamp_created": 1702649164, "timestamp_updated": 1702649164, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.455032795667648315", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": true, "app_release_date": "1690300800", "reactions": []}]}