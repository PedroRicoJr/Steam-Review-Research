92372830, "voted_up": false, "votes_up": 9, "votes_funny": 0, "weighted_vote_score": "0.579628229141235352", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1644587089", "reactions": []}, {"recommendationid": "144434886", "author": {"steamid": "76561198070616040", "personaname": "Neyreyan_Youtube", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198070616040/", "num_games_owned": 777, "num_reviews": 487, "playtime_forever": 56, "playtime_last_two_weeks": 0, "playtime_at_review": 56, "last_played": 1692279405, "avatar": "b2c0f6ee35e24dd0c577dfc3d873ea005e0da8c2"}, "language": "english", "review": "Doesn't feel like this game had good updates in the early access period. The game is fun for maybe 10-15 hours but it's too simplistic and once you learn the only map you play on, it's just repetitive. https://www.youtube.com/watch?v=WGn6pzK7Dw8\nPro: easy to play and learn, nice enviroment on the beach, looting is good, character builds are solid, permanent upgrades\nCons: clunky controls, clunky camera, static map, not much in terms of content, it's always a slow start, learning the map makes the game boring because you always do the same things for eficiency.\nMy review would have been positive but i feel like 20 euros for this game in 2023 is not worth it because we have much better games at this price", "timestamp_created": 1692301578, "timestamp_updated": 1692301594, "voted_up": false, "votes_up": 5, "votes_funny": 0, "weighted_vote_score": "0.46807977557182312", "comment_count": 0, "steam_purchase": false, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1644587089", "reactions": []}]}