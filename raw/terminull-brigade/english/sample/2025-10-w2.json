0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1753830060", "reactions": []}, {"recommendationid": "206615270", "author": {"steamid": "76561197982968002", "personaname": "Kanryb", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/kanryb/", "num_games_owned": 0, "num_reviews": 79, "playtime_forever": 775, "playtime_last_two_weeks": 0, "playtime_at_review": 568, "last_played": 1764588009, "avatar": "e0de397fdbf784c5d476b1bad516af53e33f5d7f"}, "language": "english", "review": "This game is for you if you’re looking for a quick running and gunning game. \r\nYou pick among a handful of characters and then go into these levels divided into segments where you after each segment, you pick between 3 different upgrades. These upgrades are only for that level. What you carry on is the xp, which you use to better that char and your account. The content as of now is somewhat limited, but with more support, I think they’ll add more.\r\nIt’s free and co op, so why not try it out.\r\nThe paywall only hits when you want new skins, not when it comes to content. At least for now. \r\nI’ve had no crashes or stuttering issues.", "timestamp_created": 1760338901, "timestamp_updated": 1760338901, "voted_up": true, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.578747749328613281", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1753830060", "reactions": []}, {"recommendationid": "206529266", "author": {"steamid": "76561199747904569", "personaname": "TTV Sotek_Shotz", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199747904569/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 1077, "playtime_last_two_weeks": 0, "playtime_at_review": 611,