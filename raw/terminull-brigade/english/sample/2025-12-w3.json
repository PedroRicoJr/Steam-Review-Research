_early_access": false, "primarily_steam_deck": false, "app_release_date": "1753830060", "reactions": []}, {"recommendationid": "213563902", "author": {"steamid": "76561199202185771", "personaname": "Kawzier", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Kawzier/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 9, "playtime_last_two_weeks": 0, "playtime_at_review": 9, "last_played": 1766061483, "avatar": "0c80eec3681a188121bd91d4afc99b5406642190"}, "language": "english", "review": "Such a bad game it is rediculous, this game is just Concord, but it actually stuck around for more than 2 days, somehow, and whoever owns the Envangelion brand decided to make the mistake of allowing them to do a collab with their IP in such an utterly awfully terrible piece of trash of a game, there is utterly nothing to like here except for Asuka and Rei and then... then every single part of this garbage does everything it possibly can to make the game worse.\n\nThe performance is literally worse than Cities Skylines 2, you will experience on the lowest possible settings hitching and stuttering every 30 plus or minus seconds to the level where you have to wait for at minimum 10 seconds, and then it will run great for 30 seconds and then you wait 10 seconds to keep playing, what trash this is!\n\nThe UI is utter trash on another level! Why is there so many buttons and then more buttons leading to more buttons! Who made this garbage dump of a game for crying out loud!\n\nAnd then there's the bloomin' gameplay for crying out load, what the heck even is it, where is it for that matter? Why am I playing this game? Just to suffer, well I'm not, not anymore, that's for sure!", "timestamp_created": 1766062097, "timestamp_updated": 1766062228, "voted_up": false, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.474300801753997803", "comment_count": 3, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_ac