y.com/profiles/76561199554451272/", "num_games_owned": 23, "num_reviews": 6, "playtime_forever": 2027, "playtime_last_two_weeks": 0, "playtime_at_review": 2027, "last_played": 1781647205, "avatar": "074f8a3b6788212d6276d87d63a96ab1590fb717"}, "language": "english", "review": "the game is really unoptimized", "timestamp_created": 1784215144, "timestamp_updated": 1784215144, "voted_up": false, "votes_up": 8, "votes_funny": 0, "weighted_vote_score": "0.622805476188659668", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1753830060", "reactions": []}, {"recommendationid": "230431358", "author": {"steamid": "76561199728908260", "personaname": "b4strd", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199728908260/", "num_games_owned": 25, "num_reviews": 15, "playtime_forever": 804, "playtime_last_two_weeks": 0, "playtime_at_review": 804, "last_played": 1776899643, "avatar": "68e5a4970eb027ab150627572d0a475d171e0e21"}, "language": "english", "review": "evangelion", "timestamp_created": 1784003402, "timestamp_updated": 1784003402, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.490099012851715088", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1753830060", "reactions": []}, {"recommendationid": "229578207", "author": {"steamid": "76561198357350874", "personaname": "videoplấybAckلاً\",/🅱67", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/qwqQwertyuioplkjh1234567890eo/", "num_games_owned": 295, "num_reviews": 230, "playtime_forever": 111671, "playtime_last_two_weeks": 8801, "playtime_at_review": 88211, "last_played": 1788427475, "avatar": "35c90d97dcfda0d2bd79cb5828da51e51350f6e3"}, "language": "english", "review": "TL;DR -Overall, I really like what TermiinulI  bvrigaedse is is, especially as a title offered way below the $70 usual price, and you should try it for yourself, but I do feel a little frustrated now and then because the gameplay can feel clunky. It also has a pause function! Game has really bad FPS stuttering problems. Game is unplayable in its current state. Wait for an update to fix this, if it ever comes.\r\n\r\nI \"recommend\" this game with some hesitation because there are some caveats. AI Limit is an interesting, compelling \"Souls-Lite\" with a world I'm interested in learning more about, and the gameplay is decent.\r\n\r\nIt's important to really understand that. The gameplay is DECENT not great. There are some quirks with the mechanics that make it feel clunky. Some animations you lock-into Monster Hunter style, there are some you can cancel out of, but only sometimes, and while I'm sure there's consistency to it, in real-time, a lot of animation canceling (or lack thereof) feels random, making it difficult to figure out if it's all intentional, or not. It leads to gaemplay that feels inconsistent and clunky, despite being built on a very solid foundation.\r\n\r\nI call AI Limit a \"Souls-Lite\" because of several stand-out features that I think many people may be interested in. Firstly, you don't loose all of your currency when you die, only a portion of it, but the trade-off is that what you do lose cannot be recovered. Secondly, there's no Stamina bar, leading the game to feel like more of an ARPG that perhaps flows a little better than Souls games where you need to manage a Stamina Bar. Perhaps most importantly, you can in fact pause the game by accessing the in-game menu.\r\n\r\nThe level design is really interesting, though I can see some people getting overwhelmed and lost easily at times.\r\n\r\nThis is not a $70 dollar game. Wait for a Steam Sale when it's been discounted to $20 or $30. While the game is generally fun, it doesn't have a lot of depth to the combat and it's pretty buggy. Overall, pretty goodbugs but trash devs\r\n\r\nGame has really bad FPS stuttering problems. Game is unplayable in its current state. Wait for an update to fix this, if it ever comes.\r\n", "timestamp_created": 1783162026, "timestamp_updated": 1783162026, "voted_up": false, "votes_up": 2, "votes_funny": 1, "weighted_vote_score": "0.434537261724472046", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1753830060", "reactions": []}]}