, "profile_url": "https://steamcommunity.com/profiles/76561198076649138/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 2242, "playtime_last_two_weeks": 0, "playtime_at_review": 2242, "last_played": 1672690376, "avatar": "8f7738b76a580bb51aedbd874ed9facb6ef335e0"}, "language": "english", "review": "Great Mass Effect game. Although the ending is not the best it could have been, the game is still fantastic giving you a ton of options, having multiple paths, tons of different conversations with the crew-members, funny and emotional. It's a great finale to the series and after the Mass Effect one we have not gotten any single series that has stuck with me for such a long time. I love the characters and the world they created. I only wish there was more but I guess all great things must come to an end.\n\nWish these types of games were more common. Took me about 34 hours to complete while doing all side missions.", "timestamp_created": 1672694910, "timestamp_updated": 1672694910, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}