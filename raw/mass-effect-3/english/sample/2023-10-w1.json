t_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "148334163", "author": {"steamid": "76561199215796652", "personaname": "Wordzmith", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/wordzmith/", "num_games_owned": 13, "num_reviews": 6, "playtime_forever": 887, "playtime_last_two_weeks": 0, "playtime_at_review": 495, "last_played": 1697486634, "avatar": "61de4406eb3d39636a167de86e203f2104a36860"}, "language": "english", "review": "The best Sci-Fi Action RPG ever made!!! If you don't like it you don't belong in the gaming community!", "timestamp_created": 1697463059, "timestamp_updated": 1697463059, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": "0.479683965444564819", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "148050150", "author": {"steamid": "76561198066813527", "personaname": "Father Ted Gaming", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/hiimtom/", "num_games_owned": 0, "num_reviews": 40, "playtime_forever": 1806, "playtime_last_two_weeks": 0, "playtime_at_review": 1297, "last_played": 1720717628, "avatar": "0c4cede17de94b3dff3f6b2193eebd13f4bc5ef2"}, "language": "english", "review": "The game is great, HOWEVER I cannot recommend the Steam version because of EA's godawful customer support and DRM. No matter what you do, it cannot log you in as the DRM relies on Origin, which was shut down a few years ago, and EA never bothered to fix anything that might have used it. Basically, it locks you out of playing the game that you paid for!!\n\nIf you buy the Steam version, to get it to work you have to download it through EA's app. If your Steam and EA accounts are synced, it should already be in your EA library. After installing it, Steam should detect it and you can play it through Steam as usual without issue, with achievements etc. Still a massive pain.\n\nIn short, ♥♥♥♥ EA.", "timestamp_created": 1697065356, "timestamp_updated": 1697065578, "voted_up": false, "votes_up": 24, "votes_funny": 1, "weighted_vote_score": "0.726560652256011963", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}