": "1591887286", "reactions": []}, {"recommendationid": "92417644", "author": {"steamid": "76561198798468051", "personaname": "charlesedwardclive", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198798468051/", "num_games_owned": 185, "num_reviews": 4, "playtime_forever": 416, "playtime_last_two_weeks": 0, "playtime_at_review": 416, "last_played": 1642169383, "avatar": "0f6b66192a40400a5361a2509d7561809feeaf3c"}, "language": "english", "review": "Because of the new origins privacy policy ME3 must now run on the origin servers which doesn't even work you can't even launch the game now.", "timestamp_created": 1621698904, "timestamp_updated": 1621698904, "voted_up": false, "votes_up": 25, "votes_funny": 0, "weighted_vote_score": "0.704543054103851318", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": [{"reaction_type": 6, "count": 1}]}, {"recommendationid": "92236609", "author": {"steamid": "76561198081783510", "personaname": "Carret Top", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198081783510/", "num_games_owned": 242, "num_reviews": 2, "playtime_forever": 597, "playtime_last_two_weeks": 0, "playtime_at_review": 597, "last_played": 1621390804, "avatar": "56646db3df4888e6e7153042581aa952088ca0a6"}, "language": "english", "review": "Really glad I got the remaster. The Origin update and interface has utterly broken this game. Pursuing a refund.", "timestamp_created": 1621391199, "timestamp_updated": 1621391199, "voted_up": false, "votes_up": 15, "votes_funny": 0, "weighted_vote_score": "0.523762404918670654", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "92234412", "author": {"steamid": "76561198106452459", "personaname": "HamburgerHelper", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198106452459/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 465, "playtime_last_two_weeks": 0, "playtime_at_review": 460, "last_played": 1626032925, "avatar": "b2f3290c465f540ea62bce64282cfed7b69ace6e"}, "language": "english", "review": "The added origin launcher makes this game almost non-functional. I have attempted many times to launch the game from both here and the origin launcher, since the steam menu does not directly start the game, and each time it brings origin back up. This is really a reflection on a poorly designed steam-adjacent product shilled to us by EA in an attempt to compete with steam. The game itself is fairly fun, from what I've managed to play before not being able to launch it again (which was only about 7.5 hours or so) but I definitely will not be recommending others play it through the same client as I have. Save yourself the time and money and buy a physical version. Maybe for the xbox or something, just not through EA's origin.", "timestamp_created": 1621386703, "timestamp_updated": 1621386703, "voted_up": false, "votes_up": 10, "votes_funny": 0, "weighted_vote_score": "0.498174428939819336", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}