aytime_at_review": 854, "last_played": 1648136025, "avatar": "82072ea98fdcf56be179afe79fcb0e09e597e0d3"}, "language": "english", "review": "Suspense, drama, action, romance, humour all set in exotic locations on distant worlds. Who don't like being shep ? Being the third and final part of a splendid trilogy the actions taken in the previous games have an impact through to the final instalment of the story.\nYou fly around in a hectic race to gain support for the alliance to fight the common enemy of all life, the reapers. Along the way you face numerous problems of different kinds that call for a variety of response's to effect an optimal outcome.\nA great story and many hours of enjoyable game play even after more than a few play through's keeps this title in the top five all time greats of the gaming universe.", "timestamp_created": 1620868967, "timestamp_updated": 1620868967, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.506283104419708252", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}