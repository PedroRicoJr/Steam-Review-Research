_weeks": 22, "playtime_at_review": 287, "last_played": 1790381095, "avatar": "a4e3644d06185db8ceecd30539d2e5dedf7f3cec"}, "language": "english", "review": "Smash", "timestamp_created": 1730687950, "timestamp_updated": 1730687950, "voted_up": true, "votes_up": 3, "votes_funny": 1, "weighted_vote_score": "0.551317393779754639", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "178319917", "author": {"steamid": "76561198056673717", "personaname": "Paragonleft", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198056673717/", "num_games_owned": 331, "num_reviews": 18, "playtime_forever": 10, "playtime_last_two_weeks": 0, "playtime_at_review": 5, "last_played": 1731123923, "avatar": "dea10ef20c1d6bd2f025f42c649b989d08457d9c"}, "language": "english", "review": "Game immediately freezes when I try to load the multiplayer, which is the only reason I bought this. Everyone at EA deserves eternity in hell for ruining every game franchise they've ever touched, I truly wish the worst for every single EA employee and CEO hope there's a special layer of hell waiting for you worthless cretins.", "timestamp_created": 1730645420, "timestamp_updated": 1730645420, "voted_up": false, "votes_up": 40, "votes_funny": 9, "weighted_vote_score": "0.640912294387817383", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": [{"reaction_type": 16, "count": 2}, {"reaction_type": 18, "count": 2}, {"reaction_type": 17, "count": 1}, {"reaction_type": 19, "count": 1}, {"reaction_type": 5, "count": 1}, {"reaction_type": 6, "count": 1}, {"reaction_type": 7, "count": 1}]}, {"recommendationid": "178247665", "author": {"steamid": "7656119