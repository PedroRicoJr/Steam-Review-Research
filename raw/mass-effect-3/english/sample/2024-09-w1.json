udes all of the DLCs Mass Effect 3 has.", "timestamp_created": 1725186529, "timestamp_updated": 1725186529, "voted_up": true, "votes_up": 11, "votes_funny": 1, "weighted_vote_score": "0.661141455173492432", "comment_count": 3, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}