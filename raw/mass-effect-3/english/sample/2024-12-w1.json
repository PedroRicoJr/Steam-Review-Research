{"game": "mass-effect-3", "language": "english", "appid": 1238020, "month": "2024-12", "window": 1, "start_date": 1733011200, "end_date": 1733615999, "month_true_total": 38, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 19:54:52 UTC", "reviews": [{"recommendationid": "182107029", "author": {"steamid": "76561197998453150", "personaname": "Darkmiroku", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197998453150/", "num_games_owned": 161, "num_reviews": 3, "playtime_forever": 428, "playtime_last_two_weeks": 0, "playtime_at_review": 428, "last_played": 1733544664, "avatar": "7fc2d7b44c0af426641afa34904f3a1dc5ada809"}, "language": "english", "review": "Mass Effect 3 is a fantastic game. Great tactical 3rd Person shooter with many fine shops aboard the Citadel. Sheppard and Wrex, Wrex and Sheppard. What's not to love. Also comes with a fun Multiplayer Mode.", "timestamp_created": 1733544839, "timestamp_updated": 1733544839, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.545731067657470703", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "182019135", "author": {"steamid": "76561198032624936", "personaname": "FYI", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198032624936/", "num_games_owned": 0, "num_reviews": 35, "playtime_forever": 2866, "playtime_last_two_weeks": 0, "playtime_at_review": 526, "last_played": 1740149498, "avatar": "8a78a24d3ae3031caf2695bc4dede2d6eb7af7cf"}, "language": "english", "review": "I have played Mass effect 1,2 since Xbox console, if you are Mass effect fan don't miss it", "timestamp_created": 1733472276, "timestamp_updated": 1733472276, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.503875970840454102", "comment_count