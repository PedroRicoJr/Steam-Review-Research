 []}, {"recommendationid": "185989968", "author": {"steamid": "76561199436768606", "personaname": "QuikNation", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199436768606/", "num_games_owned": 403, "num_reviews": 2, "playtime_forever": 2953, "playtime_last_two_weeks": 0, "playtime_at_review": 1325, "last_played": 1741514544, "avatar": "1fbffe728c9ab18a3a95b4f3beb054d25ea71e67"}, "language": "english", "review": "I only play the Multiplayer, even when I was a kid I loved it. I do play ME:LE and gone all the way through, I just wish they would've revamped MP on there. This game is peak, no micro transactions, no BS, you get what you play for, Now that I am more knowledgeable, I know how to spend my credits, I actually wait till I get 2 characters to level 20 (highest 2 after packs) and reset them so that way if i get any of that character, I don't waste XP. PLEASE BUY THIS GAME, a lot of people still play, I get a game every few seconds, and if I don't, I just quit to desktop and restart and usually get one in 2 seconds.", "timestamp_created": 1737342187, "timestamp_updated": 1737342187, "voted_up": true, "votes_up": 4, "votes_funny": 0, "weighted_vote_score": "0.563492059707641602", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "185259782", "author": {"steamid": "76561198107779127", "personaname": "toammar2006", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198107779127/", "num_games_owned": 557, "num_reviews": 461, "playtime_forever": 3424, "playtime_last_two_weeks": 0, "playtime_at_review": 3424, "last_played": 1736517740, "avatar": "dbe45201d91692c9ba66c028fb91ddbcc29b7d56"}, "language": "english", "review": "Game :- Very Good game and Enjoyable\r\nStory :- Good\r\nGraphics :- Good\r\nDifficulty :- Bala