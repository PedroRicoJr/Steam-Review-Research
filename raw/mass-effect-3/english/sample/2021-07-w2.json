": "1591887286", "reactions": []}, {"recommendationid": "95643771", "author": {"steamid": "76561199014042294", "personaname": "chickenfricken", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199014042294/", "num_games_owned": 216, "num_reviews": 69, "playtime_forever": 3185, "playtime_last_two_weeks": 0, "playtime_at_review": 1442, "last_played": 1699177518, "avatar": "b5954e401d2548e62ae00ca71b15dbd8e4777b04"}, "language": "english", "review": "pretty fun game, ♥♥♥♥♥♥ ending, but its pretty good", "timestamp_created": 1626152694, "timestamp_updated": 1692779824, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "95590711", "author": {"steamid": "76561199001676681", "personaname": "Berkal", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199001676681/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 2274, "playtime_last_two_weeks": 0, "playtime_at_review": 2275, "last_played": 1625978625, "avatar": "0898323d82a4a6e73030e82b17f8aeeaef0c6e05"}, "language": "english", "review": "yeah it good :)", "timestamp_created": 1626081907, "timestamp_updated": 1626081907, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "95416630", "author": {"steamid": "76561199026607730", "personaname": "Fun Joe Infin.", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199026607730/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 1728, "playtime_last_two_weeks": 0, "playtime_at_review": 1722, "last_played": 1642260580, "avatar": "e4663e578d1bef5e6e1eb5100e0f0dd05386f57f"}, "language": "english", "review": "I am a fifteen year old guy, in 2021. my dad recommended this series to me and I tried to get the legendary edition, but it didn't work. I sadly figured out that my computer was made just at the wrong time. too old to endure amazing graphics, too new to play with old programs. My dad had only played this one, and I, loving stories, was skeptical about starting at the end of the first trilogy. I wanted to start at the beginning, but it is unlikely that the first or even the second would work with my computer.\nI now just finished it and admit I was near tears. I died by taking control of the reapers, and felt like I was there. As the images of the characters of the game scrolled by, I saw friends.\nI don't know the history and connections to these people as I would have if I started from the beginning, but I sure am going to now.\nTo all you like me, eager to play a part in stories and not purely for the enjoyment of blasting aliens away, or picking a fight just because you can. Rather you want to be a part of something, see what you can do, be inspired by amazing characters and builders of this amazing game series, you would love this game! I recommend this game! I am now going to work and see how I can claim the first two games, and then go off on a new adventure in the Mass Effects world!", "timestamp_created": 1625853032, "timestamp_updated": 1625853032, "voted_up": true, "votes_up": 16, "votes_funny": 0, "weighted_vote_score": "0.665290892124176025", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": [{"reaction_type": 18, "count": 3}, {"reaction_type": 17, "count": 2}]}]}