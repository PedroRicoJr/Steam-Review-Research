s": []}, {"recommendationid": "203487323", "author": {"steamid": "76561198150710850", "personaname": "qilinggs", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/qilinggs/", "num_games_owned": 326, "num_reviews": 43, "playtime_forever": 506, "playtime_last_two_weeks": 0, "playtime_at_review": 270, "last_played": 1773810078, "avatar": "ff22cb2ad86e9490ce870eaacb52dee30e81202b"}, "language": "english", "review": "still worth buying separately from legendary edition just for the multiplayer", "timestamp_created": 1756969629, "timestamp_updated": 1756969629, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "203299308", "author": {"steamid": "76561198132031653", "personaname": "Terrorble", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198132031653/", "num_games_owned": 0, "num_reviews": 14, "playtime_forever": 3854, "playtime_last_two_weeks": 0, "playtime_at_review": 3854, "last_played": 1756427779, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "I admit, I was rushing thru the trilogy to see what it was all about.  The first game was interesting, the second better, then the third was amazing.  It's all about the characters.  Joker is a hoot, Garrus and James are bros, I was a fan of Tali from earlier and the parts with Mordin and Legoin are great along with EDI and Traynor.  Their interplay and the connection you build to them is the heart of ME3.  And, play on Hardcore!  A few fights are so difficult, frustrating and awesome.", "timestamp_created": 1756700276, "timestamp_updated": 1756700276, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.557522118091583252", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}