ighted_vote_score": "0.516129076480865479", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}, {"recommendationid": "142293802", "author": {"steamid": "76561198253376113", "personaname": "SDettner4", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198253376113/", "num_games_owned": 180, "num_reviews": 4, "playtime_forever": 30, "playtime_last_two_weeks": 0, "playtime_at_review": 23, "last_played": 1689638880, "avatar": "b6d8f399f41176c25ca00d1a033a78cee65d52d9"}, "language": "english", "review": "I am extremely frustrated that EA's transition from Origin has left me with an unusable product that requires I:\nA) request a refund for my purchase of this bundle back in in Nov `20 on sale for ~$11 to turn around and re-purchase it at $29.99 or\nB) find a 3rd party platform that will sell me a product key for the same cost I originally paid Steam for this product without guarantee that it will, in fact, work\n\nThe biggest grain of salt in this wound is staring at the DLC labelled \"Product Key\" and knowing that the answer is more than likely encrypted within one of the game's DLC subfolders, but not having the savvyness/recklessness to download file readers of dubious nature just so I can build Tali a new home ='(", "timestamp_created": 1689630917, "timestamp_updated": 1689630917, "voted_up": false, "votes_up": 8, "votes_funny": 0, "weighted_vote_score": "0.509803950786590576", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}