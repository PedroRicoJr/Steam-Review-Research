actions": []}, {"recommendationid": "97834562", "author": {"steamid": "76561197970481461", "personaname": "Treycifer444", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197970481461/", "num_games_owned": 0, "num_reviews": 4, "playtime_forever": 5370, "playtime_last_two_weeks": 0, "playtime_at_review": 5365, "last_played": 1751305415, "avatar": "44ef5ef610bebe3f11e717134b273916ff8e05b1"}, "language": "english", "review": "Iv'e played mass effect from the beginning, and I actually do like this franchise, that is when it ran on my pc, but for some weird, unknown(to me) reason, it will not even start up, even after having to go through the slight HASSLE of dealing with origin and its installation, it still wont run on my pc, and my pc specs or MORE than adequate to run this game, as it has run before, (granted to my inconvenience, I had to do some \"tinkering\" to get it to run smoothly on my pc because of ORIGIN mind you) I don't feel this should have to be a problem with a supposed \"AAA\" title game company for us \"measly dumb money peasants\" to spend our cash on a Licences to use their product and it refusing to work for reasons that our freaking beyond me, they're quality, admittedly, is second to none, imo arguably speaking, but this is absolutely beyond acceptable and unless they will do something to fix this ON THEIR END! I will no longer support EA and I will encourage as MANY people as I can to just pirate their games instead of to risk paying for something that wont even run or even work in the first place, pc wise... F*CK EA, I'D SAY!", "timestamp_created": 1629340563, "timestamp_updated": 1629340563, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887286", "reactions": []}]}