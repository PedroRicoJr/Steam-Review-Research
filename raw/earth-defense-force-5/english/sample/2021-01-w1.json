_url": "https://steamcommunity.com/profiles/76561198818737774/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 1066, "playtime_last_two_weeks": 0, "playtime_at_review": 997, "last_played": 1670304715, "avatar": "95d8f1c00bbdc43e289e494f3dad027a6f930ac4"}, "language": "english", "review": "11/10 Modern masterpiece of storytelling and drama. Masterful dialogue and phenomenal voice acting performances that put most theater work to shame. An incredibly deep and rewarding combat system that focuses on deeper strategy and co-ordination of attacks.\n\n           Who am I kidding? This is EDF. The dialogue is 50's sci-fi camp, the voice acting is intentionally bad, the combat is classic arcade shooter, and everything is destructable. I mean EVERYTHING is destructable. These games are famous for giving you a rocket launcher and assault rifle with unlimited ammo in each and telling you to ♥♥♥♥ ♥♥♥♥ up. If you like arcade action, then this is for you. If you like tactical combat and realistic physics, yeah you may want to keep looking. \n\n11/10 Its just fun.", "timestamp_created": 1609967360, "timestamp_updated": 1609967360, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}