{"game": "earth-defense-force-5", "language": "english", "appid": 1007040, "month": "2022-10", "window": 3, "start_date": 1665878400, "end_date": 1666569599, "month_true_total": 83, "quota": 5, "returned": 5, "pulled_at": "2026-09-28 17:52:34 UTC", "reviews": [{"recommendationid": "124288748", "author": {"steamid": "76561198176175754", "personaname": "Bullseye", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/bullseye69/", "num_games_owned": 231, "num_reviews": 6, "playtime_forever": 4305, "playtime_last_two_weeks": 0, "playtime_at_review": 2062, "last_played": 1723597972, "avatar": "02824a7f6e98b080c3dafb134741aa49609895c0"}, "language": "english", "review": "Greatest game ever created 10/10 would recommend. \n\nOh we are the valiant infantry.\nWe are the alpha team with passion and camaraderie.\nHear us as we shout at the top our lungs, be calm and be bold and raise your guns!\nIt's only with our sacrifice, that mankind can still exist in paradise.\nTo defend our dearest Mother Earth, we're ready to give up our lives!\nHigh up in the air our comrades fight, dashing through the sky now like million bolts of light.\nWe shall spread out wings wide and fly high, soaring, gliding through the endless sky!\nNow pick up our weapons, off we go.\nFiring at the flying saucers, shooting down our foe.\nWe shall not allow these aliens, to rule we ♥♥♥♥ sapiens.", "timestamp_created": 1666550410, "timestamp_updated": 1666550410, "voted_up": true, "votes_up": 22, "votes_funny": 4, "weighted_vote_score": "0.629302382469177246", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "124244505", "author": {"steamid": "76561198088182764", "personaname": "Bonded", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/BondedGunner/", "num_games_owned": 409, "num_r