ationid": "165288608", "author": {"steamid": "76561198119693617", "personaname": "Le Ramdikal", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/UwUMyUwwrlX3/", "num_games_owned": 0, "num_reviews": 13, "playtime_forever": 329, "playtime_last_two_weeks": 0, "playtime_at_review": 314, "last_played": 1715635734, "avatar": "5845e17823396386b1cdc4521089a6cac2a83dc8"}, "language": "english", "review": "Me: Hey Sony, can we have helldivers 2 in our country now ? \n\nSony: I mean sure thing there you go fam\n\nHelldivers 2 in 177 countries :", "timestamp_created": 1715613172, "timestamp_updated": 1715613172, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "165278119", "author": {"steamid": "76561198048661259", "personaname": "Leoss", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198048661259/", "num_games_owned": 459, "num_reviews": 76, "playtime_forever": 3237, "playtime_last_two_weeks": 0, "playtime_at_review": 1176, "last_played": 1763203340, "avatar": "036aa2f2833f316822589d8b0e7fcf060ad43105"}, "language": "english", "review": "Not too deep but still fun because of local co-op. I'd probably be playing Helldivers 2 instead if it had splitscreen co-op, but it doesn't, so here I settled with this game for some brainless shooting fun.\nI like that there's a campaign with a ♥♥♥♥-ton of missions (even though most are copy-paste, just the map is a bit different) instead of doing \"runs\" over and over.\nThe gacha / progression system of weapons is fun, and I like the variety. The game can be a bit janky at time (an ant once made me flew up to the sky higher than a mothership), but haven't had any experience ruining bug.\n\nAgain, don't expect anything too deep, but it's really good comfort food when you just want to kick back and relax, especially with a friend. I also got it on a deep discount, so I had no expectation. I personally wouldn't have bought the game full price knowing how repetitve the game can be.", "timestamp_created": 1715600468, "timestamp_updated": 1715600468, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "165262500", "author": {"steamid": "76561198082109919", "personaname": "BraveCancer", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/toddkojima/", "num_games_owned": 652, "num_reviews": 130, "playtime_forever": 111, "playtime_last_two_weeks": 0, "playtime_at_review": 111, "last_played": 1714619874, "avatar": "d740bdfd24aa4c9a35015bf6395c1a281a996693"}, "language": "english", "review": "I'm going to say \"recommend\", but this game really wasn't for me. Felt more like a mobile game version of Helldivers 2, but it's still a lot of fun to play with friends. Unfortunately for me, I really didn't get into it that much and my friends quit playing it, but if you liked the trailer and it's on sale, I'd give it a shot. You might just enjoy it!", "timestamp_created": 1715570802, "timestamp_updated": 1715570802, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.460893839597702026", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}