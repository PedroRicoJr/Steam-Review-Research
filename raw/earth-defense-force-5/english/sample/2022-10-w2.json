ctions": []}, {"recommendationid": "123805315", "author": {"steamid": "76561197962098105", "personaname": "GeekSHO", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197962098105/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 12058, "playtime_last_two_weeks": 0, "playtime_at_review": 1064, "last_played": 1787553663, "avatar": "3f9ce7c86d315d326385ea05f1378a1525107e3d"}, "language": "english", "review": "EDF5 is incredible. They have improved on every aspect found in EDF4.1, except for maybe the shanty that the soliders sing. Yep, that's it. The enemies are even more awesome. All the weapons are more satisfying. The progression of weapons is super fun where each weapon can receive upgrades, sometimes with very big boosts that dramatically alter their behavior. I can't wait to get the really big vehicles and weapons I've played with in the old games. If you enjoyed any previous EDF game, you've gotta pick this one up!", "timestamp_created": 1665735633, "timestamp_updated": 1665735633, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}