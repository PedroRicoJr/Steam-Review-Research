{"game": "earth-defense-force-5", "language": "english", "appid": 1007040, "month": "2019-12", "window": 1, "start_date": 1575158400, "end_date": 1575763199, "month_true_total": 235, "quota": 6, "returned": 6, "pulled_at": "2026-09-28 17:47:57 UTC", "reviews": [{"recommendationid": "59456112", "author": {"steamid": "76561198006644095", "personaname": "randomcuban", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198006644095/", "num_games_owned": 371, "num_reviews": 4, "playtime_forever": 2348, "playtime_last_two_weeks": 0, "playtime_at_review": 1932, "last_played": 1625940099, "avatar": "909b24b74b64074218a3f0655bbfa20326afbd2d"}, "language": "english", "review": "Just ridiculously good.", "timestamp_created": 1575761020, "timestamp_updated": 1575761020, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "59454992", "author": {"steamid": "76561197993032547", "personaname": "Gamephreak5", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/gamephreak5/", "num_games_owned": 0, "num_reviews": 17, "playtime_forever": 1212, "playtime_last_two_weeks": 0, "playtime_at_review": 813, "last_played": 1607273808, "avatar": "3aa628b81d4f72bcffa8140b3347aa23a89852a8"}, "language": "english", "review": "I've put many hours into EDF 4.1, and I gotta say this game has so many QoL improvements that will make it hard to go back to EDF 4.1. The monsters are challenging, yet fun to fight! The AI troops aren't totally worthless and can take down a huge monster or two!\n\nThe biggest and best change in the game is the loot. When you get weapon boxes, you'll either get a new weapon, an upgraded weapon, or the same weapon. When you get an upgraded weapon, that gun now replaces your old one etc until you max out that gun's stats! \n\nWhen you pick up weapon and armor boxes, you can also raise the armor or get weapons for a class you aren't playing, so you don't have to start from scratch when you want to try out a different class!", "timestamp_created": 1575759525, "timestamp_updated": 1575759525, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.461783438920974731", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "59449398", "author": {"steamid": "76561198031411821", "personaname": "Grim Delta", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198031411821/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 15221, "playtime_last_two_weeks": 0, "playtime_at_review": 3696, "last_played": 1701821807, "avatar": "c2c51159307ac0e5c3960f0df31732a07cd85cd0"}, "language": "english", "review": "Great game for letting off steam, set up and blast all the bugs to cinders", "timestamp_created": 1575753237, "timestamp_updated": 1575753237, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "59447908", "author": {"steamid": "76561198007382935", "personaname": "Tsavrvs", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/tyrannosaurusjudas/", "num_games_owned": 531, "num_reviews": 19, "playtime_forever": 6121, "playtime_last_two_weeks": 0, "playtime_at_review": 1803, "last_played": 1704666395, "avatar": "fbb7f96a3d40865edfd77243524543bf62214d7d"}, "language": "english", "review": "Blowing this many giant ants really ge