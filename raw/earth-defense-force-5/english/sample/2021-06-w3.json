, {"recommendationid": "94036741", "author": {"steamid": "76561198042375567", "personaname": "IronCroshu", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198042375567/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 6116, "playtime_last_two_weeks": 0, "playtime_at_review": 3737, "last_played": 1690016120, "avatar": "d4371bdba4c8c3484bc5b88edc6ee3c15d2bc250"}, "language": "english", "review": "EDF EDF EDF!!!", "timestamp_created": 1624154394, "timestamp_updated": 1624154394, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "94020422", "author": {"steamid": "76561197988149356", "personaname": "Nimsosim", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197988149356/", "num_games_owned": 92, "num_reviews": 23, "playtime_forever": 10871, "playtime_last_two_weeks": 0, "playtime_at_review": 958, "last_played": 1721604645, "avatar": "0851c440cfd90757f26189b8b71ef96f258d2010"}, "language": "english", "review": "Have a blast shooting down giant creatures, giant aliens and giant space ships. Build your characters up as you play earning new weapons, armor, boosts, vehicles and levels. Offline or online EDF5 is a great shooter that you can quickly jump into. Different classes with different weapons that fit your mood. Mission based game play offers a large range of activities and short breaks between missions. The game is very well made in my opinion top notch blend of performance, polish and awesomeness. The game fails sometimes at online play when players are just not helpful, cheating and or the game difficulty scale seams to just do its own thing. When your online and a high ranking player joins it seams to be very difficult. This is not a good thing since often these players are doing there own thing and not helping that much. Also the match making is to old, if the host leaves the game is over. Can't join games in progress and a dwindling community makes the game feel antiquated.", "timestamp_created": 1624127901, "timestamp_updated": 1721604871, "voted_up": true, "votes_up": 3, "votes_funny": 1, "weighted_vote_score": "0.535945773124694824", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "94003076", "author": {"steamid": "76561198025365539", "personaname": "VagabondFerret", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/vagabondferret/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 3214, "playtime_last_two_weeks": 0, "playtime_at_review": 2328, "last_played": 1679189659, "avatar": "65f7a75991dc6609b924535fbf0825551aeb6901"}, "language": "english", "review": "Welcome to the end of the world, these aliens look just like us and we have no way to stop them.\nSo it's up to you to stop them.\n\nIt's a hilarious time as always with EDF, this is an amazing arcade style game that slowly ramps in difficulty as you go but will reward your progress highly.\n\nMy only wish is that the retail price would be just a bit lower over time.", "timestamp_created": 1624104745, "timestamp_updated": 1624104745, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}