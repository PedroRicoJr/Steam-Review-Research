": {"steamid": "76561199050587125", "personaname": "Mr Dr Buffalo", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199050587125/", "num_games_owned": 114, "num_reviews": 3, "playtime_forever": 2992, "playtime_last_two_weeks": 0, "playtime_at_review": 1821, "last_played": 1721519033, "avatar": "acfeb35368053fc492fea73249f317f03fba3767"}, "language": "english", "review": "This game starts out like a cheesy action movie. Slowly over time it becomes a cheesy action game with great sense of scale and progression. This game has caught my attention within the first few missions and they just get better and better with time. As you get bigger weapons the enemies get larger and larger. The scale of each combat scenario grows with every mission really letting you feel like you're in the middle of this great war! Overall I would recommend this game to anybody who enjoys simple shooters that aren't too serious.", "timestamp_created": 1602020258, "timestamp_updated": 1602020258, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}