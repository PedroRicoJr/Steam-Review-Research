dationid": "60407507", "author": {"steamid": "76561197993524945", "personaname": "FU", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197993524945/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 10592, "playtime_last_two_weeks": 75, "playtime_at_review": 7377, "last_played": 1789520306, "avatar": "fc197abe3ed445e0ec95aebf174b8c1806c4187e"}, "language": "english", "review": "I love this game.\nWhy? Because the classes a really really diverse.\nIt takes a well mixed team to win the game.\nThe Airraider is like a modern wizard conjuring waves of destruction from the sky, but sometimes it is also very satisfying to play the grunt with a shotgun.\nThere is happening so much, that at first a new player may be overwhelmed, but this state of being overwhelmed ceases to a state of total immersion.\nAnd no, this game is not like EDF 4.1 which is also liked. It is in fact very different.\nI would always buy a new game of this series, even for the full priece, because it fits a niche that you cannot have elsewhere.\nThe game may seem cheesy or blunt at first, but there is something in the gameplay i cannot describe, which are the developers doing very very right.", "timestamp_created": 1577127869, "timestamp_updated": 1577127869, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.502292037010192871", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}