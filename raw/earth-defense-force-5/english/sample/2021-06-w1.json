unt": 1}, {"reaction_type": 16, "count": 1}]}, {"recommendationid": "93278649", "author": {"steamid": "76561197995774568", "personaname": "Obi-Two Kenobi", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561197995774568/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 15972, "playtime_last_two_weeks": 0, "playtime_at_review": 13694, "last_played": 1700584942, "avatar": "bec0b8e4db3741bc10746d4aaa9a7d54584b8cc8"}, "language": "english", "review": "Ever felt the need to burn/annihilate your entire house down after seeing a giant bug escape your murder attempt? This game lets you do that in a city scale. The ants and spiders too are enlarged proportionally.\n\nThe game is a bit grindy, but a lot of fun even with random people (I recommend online play over single player any day of the week).\n\nThe story gives off a massive B-movie vibe. It's ridiculous, and a pro in my book. However, the story is not the reason to play this game. The catharsis of firing 20+ missiles or multiple airstrikes into an encroaching horde of house-sized ants and jumping spiders is what keeps me returning to this game time after time.", "timestamp_created": 1622962899, "timestamp_updated": 1622962899, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "93223459", "author": {"steamid": "76561198111324001", "personaname": "Kyzous", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Kyzous/", "num_games_owned": 663, "num_reviews": 197, "playtime_forever": 411, "playtime_last_two_weeks": 0, "playtime_at_review": 399, "last_played": 1625279367, "avatar": "f7a2deb1c7cec9c3bd97394b8f0b500a6fc0f376"}, "language": "english", "review": "turn yoru brain off anmd shoot big alien