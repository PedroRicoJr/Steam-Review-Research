s": 40, "playtime_forever": 6786, "playtime_last_two_weeks": 0, "playtime_at_review": 5003, "last_played": 1692952334, "avatar": "326df5f2a0208caed1e244063ffd5724a595189b"}, "language": "english", "review": "I jumped into this series at EDF 4 (English version) and im so glad i did. The game always looked kinda sega dreamcasty and i thought it would be pretty basic, so i held off for awhile. Well i was right on both fronts and and thats what i love about this game.\n\nIts simple and charming in its own right. Its known as a game thats \"so bad its good\" but it really is good. The weapons are fun to use and there is a ton to unlock across 4 unique (and also fun) classes.  This game gives you alot to do and has a great community.\n\nIf you have never played it, you should give it a shot. It doesnt go on sale often but you wont be disappointed. EDF! EDF!", "timestamp_created": 1637272207, "timestamp_updated": 1637272207, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}