s": []}, {"recommendationid": "58804389", "author": {"steamid": "76561198014748807", "personaname": "Grand Chief,  Dokam", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Docam/", "num_games_owned": 1301, "num_reviews": 35, "playtime_forever": 2024, "playtime_last_two_weeks": 0, "playtime_at_review": 910, "last_played": 1678696075, "avatar": "f62ca53bcf6f52dc3d5907724eee01aba77ab872"}, "language": "english", "review": "The best so far", "timestamp_created": 1575149579, "timestamp_updated": 1575149579, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.53950810432434082", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "58800973", "author": {"steamid": "76561198000434062", "personaname": "dimsum", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198000434062/", "num_games_owned": 262, "num_reviews": 4, "playtime_forever": 3950, "playtime_last_two_weeks": 0, "playtime_at_review": 2648, "last_played": 1718290500, "avatar": "fb7b3253b9abd803a100c91c30d3c2980b445f21"}, "language": "english", "review": "stupid mindless fun", "timestamp_created": 1575147756, "timestamp_updated": 1575147756, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "58797725", "author": {"steamid": "76561198014665273", "personaname": "Brazilian_Soldier", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Brazilian_Soldier/", "num_games_owned": 482, "num_reviews": 80, "playtime_forever": 9086, "playtime_last_two_weeks": 0, "playtime_at_review": 3184, "last_played": 1750657493, "avatar": "b4083a11aa1c8fd88d05abb53f8160c069c38637"}, "language": "english", "review": "Huge improvements over EDF 4.5\nOne of the best co-op game out there!", "timestamp_created": 1575146105, "timestamp_updated": 1575146105, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.53947371244430542", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "58797690", "author": {"steamid": "76561198007674930", "personaname": "Fel", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198007674930/", "num_games_owned": 721, "num_reviews": 86, "playtime_forever": 5697, "playtime_last_two_weeks": 0, "playtime_at_review": 5697, "last_played": 1575024113, "avatar": "3716b209303a9bbabc10c296d7a45f252fcefeb6"}, "language": "english", "review": "I only encountered EDF with 4.1 on PC but this iteration is basically \"everything even better\" for me.\n\nI am aware that the hardcore players are torn because of changes on specific weapons they liked to use, but for me the classes are now all viable and even more distinct.\n\nAir raider is no longer locked beind kills, with several strong request weapons that reload with time (and quite a few reload fast too) and the underground vehicle and the guns seem much less like something you take because you don't have other options.\n\nRanger has a lot of mobility between fights, so he can collect boxes and get to the next pod reasonably well without becoming a highly mobile class during fights.\nIt is a very solid class that has good options for just about everything (but not excelling at anything in particular like the other classes), incredibly easy to pickup as a new player.\nThe addition of either tanks or powerups really fleshes the class as well.\n\nWing divers have air dash/dodge that allow they to remain airborn at a lower energy cost while also allowing them to cover a lot of ground quickly, with different energy cores depending on what you want to do (including a core that can't realistically fly but is great for high energy weapons)\nIt is still a class that dashes in, dishes a lot of damage quickly and retreats to recharge its energy, but with more options.\n\nFencers are still pretty hard to learn, and at least as incredible as before for those that put the efforts in understanding all of the specifics about the class.\n\n\nI can't comment on the multiplayer outside of watching people play it on twitch since I only played in single player but I definitely enjoyed my time with all 4 classes a lot more than I did in 4.1.", "timestamp_created": 1575146084, "timestamp_updated": 1575146084, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "58791898", "author": {"steamid": "76561197999319140", "personaname": "Squirtle®", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/SquirtleSkillz/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 3542, "playtime_last_two_weeks": 0, "playtime_at_review": 432, "last_played": 1626309236, "avatar": "769fcaf09950066fab31ab5d1ea6b6ce7f0c264d"}, "language": "english", "review": "WAAAAAAGH. Best Couch-COOP game of all time.", "timestamp_created": 1575143303, "timestamp_updated": 1575143303, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}