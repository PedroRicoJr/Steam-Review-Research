{"game": "earth-defense-force-5", "language": "english", "appid": 1007040, "month": "2020-09", "window": 1, "start_date": 1598918400, "end_date": 1599523199, "month_true_total": 42, "quota": 5, "returned": 5, "pulled_at": "2026-09-28 17:49:10 UTC", "reviews": [{"recommendationid": "75573701", "author": {"steamid": "76561198008425081", "personaname": "PlasmaLink", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/LM64/", "num_games_owned": 972, "num_reviews": 83, "playtime_forever": 5298, "playtime_last_two_weeks": 0, "playtime_at_review": 1413, "last_played": 1697312647, "avatar": "2561490a00358e2f1294871f7c1c2e72288d95f0"}, "language": "english", "review": "If coming from EDF 4.1: Pretty much a direct improvement, though I do miss some of the songs of 4 (particularly the battle chant, this one's not as catchy, though it's still nice)\n\nIf not: This is one of those games that has something very unique to it, and it might feel unpolished in places, but the core is just something not really in other games. It's one of those situations where you're worried that if you polish it any more, it would lose some of its charm, you know? It's a really fun game with a lot of content to sink your teeth into, fun with friends or solo.", "timestamp_created": 1599443883, "timestamp_updated": 1599443883, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "75562452", "author": {"steamid": "76561198149312514", "personaname": "slingshot5", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Trailstorm/", "num_games_owned": 0, "num_reviews": 43, "playtime_forever": 2846, "playtime_last_two_weeks": 0, "playtime_at_review": 641, "last_played": 1763054570, "avatar": "26b5af3e93d6b8d31b