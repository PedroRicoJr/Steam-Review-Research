lease_date": "1562828575", "reactions": []}, {"recommendationid": "212752679", "author": {"steamid": "76561197961319333", "personaname": "Tutorial Monster", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ironygiant/", "num_games_owned": 547, "num_reviews": 62, "playtime_forever": 19659, "playtime_last_two_weeks": 0, "playtime_at_review": 16767, "deck_playtime_at_review": 780, "last_played": 1782425827, "avatar": "be34ad7a334bc14b96382c047fd7e99e0fc41790"}, "language": "english", "review": "One of the greatest unapologetically massive indulgences in the shooter genre.  It's as charming and endearing as it is competent.  While the prequel holds a special place in my heart and the sequel is a perfect follow-up in its own right, Earth Defense Force 5 is, in my opinion, the standout entry in the series.  Not only is it the official \"reboot\" point for the series, making it a perfect starting point for new players, it so perfectly balances its unique \"ugly\" visual fidelity with rock solid \"massive waves of enemy\" gameplay, that it will run great on just about any system.  If this game is on sale, grab it to play solo or in multiplayer.  You will not be sorry.  EDF!!!\n", "timestamp_created": 1765088816, "timestamp_updated": 1765088816, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.540636062622070312", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "212742464", "author": {"steamid": "76561199886054359", "personaname": "Not good at speaking", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199886054359/", "num_games_owned": 95, "num_reviews": 13, "playtime_forever": 41166, "playtime_last_two_weeks": 167, "playtime_at_review": 9584, "last_played": 1790581993, "avatar": "bcb64b06667267d0c70d80