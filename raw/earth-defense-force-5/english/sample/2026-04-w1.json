6}, "reactions": []}, {"recommendationid": "222861933", "author": {"steamid": "76561198064170580", "personaname": "Akufishi", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/akufishi/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 3653, "playtime_last_two_weeks": 0, "playtime_at_review": 2911, "deck_playtime_at_review": 60, "last_played": 1789406407, "avatar": "548f8f4ed398904a2ce5f9d82382d118c2cb688a"}, "language": "english", "review": "This game is basically: What if Starship Troopers and Nuclear Throne had a baby...", "timestamp_created": 1775722703, "timestamp_updated": 1775722703, "voted_up": true, "votes_up": 3, "votes_funny": 2, "weighted_vote_score": "0.545454561710357666", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "222650482", "author": {"steamid": "76561198025207731", "personaname": "shonatte", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/shonate/", "num_games_owned": 0, "num_reviews": 29, "playtime_forever": 12349, "playtime_last_two_weeks": 0, "playtime_at_review": 12349, "last_played": 1775463787, "avatar": "96579f63b41782187923acdf6b9b8280f068c504"}, "language": "english", "review": "Unless you have friends willing to go the distance and play through the difficulties with you or you're ok with playing with randoms online, I would not recommend this to the casual player. Although it does allow you to play solo, this is a HELLISH endeavour beyond easy difficultly and will leave you questioning what the Developers were thinking at the time they designed certain levels. Simply put, other players make the game easier. Solo, difficulty scales very steeply. As far as I can make out as my only solution: Get better friends.", "timestamp_created": 1775464258, "timestamp_updated": 1775464258, "voted_up": false, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.467562109231948853", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "222430521", "author": {"steamid": "76561198044022971", "personaname": "jeffspitzer69", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198044022971/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 1069, "playtime_last_two_weeks": 0, "playtime_at_review": 500, "last_played": 1788568773, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "best played with friends to take the piss out of the hammy dialog with.", "timestamp_created": 1775242848, "timestamp_updated": 1775242848, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "222374400", "author": {"steamid": "76561198425625809", "personaname": "FragnDragn", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198425625809/", "num_games_owned": 0, "num_reviews": 34, "playtime_forever": 159, "playtime_last_two_weeks": 0, "playtime_at_review": 159, "last_played": 1774589763, "avatar": "f4aee01a2cda57c1ffa9d178aafa13c3c170b5db"}, "language": "english", "review": "Game released in 2019 and has worse interface/graphics then games on the ps2.\r\nAlso weapons sway like you drank 15 beers before you started playing.\r\nGame's poop.", "timestamp_created": 1775184341, "timestamp_updated": 1775184341, "voted_up": false, "votes_up": 0, "votes_funny": 4, "weighted_vote_score": "0.399306565523147583", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "222335866", "author": {"steamid": "76561198271297392", "personaname": "Psyduck", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/psychicduck/", "num_games_owned": 0, "num_reviews": 16, "playtime_forever": 5070, "playtime_last_two_weeks": 0, "playtime_at_review": 1133, "last_played": 1786992951, "avatar": "57599bb742ef02635a7568ee0f7573cf50f03e14"}, "language": "english", "review": "This is basically Japanese Starship Troopers, LOL, Except all battles are on Earth, and its 100X better. After 18 hours of playing, I must say....WOW, this game is addicting. You can't stop playing once you get further into the game. Just shoot everything in sight : insects, frogs, aliens, A SH1T LOAD OF ENEMES at a time, its VERY chaotic.\r\nTime flies when playing this game, you keep on wanting more. When one level done, you get one upgrade or two, and sometimes you got some new weapons, which left you wondering : \"Hey I got this new weapon, what if I test this gun on the battlefield\". Then there you go, you got your classic \"one more level before sleep\" that actually never happens, that left you keep on playing till morning. \r\nYou got multiple classes to choose from, ranging from the regular soldier, the flying one, and the one with heavy armor, and lots of weapon choices too. I think this is Helldivers before Helldivers even exist. \r\n\r\n", "timestamp_created": 1775145134, "timestamp_updated": 1775145134, "voted_up": true, "votes_up": 10, "votes_funny": 0, "weighted_vote_score": "0.609658360481262207", "comment_count": 2, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}