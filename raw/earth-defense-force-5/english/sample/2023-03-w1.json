tionid": "134187154", "author": {"steamid": "76561197960858217", "personaname": "ecurbbb", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561197960858217/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 6987, "playtime_last_two_weeks": 0, "playtime_at_review": 219, "last_played": 1735966182, "avatar": "3189a438213ca54663b859a8a9187c1a6b3e82bc"}, "language": "english", "review": "\"EDF! EDF! EDF!\" \n\nThe in game NPC voice acting is hilarious. \n\nFirst they blame the alien attack on terrorists, then move on to countries, then acknowledges it's aliens and then reverts back to terrorists. hahaha\n\nOne of the most fun games you can play with friends. Played a version of EDF back in 2007 with my roommate when I was in university, not sleeping, getting crunked and skipping class until the game was beat. Absolutely worth the time. You can find cheaper deals of this game through online game stores.", "timestamp_created": 1678114668, "timestamp_updated": 1678114668, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.519230782985687256", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "134162573", "author": {"steamid": "76561198018309077", "personaname": "Eeshton", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Eeshton/", "num_games_owned": 0, "num_reviews": 40, "playtime_forever": 4164, "playtime_last_two_weeks": 0, "playtime_at_review": 3286, "last_played": 1708729471, "avatar": "ea1d65774f4d8097760da86775c6e5c4eb18de1e"}, "language": "english", "review": "EDF! EDF! EDF! YOU KILLED MY WIFE!!! YOU'RE GOOD!! GIANT INSECTS!! FIND GOD AND KILL HIM SO YOU CAN SAVE THE HUMAN RACE.", "timestamp_created": 1678071154, "timestamp_updated": 1678071154, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.514653325080871582", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "134103499", "author": {"steamid": "76561198242344180", "personaname": "SoulSeeker", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198242344180/", "num_games_owned": 175, "num_reviews": 51, "playtime_forever": 9133, "playtime_last_two_weeks": 0, "playtime_at_review": 4282, "last_played": 1699008781, "avatar": "a9740025497f8d3b45b60bc8eee14ac7d20ebc64"}, "language": "english", "review": "Hammy B movie fun with silly wild power scaling over time. But unlike EDF4.1, doesn't waste 100's of hours with obnoxious stuff like forcing you to play a mission on easy after you beat it in hard because you don't get lower difficulty medals beating higher difficulties. Super clunky vehicles and bad guns that made Air raider miserable to play were also re-balanced. Just generally has more respect for your time and more polished then 4. That combined with being a new timeline means 4 is basically invalidated, and being that 4 started to frustrate me after 150 hours or so, I'm happy about that.", "timestamp_created": 1678003118, "timestamp_updated": 1678003118, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}