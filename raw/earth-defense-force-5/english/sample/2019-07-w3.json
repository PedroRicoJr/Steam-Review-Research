recommendationid": "54259468", "author": {"steamid": "76561198001198980", "personaname": "xyzdude0", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/xyzdude0/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 23193, "playtime_last_two_weeks": 0, "playtime_at_review": 3582, "last_played": 1772049805, "avatar": "0b66c91d13c7143ab981e75ac6ca4c2d3c2a049e"}, "language": "english", "review": "The only downside is that you can't give your vehicles custom skins", "timestamp_created": 1563915572, "timestamp_updated": 1563915572, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54259001", "author": {"steamid": "76561198022458569", "personaname": "Master Beatty", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/DrewB123/", "num_games_owned": 1064, "num_reviews": 18, "playtime_forever": 7410, "playtime_last_two_weeks": 0, "playtime_at_review": 1801, "last_played": 1641623900, "avatar": "2721d97982dd887b69b0a7c305f1556f2d20943b"}, "language": "english", "review": "You take on hundres of UFOs, giant frog aliends with guns, bus sized insects all falling from dropships with rocket powered hammers, giant Gundam like mech suits, swords that can slice things from 100 meters away and rapid fire rocket launchers. It's the most over the top video game ever made and it's just flat out fun to play.", "timestamp_created": 1563913111, "timestamp_updated": 1563913111, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54257745", "author": {"steamid": "76561198016250077", "personaname": "space wizard lizard", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/thedukeoffroup/", "num_games_owned": 0, "num_reviews": 33, "playtime_forever": 7834, "playtime_last_two_weeks": 0, "playtime_at_review": 1742, "last_played": 1729381537, "avatar": "82d57a74a14aac4f7eb1c1a1a08f93d182134eda"}, "language": "english", "review": "Just pure, no ♥♥♥♥♥♥♥♥, FUN. 100+ individual missions, a uncountable number of weapons to unlock, and infinite replayability. Co-op works flawlessly, everything is funner with friends. Gameplay is as smooth as butter.\n\nDialogue is intentionally cheesy in a \"so bad its hilarious\" kind of way. Story is about what you'd expect in a game about annihilating hordes of invading space monsters.\n\nGraphics are very basic, nothing beautiful here. But its understandable considering all the crazy stuff going on in-game that they sacrifice visual quality for performance and optimization.\n\nVery very much recommended. \n", "timestamp_created": 1563907333, "timestamp_updated": 1563907333, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.535891056060791016", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54257504", "author": {"steamid": "76561197962092054", "personaname": "Rimuru", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197962092054/", "num_games_owned": 0, "num_reviews": 23, "playtime_forever": 1607, "playtime_last_two_weeks": 0, "playtime_at_review": 621, "last_played": 1705252765, "avatar": "f7bc0bc693a09af66d1ff83b57480b3b493c8b28"}, "language": "english", "review": "PROTECT EARTH. BE CAMPY ABOUT IT.\nBIKINI ARMOR FLYING GIRLS.\nEEEHH DEEE EEEF!", "timestamp_created": 1563906267, "timestamp_u