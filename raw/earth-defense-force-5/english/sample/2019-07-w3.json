vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54249173", "author": {"steamid": "76561198001957690", "personaname": "2IOF", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/2IOF/", "num_games_owned": 0, "num_reviews": 21, "playtime_forever": 3500, "playtime_last_two_weeks": 0, "playtime_at_review": 210, "last_played": 1618733777, "avatar": "c288ccdb164a11a883bc92d41ebc6171a3657f78"}, "language": "english", "review": "I'm doing my part!", "timestamp_created": 1563865186, "timestamp_updated": 1563865186, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54248958", "author": {"steamid": "76561198003221110", "personaname": "Z", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/tanakaeka/", "num_games_owned": 0, "num_reviews": 34, "playtime_forever": 3807, "playtime_last_two_weeks": 0, "playtime_at_review": 1089, "last_played": 1568217244, "avatar": "e6fd518f874dd79985ac50344f9ec2e461fda5eb"}, "language": "english", "review": "Shooting the armored ass of a giant ant while screaming to my friend: \"penetrate the ass !!\" when my wife was around.\n\n11/11 would scream again.", "timestamp_created": 1563863690, "timestamp_updated": 1563863690, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54247838", "author": {"steamid": "76561197998855842", "personaname": "TheMadTypist", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197998855842/", "num_games_owned": 0, "num_reviews": 24, "playtime_forever": 2046, "playtime_last_two_weeks": 0, "playtime_at_review": 660, "last_played": 1637126053, "avatar": "aab5974eefccb0b85ebd235e1bdb394d621d41e5"}, "language": "english", "review": "A charming retro third person shooter- Focused more on gameplay than graphics, the four classes offer good variety over an expansive series of missions, with a loot system to collect and upgrade all your toys. A B-movie monster-mash plotline strung together with a script co-written by google translate gives a myriad of excuses to be smashing waves of ants, spiders, flying saucers, and other alien threats off the face of the earth. A few examples of weapons the classes get include- assault rifles, missile launchers, plasma guns, heavy cannons, airstrikes, motorcycles, orbital lasers, mechs, jetpacks, giant hammers, cruise missiles- and a bunch more besides.\n\nThough it does offer co-op play, my experience has been in singleplayer and it's really fun. I have a hard time putting it down, often finding myself making excuses like 'just one more mission to try out that upgraded shotgun'. I'm happy to recommend it.", "timestamp_created": 1563855496, "timestamp_updated": 1563855496, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54247539", "author": {"steamid": "76561198079446295", "personaname": "atrium", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198079446295/", "num_games_owned": 100, "num_reviews": 2, "playtime_forever": 6973, "playtime_last_two_weeks": 0, "playtime_at_review": 993, "last_played": 1659480944, "avatar": "6042643e43b7975f69fa9fb078b32daf4b1fdcb2"}, "language": "english", "review": "I can hold three separate airstrikes, and still call in a giant mech. Pretty much the most fun I've ever had in a video game.", "timestamp_created": 1563853344, "timestamp_updated": 1563853344, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54246814", "author": {"steamid": "76561197996715488", "personaname": "Zylth", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197996715488/", "num_games_owned": 0, "num_reviews": 395, "playtime_forever": 2220, "playtime_last_two_weeks": 0, "playtime_at_review": 555, "last_played": 1576470726, "avatar": "cb0a4c58b348d3d51abfaa179c34e72808314ea9"}, "language": "english", "review": "Ok. Imagine this? It's EDF4, but better in every way.\n\n\n\nWhat's that? You don't know what EDF is? You uncultured swine. This game is the pinnacle of terrible sci-fi movies, the game is an absolute blast with friends and hilarious in the absurdity of the lines delivered with such sincerity.", "timestamp_created": 1563848504, "timestamp_updated": 1563848504, "voted_up": true, "votes_up": 0, "votes_funny": 1, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "54246177", "author": {"steamid": "76561198373055571", "personaname": "TacticalDonut", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198373055571/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 517, "playtime_last_two_weeks": 0, "playtime_at_review": 44, "last_played": 1748055122, "avatar": "6ee2b77f5c79d32797c2910524431b93bdd3837c"}, "language": "english", "review": "I normally love Earth Defense games but sadly it keeps freezing on me. When playing the game kept freezing tried windowed lowering my graphics still low frame rate and freeze. So bummed it didnt work. Really wish it did.", "timestamp_created": 1563843924, "timestamp_updated": 1563843924, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.435687363147735596", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": true, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}