name": "The Ginger, Breadman", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561197972026832/", "num_games_owned": 179, "num_reviews": 29, "playtime_forever": 4092, "playtime_last_two_weeks": 0, "playtime_at_review": 606, "last_played": 1772676374, "avatar": "55f70a8ce15a4349e45b89003691d8637a914321"}, "language": "english", "review": "Cool enemies, good graphics and neat new story, but the weapon system feels way worse compared to EDF 4.1", "timestamp_created": 1754372303, "timestamp_updated": 1754372303, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.476744204759597778", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "201453939", "author": {"steamid": "76561198436725725", "personaname": "Lupis", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/1ALupis/", "num_games_owned": 131, "num_reviews": 6, "playtime_forever": 1849, "playtime_last_two_weeks": 0, "playtime_at_review": 1835, "last_played": 1754344986, "avatar": "db763afc4549e4e3e1e376bce9e9ce3a1bf22c5c"}, "language": "english", "review": "A friend of mine got me into this game, and I'm really glad he did. As someone who's usually squeamish around gore, I wasn't sure I'd enjoy it, but the over-the-top chaos and the campy writing quickly won me over and made me invest SEVERAL hours into the game.\r\n\r\nThe core gameplay loop never gets old. The variety of weapons and classes alongside a steady but not overwhelming increase in difficulty and advancing enemy types kept things fresh, and the way each mission escalates is both ridiculous and exciting.\r\n\r\nWhat really stuck with me was the dialogue. The mix of dramatic lines and hilarious moments (both scripted events and unscripted banter) gave the game a ton of personality. It never takes itself too seriously, and that's a big part of the charm.\r\n\r\nAnd if you're done with the game in Solo mode, go grab your friends and do it again in Multiplayer! Cue confused screams, complaints about friendly fire, and a lot of laughs as everything (and everyone) explodes, or you accidentally explode yourself with a rocket launcher and everyone else laughs their asses off about it as you ragdoll fly through the air. It's a total mess in the best possible way.", "timestamp_created": 1754334796, "timestamp_updated": 1754334796, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}, {"recommendationid": "201412398", "author": {"steamid": "76561199406049489", "personaname": "Nova Yuri", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199406049489/", "num_games_owned": 0, "num_reviews": 15, "playtime_forever": 2584, "playtime_last_two_weeks": 0, "playtime_at_review": 2075, "last_played": 1770706691, "avatar": "7b0c8b6773ed4b3fe068492c531efbb06fb5fac9"}, "language": "english", "review": "Fun", "timestamp_created": 1754283856, "timestamp_updated": 1754283856, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 1, "steam_purchase": true, "received_for_free": true, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1562828575", "reactions": []}]}