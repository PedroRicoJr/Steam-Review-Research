ck": true, "app_release_date": "1699469751", "reactions": []}, {"recommendationid": "162392918", "author": {"steamid": "76561199500055931", "personaname": "tuffersson", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199500055931/", "num_games_owned": 0, "num_reviews": 54, "playtime_forever": 2380, "playtime_last_two_weeks": 0, "playtime_at_review": 271, "last_played": 1785845048, "avatar": "1038de53063eae7cc58b661d1320f1c1cbf8f351"}, "language": "english", "review": "Awesome", "timestamp_created": 1712473696, "timestamp_updated": 1712473696, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}, {"recommendationid": "162387773", "author": {"steamid": "76561197972956960", "personaname": "—Stiƒle—", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197972956960/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 3524, "playtime_last_two_weeks": 0, "playtime_at_review": 3108, "last_played": 1789794026, "avatar": "c0055bdedfcba9ece28378e9dcbe6c36121a2838"}, "language": "english", "review": "Great 5 stars!", "timestamp_created": 1712466037, "timestamp_updated": 1712466037, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}, {"recommendationid": "162384583", "author": {"steamid": "76561199040587999", "personaname": "Latte", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561199040587999/", "num_games_owned": 123, "num_reviews": 2, "playtime_forever": 3874, "playtime_last_two_weeks": 0, "playtime_at_review": 3487, "last_played": 1773406994, "avatar": "ca335483c7e361b7b44fdba133fb5df69d411554"}, "language": "english", "review": "This game, at launch, lead to one of the worst malding sessions I have ever had. For the first couple of hours i played, I was having a fair enough amount of fun, and then I got into the later providence trials. I then multiple hours on ONE specific HAN-D trial.. and could barely beat it, much less get any progress towards a golden ranking. Discouraged, I remember going to sleep, and not touching the game for four months. I even made a grand return to playing ror2!\r\nBut, a friend of mine decided to 100% the game, and they had been at it all this time. With the aiming update, a handful of patches, and several providence trials being re-balanced, I decided to get back into it.\r\nThis game is truly incredible. From the music, to the story, to the game-play, every aspect of this game was enjoyable. The process to complete this game, isn't. To earn all the achievements and get another perfect game on your profile is relatively easy, and fun enough. There are still challenges, and none of them (as of current patch) are 'too difficult'. None of the achievement unlocks are like that damned HAN-D trial.\r\nThe unlocks that don't unlock achievements are fun to find as well. I have several now, some I found naturally, and others I had to look up and go 'wow yeah I wasn't figuring that out'. Collecting every log is gonna be a pain, but an inevitability if I keep playing the game. As a bonus, I got a golden rank on every providence trial. In fact, the last 7-10 hours of game play I've done were exclusively providence trials.\r\nNow all that's left is to finish the rest of the game, read all the logs, and dream of wells and worms. Good-ish game, and an amazing series.\r\n", "timestamp_created": 1712461536, "timestamp_updated": 1712461536, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}]}