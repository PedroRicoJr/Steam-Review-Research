d": "76561198121077989", "personaname": "WizardwithaSword", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/wizardwithasword/", "num_games_owned": 0, "num_reviews": 49, "playtime_forever": 894, "playtime_last_two_weeks": 0, "playtime_at_review": 894, "last_played": 1754168572, "avatar": "2bb819eeac42f6a3863c5ba92aa0edb95bc0080f"}, "language": "english", "review": "I suspect the balance is better than RoR2 due to the simpler geometry. I also have a preference for pixel aesthetics.", "timestamp_created": 1783284019, "timestamp_updated": 1783284048, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}, {"recommendationid": "229626627", "author": {"steamid": "76561198311681248", "personaname": "ultimateones", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198311681248/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 278, "playtime_last_two_weeks": 0, "playtime_at_review": 258, "last_played": 1783344615, "avatar": "dcd50e2b15bee3047361b4122e9ffc82ed7310ff"}, "language": "english", "review": "it's much less intutive than ROR2 THAT'S FOR SURE, IT IS DIFFICULT TO TELL WHEN I GOT HIT, the loot is.... well minimal per map and that leads to less fun overall, in the 4 hours i have played i didn;t get even one good enough run, skill issue maybe but still the information given to me in terms of feedback for almost everything is ♥♥♥♥.", "timestamp_created": 1783201051, "timestamp_updated": 1783201051, "voted_up": false, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.415112584829330444", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}, {"recommendationid": "229622676", "author": {"steamid": "76561198047366069", "personaname": "Vadok", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/FinTuyokee/", "num_games_owned": 0, "num_reviews": 301, "playtime_forever": 1853, "playtime_last_two_weeks": 0, "playtime_at_review": 1853, "last_played": 1783196220, "avatar": "18b9c3b6ddb83a115a23e47dfedad697d61f591c"}, "language": "english", "review": "I loved the original Risk of Rain, and Returns is exactly what I was hoping for.\r\nIt stays true to the original while making it feel much smoother and more \"modern\". The new graphics are fantastic, the soundtrack is still incredible, and all the little QoL are all appreciated.\r\n\r\nIt's still the brutal roguelike I loved years ago, just with more identity, polished, with slightly more content.\r\n\r\nA great excuse to experience a classic all over again; this time, filled with more maturity, both from my side as a player and from the developers.", "timestamp_created": 1783197682, "timestamp_updated": 1783197682, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.54356849193572998", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}]}