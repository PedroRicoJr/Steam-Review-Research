aytime_at_review": 2217, "last_played": 1769122141, "avatar": "68418358784fb40de50870f5205b4a4abb9642fd"}, "language": "english", "review": "Now THIS is how you do a remake. They took everything from the original game and improved upon it. They changed nothing about the formula, only added onto it. RE3-Remake should've taken some notes here. About the actual content, its very fun, though the Providence Trials are absolutely ♥♥♥♥♥♥♥♥ rediculously difficult. Each character feels unique and equally interesting to play. The vast number of items allows for a new and fun run every time, and helps you create builds. Whether you just want to listen to the great music and look at the beautiful pixel art while strolling through on drizzle difficulty, or obliterate literal gods in -2 seconds with a hyper-optimized overpowered builds on monsoon, this game has something for everyone... Wait. You're telling me the people who made this game are the same ones who made the SoTS DLC for Risk of Rain 2 and single-handedly tore apart my favorite game? WHAT THE ♥♥♥♥.", "timestamp_created": 1733507905, "timestamp_updated": 1733507905, "voted_up": true, "votes_up": 7, "votes_funny": 0, "weighted_vote_score": "0.594345390796661377", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}]}