{"game": "risk-of-rain-returns", "language": "english", "appid": 1337520, "month": "2024-01", "window": 2, "start_date": 1704672000, "end_date": 1705363199, "month_true_total": 539, "quota": 9, "returned": 9, "pulled_at": "2026-10-07 00:51:58 UTC", "reviews": [{"recommendationid": "156066790", "author": {"steamid": "76561198045632419", "personaname": "rianu91", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198045632419/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 3184, "playtime_last_two_weeks": 0, "playtime_at_review": 2049, "last_played": 1734921537, "avatar": "03afe2a31947e1e31c1ff05137c2566c66ad8538"}, "language": "english", "review": "This game is quite challenging. I’m experienced in rogue-lites and I have a hard time completing a run on the standard difficulty. There’s a fair amount of rng in the items you get but that gets fixed later with an artifact you can unlock. \n\nThis game really shines with the variety of characters you can play. You start out with two but quickly can unlock the others. If you hover over the character slot it will tell you what to do. \n\nIf you like rogue-lites with fast gameplay, amazing soundtrack, and a variety of play styles you should get this game.", "timestamp_created": 1705362870, "timestamp_updated": 1705362870, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1699469751", "reactions": []}, {"recommendationid": "156065263", "author": {"steamid": "76561198048048353", "personaname": "Rigber", "persona_status": "online", "profile_url": "https://steamcommunity.com/id/mrbonkbonk/", "num_games_owned": 0, "num_reviews": 33, "playtime_forever": 459, "playtime_last_two_weeks": 0, "playtime_at_review": 299, "last_played": 1717559848, "avatar": "254331d9e171d2ad754a95ae