eam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "191608627", "author": {"steamid": "76561198067952921", "personaname": "Dirtmonkey7", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198067952921/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 5041, "playtime_last_two_weeks": 0, "playtime_at_review": 4976, "last_played": 1743382157, "avatar": "22c46182be26354955fa80417813136237dec53a"}, "language": "english", "review": "Fun game play, interesting story line and characters, great graphics, game. There are a few bugs, but nothing major. Lots of online wikis to help fill in missed details.", "timestamp_created": 1743377870, "timestamp_updated": 1743377870, "voted_up": true, "votes_up": 6, "votes_funny": 0, "weighted_vote_score": "0.571350455284118652", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "191585495", "author": {"steamid": "76561198082526940", "personaname": "kimson82", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198082526940/", "num_games_owned": 156, "num_reviews": 4, "playtime_forever": 10923, "playtime_last_two_weeks": 16, "playtime_at_review": 8879, "last_played": 1790212549, "avatar": "838bb3f582aba85b7021c4e93fe89ec449208c63"}, "language": "english", "review": "Very good game even it's not perfect. If you liked the universe and lore of ME you probably also like this game even if it's not so epic and memorable as the trilogy. But here it's not about defending our home and our galaxy (which is more emotional), here it's about settling in a galaxy where we're the aliens so it's a very interesting point of view, at least for me :) \r\nThose who didn't played it yet or didn't play because of all the negative in social media back in 2018 I'll recommend to give it a chance.", "timestamp_created": 1743357495, "timestamp_updated": 1743357495, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.476190477609634399", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "191582772", "author": {"steamid": "76561197987439433", "personaname": "Bel Riose", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/admira_cadiz/", "num_games_owned": 0, "num_reviews": 9, "playtime_forever": 5838, "playtime_last_two_weeks": 0, "playtime_at_review": 5838, "last_played": 1737808905, "avatar": "dd1e3e5ad4959d53dd499df3dc3f9d4d2c16b5e5"}, "language": "english", "review": "Takes the Mass Effect Universe and then perfectly captures the sense of optimism and possibility that we attribute to the ideal version of frontier exploration and colonisation. An absolute joy to play.", "timestamp_created": 1743355449, "timestamp_updated": 1743355449, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}