}, {"recommendationid": "91524846", "author": {"steamid": "76561198848593647", "personaname": "MagentaSpektrum", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/magentaspektrum/", "num_games_owned": 0, "num_reviews": 10, "playtime_forever": 3412, "playtime_last_two_weeks": 0, "playtime_at_review": 3412, "last_played": 1620296848, "avatar": "47b94faf5b564d90ab5c94e9a808389962c674b9"}, "language": "english", "review": "I like this game much more than the negatitvite it got :) I recommend it!", "timestamp_created": 1620296949, "timestamp_updated": 1620296949, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "91521080", "author": {"steamid": "76561198051314648", "personaname": "ᵥₒₙ 𝕲 ü 𝖙 𝖘", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Gattsuis/", "num_games_owned": 0, "num_reviews": 46, "playtime_forever": 1581, "playtime_last_two_weeks": 0, "playtime_at_review": 897, "last_played": 1695795386, "avatar": "049116dc3827584518d1124b90aa06b7fab8d023"}, "language": "english", "review": "I should dislike this game solely on account of it being unplayable offline.. however i simply cant: its easy enough to crack.. the graphics, gameplay, and story totally make up for it - wisping the mind away to a whole new.. galaxy, really. \n\noutstanding game, much like the first two. I recommend this game to anyone who remotely enjoys sci-fi. \n\npick up on sale and itll pay for itself many times over", "timestamp_created": 1620290483, "timestamp_updated": 1620290483, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "91512411", "author": {"steamid": "76561198333416140", "personaname": "AmptiFa", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198333416140/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 1369, "playtime_last_two_weeks": 0, "playtime_at_review": 1202, "last_played": 1653188767, "avatar": "618bfa7e8477cee17e56637af632fef4e31724b2"}, "language": "english", "review": "This game gets entirely too much hate. This is an excellent first game in what was/is suppose to be a new trilogy. I loved every single location, save for one (Kadaraa kinda sucks), the space flight is intuitive, gorgeous, and incredibly immersive. Since release a decent amount of patches have smoothed the game out, although I highly recommend doing some modding (which is incredibly easy with Frosty Mod). The gameplay is peak mass effect and is so much cleaner than the OGT in that movement is flexible, crafting and no limit to which powers you want allow for much to experiment with.\n\nStory is a solid 8/10 if you do not rush through and make dialogue choices based on how you would react. The enemies leave something to be desired but I really enjoyed fighting them.", "timestamp_created": 1620271724, "timestamp_updated": 1620271724, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "91504202", "author": {"steamid": "76561198321452741", "personaname": "Judith", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198321452741/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 956, "playtime_last_two_weeks": 0, "playtime_at_review": 309, "last_played": 1625257290, "avatar": "e37e7a36eac696b4ed111140c8cdf0ba6ccf8b40"}, "language": "english", "review": "I have just started playing this, but I love it. The graphics are amazing and the story line is fantastic. I know a friend who plays and she and I both agree it is worth the money! We love it", "timestamp_created": 1620255486, "timestamp_updated": 1620255486, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}