{"game": "mass-effect-andromeda", "language": "english", "appid": 1238000, "month": "2026-02", "window": 3, "start_date": 1771113600, "end_date": 1771718399, "month_true_total": 87, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 22:02:50 UTC", "reviews": [{"recommendationid": "218902796", "author": {"steamid": "76561198002602624", "personaname": "Rococo Rockwell", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198002602624/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 3703, "playtime_last_two_weeks": 0, "playtime_at_review": 3168, "last_played": 1771778931, "avatar": "2648b8bf2a176645c47b8002c0dc0be6e7f9af05"}, "language": "english", "review": "If you are looking for a decent, though flawed scifi action-rpg with pretty fun combat, this is for you. Unfortunately, this game is haunted by the specter of its much better predecessors. When held up against the original trilogy, this game definitely falls short. It is not, however, the complete mess that people sometimes make it out to be. It's a solid 7 out of 10, if not a 7.5. Get it on sale and you'll have yourself a decent rpg experience with plenty of content.", "timestamp_created": 1771712121, "timestamp_updated": 1771712121, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "218899976", "author": {"steamid": "76561198203190298", "personaname": "Squashed.Pumpkin", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198203190298/", "num_games_owned": 0, "num_reviews": 29, "playtime_forever": 4034, "playtime_last_two_weeks": 0, "playtime_at_review": 4034, "last_played": 1771709374, "avatar": "e14d273b328d9a08e97e169f4a8df488d1715a97"}, "language": "e