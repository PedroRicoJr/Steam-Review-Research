ment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "176049133", "author": {"steamid": "76561198372600338", "personaname": "XScarecrow+-+AimX", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198372600338/", "num_games_owned": 0, "num_reviews": 62, "playtime_forever": 1103, "playtime_last_two_weeks": 0, "playtime_at_review": 886, "last_played": 1731934477, "avatar": "ee15a2f07e5b24ce5e91524d46271fe1406408fb"}, "language": "english", "review": "good gameplay", "timestamp_created": 1727639899, "timestamp_updated": 1727639899, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "176046637", "author": {"steamid": "76561199588095216", "personaname": "CT-Mozze", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/Duckie_09/", "num_games_owned": 0, "num_reviews": 8, "playtime_forever": 2205, "playtime_last_two_weeks": 0, "playtime_at_review": 2205, "last_played": 1727637170, "avatar": "7e64e4a94789309cc57c75fc7ff1d518eea0bd48"}, "language": "english", "review": "This game isn't like the original trilogy sure but the story is lovely when you really get into it, and there is plenty of side missions to explore and give Andromeda a flare of life", "timestamp_created": 1727637401, "timestamp_updated": 1727637401, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "176046345", "author": {"steamid": "76561198020736036", "personaname": "MechMan3050", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198020736036/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 7419, "playtime_last_two_weeks": 0, "playtime_at_review": 7419, "last_played": 1727572726, "avatar": "b41610e0a235e45c0174ab806db2e0d57225217f"}, "language": "english", "review": "I enjoyed the game quite a bit. Helps if you've played the Original Mass Effect games (it'll be more meaningful) but not required. Combat is fun and abilities mix things up from just a straight shooter. If you like RPGs you'll most likely enjoy this game. Didn't try the multi-player portion, but that's really only once you've played through the campaign and done all the content. Not quite as good of a story as ME1-3 but still entertaining. Has romance options that add to the immersion. Sure there are a few flaws (facial animations are weird, but it's not that big of a deal), and some of the quests are just \"fetch the item\", but overall they are varied enough to keep the story interesting and moving forward. To me it was worth the purchase.", "timestamp_created": 1727637097, "timestamp_updated": 1727637097, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}