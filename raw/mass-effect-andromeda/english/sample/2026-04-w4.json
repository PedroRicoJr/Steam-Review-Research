{"game": "mass-effect-andromeda", "language": "english", "appid": 1238000, "month": "2026-04", "window": 4, "start_date": 1776902400, "end_date": 1777593599, "month_true_total": 83, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 22:03:08 UTC", "reviews": [{"recommendationid": "224466927", "author": {"steamid": "76561198086665290", "personaname": "Super Suavesky", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198086665290/", "num_games_owned": 0, "num_reviews": 45, "playtime_forever": 804, "playtime_last_two_weeks": 0, "playtime_at_review": 728, "last_played": 1777621356, "avatar": "48b7dd4a46bb7fa11ad9f35fcb9a6e9a581b387b"}, "language": "english", "review": "Have had several playthroughs on console. Brought the Steam edition on sale.\r\n\r\nThis game a glimpse into what could have been. If it was listed as anything but 'Mass Effect' it would have drawn more acclaim. The only real issues it the wonky facial animations. In terms of combat and gameplay it's by far the best the series has ever been and is filled with exploration and quest to dive in to. I highly advise anyone on the fence to try it out, especially if its on the cheap.", "timestamp_created": 1777592355, "timestamp_updated": 1777592355, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "hardware": {"system_ram": "32693", "os": "Windows 11", "cpu_name": "AMD Ryzen 5 5600X 6-Core Processor             ", "adapter_description": "AMD Radeon RX 9070 XT", "vram_size": 16253}, "reactions": []}, {"recommendationid": "224398550", "author": {"steamid": "76561198135031863", "personaname": "Dichotomy", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198135031863/", "num_games_owned": 151, "num_reviews": 26, "playtime_