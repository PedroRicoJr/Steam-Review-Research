{"game": "mass-effect-andromeda", "language": "english", "appid": 1238000, "month": "2024-04", "window": 2, "start_date": 1712534400, "end_date": 1713225599, "month_true_total": 82, "quota": 5, "returned": 5, "pulled_at": "2026-10-07 21:59:50 UTC", "reviews": [{"recommendationid": "162897740", "author": {"steamid": "76561197971049676", "personaname": "bancodegaia", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561197971049676/", "num_games_owned": 0, "num_reviews": 22, "playtime_forever": 19321, "playtime_last_two_weeks": 0, "playtime_at_review": 19321, "last_played": 1663983071, "avatar": "5497e4de77b61d37b8e22fcccd525ac450ed2121"}, "language": "english", "review": "This game was nowhere near as bad as people said it was. Had a lot of fun with it, but it’s not remarkable (especially compared to the previous three installments). The supporting characters could be more interesting, but they do the job. However, the plot is quite successful (apart from the somewhat boring alien antagonists). The gameplay model is also not the worst. Yes, it's different than in the previous parts, but you can get used to it and appreciate its advantages over time.\n\nIt's a pity that I've been waiting for the next part for 7 years and it still isn't available... Soon I'll start to lose hope that it will ever be made.", "timestamp_created": 1713133090, "timestamp_updated": 1713133090, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "162896869", "author": {"steamid": "76561199041006474", "personaname": "TheGrassPhoenix", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199041006474/", "num_games_owned": 255, "num_reviews": 30, "playtime_forever": 415, "pla