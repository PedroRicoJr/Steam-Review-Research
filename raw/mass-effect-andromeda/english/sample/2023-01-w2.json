e", "profile_url": "https://steamcommunity.com/profiles/76561198037688345/", "num_games_owned": 0, "num_reviews": 18, "playtime_forever": 6938, "playtime_last_two_weeks": 0, "playtime_at_review": 3122, "last_played": 1674911354, "avatar": "af8c252f15460ad0e2304f80e2780c15a0957ed2"}, "language": "english", "review": "This is a good game, well worth a buy. \nIt had a rough start because its writing does fall short in places, the dialogue and character personalities (looking at you Addison) make you question if the writers were amateur at best. \nIts strength lies in design and gameplay, its better that the original trilogy by far, better ship design,  better exploration, better mini games... combat is heads above (only downsize is being restricted to 3 active abilities but some will love that) but you can design your character as you see fit. \nIf you are a Mass Effect / Sci-Fil fan, this is a must play, just ignore some of the weird facial expressions and bad writing at times and you'll have fun! \nThis could have been Game of the Year worthy, shame it was abandoned for Anthem.", "timestamp_created": 1673706229, "timestamp_updated": 1673706229, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}