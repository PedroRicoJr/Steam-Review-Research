7156713", "author": {"steamid": "76561198278891902", "personaname": "RealMadridUCL15", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/DoctorMadrid/", "num_games_owned": 173, "num_reviews": 46, "playtime_forever": 21149, "playtime_last_two_weeks": 0, "playtime_at_review": 1610, "last_played": 1789637953, "avatar": "fb6460711a0c419b797aea1230c5954df8e950dd"}, "language": "english", "review": "Mass Effect: My money flew to Andromeda", "timestamp_created": 1602038108, "timestamp_updated": 1602038108, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.446177840232849121", "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "77155987", "author": {"steamid": "76561198088482060", "personaname": "M8H", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198088482060/", "num_games_owned": 0, "num_reviews": 3, "playtime_forever": 883, "playtime_last_two_weeks": 0, "playtime_at_review": 855, "last_played": 1609392133, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "Story is good, squadmates though are more like work colleagues than people you'd actually want to be friends with. Much longer than the other ME games. CQC combat is very good, but at range you can cheese enemies easily. Crafting is good, inventory is quite deep. This game is closer to me1 than either me2 or me3.  Exploration is pretty good. This game does have an issue now where it uses a lot of cpu for no reason, if you have your cpu overclocked it can cause crashes, before playing turn the clock down. Runs pretty well but not great in terms of frame rate. 8.5/10. Already owned this on origin and did 1k hours on the multiplayer and beat the campaign a few times.", "timestamp_created": 1602036746, "timestamp_updated": 1602036746, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "77146854", "author": {"steamid": "76561198036020404", "personaname": "jimchon", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198036020404/", "num_games_owned": 0, "num_reviews": 12, "playtime_forever": 1777, "playtime_last_two_weeks": 0, "playtime_at_review": 1777, "last_played": 1602019269, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "Enjoyable and worth buying on sale.  It is not as good as previous Mass Effect Games but has many good missions and explorations to keep you busy.  \n  It feels like the work of 100 very smart programmers all working on parts of a game which were never put into a single game.  Lots of good parts that would be even better if there was more mission direction.", "timestamp_created": 1602019666, "timestamp_updated": 1602019666, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": "0.48888888955116272", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}