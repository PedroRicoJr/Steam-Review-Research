ctions": []}, {"recommendationid": "84225661", "author": {"steamid": "76561198128360550", "personaname": "ShaneyMac777", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/ShaneyMac777/", "num_games_owned": 355, "num_reviews": 11, "playtime_forever": 5785, "playtime_last_two_weeks": 0, "playtime_at_review": 5785, "last_played": 1610024423, "avatar": "72a3021435ed639658cfd9bfca50c309cde8f7a1"}, "language": "english", "review": "Great game, despite the hilarious animations and cringeworthy characters. Combat and exploration excellent, wide range of different weapons and abilities to play around with. A lot of the decisions really don't make a difference to the story which is annoying, and there's only one ending which is usually the main reason anyone plays Mass Effect. There is 100% no reason to replay, I'm glad I did play through it all once though.", "timestamp_created": 1610032547, "timestamp_updated": 1610032547, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": false, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "84218930", "author": {"steamid": "76561198139480426", "personaname": "Noiseless", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/IllNoiselessllI/", "num_games_owned": 95, "num_reviews": 18, "playtime_forever": 3511, "playtime_last_two_weeks": 0, "playtime_at_review": 3385, "last_played": 1623747327, "avatar": "375e96755cc78feb7ef46810c42dd2841d653287"}, "language": "english", "review": "Sometimes buggy and the travel in mid-game gets very annoying with all those cut scenes but overall the atmosphere, missions and combat make for a very nice game. Can only recommend it especially to sci-fi enthusiasts", "timestamp_created": 1610025410, "timestamp_updated": 1610025410, "voted_up": true, "votes_up"