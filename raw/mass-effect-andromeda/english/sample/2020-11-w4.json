_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198131430848/", "num_games_owned": 108, "num_reviews": 5, "playtime_forever": 5766, "playtime_last_two_weeks": 0, "playtime_at_review": 5766, "last_played": 1606744400, "avatar": "fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb"}, "language": "english", "review": "OMG this is so emotionally neeedy. Every character you play with has to have multiple utterly pointless chats about their feelings. The main quest line is really basic and if that was all you did it would just be a few hours. A huge chunk of the rest is filler. I have no idea why i even finished the game. I get the feeling the writers of this game had a list of PC/diversity/wellbeing themes they had to tick off before they payed real attention to story. I'm actually suprised they didnt have a fatty in the story somewhere just so they could put a tick next to body positivity. \n\nAside from that, the graphics were decent, the final mission was enjoyable but not exactly taxing. It was as though they were saying \"yeah we know you're sick to death of this by now, lets turn down the difficulty for you so you can get it finished and go play something more enjoyable.\"\n\nDo noy buy.", "timestamp_created": 1606745149, "timestamp_updated": 1606745149, "voted_up": false, "votes_up": 4, "votes_funny": 1, "weighted_vote_score": "0.480371654033660889", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": [{"reaction_type": 11, "count": 1}]}, {"recommendationid": "81209661", "author": {"steamid": "76561198357034328", "personaname": "TwinPeaksWannabe", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/depreshunn/", "num_games_owned": 0, "num_reviews": 5, "playtime_forever": 4728, "playtime_last_two_weeks": 0, "playtime_at_review": 4728, "last_played": 1594843363, "avatar": 