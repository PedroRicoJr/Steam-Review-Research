rsona_status": "in-game", "profile_url": "https://steamcommunity.com/id/Hello_again1234/", "num_games_owned": 512, "num_reviews": 47, "playtime_forever": 1307, "playtime_last_two_weeks": 0, "playtime_at_review": 465, "last_played": 1749905782, "avatar": "5314627063104c146d9600ec9ba791ba4560fd19"}, "language": "english", "review": "Bought on sale for $10. Definitely worth it in my opinion. Very minor technical issues with animations & voice acting, may bug you depending on how much you care about such things. Seems to run fairly well at max settings on my laptop, i7-10750h, gtx 1660ti, 16gb ram, ssd, 1920x1080 144hz. Landscapes are absolutely beautiful and gameplay is pretty great.", "timestamp_created": 1605344513, "timestamp_updated": 1605344513, "voted_up": true, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}