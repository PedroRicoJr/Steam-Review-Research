": "138315436", "author": {"steamid": "76561199086123014", "personaname": "Tay", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561199086123014/", "num_games_owned": 0, "num_reviews": 6, "playtime_forever": 3215, "playtime_last_two_weeks": 0, "playtime_at_review": 1409, "last_played": 1687573771, "avatar": "03c8152a662770d4d8ab2f92b07c483e648b0d00"}, "language": "english", "review": "the multiplayer is decent", "timestamp_created": 1684105131, "timestamp_updated": 1684697239, "voted_up": false, "votes_up": 0, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "138313078", "author": {"steamid": "76561198021476482", "personaname": "Bremen", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198021476482/", "num_games_owned": 0, "num_reviews": 1, "playtime_forever": 14112, "playtime_last_two_weeks": 0, "playtime_at_review": 5471, "last_played": 1763825867, "avatar": "4733c3713023f492126f7806f6cbc275bad077de"}, "language": "english", "review": "Absolutely amazing game! Must play - ignore any bad reviews - fantastic story, great gameplay - simply the best!", "timestamp_created": 1684100821, "timestamp_updated": 1684100821, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.519414305686950684", "comment_count": 1, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}, {"recommendationid": "138312600", "author": {"steamid": "76561198193439169", "personaname": "Maria", "persona_status": "in-game", "profile_url": "https://steamcommunity.com/profiles/76561198193439169/", "num_games_owned": 149, "num_reviews": 24, "playtime_forever": 5562, "playtime_last_two_weeks": 0, "playtime_at_review": 3661, "last_played": 1686481990, "avatar": "28016a22b5d509c5b5584b66a49a143241a48fda"}, "language": "english", "review": "I never gave this game the time of day. I was, and in some way still am salty about how ME3 was handled, the replayability was destroyed for me. So I stepped out of the ME verse. Not sure what brought me back, bored and curious, I guess. I really liked this game. Ryder really came into her own. I think this game got a lot of unfair criticism. Sure, the animation bugs and launch were unacceptable, but that was patched out rather quick from what I heard. This game had the unfortunate reality of ME3 lingering over it. And Shepard being epic.\n\nGiven some story threads, I know they planned for several DLC, poor reception cancelled those plans, it would seem. And it's criminal. Because this is a very interesting story. The Archon is not as big a badguy as Sovereign was. Less mysterious, but there are a lot of unanswered questions. I also really want to find the Quarian ark!\n\nAnyway, I definitely recommend the game, the combat is great, I like it over ME 1 2 and 3 actually.", "timestamp_created": 1684100046, "timestamp_updated": 1684100046, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.476184040307998657", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1591887420", "reactions": []}]}